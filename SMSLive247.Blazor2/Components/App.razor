@inject Settings settings

<!DOCTYPE html>
<html lang="en">

<head>
    <base href="/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <ResourcePreloader />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:wght@100;200;300;400;500" />
    <link rel="stylesheet" href="@Assets["SMSLive247.Blazor2.styles.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss" data-desc="Tailwind default theme styles">
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 3px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            @@theme {
                --font-sans: "Ubuntu", sans-serif;

                /* this is orange */
                --color-brand-50: #fdf4f0;
                --color-brand-100: #fbe6df;
                --color-brand-200: #f8cebf;
                --color-brand-300: #f3ab91;
                --color-brand-400: #ee8159;
                --color-brand-500: #e95420;
                --color-brand-600: #db4d1a;
                --color-brand-700: #c6471b;
                --color-brand-800: #ba431a;
                --color-brand-900: #af3f18;
                --color-background-light: #f6f7f8;
                --color-background-dark: #101822; 

                /* this is blueish */
                --color-brand-50: #ecf3fd;
                --color-brand-100: #d9e8fc;
                --color-brand-200: #b3d0f9;
                --color-brand-300: #80b0f5;
                --color-brand-400: #478df0;
                --color-brand-500: #136dec;
                --color-brand-600: #1160d0;
                --color-brand-700: #0f53b3;
                --color-brand-800: #0d489c;
                --color-brand-900: #0b3d84;

               /*  
                  this is the original 
                --font-sans: "Inter", sans-serif;
                --color-brand-50: #eff6ff;
                --color-brand-100: #dbeafe;
                --color-brand-500: #136dec;
                --color-brand-600: #0e5bc4;
                --color-brand-700: #1d4ed8;
                --color-brand-900: #1e3a8a;
                --color-background-light: #f6f7f8;
                --color-background-dark: #101822;
                */

                /* Register the custom enter keyframes */
                --animate-enter: enter 200ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
                @@keyframes enter {
                    from {
                        opacity: var(--tw-enter-opacity, 1);
                        transform: scale(var(--tw-enter-scale, 1)) translateY(var(--tw-enter-translate-y, 0));
                    }

                    to {
                        opacity: 1;
                        transform: scale(1) translateY(0);
                    }
                }
            }

            /* Define v4 utilities using utility */
            @@utility animate-in {
                animation: var(--animate-enter);
            }
            @@utility fade-in {
                --tw-enter-opacity: 0;
            }
            @@utility zoom-in-95 {
                --tw-enter-scale: 0.95;
            }
            @@utility slide-in-from-top-1 {
                --tw-enter-translate-y: -0.25rem;
            }
            @@utility slide-in-from-top-2 {
                --tw-enter-translate-y: -0.5rem;
            }

            @@utility scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;

                &::-webkit-scrollbar {
                    display: none;
                }
            }

            /* Global HTML Overrides */
            body {
                font-size: 95%;
                font-family: var(--font-sans);
                background-color: #f8fafc; /* bg-slate-50 */
                color: #0f172a; /* text-slate-900 */
                -webkit-font-smoothing: antialiased;
            }

            h1:focus, h2:focus, h3:focus, h4:focus, h5:focus, h6:focus {
                outline: none;
            }

            button, [role="button"], select, input[type="submit"] {
                cursor: pointer;
            }
    </style>
    <script type="text/javascript" data-name="Script to load TawkTo Chat">
            (function() {
                window.LoadTawk = function(propertyId) {
                    if (!propertyId || document.getElementById("tawk-script")) {
                        return;
                    }

                    window.Tawk_API = window.Tawk_API || {};
                    window.Tawk_LoadStart = new Date();

                    window.Tawk_API.onLoad = function() {
                        if (typeof window.Tawk_API.hideWidget === "function") {
                            window.Tawk_API.hideWidget();
                        }
                    };

                    window.Tawk_API.onChatMinimized = function() {
                        if (typeof window.Tawk_API.hideWidget === "function") {
                            window.Tawk_API.hideWidget();
                        }
                    };

                    var script = document.createElement("script");
                    script.id = "tawk-script";
                    script.async = true;
                    script.charset = "UTF-8";
                    script.setAttribute("crossorigin", "*");

                    var widgetId = propertyId.indexOf("/") >= 0 ? "" : "/1";
                    script.src = "https://embed.tawk.to/" + propertyId + widgetId;

                    var firstScript = document.getElementsByTagName("script")[0];
                    if (firstScript && firstScript.parentNode) {
                        firstScript.parentNode.insertBefore(script, firstScript);
                    } else {
                        document.head.appendChild(script);
                    }
                };

                window.OpenTawkChat = function() {
                    if (window.Tawk_API && typeof window.Tawk_API.showWidget === "function") {
                        window.Tawk_API.showWidget();
                        window.Tawk_API.maximize();
                        return true;
                    }

                    alert("Live chat is still initializing. Please wait a moment and try again.");
                    return false;
                };
            })();

            //window.LoadTawk(@((MarkupString)settings.TawkToID));
    </script>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)"></Routes>
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
