@typeparam TValue
@inherits InputBase<TValue?>

<div>
    @if (!string.IsNullOrEmpty(Label))
    {
        @* <label class="mb-1 block text-sm font-medium text-slate-700">
            @Label
        </label> *@
    }
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-slate-700">
            @Label
            @if (Required)
            {
                <span class="ml-2 text-red-500">*</span>
            }
            @if (HasError)
            {
                <span class="ml-2 text-red-500">
                    @* <Icon Style="Icon.IconStyle.Info" CssClass="mr-2 text-[2px] text-yellow-500" /> *@
                    <o>@ErrorMessage</o>
                </span>
            }
        </label>
    }
    <div class="relative">
        <select 
                value="@CurrentValueAsString" 
                @onchange="OnChange"
                @attributes="AdditionalAttributes"
                class="@GetCssClass()">

            @if (Variant == SelectType.Country)
            {
                <option value="">- select country -</option>
                @foreach (var country in countries)
                {
                    <option value="@country.Key">@country.Value</option>
                }
            }
            else if (Variant == SelectType.TimeZone)
            {
                <option value="">- select time zone -</option>
                @foreach (var timeZone in timeZones)
                {
                    var offset = timeZone.BaseUtcOffset.Hours;
                    <option value="@offset">@timeZone.DisplayName</option>
                }
            }
            @ChildContent
        </select>
        @if (IconStyle != null)
        {
            <div
                class="absolute inset-y-0 right-0 flex cursor-pointer items-center pr-3 text-slate-400 transition-colors hover:text-slate-600">
                <Icon Style="@((Icon.IconStyle)IconStyle)" />
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(HelpText))
    {
        <p class="text-s mt-1 text-slate-500">
            <Icon Style="Icon.IconStyle.Info" CssClass="" />
            <span>@HelpText</span>
        </p>
    }
</div>

@code {
    public enum SelectType { None, Country, TimeZone }

    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SelectType Variant { get; set; } = SelectType.None;
    [Parameter] public Icon.IconStyle? IconStyle { get; set; }
    [Parameter] public bool IsEmbedded { get; set; } = false;
    [Parameter] public string? HelpText { get; set; }

    // additional validation parameters
    [Parameter] public bool Required { get; set; } = true;

    [Parameter] public string InvalidMessage { get; set; } = "Please enter a valid {0}.";
    [Parameter] public string RequiredMessage { get; set; } = "The {0} field is required.";

    [Parameter] public EventCallback<bool> IsValidChanged { get; set; }

    // public properties to expose validation state to parent components
    public bool HasError { get; private set; }
    public string? ErrorMessage { get; private set; }

    private ValidationMessageStore? messageStore;
    private TimeZoneInfo[] timeZones = TimeZoneInfo.GetSystemTimeZones().ToArray();

    private static readonly Dictionary<int, string> countries = new()
    {
        { 234, "Nigeria" },
        { 233, "Ghana" },
        { 254, "Kenya" },
        { 27, "South Africa" },
        { 1, "United States of America" },
        { 44, "United Kingdom" }
    };

    protected override void OnInitialized()
    {
        if (EditContext is not null)
            messageStore = new ValidationMessageStore(EditContext);
    }

    private string GetCssClass()
    {
        return IsEmbedded
            ? "h-9 px-3 border-l border-slate-200 text-sm text-slate-700 focus:outline-none cursor-pointer"
            : "appearance-none block w-full px-3 py-2.5 border rounded-lg sm:text-sm bg-white text-slate-900 transition-all border-slate-200";
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
        await ValidateAsync();
    }

    private async Task ValidateAsync()
    {
        var (isValid, message) = Validate(CurrentValueAsString);

        HasError = !isValid;
        ErrorMessage = message;

        if (messageStore is not null && EditContext is not null)
        {
            messageStore.Clear(FieldIdentifier);
            if (!isValid && message is not null)
            {
                messageStore.Add(FieldIdentifier, message);
            }
            EditContext.NotifyValidationStateChanged();
        }

        await IsValidChanged.InvokeAsync(isValid);
        StateHasChanged();
    }

    private (bool IsValid, string? Message) Validate(string? raw)
    {
        var isEmpty = string.IsNullOrWhiteSpace(raw) 
                    || default(TValue)?.ToString() == raw;

        if (Required && isEmpty)
            return (false, string.Format(RequiredMessage, Label ?? Variant.ToString()));

        if (isEmpty)
            // Not required and empty — nothing further to check.
            return (true, null);

        // if (!TryParse(raw, out _))
        //     return (false, "Please enter a valid number.");

        // var numeric = Convert.ToDouble(raw, CultureInfo.InvariantCulture);

        // if (Min.HasValue && numeric < Min.Value)
        //     return (false, string.Format(RangeMessageFormat, Min, Max));

        // if (Max.HasValue && numeric > Max.Value)
        //     return (false, string.Format(RangeMessageFormat, Min, Max));

        return (true, null);
    }

    protected override bool TryParseValueFromString(string? value,
        [MaybeNullWhen(false)] out TValue? result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        try
        {
            result = string.IsNullOrWhiteSpace(value)
                ? default : Parse(value);
        }
        catch (Exception)
        {
            throw new Exception($"Failed to cast value:'{value}' to type:'{typeof(TValue)}' in FormSelect");
        }

        validationErrorMessage = null;
        return true;
    }

    private TValue? Parse(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return default;

        var underlyingType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        var converted = Convert.ChangeType(raw, underlyingType, System.Globalization.CultureInfo.InvariantCulture);
        return (TValue)converted;
    }
}