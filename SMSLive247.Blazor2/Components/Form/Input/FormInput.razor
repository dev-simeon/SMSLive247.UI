@inherits InputBase<string>

<div>
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-slate-700">
            @Label
        </label>
    }
    <div class="mt-1 relative">
        <input @attributes="AdditionalAttributes" 
               type="@inputType"
               placeholder="@PlaceHolder"
               value="@CurrentValueAsString"
               @onchange="OnChange"
               @onblur="OnBlur" 
               class="appearance-none block w-full px-3 py-2.5 border rounded-lg placeholder-slate-400 
                      focus:outline-none focus:ring-brand-500 focus:border-brand-500 
                      sm:text-sm bg-white text-slate-900 transition-all border-slate-200 
                      @GetErrorClass()" />

        @if (IconStyle != null)
        {
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer text-slate-400 hover:text-slate-600 transition-colors">
                <Icon Style="@((Icon.IconStyle)IconStyle)" />
            </div>
        }

        @if (Type == "password")
        {
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer text-slate-400 hover:text-slate-600 transition-colors"
                 @onclick="TogglePasswordType">
                @if (showPassword)
                {
                    <Icon Style="Icon.IconStyle.EyeOff" />                
                }
                else
                {
                    <Icon Style="Icon.IconStyle.Eye" />
                }
            </div>
        }
    </div>

    @if (showError)
    {
        <p class="mt-1 text-xs text-red-500">
            <Icon Style="Icon.IconStyle.Close" CssClass="mr-2" />@ErrorMessage
        </p>
    }
    else if(!string.IsNullOrEmpty(HelpText))
    {
        <p class="mt-1 text-xs text-slate-500">
            <Icon Style="Icon.IconStyle.Info" CssClass="mr-2" />@HelpText
        </p>
    }
</div>

<script>
    function validateField(event) {
        const element = event.target;
        const validity = element.validity;

        // Find the companion error span inside the same parent container
        const errorContainer = element.closest('.input-group');
        const errorSpan = errorContainer ? errorContainer.querySelector('.error-msg') : null;

        let errorMessage = "";

        // 1. Check if the field is empty but marked as required
        if (validity.valueMissing) {
            if (element.type === 'checkbox') {
                errorMessage = "You must accept this field to proceed.";
            } else {
                errorMessage = "This field cannot be left blank.";
            }
        }
        // 2. Check type mismatches (e.g., invalid email format or broken URL)
        else if (validity.typeMismatch) {
            if (element.type === 'email') {
                errorMessage = "Please enter a valid email address (e.g., name@example.com).";
            } else {
                errorMessage = "The format entered is incorrect.";
            }
        }
        // 3. Check text length limits
        else if (validity.tooShort) {
            errorMessage = `Must be at least ${element.minLength} characters long.`;
        }
        // 4. Check numeric ranges
        else if (validity.rangeUnderflow) {
            errorMessage = `Value must be at least ${element.min}.`;
        } else if (validity.rangeOverflow) {
            errorMessage = `Value cannot be higher than ${element.max}.`;
        }
        // 5. Check custom regex pattern attributes
        else if (validity.patternMismatch) {
            errorMessage = "The format does not match requirements.";
        }

        // Render the error message to the UI
        if (errorSpan) {
            if (errorMessage) {
                errorSpan.textContent = errorMessage;
                errorSpan.style.display = "block";
                element.classList.add('input-error'); // Optional: for CSS styling
            } else {
                errorSpan.textContent = "";
                errorSpan.style.display = "none";
                element.classList.remove('input-error');
            }
        }
    }

</script>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? PlaceHolder { get; set; }
    [Parameter] public string? Type { get; set; } = "text";
    [Parameter] public Icon.IconStyle? IconStyle { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? HelpText { get; set; }

    private string inputType = "text";
    private bool showPassword = false;
    private bool showError = false;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Type))
            inputType = Type.Trim().ToLower();

        base.OnParametersSet();
    }

    private void OnChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    private void OnBlur(FocusEventArgs e)
    {
        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }

    private void TogglePasswordType()
    {
        showPassword = !showPassword;
        inputType = showPassword ? "text" : "password";
    }

    private string GetErrorClass()
    {
        return showError ? "border-red-300 ring-1 ring-red-300" : "border-slate-200";
    }

    private void ValidateInput(FocusEventArgs args)
    {
        ErrorMessage = args.Type;
    }

    protected override bool TryParseValueFromString(string? value,
        [MaybeNullWhen(false)] out string result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = null;
        return true;
    }
}
