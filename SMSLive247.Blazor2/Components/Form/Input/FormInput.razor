@typeparam TValue
@inherits InputBase<TValue>

<div>
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block">
            @Label
            @if (Required)
            {
                <span class="ml-2 text-red-500">*</span>
            }
            @if (HasError)
            {
                <span class="ml-2 text-xs text-red-500">
                    @* <Icon Style="Icon.IconStyle.Info" CssClass="mr-2 text-[2px] text-yellow-500" /> *@
                    <o>@ErrorMessage</o>
                </span>
            }
        </label>
    }
    <div class="relative mt-1">
        @if (Multiline == 1)
        {
            <input type="@inputType"
                   placeholder="@PlaceHolder"
                   value="@CurrentValueAsString"
                   min="@Min"
                   max="@Max"
                   @oninput="OnInput"
                   @onblur="OnBlur"
                   @attributes="AdditionalAttributes"
                   class="block w-full appearance-none rounded-lg border border-slate-200 px-3 py-2.5 text-slate-900 placeholder-slate-400 transition-all focus:ring-brand-500/30 focus:border-brand-500 focus:ring-4 focus:outline-none @GetCssClass()" />
        }
        else
        {
            <textarea rows="@Multiline"
                   placeholder="@PlaceHolder"
                   value="@CurrentValueAsString"
                   min="@Min"
                   max="@Max"
                   @oninput="OnInput"
                   @onblur="OnBlur"
                   @attributes="AdditionalAttributes"
                   class="block w-full resize-none appearance-none rounded-lg border border-slate-200 px-3 py-2.5 text-slate-900 placeholder-slate-400 transition-all focus:ring-brand-500/30 focus:border-brand-500 focus:ring-4 focus:outline-none @GetCssClass()" />
        }

        @if (IconStyle != null)
        {
            <div class="absolute inset-y-0 right-0 flex cursor-pointer items-center pr-3 text-slate-400 transition-colors hover:text-slate-600">
                <Icon Style="@((Icon.IconStyle)IconStyle)" />
            </div>
        }

        @if (Type == "password")
        {
            <div class="absolute inset-y-0 right-0 flex cursor-pointer items-center pr-3 text-slate-400 transition-colors hover:text-slate-600"
                 @onclick="TogglePasswordType">
                @if (inputType == "password")
                {
                    <Icon Style="Icon.IconStyle.EyeOff" />                
                }
                else
                {
                    <Icon Style="Icon.IconStyle.Eye" />
                }

            </div>
        }
    </div>

    @if(!string.IsNullOrEmpty(HelpText))
    {
        <p class="mt-1 text-xs text-slate-500">
            <Icon Style="Icon.IconStyle.Info" CssClass="" />
            <span>@HelpText</span>
        </p>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? PlaceHolder { get; set; }
    [Parameter] public string? Type { get; set; } = "text"; //text, password, email, number, etc.
    [Parameter] public Icon.IconStyle? IconStyle { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public int Multiline { get; set; } = 1;

    // additional validation parameters
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public TValue? Min { get; set; }
    [Parameter] public TValue? Max { get; set; }

    [Parameter] public string InvalidMessage { get; set; } = "Please enter a valid {0}.";
    [Parameter] public string RequiredMessage { get; set; } = "The {0} field is required.";
    [Parameter] public string RangeMessageFormat { get; set; } = "Value must be between {0} and {1}.";

    [Parameter] public EventCallback<bool> IsValidChanged { get; set; }

    // public properties to expose validation state to parent components
    public bool HasError { get; private set; }
    public string? ErrorMessage { get; private set; }

    private bool hasBlurredOnce = false;
    private string inputType = "text";
    private ValidationMessageStore? messageStore;

    protected override void OnInitialized()
    {
        if (EditContext is not null)
            messageStore = new ValidationMessageStore(EditContext);
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Type))
            inputType = Type.Trim().ToLower();

        base.OnParametersSet();
    }

    private void TogglePasswordType()
    {
        inputType = inputType == "password" ? "text" : "password";
    }

    private string GetCssClass()
    {
        return HasError ? "border-red-300 ring-2 ring-red-300 bg-red-50" : "border-slate-200 bg-white";
    }

    protected override bool TryParseValueFromString(string? value,
        [MaybeNullWhen(false)] out TValue result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value is null ? default : (TValue)(object)value;

        validationErrorMessage = null;
        return true;
    }
      
    private async Task OnBlur(FocusEventArgs e)
    {
        hasBlurredOnce = true;
        await ValidateAsync();
    }
    
    private async Task OnInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
                
        if (hasBlurredOnce)
            await ValidateAsync();
    }

    private async Task ValidateAsync()
    {
        var (isValid, message) = Validate(CurrentValueAsString);

        HasError = !isValid;
        ErrorMessage = message;

        if (messageStore is not null && EditContext is not null)
        {
            messageStore.Clear(FieldIdentifier);
            if (!isValid && message is not null)
            {
                messageStore.Add(FieldIdentifier, message);
            }
            EditContext.NotifyValidationStateChanged();
        }

        await IsValidChanged.InvokeAsync(isValid);
        StateHasChanged();
    }

    private (bool IsValid, string? Message) Validate(string? raw)
    {
        var isEmpty = string.IsNullOrWhiteSpace(raw);

        if (Required && isEmpty)
            return (false, string.Format(RequiredMessage, Label ?? Type));

        if (isEmpty)
            // Not required and empty — nothing further to check.
            return (true, null);

        if (Type == "email" && !System.Net.Mail.MailAddress.TryCreate(raw, out _))
            return (false, string.Format(InvalidMessage, Label ?? Type));

        // if (!TryParse(raw, out _))
        //     return (false, "Please enter a valid number.");

        // var numeric = Convert.ToDouble(raw, CultureInfo.InvariantCulture);

        // if (Min.HasValue && numeric < Min.Value)
        //     return (false, string.Format(RangeMessageFormat, Min, Max));

        // if (Max.HasValue && numeric > Max.Value)
        //     return (false, string.Format(RangeMessageFormat, Min, Max));

        return (true, null);
    }

    // private async Task<bool> ValidateNowAsync()
    // {
    //     hasBlurredOnce = true;
    //     await ValidateAsync();
    //     return !HasError;
    // }
}