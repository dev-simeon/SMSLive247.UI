<button @attributes="AdditionalAttributes" type="@buttonType" disabled="@(IsBusy || IsDisabled)" @onclick="HandleClick"
        class="flex min-h-[37.6px] min-w-[120px] transform items-center justify-center gap-2 rounded-lg px-5 transition-all focus:ring-2 focus:ring-offset-2 focus:outline-none active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 @GetVariantClasses() @CssClass">
    @if (IsBusy)
    {
        <div class="h-5 w-5 animate-spin rounded-full border-2 border-current border-t-transparent"></div>
    }
    else
    {
        @if (Icon.HasValue)
        {
            <Icon Style="Icon.Value" FontWeight="300" />
        }
        @Text
        @ChildContent
    }
</button>

@code {
    [Parameter] public ColorStyle Style { get; set; } = ColorStyle.Primary;
    [Parameter] public Icon.IconStyle? Icon { get; set; }
    [Parameter] public string Text { get; set; } = "Submit";
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public bool IsSubmit { get; set; } = false;
    [Parameter] public bool IsBusy { get; set; } = false;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string buttonType => IsSubmit ? "submit" : "button";

    private string GetVariantClasses()
    {
        return Style switch
        {
            ColorStyle.Primary => "bg-brand-500 hover:bg-brand-600 text-white border border-transparent shadow-sm focus:ring-brand-500",
            ColorStyle.Secondary => "bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-sm focus:ring-slate-300",
            ColorStyle.Success => "bg-green-500 hover:bg-green-600 text-white border border-transparent shadow-sm focus:ring-green-500",
            ColorStyle.Danger => "bg-red-500 hover:bg-red-600 text-white border border-transparent shadow-sm focus:ring-red-500",
            ColorStyle.Warning => "bg-yellow-500 hover:bg-yellow-600 text-white border border-transparent shadow-sm focus:ring-yellow-500",
            ColorStyle.Info => "bg-blue-500 hover:bg-blue-600 text-white border border-transparent shadow-sm focus:ring-blue-500",
            ColorStyle.Light => "bg-gray-100 hover:bg-gray-200 text-gray-800 border border-gray-300 shadow-sm focus:ring-gray-300",
            ColorStyle.Dark => "bg-gray-800 hover:bg-gray-900 text-white border border-transparent shadow-sm focus:ring-gray-500",
            _ => "bg-brand-500 hover:bg-brand-600 text-white border border-transparent shadow-sm focus:ring-brand-500"
        };
    }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!OnClick.HasDelegate)
            return; // No OnClick delegate

        if (IsSubmit)
            throw new InvalidOperationException("Button cannot be both submit and have an OnClick event.");

        if (IsBusy)
            throw new InvalidOperationException("Button is busy. Please wait until the current operation is complete.");

        await OnClick.InvokeAsync(e);
    }
}
