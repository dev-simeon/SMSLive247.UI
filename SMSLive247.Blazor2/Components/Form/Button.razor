<button @attributes="AdditionalAttributes" type="@buttonType" disabled="@(IsBusy || IsDisabled)" @onclick="HandleClick"
        class="flex min-h-[37.6px] min-w-[120px] transform items-center justify-center gap-2 rounded-lg px-5 text-sm font-medium transition-all focus:ring-2 focus:ring-offset-2 focus:outline-none active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 @GetVariantClasses() @CssClass">
    @if (IsBusy)
    {
        <div class="h-5 w-5 animate-spin rounded-full border-2 border-current border-t-transparent"></div>
    }
    else
    {
        @if (Icon.HasValue)
        {
            <Icon Style="Icon.Value" CssStyle="font-weight: 200;" />
        }
        @Text
        @ChildContent
    }
</button>

@code {
    public enum ButtonStyle { Primary, Secondary }

    [Parameter] public ButtonStyle Style { get; set; } = ButtonStyle.Primary;
    [Parameter] public Icon.IconStyle? Icon { get; set; }
    [Parameter] public string Text { get; set; } = "Submit";
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public bool IsSubmit { get; set; } = false;
    [Parameter] public bool IsBusy { get; set; } = false;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string buttonType => IsSubmit ? "submit" : "button";

    private string GetVariantClasses()
    {
        return Style switch
        {
            ButtonStyle.Primary => "bg-brand-500 hover:bg-brand-600 text-white border border-transparent shadow-sm focus:ring-brand-500",
            ButtonStyle.Secondary => "bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-sm focus:ring-slate-300",
            _ => "bg-brand-500 hover:bg-brand-600 text-white border border-transparent shadow-sm focus:ring-brand-500"
        };
    }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!OnClick.HasDelegate)
            return; // No OnClick delegate

        if (IsSubmit)
            throw new InvalidOperationException("Button cannot be both submit and have an OnClick event.");

        if (IsBusy)
            throw new InvalidOperationException("Button is busy. Please wait until the current operation is complete.");

        await OnClick.InvokeAsync(e);
    }
}
