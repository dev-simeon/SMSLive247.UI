<CascadingValue Value="this">
    <div class="border-b border-slate-200">
        <nav class="-mb-px flex space-x-8 overflow-x-auto">
            @foreach (TabPage p in pages)
            {
                <button type="button" @onclick="() => SetActivePage(p)"
                        class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm 
                               flex items-center gap-2 transition-colors cursor-pointer
                        @(IsActive(p) 
                            ? "border-brand-500 text-brand-600" 
                            : "border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-200")">

                    @if (p.Icon.HasValue)
                    {
                        <Icon Style="@p.Icon.Value" CssClass="w-5 h-5" />
                    }
                    @p.Title
                </button>
            }
        </nav>
    </div>
    <div class="mt-6">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }
    [Parameter] public string? CurrentRoute { get; set; }

    public readonly HashSet<string> LoadedTabs = [];

    private readonly List<TabPage> pages = new();
    private TabPage? activePage;

    public bool IsActive(TabPage page) => page == activePage;

    public void AddPage(TabPage page)
    {
        if (!pages.Contains(page))
            pages.Add(page);

        if (pages.Count == 1)
        {
            activePage = page;
            LoadedTabs.Add(page.Id);
        }

        if (!string.IsNullOrEmpty(CurrentRoute) &&
            string.Equals(CurrentRoute, page.Route, StringComparison.OrdinalIgnoreCase))
            activePage = page;

        StateHasChanged();
    }

    public async Task SelectTab(string id)
    {
        var page = pages.FirstOrDefault(p => p.Id == id || p.Route == id);
        if (page != null)
            await SetActivePage(page);
    }

    private async Task SetActivePage(TabPage page)
    {
        activePage = page;

        if (!LoadedTabs.Contains(page.Id))
            LoadedTabs.Add(page.Id);

        if (OnTabSelected.HasDelegate)
            await OnTabSelected.InvokeAsync(page.Id);

        StateHasChanged();
    }
}
