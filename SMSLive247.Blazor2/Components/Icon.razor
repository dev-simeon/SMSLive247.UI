<i class="@GetIconCss() @CssClass"></i>

@code {
    [Parameter]
    public IconStyle Style { get; set; } = IconStyle.Bell;

    [Parameter]
    public string CssClass { get; set; } = "w-5 h-5";


    public enum IconStyle
    {
        ChevronRight,
        Bell,
        Info,
        Eye,
        EyeOff,
        Menu,
        Coins,
        PlusCircle,
        CheckCircle,
        Shield,
        Home,
        PenSquare,
        Mail,
        Users,
        CreditCard,
        ArrowRightLeft,
        Tag,
        Headphones,
        HelpCircle,
        Globe,
        ChevronDown,
        Close,
        User,
        LogOut,
        Network,
        Fingerprint,
        Terminal,
        BookOpen,
        Phone,
        Clock,
        AlertCircle,
    }

    public string GetIconCss()
    {
        switch (Style)
        {
            case IconStyle.ChevronRight:
                return "bi bi-chevron-right";
            case IconStyle.Bell:
                return "bi bi-bell";
            case IconStyle.Menu:
                return "bi bi-list";
            case IconStyle.Info:
                return "bi bi-info-circle";
            case IconStyle.Coins:
                return "bi bi-coins";
            case IconStyle.PlusCircle:
                return "bi bi-plus-circle";
            case IconStyle.Home:
                return "bi bi-house";
            case IconStyle.PenSquare:
                return "bi bi-pencil-square";
            case IconStyle.Mail:
                return "bi bi-envelope";
            case IconStyle.Users:
                return "bi bi-people";
            case IconStyle.CreditCard:
                return "bi bi-credit-card";
            case IconStyle.ArrowRightLeft:
                return "bi bi-arrow-left-right";
            case IconStyle.Tag:
                return "bi bi-tag";
            case IconStyle.Headphones:
                return "bi bi-headphones";
            case IconStyle.HelpCircle:
                return "bi bi-question-circle";
            case IconStyle.Globe:
                return "bi bi-globe";
            case IconStyle.ChevronDown:
                return "bi bi-chevron-down";
            case IconStyle.Close:
                return "bi bi-x-lg";
            case IconStyle.User:
                return "bi bi-person";
            case IconStyle.Eye:
                return "bi bi-eye";
            case IconStyle.EyeOff:
                return "bi bi-eye-slash";
            case IconStyle.LogOut:
                return "bi bi-box-arrow-right";
            case IconStyle.CheckCircle:
                return "bi bi-check-circle";
            case IconStyle.Shield:
                return "bi bi-shield-fill-check";
            case IconStyle.Network:
                return "bi bi-diagram-3-fill";
            case IconStyle.Fingerprint:
                return "bi bi-fingerprint";
            case IconStyle.Terminal:
                return "bi bi-terminal-fill";
            case IconStyle.BookOpen:
                return "bi bi-book";
            case IconStyle.Phone:
                return "bi bi-telephone";
            case IconStyle.Clock:
                return "bi bi-clock";
            case IconStyle.AlertCircle:
                return "bi bi-exclamation-circle";
            default:
                throw new ArgumentOutOfRangeException();
        }
    }
}
