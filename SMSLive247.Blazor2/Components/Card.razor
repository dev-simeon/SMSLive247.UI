<div class="rounded-xl border border-slate-200 bg-white p-6 pt-4 shadow-sm">
    @if (HeaderText != null || HeaderRight != null)
    {
        <div class="mb-3 flex items-center justify-between">
            <label class="block font-medium text-slate-800 uppercase">
                @HeaderText
            </label>
            @HeaderRight
        </div>
    }
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderRight { get; set; }
    [Parameter] public string? HeaderText { get; set; }

}
