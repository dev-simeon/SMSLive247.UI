@if (IsVisible)
{
    <div class="relative z-50">

        <Backdrop IsVisible="IsVisible" IsVisibleChanged="OnClose" />

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative w-full transform overflow-hidden rounded-lg bg-white text-left shadow-2xl transition-all sm:my-8 @GetMaxWidthClass()">
                    @* Header *@
                    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
                        <h3 class="text-lg leading-6 font-normal text-slate-900">
                            @Title
                        </h3>
                        <button type="button"
                                class="text-slate-400 transition-colors hover:text-slate-900"
                                @onclick="OnClose">
                            <Icon Style="Icon.IconStyle.Close" />
                        </button>
                    </div>

                    @* Content *@
                    <div class="max-h-[70vh] overflow-y-auto px-4 py-4">
                        @Body
                    </div>

                    @* Footer *@
                    @if (Footer != null)
                    {
                        <div class="flex flex-row-reverse gap-3 border-t border-slate-200 bg-slate-50 px-4 py-3">
                            @Footer
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    public enum ModalSize
    {
        Small,
        Medium,
        Large,
        ExtraLarge
    }

    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public ModalSize Size { get; set; } = ModalSize.Medium;
    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    public string GetMaxWidthClass() => Size switch
    {
        ModalSize.Small     => "max-w-md",
        ModalSize.Medium    => "max-w-lg",
        ModalSize.Large     => "max-w-2xl",
        ModalSize.ExtraLarge => "max-w-4xl",
        _                   => "max-w-lg"
    };

    private async Task OnClose()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);

        StateHasChanged();
    }
}
