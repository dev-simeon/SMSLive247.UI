@if (IsVisible)
{
    <div class="fixed inset-0 z-[9999]" style="z-index: @OverlayZIndex;">
        <Backdrop IsVisible="IsVisible" IsVisibleChanged="OnClose" />
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative w-full @maxWidthCss transform overflow-hidden rounded-lg bg-white text-left shadow-2xl transition-all sm:my-8 @CssClass"
                     style="@panelStyle">

                    <header class="flex items-center justify-between px-4 @colorCss py-3">
                        <h3 class="text-lg leading-6 font-normal">
                            @Title
                        </h3>
                        <button type="button"
                                class="text-slate-200 transition-colors hover:text-white"
                                @onclick="OnClose">
                            <Icon Style="Icon.IconStyle.Close" />
                        </button>
                    </header>

                    <main class="@bodyHeightCss overflow-y-auto px-4 py-4 @BodyCssClass" style="@bodyStyle">
                        @Body
                    </main>

                    @if (Footer != null)
                    {
                        <footer class="flex flex-row-reverse gap-3 border-t border-slate-200 bg-slate-100 px-4 py-3 @FooterCssClass">
                            @Footer
                        </footer>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    public enum ModalSize { Small, Medium, Large, XLarge, Full }

    [Parameter] public ColorStyle Style { get; set; } = ColorStyle.Primary;
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public ModalSize Size { get; set; } = ModalSize.Medium;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string BodyCssClass { get; set; } = "";
    [Parameter] public string FooterCssClass { get; set; } = "";
    [Parameter] public int OverlayZIndex { get; set; } = 2147483000;
    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    private string colorCss => Style.ToTailwindCss();
    private string maxWidthCss => Size switch
    {
        ModalSize.Small     => "max-w-md",
        ModalSize.Medium    => "max-w-lg",
        ModalSize.Large     => "max-w-2xl",
        ModalSize.XLarge    => "max-w-4xl",
        ModalSize.Full      => "",
        _                   => "max-w-lg"
    };
    private string panelStyle => Size == ModalSize.Full
        ? "width:75vw;max-width:calc(100vw - 2rem);height:75vh;display:flex;flex-direction:column;"
        : "";
    private string bodyStyle => Size == ModalSize.Full ? "min-height:0;flex:1;" : "";
    private string bodyHeightCss => Size == ModalSize.Full ? "" : "max-h-[70vh]";

    private async Task OnClose()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);

        StateHasChanged();
    }
}
