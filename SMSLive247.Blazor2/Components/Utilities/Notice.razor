@if (!_isDismissed)
{
    <div role="@(Variant == NoticeVariant.Error ? "alert" : "status")" class="flex items-start gap-3 rounded-lg px-4 py-3 @containerCss @CssClass">
        <Icon Style="@IconStyle" CssClass="@iconClass" />
        <div class="min-w-0 flex-1">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <h3 class="font-semibold @titleCss">@Title</h3>
            }
            <div class="@MessageClass @messageCss">
                @ChildContent
            </div>
        </div>
        @if (Dismissible)
        {
            <button type="button" class="ml-2 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
                    aria-label="Close notice" title="Close notice" @onclick="Dismiss">
                <Icon Style="Icon.IconStyle.Close" CssClass="text-lg" />
            </button>
        }
    </div>
}

@code {
    public enum NoticeVariant { Info, Warning, Error, Success }

    [Parameter] public NoticeVariant Variant { get; set; } = NoticeVariant.Info;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string MessageClass { get; set; } = "text-base leading-6";
    [Parameter] public bool Dismissible { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _isDismissed;

    private Icon.IconStyle IconStyle => Variant switch
    {
        NoticeVariant.Warning => Icon.IconStyle.Warning,
        NoticeVariant.Error => Icon.IconStyle.AlertCircle,
        NoticeVariant.Success => Icon.IconStyle.CheckCircle,
        _ => Icon.IconStyle.Info
    };

    private string iconClass => $"shrink-0 {iconCss}";

    private string containerCss => Variant switch
    {
        NoticeVariant.Warning => "bg-amber-50 dark:bg-amber-950/30",
        NoticeVariant.Error => "bg-red-50 dark:bg-red-950/30",
        NoticeVariant.Success => "bg-emerald-50 dark:bg-emerald-950/30",
        _ => "bg-blue-50 dark:bg-blue-950/30"
    };

    private string iconCss => Variant switch
    {
        NoticeVariant.Warning => "text-amber-600 dark:text-amber-300",
        NoticeVariant.Error => "text-red-600 dark:text-red-300",
        NoticeVariant.Success => "text-emerald-600 dark:text-emerald-300",
        _ => "text-blue-600 dark:text-blue-300"
    };

    private string titleCss => Variant switch
    {
        NoticeVariant.Warning => "text-amber-900 dark:text-amber-200",
        NoticeVariant.Error => "text-red-900 dark:text-red-200",
        NoticeVariant.Success => "text-emerald-900 dark:text-emerald-200",
        _ => "text-blue-900 dark:text-blue-200"
    };

    private string messageCss => Variant switch
    {
        NoticeVariant.Warning => "text-amber-800 dark:text-amber-300",
        NoticeVariant.Error => "text-red-800 dark:text-red-300",
        NoticeVariant.Success => "text-emerald-800 dark:text-emerald-300",
        _ => "text-blue-800 dark:text-blue-300"
    };

    private void Dismiss() => _isDismissed = true;
}
