@inject AlertService alert

<Modal Title="@title" IsVisible="@isVisible" Style="@color" IsVisibleChanged="Cancel">
    <Body>
        <div class="flex justify-start px-4 py-4">
            <div>
                <Icon Style="@icon" CssClass="@iconColor" FontSize="4rem" FontWeight="500"></Icon>
            </div>
            <div class="my-auto ml-3">
                @message
            </div>
        </div>
    </Body>
    <Footer>
        @if (isConfirmBox)
        {
            <Button OnClick="Okay" Text="OK" Style="@color" />
            <Button OnClick="Cancel" Text="Cancel" Style="ColorStyle.Secondary" />
        }
        else
        {
            <Button OnClick="Cancel" Text="OK" Style="@color" />
        }
    </Footer>
</Modal>

@code
{
    private TaskCompletionSource<bool>? taskSource;
    private string title = "Alert Box";
    private bool isConfirmBox = false;
    private bool isVisible = false;
    private RenderFragment? message;
    private Icon.IconStyle icon = Icon.IconStyle.Info;
    private ColorStyle color = ColorStyle.Primary;

    private string iconColor => color switch
    {
        ColorStyle.Primary  => "text-brand-500",
        ColorStyle.Secondary => "text-slate-100",
        ColorStyle.Success  => "text-green-500",
        ColorStyle.Danger   => "text-red-500",
        ColorStyle.Warning  => "text-yellow-500",
        ColorStyle.Info     => "text-blue-500",
        ColorStyle.Light    => "text-gray-100",
        ColorStyle.Dark     => "text-gray-800",
        _ => ""
    };

    protected override void OnInitialized()
    {
        alert.OnInfo += Info;
        alert.OnError += Error;
        alert.OnSuccess += Success;
        alert.OnConfirm += Confirm;
    }

    public Task Info(string message, string title)
    {
        return Open(ColorStyle.Info, Icon.IconStyle.Info, message, title);
    }

    public Task Error(string message, string title)
    {
        return Open(ColorStyle.Danger, Icon.IconStyle.Close, message, title);
    }

    public Task Success(string message, string title)
    {
        return Open(ColorStyle.Success, Icon.IconStyle.CheckCircle, message, title);
    }

    public async Task<bool> Confirm(string message, string title)
    {
        await Open(ColorStyle.Warning, Icon.IconStyle.HelpCircle, message, title, true);
        return await taskSource.Task;
    }

    [MemberNotNull(nameof(taskSource))]
    private Task Open(ColorStyle color, Icon.IconStyle icon, string message, string title, bool confirm = false)
    {
        taskSource = new();

        return InvokeAsync(async () =>
        {
            isConfirmBox = confirm;
            isVisible = true;

            this.icon = icon;
            this.color = color;
            this.title = title;
            this.message = new RenderFragment(x => x.AddMarkupContent(0, message));
            StateHasChanged();
        });
    }

    private void Cancel()
    {
        isVisible = false;
        taskSource?.SetResult(false);
        StateHasChanged();
    }

    private void Okay()
    {
        isVisible = false;
        taskSource?.SetResult(true);
        StateHasChanged();
    }

    public void Dispose()
    {
        alert.OnInfo -= Info;
        alert.OnError -= Error;
        alert.OnSuccess -= Success;
        alert.OnConfirm -= Confirm;
    }
}