 *@


<!-- Modal root -->
<div id="modalRoot" class="fixed inset-0 z-50" hidden="@isHidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50"></div>

    <!-- Modal dialog -->
    <div class="relative z-10 flex min-h-full items-center justify-center p-4">
        <div class="w-full max-w-lg rounded-lg bg-white shadow-xl outline outline-1 outline-black/10">

            <!-- Header -->
            <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
                <h5 class="text-lg font-semibold text-gray-900">@title</h5>
                <button @onclick="Cancel"
                        aria-label="Close"
                        class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>

            <!-- Body -->
            <div class="px-4 py-4 text-sm text-gray-600">
                <div>
                    <i class="text-4xl @icon text-@color"></i>
                </div>
                <div class="ml-3 my-auto">
                    @message
                </div>
            </div>

            <!-- Footer -->
            <div class="flex justify-end gap-2 border-t border-gray-200 px-4 py-3">
                @if (isConfirmBox)
                {
                    <button class="rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors"
                            @onclick="Okay">
                        OK
                    </button>
                    <button class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
                            @onclick="Cancel">
                        Cancel
                    </button>
                }
                else
                {
                    <button class="rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors"
                            @onclick="Cancel">
                        OK
                    </button>
                }
            </div>
        </div>
    </div>
</div>



@code
{
    private TaskCompletionSource<bool>? taskSource;
    private string title = "Alert Box";
    private bool isConfirmBox = false;
    private bool isHidden = true;
    private RenderFragment? message;
    private string? color;
    private string? icon;

    protected override void OnInitialized()
    {
        alert.OnInfo += Info;
        alert.OnError += Error;
        alert.OnSuccess += Success;
        alert.OnConfirm += Confirm;
    }

    public Task Info(string message, string title)
    {
        return Open("bg-yellow-300", "bi bi-info-circle-fill", message, title);
    }

    public Task Error(string message, string title)
    {
        return Open("bg-red-300", "bi bi-sign-stop-fill", message, title);
    }

    public Task Success(string message, string title)
    {
        return Open("bg-green-300", "bi bi-check-circle-fill", message, title);
    }

    public Task<bool> Confirm(string message, string title)
    {
        //return Open("warning", "bi bi-question-circle-fill", message, title, true);
        return Task.FromResult(true);
    }

    [MemberNotNull(nameof(taskSource))]
    private Task Open(string color, string icon, string message, string title, bool confirm = false)
    {
        taskSource = new();

        return InvokeAsync(async () =>
        {
            isConfirmBox = confirm;
            isHidden = false;

            this.icon = icon;
            this.color = color;
            this.title = title;
            this.message = new RenderFragment(x => x.AddMarkupContent(0, message));
            StateHasChanged();
        });
    }

    private void Cancel()
    {
        isHidden = true;
        taskSource?.SetResult(false);
        StateHasChanged();
    }

    private void Okay()
    {
        isHidden = true;
        taskSource?.SetResult(true);
        StateHasChanged();
    }

    public void Dispose()
    {
        alert.OnInfo -= Info;
        alert.OnError -= Error;
        alert.OnSuccess -= Success;
        alert.OnConfirm -= Confirm;
    }
}