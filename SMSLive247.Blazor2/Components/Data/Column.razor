@typeparam TItem

@if (Item == null)
{
    <th class="px-4 py-3 text-s font-bold text-brand-900 uppercase tracking-wider text-left" 
        style="width: @Width; text-align: @Align">@Header</th>
}
else 
{
    <td class="px-4 py-4" style="text-align: @Align">@ChildContent</td>
}

@code {
    [CascadingParameter] public TItem? Item { get; set; }
    [Parameter] public string? Header { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Align { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
