<FormRow Cols="2">
    <div>
        <label class="text-sm font-medium text-slate-700">Sender Current Balance</label>

        <div class="block w-full appearance-none rounded-lg border border-slate-200 py-2.5 px-3 text-slate-900 bg-slate-100 dark:text-slate-400 dark:bg-slate-900 transition-all">
            @OldBalance.ToString("#,##0.##")
        </div>
    </div>

    <div>
        <label class="text-sm font-medium text-slate-700">Sender New Balance</label>
        <div class="block w-full appearance-none rounded-lg border border-slate-200 py-2.5 px-3 text-slate-900 bg-slate-100 dark:text-slate-400 dark:bg-slate-900 transition-all @(NewBalance < 0 ? "text-red-600" : "text-slate-700")">
            @NewBalance.ToString("#,##0.##")
        </div>
    </div>

</FormRow>


@code {
    [Parameter] public double OldBalance { get; set; }

    [Parameter] public double NewBalance { get; set; }
}
