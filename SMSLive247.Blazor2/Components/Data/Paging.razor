<div class="flex w-full items-center gap-4 px-0 py-0 sm:px-0 sm:py-0">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <div class="flex items-center gap-2 text-slate-500">
            Showing
            <span class="font-medium">@startRecord</span>
            to
            <span class="font-medium">@endRecord</span>

            @if (TotalRecords.HasValue)
            {
                <text>of</text>
                <span class="font-medium">@TotalRecords.Value.ToString("N0")</span>
            }
            results
        </div>

        <div class="hidden h-4 w-px bg-slate-300 sm:block"></div>

        <label class="flex items-center gap-2 text-slate-500">
            <span>Rows per page:</span>
            <select class="h-8 rounded-lg border border-slate-200 bg-white px-2 py-1 text-slate-700 transition-colors hover:border-brand-500 focus:border-brand-500 focus:ring-brand-500/20 focus:ring-2 focus:outline-none"
                    @onchange="HandlePageSizeChange">
                @foreach (var option in PageSizeOptions)
                {
                    <option value="@option.ToString()" selected="@(option == PageSize)">@option</option>
                }
            </select>
        </label>
    </div>

    <div class="ml-auto flex items-center gap-3">
        <div class="flex items-center gap-2">
            <button type="button"
                    class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-slate-300 text-slate-400 transition-colors hover:border-slate-500 hover:text-slate-700 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:border-slate-200 disabled:hover:text-slate-400"
                    title="Previous page"
                    aria-label="Previous page"
                    disabled="@(PageNumber <= 1)"
                    @onclick="() => HandlePageChange(PageNumber - 1)">
                <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6" />
                </svg>
            </button>

            <button type="button"
                    class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-slate-300 text-slate-400 transition-colors hover:border-slate-500 hover:text-slate-700 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:border-slate-200 disabled:hover:text-slate-400"
                    title="Next page"
                    aria-label="Next page"
                    disabled="@(PageNumber >= TotalRecords)"
                    @onclick="() => HandlePageChange(PageNumber + 1)">
                <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public PagingState? Pagination { get; set; }
    [Parameter] public IReadOnlyList<int> PageSizeOptions { get; set; } = [25, 50, 100, 200, 400];
    [Parameter] public EventCallback<int> OnPageChange { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChange { get; set; }

    [Parameter] public int PageSize { get; set; }
    [Parameter] public int PageNumber { get; set; }
    [Parameter] public int? TotalRecords { get; set; }
    [Parameter] public EventCallback<int> PageNumberChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private int startRecord, endRecord;

    protected override void OnParametersSet()
    {
        startRecord = ((PageNumber - 1) * PageSize) + 1;
        endRecord = PageNumber * PageSize;

        if (TotalRecords.HasValue && TotalRecords < endRecord)
            endRecord = TotalRecords.Value;
    }

    private async Task HandlePageChange(int pageNumber)
    {
        if (pageNumber < 1) return;
        await PageNumberChanged.InvokeAsync(pageNumber);
    }

    private async Task HandlePageSizeChange(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var pageSize))
            await PageSizeChanged.InvokeAsync(pageSize);
    }
}
