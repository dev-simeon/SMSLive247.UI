@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var returnUrl = new Uri(Navigation.Uri).PathAndQuery;
        var destination = string.IsNullOrWhiteSpace(returnUrl) || returnUrl == Const.Routes.Login
            ? Const.Routes.Login
            : $"{Const.Routes.Login}?ReturnUrl={Uri.EscapeDataString(returnUrl)}";

        Navigation.NavigateTo(destination, replace: true);
    }
}
