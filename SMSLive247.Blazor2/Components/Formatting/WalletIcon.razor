@if (Wallet == "SMS")
{
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="9" cy="7" rx="6" ry="3" />
        <path d="M3 7v4c0 1.66 2.69 3 6 3s6-1.34 6-3V7" />
        <path d="M3 11v4c0 1.66 2.69 3 6 3s6-1.34 6-3v-4" />
        <path d="M15 9.5c3.5.2 6 1.5 6 3.1v4c0 1.66-2.69 3-6 3-1.15 0-2.22-.16-3.12-.44" />
    </svg>
}
else
{
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <!-- Banknote outline -->
        <rect x="2" y="5" width="20" height="14" rx="2" />

        <!-- Naira symbol -->
        <path d="M9 8v8" />
        <path d="M9 8l6 8" />
        <path d="M15 8v8" />
        <path d="M8 11h8" />
        <path d="M8 13h8" />

        <!-- Decorative corners -->
        <path d="M5 8h.01" />
        <path d="M19 16h.01" />
    </svg>

}

@code {
    [Parameter, EditorRequired] public required string Wallet { get; set; }

}
