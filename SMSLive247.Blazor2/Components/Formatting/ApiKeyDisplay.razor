@namespace SMSLive247.Blazor2.Components.Formatting

<div class="inline-flex items-center font-mono text-xs @CssClass" style="column-gap: 0.35rem;">
    <span class="text-slate-700 tracking-wider select-all" style="margin-right: 0.35rem;" title="@(isVisible ? keyString : "Hidden")">
        @(isVisible ? keyString : MaskedPlaceholder)
    </span>

    @if (HasValidKey)
    {
        <!-- Toggle Visibility Button -->
        <button type="button"
                @onclick="ToggleVisibility"
                class="p-1 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded transition-colors cursor-pointer"
                title="@(isVisible ? "Hide API Key" : "Show API Key")">
            <Icon Style="@(isVisible ? Icon.IconStyle.EyeOff : Icon.IconStyle.Eye)" CssClass="h-3.5 w-3.5" />
        </button>

        <!-- Copy to Clipboard Button -->
        <button type="button"
                @onclick="CopyToClipboard"
                class="p-1 text-slate-400 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors cursor-pointer"
                title="Copy API Key">
            <Icon Style="Icon.IconStyle.Copy" CssClass="h-3.5 w-3.5" />
        </button>

        <!-- Reset Button -->
        @if (ShowReset && (Account != null || !string.IsNullOrWhiteSpace(AccountId)))
        {
            <button type="button"
                    @onclick="ResetApiKeyAsync"
                    disabled="@isResetting"
                    class="p-1 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors cursor-pointer disabled:opacity-50"
                    title="Reset API Key">
                @if (isResetting)
                {
                    <div class="h-3.5 w-3.5 animate-spin rounded-full border border-brand-500 border-t-transparent"></div>
                }
                else
                {
                    <Icon Style="Icon.IconStyle.Refresh" CssClass="h-3.5 w-3.5" />
                }
            </button>
        }
    }
</div>

@code {
    [Parameter] public byte[]? Key { get; set; }
    [Parameter] public string? KeyString { get; set; }
    [Parameter] public AccountResponse? Account { get; set; }
    [Parameter] public string? AccountId { get; set; }
    [Parameter] public string? AccountName { get; set; }
    [Parameter] public bool ShowReset { get; set; } = true;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public EventCallback OnReset { get; set; }

    private bool isVisible = false;
    private bool isResetting = false;

    private const string MaskedPlaceholder = "••••••••-••••-••••-••••-••••••••••••";

    private string keyString
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(KeyString))
                return KeyString;

            var bytes = Key ?? Account?.Key;
            if (bytes == null || bytes.Length == 0)
                return "—";

            try
            {
                if (bytes.Length == 16)
                    return new Guid(bytes).ToString().ToUpperInvariant();
            }
            catch { }

            return BitConverter.ToString(bytes);
        }
    }

    private bool HasValidKey => keyString != "—" && !string.IsNullOrWhiteSpace(keyString);

    private void ToggleVisibility()
    {
        isVisible = !isVisible;
    }

    private async Task CopyToClipboard()
    {
        if (!HasValidKey) return;
        try
        {
            await js.InvokeVoidAsync("navigator.clipboard.writeText", keyString);
            await alert.Success("API Key copied to clipboard.", "Copied");
        }
        catch { }
    }

    private async Task ResetApiKeyAsync()
    {
        string? targetId = AccountId ?? Account?.AccountID;
        string targetName = AccountName ?? Account?.AccountName ?? "this account";

        if (string.IsNullOrWhiteSpace(targetId) || isResetting)
            return;

        try
        {
            bool confirmed = await alert.Confirm(
                $"This will immediately invalidate the current API key for [{targetName}]. " +
                "Any applications using it will stop authenticating. Continue?",
                "Reset API Key");

            if (!confirmed)
                return;

            isResetting = true;
            StateHasChanged();

            await apiClient.AccountUpdateProviderKeyAsync(targetId, new AccountProviderKeyRequest());
            await alert.Success("API key reset successfully. Please update your integrations.", "Key Regenerated");

            if (OnReset.HasDelegate)
            {
                await OnReset.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Reset Failed");
        }
        finally
        {
            isResetting = false;
            StateHasChanged();
        }
    }
}
