@namespace SMSLive247.Blazor.Components.Formatting

<div class="inline-flex items-center rounded-md bg-slate-100 font-mono leading-none" title="API Key">
    <span class="px-2 text-sm tracking-wider text-slate-500 select-all">
        @(isVisible ? keyString : placeholder)
    </span>

    <!-- Toggle Visibility Button -->
    <button type="button"
            @onclick="ToggleVisibility"
            class="cursor-pointer rounded p-1 leading-none text-slate-400 transition-colors hover:bg-brand-50 hover:text-brand-600"
            title="@(isVisible ? "Hide API Key" : "Show API Key")">
        <Icon Style="@(isVisible ? Icon.IconStyle.EyeOff : Icon.IconStyle.Eye)" FontSize="1.2rem" />
    </button>

    <!-- Copy to Clipboard Button -->
    <button type="button"
            @onclick="CopyToClipboard"
            class="cursor-pointer rounded p-1 leading-none text-slate-400 transition-colors hover:bg-brand-50 hover:text-brand-600"
            title="Copy API Key">
        <Icon Style="Icon.IconStyle.Copy" FontSize="1.2rem" />
    </button>

    <!-- Reset Button -->
    @if (OnReset.HasDelegate)
    {
        <button type="button"
                @onclick="ResetApiKeyAsync"
                disabled="@isBusy"
                class="cursor-pointer rounded p-1 leading-none text-slate-400 transition-colors hover:bg-red-50 hover:text-red-600 disabled:opacity-50"
                title="Reset API Key">
            @if (isBusy)
            {
                <div class="h-3.5 w-3.5 animate-spin rounded-full border border-brand-500 border-t-transparent"></div>
            }
            else
            {
                <Icon Style="Icon.IconStyle.Refresh" FontSize="1.2rem" />
            }
        </button>
    }
</div>

@code {
    [Parameter] public AccountResponse? Account { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private bool isBusy = false;
    private bool isVisible = false;
    private const string placeholder = "••••••••••••••••••••••••••••••••••••";

    private string keyString
    {
        get
        {
            var bytes = Account?.Key;
            if (bytes == null || bytes.Length == 0)
                return "—";

            try
            {
                if (bytes.Length == 16)
                    return new Guid(bytes).ToString().ToUpperInvariant();
            }
            catch { }

            return BitConverter.ToString(bytes);
        }
    }

    private void ToggleVisibility()
    {
        isVisible = !isVisible;
    }

    private async Task CopyToClipboard()
    {
        try
        {
            await js.InvokeVoidAsync("navigator.clipboard.writeText", keyString);
            await alert.Success("API Key copied to clipboard.", "Copied");
        }
        catch { }
    }

    private async Task ResetApiKeyAsync()
    {
        if (Account is null || isBusy)
            return;

        string accountId = Account.AccountID;
        string accountName = Account.AccountName ?? "this account";

        try
        {
            bool confirmed = await alert.Confirm(
                $"This will immediately invalidate the current API key for [{accountName}]. " +
                "Any applications using it will stop authenticating. Continue?",
                "Reset API Key");

            if (!confirmed)
                return;

            isBusy = true;
            StateHasChanged();

            await apiClient.AccountUpdateProviderKeyAsync(accountId, new AccountProviderKeyRequest());
            await alert.Success("API key reset successfully. Please update your integrations.", "Key Regenerated");

            if (OnReset.HasDelegate)
            {
                await OnReset.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Reset Failed");
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }
}
