<div class="flex justify-between gap-1">
    <span class="text-brand-400"
          title="@Title">
        @* <Icon Style="Icon.IconStyle.Coins" CssStyle="font-weight: 300;" /> *@

        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" 
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="9" cy="7" rx="6" ry="3" />
            <path d="M3 7v4c0 1.66 2.69 3 6 3s6-1.34 6-3V7" />
            <path d="M3 11v4c0 1.66 2.69 3 6 3s6-1.34 6-3v-4" />
            <path d="M15 9.5c3.5.2 6 1.5 6 3.1v4c0 1.66-2.69 3-6 3-1.15 0-2.22-.16-3.12-.44" />
        </svg>
    </span>
    <span class="font-bold text-slate-800">
        @Credits.ToString("#,##0.00")
    </span>
</div>

@code {
    [Parameter, EditorRequired] public required double Credits { get; set; }
    [Parameter, EditorRequired] public required string? Title { get; set; }  
}
