@inject NavigationManager NavigationManager

@if (IsOpen)
{
    <!-- Mobile Backdrop -->
    <div class="fixed inset-0 bg-slate-800/50 z-20 lg:hidden" @onclick="CloseSidebar"></div>
}

<aside
    class="fixed lg:static inset-y-0 left-0 z-30 w-64 bg-white border-r border-slate-200 flex flex-col h-screen transition-transform duration-300 lg:translate-x-0 @(IsOpen ? "translate-x-0" : "-translate-x-full")">

    <div class="h-16 flex items-center justify-between px-6 border-b border-slate-100">
        <div class="flex items-center">
            <img src="/smslive-logo-2.png" alt="SMSLive247" class="h-10 w-auto" />
        </div>
        <button class="lg:hidden text-slate-400" @onclick="CloseSidebar">
            <Icon Style="Icon.IconStyle.Close" CssClass="w-6 h-6" />
        </button>
    </div>

    <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-1">
        @foreach (var category in Categories)
        {
            if (!string.IsNullOrEmpty(category.Title))
            {
                <div class="pt-6 pb-2 px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                    @category.Title
                </div>
            }
            else
            {
                <!-- Add margin bottom if it's the main items without title (like Dashboard) -->
                <div class="mb-4"></div>
            }

            foreach (var item in category.Items)
            {
                <NavLink href="@item.Url" Match="NavLinkMatch.Prefix" ActiveClass="active"
                         class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors font-medium text-sm group cursor-pointer text-slate-600 hover:bg-slate-50 hover:text-brand-600 [&.active]:bg-brand-50 [&.active]:text-brand-600 [&.active]:hover:bg-brand-50 [&.active]:hover:text-brand-600 mb-1">
                    <Icon Style="@item.Icon" />
                    @item.Title
                </NavLink>
            }
        }
    </nav>

    @if (isUserDropdownOpen)
    {
        <!-- Transparent overlay to handle clicking outside -->
        <div class="fixed inset-0 z-30" @onclick="() => isUserDropdownOpen = false"></div>
    }

    <!-- User Profile Dropdown -->
    <div class="p-4 border-t border-slate-100 relative">
        <button @onclick="() => isUserDropdownOpen = !isUserDropdownOpen"
                class="flex items-center gap-3 w-full p-2 rounded-xl transition-all cursor-pointer @(isUserDropdownOpen ? "bg-slate-100 ring-1 ring-slate-200" : "hover:bg-slate-50")">
            <div
                class="w-9 h-9 rounded-full bg-brand-500 flex items-center justify-center text-white font-bold border-2 border-white shadow-sm shrink-0">
                U
            </div>
            <div class="flex-1 min-w-0 text-left">
                <p class="text-sm font-bold text-slate-900 truncate">
                    User Account
                </p>
                <div class="flex items-center gap-1 text-slate-500">
                    <p class="text-[11px] truncate">user@example.com</p>
                    <Icon Style="Icon.IconStyle.ChevronDown" CssClass="@($"w-3 h-3 transition-transform duration-200 {(isUserDropdownOpen ? "rotate-180" : "")}")" />
                </div>
            </div>
        </button>

        @if (isUserDropdownOpen)
        {
            <div
                class="absolute bottom-[calc(100%+8px)] left-4 right-4 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden z-40 animate-in fade-in slide-in-from-bottom-2 duration-200">
                <div class="p-3 border-b border-slate-50 bg-slate-50/50">
                    <p class="text-[10px] uppercase font-bold text-slate-400 tracking-wider mb-1">
                        Signed in as
                    </p>
                    <p class="text-xs font-semibold text-slate-900 truncate">
                        user@example.com
                    </p>
                </div>
                <div class="p-1">
                    <button @onclick="NavigateToProfile"
                            class="flex items-center gap-2.5 w-full px-3 py-2 text-slate-600 hover:text-brand-600 hover:bg-brand-50 rounded-lg transition-colors text-sm font-medium cursor-pointer">
                        <Icon Style="Icon.IconStyle.User" CssClass="w-4 h-4" />
                        <span>My Profile</span>
                    </button>
                    <div class="h-px bg-slate-50 my-1 mx-2" />
                    <button @onclick="SignOut"
                            class="flex items-center gap-2.5 w-full px-3 py-2 text-slate-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors text-sm font-medium cursor-pointer">
                        <Icon Style="Icon.IconStyle.LogOut" CssClass="w-4 h-4" />
                        <span>Sign Out</span>
                    </button>
                </div>
            </div>
        }
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool isUserDropdownOpen = false;

    private async Task CloseSidebar()
    {
        IsOpen = false;
        if (IsOpenChanged.HasDelegate)
        {
            await IsOpenChanged.InvokeAsync(IsOpen);
        }
    }

    private void NavigateToProfile()
    {
        isUserDropdownOpen = false;
        NavigationManager.NavigateTo("/account/profile");
    }

    private void SignOut()
    {
        isUserDropdownOpen = false;
        NavigationManager.NavigateTo("/");
    }
}
