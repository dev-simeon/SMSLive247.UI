@* <span class="inline-flex items-center gap-1.5 rounded-full border-2 px-2 py-0.5 font-bold text-[100] @GetBadgeCss()">
    @if (ShowDot)
    {
        <span class="h-1.5 w-1.5 rounded-full @colorCss"></span>
    }
    @Value
</span>
 *@
<span class="rounded-md px-2 py-1 text-xs font-bold whitespace-nowrap @calc.Color">
    @calc.Text
</span>

@code {
    public enum StatusVariant { ActiveInactive, SenderIdRequest, BatchMessage, DeliveryReport, PurchaseStatus, None }

    [Parameter] public StatusVariant Variant { get; set; } = StatusVariant.None;
    [Parameter] public ColorStyle Style { get; set; } = ColorStyle.Primary;
    [Parameter] public string Value { get; set; } = string.Empty;

    private (string Color, string Text) calc
    {
        get
        {
            var (colorCss, textValue) = GetColorStyleFromVariant();
            return (colorCss.ToTailwindCss(), textValue);
        }
    }

    private (ColorStyle, string) GetColorStyleFromVariant()
    {
        return Variant switch
        {
            StatusVariant.ActiveInactive    => MapActiveInactiveStatus(Value),
            StatusVariant.BatchMessage      => MapBatchMessageStatus(Value),
            StatusVariant.SenderIdRequest   => MapSenderIdRequestStatus(Value),
            StatusVariant.DeliveryReport    => MapDeliveryReportStatus(Value),
            StatusVariant.PurchaseStatus    => MapPurchaseStatus(Value),
            _                               => (Style, Value),
        };
    }

    private static (ColorStyle, string) MapPurchaseStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "PAID"      => (ColorStyle.Success,   "SUCCESS"),
            "PENDING"   => (ColorStyle.Warning,   "PENDING"),
            "FAILED"    => (ColorStyle.Danger,    "FAILED"),
            "CANCELLED" => (ColorStyle.Danger,    "CANCELLED"),
            _           => (ColorStyle.Secondary, "UNKNOWN")
        };
    }

    private static (ColorStyle, string) MapActiveInactiveStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "ACTIVE"    => (ColorStyle.Success,   "ACTIVE"),
            "ENABLED"   => (ColorStyle.Success,   "ENABLED"),
            "INACTIVE"  => (ColorStyle.Danger,    "INACTIVE"),
            "DISABLED"  => (ColorStyle.Danger,    "DISABLED"),
            _           => (ColorStyle.Secondary, "UNKNOWN")
        };
    }

    private static (ColorStyle, string) MapBatchMessageStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "COMPLETED"     => (ColorStyle.Success,   "COMPLETED"),
            "RUNNING"       => (ColorStyle.Warning,   "RUNNING"),
            "PAUSED"        => (ColorStyle.Info,      "PAUSED"),
            "ABORTED"       => (ColorStyle.Danger,    "ABORTED"),
            _               => (ColorStyle.Secondary, "UNKNOWN")
        };
    }

    private static (ColorStyle, string) MapSenderIdRequestStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "APPROVED"  => (ColorStyle.Success,   "APPROVED"),
            "PENDING"   => (ColorStyle.Warning,   "PENDING"),
            "DELETED"   => (ColorStyle.Info,      "DELETED"),
            "REJECTED"  => (ColorStyle.Danger,    "REJECTED"),
            _           => (ColorStyle.Secondary, "UNKNOWN")
        };
    }

    private static (ColorStyle, string) MapDeliveryReportStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "DELIVRD" => (ColorStyle.Success,   "DELIVRD"),
            "ACCEPTD" => (ColorStyle.Info,      "ACCEPTD"),
            "ENROUTE" => (ColorStyle.Info,      "ENROUTE"),
            "UNKNOWN" => (ColorStyle.Info,      "UNKNOWN"),
            "EXPIRED" => (ColorStyle.Warning,   "EXPIRED"),
            "UNDELIV" => (ColorStyle.Danger,    "UNDELIV"),
            "REJECTD" => (ColorStyle.Danger,    "REJECTD"),
            _         => (ColorStyle.Secondary, "UNKNOWN")
        };
    }
}