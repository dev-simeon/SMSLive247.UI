@* <span class="inline-flex items-center gap-1.5 rounded-full border-2 px-2 py-0.5 font-bold text-[100] @GetBadgeCss()">
    @if (ShowDot)
    {
        <span class="h-1.5 w-1.5 rounded-full @colorCss"></span>
    }
    @Value
</span>
 *@
<span class="rounded-md px-2 py-1 text-xs font-bold whitespace-nowrap @colorCss">
    @Value
</span>

@code {
    public enum StatusVariant { ActiveInactive, SenderIdRequest, BatchMessage, DeliveryReport, None }

    [Parameter] public StatusVariant Variant { get; set; } = StatusVariant.None;
    [Parameter] public ColorStyle Style { get; set; } = ColorStyle.Primary;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public bool ShowDot { get; set; } = true;

    private string colorCss => GetColorStyleFromVariant().ToTailwindCss();

    private ColorStyle GetColorStyleFromVariant()
    {
        return Variant switch
        {
            StatusVariant.ActiveInactive    => MapActiveInactiveStatus(Value),
            StatusVariant.BatchMessage      => MapBatchMessageStatus(Value),
            StatusVariant.SenderIdRequest   => MapSenderIdRequestStatus(Value),
            StatusVariant.DeliveryReport    => MapDeliveryReportStatus(Value),
            _                               => Style,
        };
    }

    private static ColorStyle MapActiveInactiveStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "ACTIVE"    => ColorStyle.Success,
            "ENABLED"   => ColorStyle.Success,
            "INACTIVE"  => ColorStyle.Danger,
            "DISABLED"  => ColorStyle.Danger,
            _           => ColorStyle.Secondary
        };
    }

    private static ColorStyle MapBatchMessageStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "COMPLETED"     => ColorStyle.Success,
            "RUNNING"       => ColorStyle.Warning,
            "PAUSED"        => ColorStyle.Info,
            "ABORTED"       => ColorStyle.Danger,
            _               => ColorStyle.Secondary
        };
    }

    private static ColorStyle MapSenderIdRequestStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "APPROVED"  => ColorStyle.Success,
            "PENDING"   => ColorStyle.Warning,
            "DELETED"   => ColorStyle.Info,
            "REJECTED"  => ColorStyle.Danger,
            _           => ColorStyle.Secondary
        };
    }

    private static ColorStyle MapDeliveryReportStatus(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "DELIVRD" => ColorStyle.Success,
            "ACCEPTD" => ColorStyle.Info,
            "ENROUTE" => ColorStyle.Info,
            "UNKNOWN" => ColorStyle.Info,
            "EXPIRED" => ColorStyle.Warning,
            "UNDELIV" => ColorStyle.Danger,
            "REJECTD" => ColorStyle.Danger,
            _         => ColorStyle.Secondary
        };
    }
}