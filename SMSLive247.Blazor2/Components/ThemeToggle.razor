@inject IJSRuntime JS
@implements IAsyncDisposable

@if(_currentTheme == "dark")
{
    <button type="button" title="Switch to light mode" aria-label="Switch to light mode"
            class="rounded-md p-2 text-slate-500 transition-colors hover:bg-slate-100 hover:text-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500 dark:hover:bg-slate-800"
            @onclick='() => SetTheme("light")'>
        <Icon CssClass="text-xl" Style="Icon.IconStyle.LightMode" />
    </button>
}
@if (_currentTheme == "light")
{
    <button type="button" title="Switch to dark mode" aria-label="Switch to dark mode"
            class="rounded-md p-2 text-slate-500 transition-colors hover:bg-slate-100 hover:text-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500 dark:hover:bg-slate-800"
            @onclick='() => SetTheme("dark")'>
        <Icon CssClass="text-xl" Style="Icon.IconStyle.DarkMode" />
    </button>
}

@* <select @onchange="OnThemeChanged" value="@_currentTheme" class="p-2 text-slate-400">
    <option value="system">System</option>
    <option value="light" >Light </option>
    <option value="dark"  >Dark  </option>
</select> *@

@code {
    private IJSObjectReference? _module;
    private string _currentTheme = "system";
    private DotNetObjectReference<ThemeToggle>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme.js");
            _currentTheme = await _module.InvokeAsync<string>("getTheme");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("watchSystemTheme", _dotNetRef);
            StateHasChanged();
        }
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        _currentTheme = e.Value?.ToString() ?? "system";
        if (_module != null)
            await _module.InvokeVoidAsync("setTheme", _currentTheme);
    }

    [JSInvokable]
    public void OnSystemThemeChanged(bool isDark)
    {
        StateHasChanged(); // re-render if you show a live indicator
    }

    public async Task SetTheme(string theme)
    {
        _currentTheme = theme;
        if (_module != null)
            await _module.InvokeVoidAsync("setTheme", _currentTheme);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _dotNetRef?.Dispose();
            if (_module != null) await _module.DisposeAsync();
        }
        catch
        {
        }
    }
}
