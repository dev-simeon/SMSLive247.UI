@inherits LayoutComponentBase

<div class="flex min-h-screen w-full font-sans">
    @* Left Side - Branding *@
    <div class="bg-brand-500 relative hidden w-1/2 flex-col justify-between overflow-hidden p-12 text-white lg:flex">
        <div class="absolute inset-0 opacity-10">
            <svg class="h-full w-full"
                 preserveAspectRatio="none"
                 viewBox="0 0 100 100">
                <path d="M0 100 C 20 0 50 0 100 100 Z" fill="white"></path>
                <path d="M0 0 C 50 100 80 100 100 0 Z"
                      fill="white"
                      opacity="0.5"></path>
            </svg>
        </div>

        <div class="relative z-10 flex items-center">
            <img src="smslive-logo-2.png"
                 alt="SMSLive247"
                 class="h-12 w-auto rounded-lg" />
        </div>

        <SectionOutlet SectionName="page-branding" />

        <div class="relative z-10 flex items-center justify-between text-sm text-slate-100">
            <p>© @DateTime.Now.Year SMSLive247 by iDevWorks Technologies Ltd.</p>
            <div class="flex gap-4">
                <a href="@Const.Routes.Legal.Privacy" target="_blank"
                       class="transition-colors hover:text-white">
                    Privacy
                </a>
                <a href="@Const.Routes.Legal.Terms" target="_blank"
                       class="transition-colors hover:text-white">
                    Terms
                </a>
            </div>
        </div>
    </div>

    @* Right Side *@
    <div class="relative flex w-full items-center justify-center overflow-y-auto bg-white p-8 lg:w-1/2 lg:p-16">
        <Alert />
        <div class="my-8 w-full max-w-md space-y-8">
            @Body

            <p class="prose-slate mt-6 text-center text-xs text-slate-100">
                By submitting the form, you agree to our
                <a href="@Const.Routes.Legal.Terms" target="_blank"
                       class="underline hover:text-slate-600 dark:hover:text-slate-300">Terms of Service</a>
                and
                <a href="@Const.Routes.Legal.Privacy" target="_blank"
                       class="underline hover:text-slate-600 dark:hover:text-slate-300">Privacy Policy</a>
                .
            </p>
        </div>
    </div>
</div>
