@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@implements IDisposable
@inject ProtectedLocalStorage BrowserStorage
@inject ProtectedSessionStorage SessionStorage
@inject MaintenanceNoticeClient NoticeClient

@if (notice is not null && !isDismissed)
{
    <div class="w-full shrink-0 bg-blue-600 text-white shadow-lg dark:bg-slate-800 dark:text-slate-100" role="status" aria-live="polite">
        <div class="flex w-full items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
            <div class="min-w-0 flex-1">
                <h3 class="mb-1 font-semibold">@notice.Title</h3>
                <p class="text-white/95 dark:text-slate-200">@notice.Message</p>
            </div>
            <button type="button" @onclick="DismissAsync"
                    class="inline-flex shrink-0 text-white transition-colors duration-200 hover:text-blue-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-blue-600 dark:text-slate-200 dark:hover:text-white dark:focus-visible:ring-offset-slate-800"
                    aria-label="Dismiss notification" title="Dismiss notification">
                <Icon Style="Icon.IconStyle.Close" CssClass="text-xl" />
            </button>
        </div>
    </div>
}

@code {
    private const string StorageKey = "maintenance-notice:v1";
    private MaintenanceNotice? notice;
    private bool isDismissed;
    private CancellationTokenSource? expiryTokenSource;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await RestoreCachedNoticeAsync();
        await RefreshNoticeAsync();
    }

    private async Task RestoreCachedNoticeAsync()
    {
        try
        {
            var cached = await BrowserStorage.GetAsync<MaintenanceNotice>(StorageKey);
            if (cached.Success && IsNotExpired(cached.Value))
            {
                notice = cached.Value!;
                isDismissed = await IsDismissedAsync(cached.Value!);
                ScheduleExpiry(cached.Value!);
            }
            else
            {
                await BrowserStorage.DeleteAsync(StorageKey);
            }
        }
        catch
        {
            notice = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshNoticeAsync()
    {
        try
        {
            var latest = await NoticeClient.GetActiveAsync();
            if (latest is null || !IsNotExpired(latest))
            {
                notice = null;
                expiryTokenSource?.Cancel();
                await BrowserStorage.DeleteAsync(StorageKey);
            }
            else
            {
                notice = latest;
                isDismissed = await IsDismissedAsync(latest);
                await BrowserStorage.SetAsync(StorageKey, latest);
                ScheduleExpiry(latest);
            }
        }
        catch
        {
            // Keep a valid cached notice visible when the endpoint is unavailable.
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> IsDismissedAsync(MaintenanceNotice value)
    {
        var dismissed = await SessionStorage.GetAsync<bool>($"maintenance-dismissed:{value.Id}");
        return dismissed.Success && dismissed.Value;
    }

    private async Task DismissAsync()
    {
        if (notice is null)
            return;

        isDismissed = true;
        await SessionStorage.SetAsync($"maintenance-dismissed:{notice.Id}", true);
    }

    private static bool IsNotExpired(MaintenanceNotice? value) =>
        value is not null
        && !string.IsNullOrWhiteSpace(value.Message)
        && DateTimeOffset.UtcNow < value.EndsAtUtc;

    private void ScheduleExpiry(MaintenanceNotice? value)
    {
        expiryTokenSource?.Cancel();
        expiryTokenSource?.Dispose();
        expiryTokenSource = new CancellationTokenSource();
        _ = ClearAtExpiryAsync(value!, expiryTokenSource.Token);
    }

    private async Task ClearAtExpiryAsync(MaintenanceNotice value, CancellationToken cancellationToken)
    {
        try
        {
            var delay = value.EndsAtUtc - DateTimeOffset.UtcNow;
            if (delay > TimeSpan.Zero)
                await Task.Delay(delay, cancellationToken);

            await InvokeAsync(async () =>
            {
                if (notice?.Id != value.Id || IsNotExpired(notice))
                    return;

                notice = null;
                await BrowserStorage.DeleteAsync(StorageKey);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public void Dispose()
    {
        expiryTokenSource?.Cancel();
        expiryTokenSource?.Dispose();
    }
}
