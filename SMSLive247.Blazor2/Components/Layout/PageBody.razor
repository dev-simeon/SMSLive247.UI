<div class="w-full bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
    @* Table Toolbar *@
    <div class="p-4 sm:p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white">
        <div>
            @HeaderLeft
        </div>
        <div>
            @HeaderRight
        </div>
    </div>

    @* Table Content *@
    <div class="unified-table-wrapper w-full overflow-x-auto">
        @ChildContent
    </div>

    @* Footer *@
    <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-between bg-white">
        <div class="flex-1">
            @FooterLeft
        </div>
        <div class="flex-none">
            @FooterRight
        </div>
    </div>
</div>

<style>
    .unified-table-wrapper table thead tr {
        background-color: #eff6ff;
        border-bottom: 2px solid #dbeafe;
    }

    .unified-table-wrapper table thead th {
        color: #1e3a8a;
        font-weight: 700;
        font-size: 0.70rem;
        text-transform: uppercase;
        letter-spacing: 0.075em;
        padding-top: 1.25rem;
        padding-bottom: 1.25rem;
    }

    .unified-table-wrapper table tbody tr:hover {
        background-color: rgba(241, 245, 249, 0.5);
    }

    .unified-table-wrapper table tbody td {
        font-size: 0.875rem;
        color: #334155;
        padding-top: 1rem;
        padding-bottom: 1rem;
        vertical-align: middle;
    }
</style>




