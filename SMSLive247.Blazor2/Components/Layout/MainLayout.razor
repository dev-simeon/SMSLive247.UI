@inherits LayoutComponentBase
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav

@implements IDisposable

<CascadingValue Value="@state" Name="MainAccount">

    <div class="flex h-screen flex-col overflow-hidden bg-gray-100 dark:bg-gray-900">
        <SiteBanner />
        <div class="flex flex-1 overflow-hidden">
            <Sidebar @bind-IsOpen="sidebarOpen"></Sidebar>
            <div class="flex min-w-0 flex-1 flex-col overflow-hidden transition-all duration-300">
                <Header OnMenuClick="() => setSidebarOpen(true)" 
                    Account="@state?.Account"></Header>

                <main class="flex-1 space-y-4 overflow-y-auto scroll-smooth p-4 sm:p-6">
                    <Alert />
                    @Body
                </main>
            </div>
        </div>
    </div>

</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool sidebarOpen = false;
    private AccountState? state;

    protected override async Task OnInitializedAsync()
    {
       try
        {
            var response = await apiClient.AccountGetAsync("self");
            state = new(response.Result);
            state.OnChange += HandleAccountStateChanged;
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"Error fetching account information. {ex.Message}");
            nav.NavigateTo(Const.Routes.Logout);
        }
    }


    private void HandleAccountStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (state is not null)
            state.OnChange -= HandleAccountStateChanged;
    }

    private void setSidebarOpen(bool value)
    {
        sidebarOpen = value;
        StateHasChanged();
    }
}
