@inherits LayoutComponentBase

<div class="flex flex-col h-screen overflow-hidden bg-slate-50">

    <div class="flex flex-1 overflow-hidden">
        <Sidebar @bind-IsOpen="sidebarOpen"></Sidebar>

        <div class="flex-1 flex flex-col min-w-0 overflow-hidden transition-all duration-300">
            <Header OnMenuClick="() => setSidebarOpen(true)"></Header>

            <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 scroll-smooth">
                @Body
            </main>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>



@code {
    private bool sidebarOpen = false;

    private void setSidebarOpen(bool value)
    {
        sidebarOpen = value;
        StateHasChanged();
    }
}