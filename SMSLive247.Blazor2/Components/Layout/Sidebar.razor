@inject NavigationManager nav

@if (IsOpen)
{
    <!-- Mobile Backdrop -->
    <div class="fixed inset-0 z-20 bg-slate-800/50 lg:hidden" @onclick="CloseSidebar"></div>
}

<aside
    class="fixed inset-y-0 left-0 z-30 flex h-screen w-64 flex-col border-r border-slate-200 bg-white transition-transform duration-300 lg:static lg:translate-x-0 @(IsOpen ? "translate-x-0" : "-translate-x-full")">

    <div class="flex h-16 items-center justify-between border-b border-slate-200 px-6">
        <a class="flex items-center" href="/">
            <img src="/smslive-logo-2.png" alt="SMSLive247" class="h-10 w-auto" />
        </a>
        <button class="text-slate-400 lg:hidden" @onclick="CloseSidebar">
            <Icon Style="Icon.IconStyle.Close" />
        </button>
    </div>

    <nav class="flex-1 space-y-4 overflow-y-auto px-4 pt-2">
        @foreach (var category in Const.NavItems)
        {
            <div>
                @if (!string.IsNullOrEmpty(category.Title))
                {
                    <div class="px-3 pt-3 pb-3 text-sm font-semibold tracking-wider text-slate-400 uppercase">
                        @category.Title
                    </div>
                }
                else
                {
                    <!-- Add margin bottom if it's the main items without title (like Dashboard) -->
                    <div class="mb-3"></div>
                }

                @foreach (var item in category.Items)
                {
                    <NavLink href="@item.Url" Match="NavLinkMatch.Prefix" ActiveClass="active"
                             class="group mb-1 flex cursor-pointer items-center gap-3 rounded-sm px-3 py-2 text-slate-600 transition-colors hover:text-brand-600 hover:bg-slate-50 [&.active]:bg-brand-50 [&.active]:text-brand-600 [&.active]:hover:bg-brand-50 [&.active]:hover:text-brand-600">
                        <Icon Style="@(item.Icon ?? Icon.IconStyle.Close)" CssStyle="font-weight: 300;" />
                        @item.Title
                    </NavLink>
                }
            </div>
        }
    </nav>

    <!-- User Profile Dropdown -->
    <div class="relative border-t border-slate-200 p-4">
        <button @onclick="() => isDropdownOpen = !isDropdownOpen"
                class="flex items-center gap-3 w-full p-2 rounded-xl transition-all cursor-pointer 
                @(isDropdownOpen ? "bg-slate-200 ring-1 ring-slate-300" : "hover:bg-slate-100")">

            <div hidden class="bg-brand-500 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 border-white font-bold text-white shadow-sm">
                @initials
            </div>
            <div class="min-w-0 flex-1 text-left">
                <p class="truncate text-sm font-bold text-slate-900" title="@name">
                    @name
                </p>
                <div class="flex items-center gap-1 text-slate-500">
                    <p class="truncate text-xs" title="@email">
                        @email 
                     @* <span class="@($"inline-block transition-transform duration-200 {(isDropdownOpen ? "rotate-180" : "")}")">AA</span> *@
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             class="@($"ms-1 inline-block transition-transform duration-200 {(isDropdownOpen ? "rotate-180" : "")}")"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 9l6 6 6-6" />
                        </svg>
                    </p>
                </div>
            </div>
        </button>

        @if (isDropdownOpen)
        {
            <Backdrop @bind-IsVisible="isDropdownOpen" />

            <div
                class="animate-in fade-in slide-in-from-bottom-2 absolute right-4 bottom-[calc(100%+8px)] left-4 z-50 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl duration-200">
                <div class="border-brand-300 bg-brand-100/50 border-b p-3">
                    <p class="mb-1 font-bold tracking-wider text-[10px] text-slate-500 uppercase">
                        Signed in as
                    </p>
                    <p class="truncate text-xs font-semibold text-slate-900" title="@email">
                        @email
                    </p>
                </div>
                <div class="p-1">
                    <button @onclick="NavigateToProfile"
                            class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:text-brand-600 hover:bg-brand-50">
                        <Icon Style="Icon.IconStyle.User" />
                        <span>My Profile</span>
                    </button>
                    <div class="mx-2 my-1 h-px bg-slate-50" />
                    <button @onclick="SignOut"
                            class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600">
                        <Icon Style="Icon.IconStyle.LogOut" />
                        <span>Sign Out</span>
                    </button>
                </div>
            </div>
        }
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool isDropdownOpen = false;
    private string email = "micheal-hues@example.com";
    private string name = "Agbabiaka Longhursting";
    private string initials => "LA";


    private async Task CloseSidebar()
    {
        IsOpen = false;
        if (IsOpenChanged.HasDelegate)
        {
            await IsOpenChanged.InvokeAsync(IsOpen);
        }
    }

    private void NavigateToProfile()
    {
        isDropdownOpen = false;
        nav.NavigateTo(Const.Routes.Account.Profile);
    }

    private void SignOut()
    {
        isDropdownOpen = false;
        nav.NavigateTo(Const.Routes.Logoff);
    }
}
