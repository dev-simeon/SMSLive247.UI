@inject NavigationManager nav

<header class="sticky top-0 z-10 flex h-16 items-center justify-between 
    border-b border-slate-200 dark:border-slate-700 bg-white dark:bg-black 
    px-4 backdrop-blur-md sm:px-6">
    <div class="flex items-center gap-3">
        <button @onclick="OnMenuClick"
                class="-ml-2 rounded-md p-2 text-slate-600 hover:text-brand-600 lg:hidden">
            <Icon Style="Icon.IconStyle.Menu" />
        </button>

        @* Mobile Logo *@
        <div class="flex items-center lg:hidden">
            <img src="/smslive-logo-2.png" class="h-12 w-auto block dark:hidden" alt="SMSLive247" />
            <img src="/smslive-logo-1.png" class="h-12 w-auto hidden dark:block" alt="SMSLive247" />
        </div>

        @* Breadcrumb *@
        <Breadcrumbs></Breadcrumbs>
    </div>

    <div class="ml-auto flex items-center gap-4">
        @if (Account is not null)
        {
            @* Credits Pill *@
            <div class="hidden items-center gap-4 rounded-lg border border-slate-200 dark:border-slate-700 px-4 py-1.5 sm:flex">
                <FormatBalance Wallet="@Account.Wallet" 
                               Balance="@Account.WalletBalance" 
                               Title="Available Balance" />
            </div>
        }
        
        @* Actions *@
        <Button Icon="Icon.IconStyle.CreditCard" Text="Top Up" 
                OnClick="() => nav.NavigateTo(Const.Routes.Wallet.Purchase)" />

        <ThemeToggle />
    </div>
</header>

@code {
    [Parameter] public EventCallback OnMenuClick { get; set; }
    [Parameter] public AccountResponse? Account { get; set; }  
}
