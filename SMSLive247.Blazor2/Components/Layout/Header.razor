@inject NavigationManager nav

<header class="h-16 bg-white/90 backdrop-blur-md border-b border-slate-200 flex items-center 
                justify-between px-4 sm:px-6 sticky top-0 z-10">
    <div class="flex items-center gap-3">
        <button @onclick="OnMenuClick"
                class="lg:hidden p-2 -ml-2 text-slate-600 hover:text-brand-600 rounded-md">
            <Icon Style="Icon.IconStyle.Menu" />
        </button>

        @* Mobile Logo *@
        <div class="lg:hidden flex items-center">
            <img src="/smslive-logo-2.png" alt="SMSLive247" class="h-8 w-auto" />
        </div>

        @* Breadcrumb *@
        <Breadcrumbs></Breadcrumbs>
    </div>

    <div class="flex items-center gap-4 ml-auto">
        @* Credits Pill *@
        <div class="hidden sm:flex items-center gap-4 bg-slate-50 px-4 py-1.5 rounded-full border border-slate-200">
            <div class="flex items-center gap-2">
                <span class="flex items-center text-blue-500 p-0.5"
                      title="Available Credits">
                    <Icon Style="Icon.IconStyle.Coins" />
                </span>
                <span class="text-sm font-bold text-slate-800">
                    5,000.00
                </span>
            </div>
        </div>

        @* Actions *@
        <Button Icon="Icon.IconStyle.CreditCard" Text="Top Up" OnClick="NavigateToTopup" />

        <button class="relative p-2 text-slate-400 hover:text-slate-600 transition-colors">
            <Icon Style="Icon.IconStyle.Bell" />
            <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
        </button>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnMenuClick { get; set; }

    private void NavigateToTopup()
    {
        nav.NavigateTo("/wallet/buy-credits");
    }
}
