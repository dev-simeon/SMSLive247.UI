<Modal Title="Select Recipients" Size="Modal.ModalSize.Large" @bind-IsVisible="isVisible">
    <Body>
        <div class="space-y-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <p class="text-sm text-slate-500">Pick contacts and/or groups. Both tabs apply.</p>
                @if (totalSelected > 0)
                {
                    <div class="flex items-center gap-1.5 rounded-lg border border-blue-100 bg-blue-50 px-3 py-1.5 text-sm font-medium text-blue-700">
                        <span>Selected:</span>
                        <span class="font-bold">@totalSelected</span>
                    </div>
                }
            </div>

            <div class="border-b border-slate-100 bg-slate-50/50 px-1">
                <div class="flex gap-4 sm:gap-6">
                    <button type="button" @onclick="() => SetTab(ContactTab.Individual)" class="@GetTabClass(ContactTab.Individual)">
                        <Icon Style="Icon.IconStyle.Users" CssClass="text-base leading-none" />
                        <span>Individual Contacts</span>
                        @if (selectedContactPhones.Count > 0)
                        {
                            <span class="bg-brand-500 inline-flex h-5 w-5 items-center justify-center rounded-full text-xs font-bold text-white">@selectedContactPhones.Count</span>
                        }
                    </button>
                    <button type="button" @onclick="() => SetTab(ContactTab.Groups)" class="@GetTabClass(ContactTab.Groups)">
                        <Icon Style="Icon.IconStyle.Users" CssClass="text-base leading-none" />
                        <span>Contact Groups</span>
                        @if (selectedGroupNames.Count > 0)
                        {
                            <span class="bg-brand-500 inline-flex h-5 w-5 items-center justify-center rounded-full text-xs font-bold text-white">@selectedGroupNames.Count</span>
                        }
                    </button>
                </div>
            </div>

            <div class="flex gap-3">
                <FormInput Label="" @bind-Value="searchTerm" Required="false" Placeholder="@SearchPlaceholder" />
                <button type="button"
                        title="Refresh"
                        disabled="@isLoading"
                        @onclick="Refresh"
                        class="mt-0 flex h-10 w-11 shrink-0 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition-colors hover:bg-slate-50 disabled:opacity-50">
                    <Icon Style="Icon.IconStyle.Refresh" CssClass="@RefreshIconClass" />
                </button>
            </div>

            <div class="flex min-h-[360px] flex-col overflow-hidden rounded-lg border border-slate-200">
                @if (isLoading)
                {
                    <div class="flex flex-1 items-center justify-center gap-3">
                        <div class="border-brand-200 border-t-brand-500 h-6 w-6 animate-spin rounded-full border-2"></div>
                        <span class="text-sm text-slate-500">Loading...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="flex flex-1 flex-col items-center justify-center gap-2">
                        <p class="text-sm text-red-500">@errorMessage</p>
                        <button type="button" @onclick="Refresh" class="text-brand-500 text-sm hover:underline">Try again</button>
                    </div>
                }
                else
                {
                    <div class="flex-1 overflow-x-auto overflow-y-auto">
                        <table class="w-full min-w-[480px] text-left text-sm">
                            <thead class="bg-brand-50 border-b-2 border-blue-100">
                                @if (activeTab == ContactTab.Individual)
                                {
                                    <tr>
                                        <th class="w-10 px-4 py-3.5 text-center">
                                            <input type="checkbox" checked="@AllPageContactsSelected" @onchange="ToggleAllContacts" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                                        </th>
                                        <th class="text-brand-900 px-4 py-3.5 text-xs font-bold tracking-wider uppercase">Name</th>
                                        <th class="text-brand-900 px-4 py-3.5 text-xs font-bold tracking-wider uppercase">Phone Number</th>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <th class="w-10 px-4 py-3.5 text-center"></th>
                                        <th class="text-brand-900 px-4 py-3.5 text-xs font-bold tracking-wider uppercase">Group Name</th>
                                        <th class="text-brand-900 px-4 py-3.5 text-right text-xs font-bold tracking-wider uppercase">Members</th>
                                    </tr>
                                }
                            </thead>
                            <tbody class="divide-y divide-slate-100 bg-white">
                                @if (ActiveCount == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="py-10 text-center text-sm text-slate-400">@EmptyMessage</td>
                                    </tr>
                                }
                                else if (activeTab == ContactTab.Individual)
                                {
                                    @foreach (var contact in PagedContacts)
                                    {
                                        var phone = contact.PhoneNumber ?? "";
                                        var name = string.IsNullOrWhiteSpace(contact.ContactName) ? phone : contact.ContactName;
                                        var selected = selectedContactPhones.Contains(phone);
                                        <tr class="cursor-pointer transition-colors hover:bg-slate-50/50 @(selected ? "bg-blue-50/30" : "")" @onclick="() => ToggleContact(phone)">
                                            <td class="px-4 py-3.5 text-center" @onclick:stopPropagation="true">
                                                <input type="checkbox" checked="@selected" @onchange="_ => ToggleContact(phone)" class="h-4 w-4 rounded border-slate-300 accent-brand-500" />
                                            </td>
                                            <td class="px-4 py-3.5 font-medium text-slate-900">
                                                <div class="flex items-center gap-2.5">
                                                    <div class="@AvatarClass(name)">@Initials(name)</div>
                                                    <span class="truncate">@name</span>
                                                </div>
                                            </td>
                                            <td class="px-4 py-3.5 font-mono text-sm text-slate-600">@phone</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    @foreach (var group in PagedGroups)
                                    {
                                        var name = group.GroupName ?? "";
                                        var selected = selectedGroupNames.Contains(name);
                                        var count = group.Members?.Count ?? 0;
                                        <tr class="cursor-pointer transition-colors hover:bg-slate-50/50 @(selected ? "bg-blue-50/30" : "")" @onclick="() => ToggleGroup(name)">
                                            <td class="px-4 py-3.5 text-center" @onclick:stopPropagation="true">
                                                <input type="checkbox" checked="@selected" @onchange="_ => ToggleGroup(name)" class="h-4 w-4 rounded border-slate-300 accent-brand-500" />
                                            </td>
                                            <td class="px-4 py-3.5 font-medium text-slate-900">
                                                <div class="flex items-center gap-2.5">
                                                    <div class="@AvatarClass(name)">@Initials(name)</div>
                                                    <span class="truncate">@name</span>
                                                </div>
                                            </td>
                                            <td class="px-4 py-3.5 text-right">
                                                <span class="inline-flex items-center rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">@count.ToString("N0")</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (ActiveCount > 0)
                    {
                        <div class="mt-1 flex shrink-0 items-center justify-between border-t border-slate-100 px-4 py-3">
                            <span class="text-xs text-slate-500 sm:text-sm">
                                Showing <span class="font-medium text-slate-900">@StartRecord</span> to <span class="font-medium text-slate-900">@EndRecord</span> of <span class="font-medium text-slate-900">@ActiveCount.ToString("N0")</span> results
                            </span>
                            <div class="flex items-center gap-2">
                                <button type="button" @onclick="PreviousPage" disabled="@(safePage <= 1)" class="rounded-lg border border-slate-200 px-3 py-2 text-slate-400 transition-colors hover:border-brand-500 hover:text-brand-600 disabled:cursor-not-allowed disabled:opacity-50">‹</button>
                                <button type="button" @onclick="NextPage" disabled="@(safePage >= totalPages)" class="rounded-lg border border-slate-200 px-3 py-2 text-slate-400 transition-colors hover:border-brand-500 hover:text-brand-600 disabled:cursor-not-allowed disabled:opacity-50">›</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </Body>
    <Footer>
        <Button Text="Add Selected Recipients" Icon="Icon.IconStyle.PlusCircle" IsDisabled="@(totalSelected == 0)" OnClick="Confirm" />
        <Button Text="Cancel" Style="Button.ButtonStyle.Secondary" OnClick="Close" />
    </Footer>
</Modal>

@code {
    private const int PageSize = 100;
    private readonly List<ContactResponse> contacts = [];
    private readonly List<GroupResponse> groups = [];
    private readonly HashSet<string> selectedContactPhones = [];
    private readonly HashSet<string> selectedGroupNames = [];
    private bool isVisible;
    private bool isLoading;
    private string searchTerm = "";
    private string? errorMessage;
    private int page = 1;
    private ContactTab activeTab = ContactTab.Individual;

    [Parameter] public EventCallback<SelectedRecipientsResult> OnSelected { get; set; }

    private enum ContactTab { Individual, Groups }

    private int totalSelected => selectedContactPhones.Count + selectedGroupNames.Count;
    private string RefreshIconClass => $"text-base leading-none {(isLoading ? "animate-spin" : "")}";
    private string SearchPlaceholder => activeTab == ContactTab.Individual ? "Search by name or phone..." : "Search by group name...";
    private string EmptyMessage => activeTab == ContactTab.Individual ? "No contacts found." : "No groups found.";

    private List<ContactResponse> FilteredContacts => contacts.Where(x =>
        string.IsNullOrWhiteSpace(searchTerm) ||
        (x.ContactName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        (x.PhoneNumber ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<GroupResponse> FilteredGroups => groups.Where(x =>
        string.IsNullOrWhiteSpace(searchTerm) ||
        (x.GroupName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    private int ActiveCount => activeTab == ContactTab.Individual ? FilteredContacts.Count : FilteredGroups.Count;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(ActiveCount / (double)PageSize));
    private int safePage => Math.Min(page, totalPages);
    private int pageStart => (safePage - 1) * PageSize;
    private int StartRecord => ActiveCount == 0 ? 0 : pageStart + 1;
    private int EndRecord => Math.Min(pageStart + PageSize, ActiveCount);
    private List<ContactResponse> PagedContacts => FilteredContacts.Skip(pageStart).Take(PageSize).ToList();
    private List<GroupResponse> PagedGroups => FilteredGroups.Skip(pageStart).Take(PageSize).ToList();

    private bool AllPageContactsSelected => PagedContacts.Count > 0 && PagedContacts.All(x => !string.IsNullOrWhiteSpace(x.PhoneNumber) && selectedContactPhones.Contains(x.PhoneNumber));

    public async Task Show(IEnumerable<SelectedContactRecipient> currentContacts, IEnumerable<SelectedGroupRecipient> currentGroups)
    {
        selectedContactPhones.Clear();
        foreach (var contact in currentContacts) selectedContactPhones.Add(contact.Phone);

        selectedGroupNames.Clear();
        foreach (var group in currentGroups) selectedGroupNames.Add(group.Id);

        searchTerm = "";
        page = 1;
        activeTab = ContactTab.Individual;
        isVisible = true;
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var contactsTask = apiClient.ContactListAsync();
            var groupsTask = apiClient.GroupListAsync();
            await Task.WhenAll(contactsTask, groupsTask);

            contacts.Clear();
            contacts.AddRange(contactsTask.Result.Result);

            groups.Clear();
            groups.AddRange(groupsTask.Result.Result);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            await alert.Error(ex.Message, "Contacts");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Refresh(MouseEventArgs _) => await LoadData();

    private void SetTab(ContactTab tab)
    {
        activeTab = tab;
        page = 1;
    }

    private string GetTabClass(ContactTab tab) =>
        activeTab == tab
            ? "flex items-center gap-1.5 border-b-2 border-brand-500 px-1 pb-3 pt-2 text-xs font-medium text-brand-600 transition-colors sm:gap-2 sm:text-sm"
            : "flex items-center gap-1.5 border-b-2 border-transparent px-1 pb-3 pt-2 text-xs font-medium text-slate-500 transition-colors hover:text-slate-700 sm:gap-2 sm:text-sm";

    private void ToggleContact(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return;

        if (!selectedContactPhones.Add(phone))
            selectedContactPhones.Remove(phone);
    }

    private void ToggleGroup(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return;

        if (!selectedGroupNames.Add(name))
            selectedGroupNames.Remove(name);
    }

    private void ToggleAllContacts(ChangeEventArgs _)
    {
        var phones = PagedContacts.Select(x => x.PhoneNumber).Where(x => !string.IsNullOrWhiteSpace(x)).Cast<string>().ToList();

        if (AllPageContactsSelected)
            foreach (var phone in phones) selectedContactPhones.Remove(phone);
        else
            foreach (var phone in phones) selectedContactPhones.Add(phone);
    }

    private void PreviousPage() => page = Math.Max(1, safePage - 1);
    private void NextPage() => page = Math.Min(totalPages, safePage + 1);

    private async Task Confirm(MouseEventArgs _)
    {
        var pickedContacts = contacts
            .Where(x => !string.IsNullOrWhiteSpace(x.PhoneNumber) && selectedContactPhones.Contains(x.PhoneNumber))
            .Select(x => new SelectedContactRecipient(x.PhoneNumber, string.IsNullOrWhiteSpace(x.ContactName) ? x.PhoneNumber : x.ContactName, x.PhoneNumber))
            .ToList();

        var pickedGroups = groups
            .Where(x => !string.IsNullOrWhiteSpace(x.GroupName) && selectedGroupNames.Contains(x.GroupName))
            .Select(x => new SelectedGroupRecipient(
                x.GroupName,
                x.GroupName,
                x.Members?.Count ?? 0,
                x.Members?.Select(m => m.PhoneNumber).Where(phone => !string.IsNullOrWhiteSpace(phone)).Cast<string>().ToList() ?? []))
            .ToList();

        isVisible = false;
        await OnSelected.InvokeAsync(new SelectedRecipientsResult(pickedContacts, pickedGroups));
    }

    private Task Close(MouseEventArgs _) { isVisible = false; return Task.CompletedTask; }

    private static string Initials(string name) =>
        string.Concat((name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));

    private static string AvatarClass(string name)
    {
        var colors = new[]
        {
            "bg-blue-100 text-blue-700",
            "bg-orange-100 text-orange-700",
            "bg-emerald-100 text-emerald-700",
            "bg-purple-100 text-purple-700",
            "bg-pink-100 text-pink-700",
            "bg-amber-100 text-amber-700",
            "bg-cyan-100 text-cyan-700",
            "bg-rose-100 text-rose-700"
        };

        var hash = (name ?? "").Aggregate(0, (current, character) => current + character);
        return $"flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold {colors[Math.Abs(hash) % colors.Length]}";
    }
}
