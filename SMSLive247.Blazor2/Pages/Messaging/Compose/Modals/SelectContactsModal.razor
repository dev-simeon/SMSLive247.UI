<Modal Title="Select Contacts" Size="Modal.ModalSize.Large" @bind-IsVisible="isVisible">
    <Body>
        <div class="flex flex-col flex-1 h-full min-h-[400px]">
            <!-- Tabs for Individual / Groups -->
            <div class="border-b border-slate-100 bg-slate-50/50 px-1 mb-4">
                <div class="flex gap-4 sm:gap-6">
                    <button type="button" @onclick="() => SetTab(ContactTab.Individual)" class="@GetTabClass(ContactTab.Individual)">
                        <Icon Style="Icon.IconStyle.Users" CssClass="text-base leading-none" />
                        <span>Individual Contacts</span>
                        @if (selectedContactPhones.Count > 0)
                        {
                            <span class="bg-brand-500 inline-flex h-5 w-5 items-center justify-center rounded-full text-xs font-bold text-white">@selectedContactPhones.Count</span>
                        }
                    </button>
                    <button type="button" @onclick="() => SetTab(ContactTab.Groups)" class="@GetTabClass(ContactTab.Groups)">
                        <Icon Style="Icon.IconStyle.Users" CssClass="text-base leading-none" />
                        <span>Contact Groups</span>
                        @if (selectedGroupNames.Count > 0)
                        {
                            <span class="bg-brand-500 inline-flex h-5 w-5 items-center justify-center rounded-full text-xs font-bold text-white">@selectedGroupNames.Count</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Header area (search + select all) -->
            <div class="mb-4">
                <div class="flex gap-3 mb-3">
                    <div class="w-1/2">
                        <FormInput Label="" @bind-Value="searchTerm" Required="false" Placeholder="@SearchPlaceholder" />
                    </div>
                    <button type="button"
                            title="Refresh"
                            disabled="@isLoading"
                            @onclick="Refresh"
                            class="mt-0 flex h-10 w-11 shrink-0 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition-colors hover:bg-slate-50 disabled:opacity-50">
                        <Icon Style="Icon.IconStyle.Refresh" CssClass="@RefreshIconClass" />
                    </button>
                </div>

                <div class="flex items-center gap-2">
                    <input type="checkbox" id="ct-all" checked="@AllPageContactsSelected" @onchange="ToggleAllContacts" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                    <label for="ct-all" class="text-sm font-medium text-slate-700 cursor-pointer select-none">Select All</label>
                </div>
            </div>

            <!-- Results area -->
            <div class="overflow-x-hidden overflow-y-auto flex-1 h-64 border border-slate-200 rounded-lg p-4 bg-slate-50 shadow-inner">
                @if (isLoading)
                {
                    <p class="text-slate-500 italic text-sm">Loading...</p>
                }
                else if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <p class="text-red-500 text-sm">@errorMessage</p>
                }
                else if (ActiveCount == 0)
                {
                    <p class="text-slate-500 italic text-sm">@EmptyMessage</p>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        @if (activeTab == ContactTab.Individual)
                        {
                            @foreach (var item in FilteredContacts.OrderBy(x => x.ContactName))
                            {
                                var phone = item.PhoneNumber ?? "";
                                var name = string.IsNullOrWhiteSpace(item.ContactName) ? phone : item.ContactName;
                                var selected = selectedContactPhones.Contains(phone);
                                
                                <div class="flex items-center gap-2">
                                    <input type="checkbox"
                                           value="@phone" checked="@selected"
                                           id="ct-@phone" @onchange="_ => ToggleContact(phone)" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                                    <label class="text-sm text-slate-700 cursor-pointer select-none truncate" for="ct-@phone" title="@name (@phone)">
                                        @name
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            @foreach (var item in FilteredGroups.OrderBy(x => x.GroupName))
                            {
                                var name = item.GroupName ?? "";
                                var selected = selectedGroupNames.Contains(name);
                                var count = item.Members?.Count ?? 0;
                                
                                <div class="flex items-center gap-2">
                                    <input type="checkbox"
                                           value="@name" checked="@selected"
                                           id="gr-@name" @onchange="_ => ToggleGroup(name)" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                                    <label class="text-sm text-slate-700 cursor-pointer select-none truncate" for="gr-@name" title="@name (@count)">
                                        @name (@count)
                                    </label>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
            
            @if (totalSelected > 0)
            {
                <div class="mt-3 text-right">
                    <span class="rounded bg-brand-50 px-2.5 py-1 text-xs font-bold text-brand-700">Total Selected: @totalSelected</span>
                </div>
            }
        </div>
    </Body>
    <Footer>
        <Button Text="Add Selected Recipients" Icon="Icon.IconStyle.PlusCircle" IsDisabled="@(totalSelected == 0)" OnClick="Confirm" />
        <Button Text="Cancel" Style="Button.ButtonStyle.Secondary" OnClick="Close" />
    </Footer>
</Modal>


@code {
    private readonly List<ContactResponse> contacts = [];
    private readonly List<GroupResponse> groups = [];
    private HashSet<string> selectedContactPhones = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> selectedGroupNames = new(StringComparer.OrdinalIgnoreCase);

    [Parameter] public EventCallback<SelectedRecipientsResult> OnSelected { get; set; }

    private bool isVisible;
    private bool isLoading;
    private string errorMessage = string.Empty;

    private ContactTab activeTab = ContactTab.Individual;
    private string searchTerm = string.Empty;

    public int totalSelected => selectedContactPhones.Count + selectedGroupNames.Count;

    private string SearchPlaceholder => activeTab == ContactTab.Individual ? "Search contacts..." : "Search groups...";
    private string EmptyMessage => activeTab == ContactTab.Individual ? "No contacts found" : "No groups found";

    private enum ContactTab { Individual, Groups }

    private List<ContactResponse> FilteredContacts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchTerm)) return contacts;
            var q = searchTerm.Trim().ToLowerInvariant();
            return contacts.Where(c => (c.ContactName?.ToLowerInvariant().Contains(q) ?? false) ||
                                     (c.PhoneNumber?.ToLowerInvariant().Contains(q) ?? false)).ToList();
        }
    }

    private List<GroupResponse> FilteredGroups
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchTerm)) return groups;
            var q = searchTerm.Trim().ToLowerInvariant();
            return groups.Where(g => g.GroupName?.ToLowerInvariant().Contains(q) ?? false).ToList();
        }
    }

    private int ActiveCount => activeTab == ContactTab.Individual ? FilteredContacts.Count : FilteredGroups.Count;

    private bool AllPageContactsSelected
    {
        get
        {
            if (ActiveCount == 0) return false;
            
            if (activeTab == ContactTab.Individual)
                return FilteredContacts.All(c => selectedContactPhones.Contains(c.PhoneNumber ?? ""));
            else
                return FilteredGroups.All(g => selectedGroupNames.Contains(g.GroupName ?? ""));
        }
    }

    public async Task Show(IEnumerable<SelectedContactRecipient> currentContacts, IEnumerable<SelectedGroupRecipient> currentGroups)
    {
        selectedContactPhones.Clear();
        foreach (var contact in currentContacts) selectedContactPhones.Add(contact.Phone);

        selectedGroupNames.Clear();
        foreach (var group in currentGroups) selectedGroupNames.Add(group.Id);

        searchTerm = string.Empty;
        activeTab = ContactTab.Individual;
        isVisible = true;

        if (contacts.Count == 0 && groups.Count == 0)
        {
            await Refresh();
        }
        
        StateHasChanged();
    }

    private async Task Refresh()
    {
        if (isLoading) return;

        isLoading = true;
        errorMessage = string.Empty;
        await InvokeAsync(StateHasChanged);

        try
        {
            contacts.Clear();
            groups.Clear();

            var contactsTask = apiClient.ContactListAsync();
            var groupsTask = apiClient.GroupListAsync();

            await Task.WhenAll(contactsTask, groupsTask);

            if (contactsTask.Result.Result != null)
                contacts.AddRange(contactsTask.Result.Result.Where(c => !string.IsNullOrWhiteSpace(c.PhoneNumber)));

            if (groupsTask.Result.Result != null)
                groups.AddRange(groupsTask.Result.Result.Where(g => !string.IsNullOrWhiteSpace(g.GroupName)));
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load data. " + ex.Message;
            await alert.Error(ex.Message, "Contacts");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetTab(ContactTab tab)
    {
        activeTab = tab;
        searchTerm = string.Empty;
    }

    private void ToggleContact(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return;
        if (!selectedContactPhones.Add(phone)) selectedContactPhones.Remove(phone);
    }

    private void ToggleGroup(string groupName)
    {
        if (string.IsNullOrWhiteSpace(groupName)) return;
        if (!selectedGroupNames.Add(groupName)) selectedGroupNames.Remove(groupName);
    }

    private void ToggleAllContacts(ChangeEventArgs e)
    {
        var selectAll = (bool)(e.Value ?? false);
        
        if (activeTab == ContactTab.Individual)
        {
            foreach (var c in FilteredContacts)
            {
                var phone = c.PhoneNumber ?? "";
                if (selectAll) selectedContactPhones.Add(phone);
                else selectedContactPhones.Remove(phone);
            }
        }
        else
        {
            foreach (var g in FilteredGroups)
            {
                var name = g.GroupName ?? "";
                if (selectAll) selectedGroupNames.Add(name);
                else selectedGroupNames.Remove(name);
            }
        }
    }

    private async Task Confirm()
    {
        if (totalSelected == 0) return;

        var pickedContacts = contacts
            .Where(x => !string.IsNullOrWhiteSpace(x.PhoneNumber) && selectedContactPhones.Contains(x.PhoneNumber))
            .Select(x => new SelectedContactRecipient(x.PhoneNumber, string.IsNullOrWhiteSpace(x.ContactName) ? x.PhoneNumber : x.ContactName, x.PhoneNumber))
            .ToList();

        var pickedGroups = groups
            .Where(x => !string.IsNullOrWhiteSpace(x.GroupName) && selectedGroupNames.Contains(x.GroupName))
            .Select(x => new SelectedGroupRecipient(
                x.GroupName,
                x.GroupName,
                x.Members?.Count ?? 0,
                x.Members?.Select(m => m.PhoneNumber).Where(phone => !string.IsNullOrWhiteSpace(phone)).Cast<string>().ToList() ?? []))
            .ToList();

        isVisible = false;
        await OnSelected.InvokeAsync(new SelectedRecipientsResult(pickedContacts, pickedGroups));
    }

    private void Close()
    {
        isVisible = false;
    }

    private string GetTabClass(ContactTab tab)
    {
        return activeTab == tab
            ? "flex items-center gap-2 border-b-2 border-brand-500 py-2.5 text-sm font-semibold text-brand-600 transition-colors"
            : "flex items-center gap-2 border-b-2 border-transparent py-2.5 text-sm font-medium text-slate-500 transition-colors hover:text-slate-700";
    }

    private string RefreshIconClass => isLoading ? "h-4 w-4 animate-spin text-brand-500" : "h-4 w-4";
}
