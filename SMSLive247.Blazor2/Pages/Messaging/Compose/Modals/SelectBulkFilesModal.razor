<Modal Title="Select Bulk File" Size="Modal.ModalSize.Large" @bind-IsVisible="isVisible">
    <Body>
        <div class="flex flex-col flex-1 h-full min-h-[400px]">
            <p class="text-sm text-slate-500 mb-4">Choose from your previously uploaded TXT files.</p>

            <!-- Header area (search + select all) -->
            <div class="mb-4">
                <div class="flex gap-3 mb-3">
                    <div class="w-1/2">
                        <FormInput Label="" @bind-Value="searchTerm" Required="false" Placeholder="Search files..." />
                    </div>
                    <button type="button"
                            title="Refresh"
                            disabled="@isLoading"
                            @onclick="Refresh"
                            class="mt-0 flex h-10 w-11 shrink-0 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition-colors hover:bg-slate-50 disabled:opacity-50">
                        <Icon Style="Icon.IconStyle.Refresh" CssClass="@RefreshIconClass" />
                    </button>
                </div>

                <div class="flex items-center gap-2">
                    <input type="checkbox" id="bf-all" checked="@AllPageSelected" @onchange="ToggleAll" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                    <label for="bf-all" class="text-sm font-medium text-slate-700 cursor-pointer select-none">Select All</label>
                </div>
            </div>

            <!-- Results area -->
            <div class="overflow-x-hidden overflow-y-auto flex-1 h-64 border border-slate-200 rounded-lg p-4 bg-slate-50 shadow-inner">
                @if (isLoading)
                {
                    <p class="text-slate-500 italic text-sm">Loading files...</p>
                }
                else if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <p class="text-red-500 text-sm">@errorMessage</p>
                }
                else if (FilteredFiles.Count == 0)
                {
                    <p class="text-slate-500 italic text-sm">No TXT files found.</p>
                }
                else
                {
                    <div class="flex flex-col gap-2">
                        @foreach (var file in FilteredFiles.OrderBy(x => string.IsNullOrWhiteSpace(x.Description) ? x.BatchFileID : x.Description))
                        {
                            var id = file.BatchFileID ?? "";
                            var name = string.IsNullOrWhiteSpace(file.Description) ? id : file.Description;
                            var selected = selectedIds.Contains(id);
                            
                            <div class="flex items-center gap-2">
                                <input type="checkbox"
                                       value="@id" checked="@selected"
                                       id="bf-@id" @onchange="_ => ToggleFile(id)" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                                <label class="text-sm text-slate-700 cursor-pointer select-none truncate" for="bf-@id" title="@name (@file.TotalNumbers.ToString("N0") numbers)">
                                    @name <span class="text-slate-400 text-xs ml-1">(@file.TotalNumbers.ToString("N0") numbers)</span>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (selectedIds.Count > 0)
            {
                <div class="mt-3 text-right">
                    <span class="rounded bg-brand-50 px-2.5 py-1 text-xs font-bold text-brand-700">Total Selected: @selectedIds.Count</span>
                </div>
            }
        </div>
    </Body>
    <Footer>
        <Button Text="@ConfirmText" Icon="Icon.IconStyle.PlusCircle" IsDisabled="@(selectedIds.Count == 0)" OnClick="Confirm" />
        <Button Text="Cancel" Style="Button.ButtonStyle.Secondary" OnClick="Close" />
    </Footer>
</Modal>

@code {
    private readonly List<BatchFileResponse> files = [];
    private HashSet<string> selectedIds = new(StringComparer.OrdinalIgnoreCase);

    [Parameter] public EventCallback<List<SelectedFileRecipient>> OnSelected { get; set; }
    [Parameter] public bool MultiSelect { get; set; } = true;
    
    private string ConfirmText => selectedIds.Count > 0
        ? $"Add {selectedIds.Count} File{(selectedIds.Count == 1 ? "" : "s")}"
        : "Add Selected";

    private bool isVisible;
    private bool isLoading;
    private string errorMessage = string.Empty;
    private string searchTerm = string.Empty;

    private List<BatchFileResponse> FilteredFiles
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchTerm)) return files;
            var q = searchTerm.Trim().ToLowerInvariant();
            return files.Where(f => (f.Description?.ToLowerInvariant().Contains(q) ?? false) ||
                                  (f.BatchFileID?.ToLowerInvariant().Contains(q) ?? false)).ToList();
        }
    }

    private bool AllPageSelected
    {
        get
        {
            if (FilteredFiles.Count == 0) return false;
            return FilteredFiles.All(f => selectedIds.Contains(f.BatchFileID ?? ""));
        }
    }

    public async Task Show(IEnumerable<SelectedFileRecipient>? currentSelected = null)
    {
        selectedIds.Clear();
        if (currentSelected != null)
        {
            foreach (var f in currentSelected) selectedIds.Add(f.FileId);
        }

        searchTerm = string.Empty;
        isVisible = true;

        if (files.Count == 0)
        {
            await Refresh();
        }
        
        StateHasChanged();
    }

    private async Task Refresh()
    {
        if (isLoading) return;

        isLoading = true;
        errorMessage = string.Empty;
        await InvokeAsync(StateHasChanged);

        try
        {
            files.Clear();
            var response = await apiClient.BatchFileListAsync();
            if (response.Result != null)
            {
                files.AddRange(response.Result.Where(f => !string.IsNullOrWhiteSpace(f.BatchFileID)));
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load files. " + ex.Message;
            await alert.Error(ex.Message, "Files");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleFile(string id)
    {
        if (string.IsNullOrWhiteSpace(id)) return;

        if (!MultiSelect)
        {
            selectedIds.Clear();
            selectedIds.Add(id);
            return;
        }

        if (!selectedIds.Add(id))
            selectedIds.Remove(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (!MultiSelect) return;

        var selectAll = (bool)(e.Value ?? false);
        
        foreach (var f in FilteredFiles)
        {
            var id = f.BatchFileID ?? "";
            if (selectAll) selectedIds.Add(id);
            else selectedIds.Remove(id);
        }
    }

    private async Task Confirm()
    {
        if (selectedIds.Count == 0) return;

        var selectedFiles = files
            .Where(x => !string.IsNullOrWhiteSpace(x.BatchFileID) && selectedIds.Contains(x.BatchFileID))
            .Select(x => new SelectedFileRecipient(
                x.BatchFileID,
                string.IsNullOrWhiteSpace(x.Description) ? x.BatchFileID : x.Description,
                x.TotalNumbers))
            .ToList();

        isVisible = false;
        await OnSelected.InvokeAsync(selectedFiles);
    }

    private void Close()
    {
        isVisible = false;
    }

    private string RefreshIconClass => isLoading ? "h-4 w-4 animate-spin text-brand-500" : "h-4 w-4";
}
