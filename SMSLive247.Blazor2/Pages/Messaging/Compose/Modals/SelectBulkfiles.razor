<Modal Title="Select Bulk File" Size="Modal.ModalSize.Large" @bind-IsVisible="isVisible">
    <Body>
        <div class="flex h-[400px] flex-1 flex-col">
            <p class="mb-4 text-slate-500">Choose from your previously uploaded TXT files.</p>

            <!-- Header area (search + select all) -->
            <div class="mb-4">
                <div class="mb-3 gap-3">
                    <SearchBox InstantSearch="true" 
                                SearchTermChanged="OnSearchChanged" 
                                Placeholder="Search files..." />
                </div>

                <div class="ml-4 flex items-center gap-2">
                    <input id="bf-all" type="checkbox" @onchange="OnSelectAll" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                    <label for="bf-all" class="cursor-pointer font-medium text-slate-700">Select All</label>
                </div>
            </div>

            <!-- Results area -->
            <div tabindex="0" class="h-64 flex-1 overflow-y-scroll rounded-lg border border-slate-300 p-4 shadow-inner">
                @if (isLoading)
                {
                    <p class="text-sm text-slate-500 italic">Loading files...</p>
                }
                else if (items.Count == 0)
                {
                    <p>No batch file found</p>
                }
                else
                {
                    <div class="flex flex-col gap-2">
                        @foreach (var f in items.Where(x => x.Visible))
                        {
                            <div class="flex items-center gap-2">
                                <input type="checkbox"
                                    value="@f.Key" checked="@f.Selected"
                                    id="bf-@f.Key" @onchange="e => OnSelect(f, e)" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                                <label class="cursor-pointer truncate text-slate-700 select-none" for="bf-@f.Key">
                                    @f.Name <span class="ml-1 text-sm text-slate-400">(@f.Count.ToString("N0") numbers)</span>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (totalSelected > 0)
            {
                <div class="mt-3">
                    <span class="px-2.5 py-1 text-slate-500">@totalSelected Files Selected</span>
                </div>
            }
        </div>
    </Body>
    <Footer>
        <Button Text="Confirm" Icon="Icon.IconStyle.PlusCircle" OnClick="Confirm" />
        <Button Text="Cancel" Style="Button.ButtonStyle.Secondary" OnClick="Close" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public EventCallback<List<ContactModel>> OnSelected { get; set; }

    private bool isVisible;
    private bool isLoading;
    private List<ContactModel> items = [];
    private int totalSelected => items.Count(x => x.Selected);

    public void Show(List<ContactModel> files)
    {
        items = ComposeExtensions.DeepClone(files);
        isVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        isVisible = false;
        StateHasChanged();
    }

    public async Task Confirm()
    {
        await OnSelected.InvokeAsync(items);
        isVisible = false;
        StateHasChanged();
    }

    private void OnSelectAll(ChangeEventArgs e)
    {
        var selected = (bool?)e.Value ?? false;
        items.Where(x => x.Visible).ToList().ForEach(x => x.Selected = selected);
    }

    public void OnSelect(ContactModel item, ChangeEventArgs e)
    {
        item.Selected = (bool?)e.Value ?? false;
    }

    private void OnSearchChanged(string search)
    {
        if (!string.IsNullOrWhiteSpace(search))
        {
            var noCase = StringComparison.OrdinalIgnoreCase;
            items.ForEach(x => x.Visible = x.Name.Contains(search, noCase));
            StateHasChanged();
            return;
        }

        items.ForEach(x => x.Visible = true);
        StateHasChanged();
    }
}
