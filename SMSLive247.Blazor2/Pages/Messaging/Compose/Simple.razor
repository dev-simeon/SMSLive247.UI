@using System.Text.RegularExpressions
@using SMSLive247.Blazor2.Pages.Messaging.Compose.Modals
@inject NavigationManager nav

@if (isLoading)
{
    <div class="rounded-xl border border-slate-200 bg-white p-8 text-sm text-slate-500">Loading compose options...</div>
}
else
{
    <div class="rounded-xl border border-slate-100 bg-white p-6 shadow-sm lg:p-8">
        <div class="mb-8 max-w-sm">
            <h3 class="mb-4 text-lg font-semibold text-slate-800">Sender ID</h3>
            <FormSelect TValue="string" @bind-Value="senderId" Required="true" IconStyle="Icon.IconStyle.ChevronDown">
                <option value="">Select Approved Sender ID...</option>
                @foreach (var item in senderIds)
                {
                    <option value="@item.SenderID">@item.SenderID</option>
                }
            </FormSelect>
            <a href="@Const.Routes.Messaging.SenderIds" class="text-brand-500 mt-2 inline-block text-xs font-medium hover:underline">Request a new sender ID</a>
        </div>

        <hr class="my-8 border-slate-100" />

        <section class="mb-8">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg font-semibold text-slate-800">Recipients</h3>
                @if (totalRecipients > 0)
                {
                    <div class="flex items-center gap-2 rounded-lg border border-slate-100 bg-slate-50 px-3 py-1.5 text-sm text-slate-500">
                        <span>Total Recipients:</span>
                        <span class="font-bold text-slate-900">@totalRecipients.ToString("N0")</span>
                    </div>
                }
            </div>

            <div class="flex flex-col gap-5">
                <div class="flex flex-wrap gap-2 sm:gap-3">
                    <Button Text="Add Manual" Icon="Icon.IconStyle.PenSquare" Style="@(showManual ? Button.ButtonStyle.Primary : Button.ButtonStyle.Secondary)" OnClick="ToggleManual" CssClass="px-3 sm:px-5" />
                    <Button Text="Add from Contacts" Icon="Icon.IconStyle.Users" Style="Button.ButtonStyle.Secondary" OnClick="OpenContacts" CssClass="px-3 sm:px-5" />
                    <Button Text="Select Bulk File" Icon="Icon.IconStyle.FileText" Style="Button.ButtonStyle.Secondary" OnClick="OpenFiles" CssClass="px-3 sm:px-5" />
                </div>

                @if (manualRecipientCount > 0 || selectedContacts.Count > 0 || selectedGroups.Count > 0 || selectedFiles.Count > 0)
                {
                    <div class="flex flex-col gap-3 pt-2">
                        <div class="flex items-start gap-3">
                            <span class="mt-2 min-w-13.5 shrink-0 text-right text-sm font-semibold text-slate-400">Added:</span>
                            <div class="min-w-0 flex-1 space-y-3">
                                @if (manualRecipientCount > 0 || selectedContacts.Count > 0)
                                {
                                    <div class="flex cursor-grab items-center gap-2 overflow-x-auto py-0.5 pb-1 select-none active:cursor-grabbing">
                                        @if (manualRecipientCount > 0)
                                        {
                                            <RecipientChip Label="@($"Manual ({manualRecipientCount})")" OnRemove="ClearManualRecipients" />
                                        }
                                        @foreach (var contact in selectedContacts)
                                        {
                                            <RecipientChip Label="@contact.Name" OnRemove="() => RemoveContact(contact.Id)" />
                                        }
                                    </div>
                                }

                                @if (selectedGroups.Count > 0)
                                {
                                    <div class="flex cursor-grab items-center gap-2 overflow-x-auto py-0.5 pb-1 select-none active:cursor-grabbing">
                                        @foreach (var group in selectedGroups)
                                        {
                                            <RecipientChip Label="@($"Group: {group.Name} ({group.Count:N0})")" LeadingIcon="Icon.IconStyle.Users" OnRemove="() => RemoveGroup(group.Id)" />
                                        }
                                    </div>
                                }

                                @if (selectedFiles.Count > 0)
                                {
                                    <div class="flex cursor-grab items-center gap-2 overflow-x-auto py-0.5 pb-1 select-none active:cursor-grabbing">
                                        @foreach (var file in selectedFiles)
                                        {
                                            <RecipientChip Label="@($"File: {file.Name} ({file.Count:N0})")" LeadingIcon="Icon.IconStyle.FileText" OnRemove="() => RemoveFile(file.FileId)" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (showManual)
                {
                    <div class="relative max-w-2xl rounded-xl border border-slate-200 bg-white shadow-sm">
                        <button type="button" @onclick="ClearManual" title="Remove manual recipients" class="absolute top-3 right-3 z-10 rounded-md p-1 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600">
                            <Icon Style="Icon.IconStyle.Close" CssClass="text-base" />
                        </button>
                        <textarea @bind="manualNumbers" @bind:event="oninput" @bind:after="SanitizeNumbers"
                                  class="h-32 w-full resize-y rounded-t-xl border-0 bg-transparent px-4 py-4 font-mono text-sm text-slate-900 placeholder-slate-400 outline-none"
                                  placeholder="Paste phone numbers here (separated by comma or new line)..."></textarea>
                        <div class="flex items-center justify-between rounded-b-xl border-t border-slate-100 bg-slate-50 px-4 py-3">
                            <span class="flex items-center gap-1.5 text-xs text-slate-500">
                                <span class="inline-block h-1.5 w-1.5 rounded-full bg-green-500"></span>
                                Duplicates will be removed automatically
                            </span>
                            @if (manualRecipientCount > 0)
                            {
                                <span class="text-brand-500 text-xs font-semibold">@manualRecipientCount number@(manualRecipientCount == 1 ? "" : "s") detected</span>
                            }
                        </div>
                    </div>
                }
            </div>

        </section>

        <hr class="my-8 border-slate-100" />

        <section>
            <div class="mb-4 flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold text-slate-800">Message Content</h3>
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <button type="button" @onclick="ClearMessage" class="flex items-center gap-1 text-xs text-slate-400 hover:text-slate-700"><Icon Style="Icon.IconStyle.Refresh" CssClass="text-sm" />Clear message</button>
                }
            </div>
            <textarea @bind="message" @bind:event="oninput" maxlength="918" class="h-44 w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-brand-500 focus:ring-brand-100 focus:ring-2" placeholder="Type your message here..."></textarea>
            <div class="mt-2 flex flex-wrap justify-between gap-2 text-xs text-slate-500">
                <span>Messages longer than 160 characters are charged per page.</span>
                <span><strong class="text-slate-700">@message.Length</strong> characters, <strong class="text-slate-700">@messageParts</strong> part@(messageParts == 1 ? "" : "s")</span>
            </div>
        </section>

        <div class="mt-6 border-t border-slate-100 pt-8">
            @if (showScheduler)
            {
                <div class="animate-in fade-in zoom-in-95 mb-6 w-fit rounded-xl border border-slate-200 p-5 duration-200">
                    <div class="max-w-xs">
                        <h4 class="mb-4 flex items-center gap-2 text-sm font-semibold text-slate-700">
                            <Icon Style="Icon.IconStyle.Clock" CssClass="text-brand-500 text-base" />
                            Schedule Delivery
                        </h4>
                        <div class="flex flex-col items-start gap-5">
                            <div class="w-full">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <label class="block text-xs font-medium text-slate-600">Date &amp; Time</label>
                                    <button type="button" @onclick="() => nav.NavigateTo(Const.Routes.Account.Profile)" class="flex items-center gap-0.5 text-[10px] font-bold tracking-tight text-brand-600 uppercase hover:text-brand-700">
                                        <Icon Style="Icon.IconStyle.User" CssClass="text-xs" />
                                        Change
                                    </button>
                                </div>
                                <input type="datetime-local" @bind="deliveryTime" min="@MinimumDeliveryTime" class="w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none focus:border-brand-500 focus:ring-brand-500 focus:ring-2" />
                            </div>
                            <div class="flex w-full flex-col gap-2.5 min-[400px]:flex-row">
                                <Button Text="Confirm Schedule" Icon="Icon.IconStyle.Clock" IsBusy="isSending" IsDisabled="@(!deliveryTime.HasValue || !CanSend)" OnClick="SendScheduledMessage" CssClass="w-full min-[400px]:w-auto" />
                                <Button Text="Cancel" Style="Button.ButtonStyle.Secondary" OnClick="HideScheduler" CssClass="w-full min-[400px]:w-auto" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!showScheduler)
            {
                <div class="animate-in fade-in zoom-in-95 flex w-full flex-col items-center gap-3 duration-200 min-[400px]:w-auto min-[400px]:flex-row">
                    <Button Text="Send Message" Icon="Icon.IconStyle.Mail" IsBusy="isSending" IsDisabled="@(!CanSend)" OnClick="SendMessage" CssClass="w-full px-5 whitespace-nowrap sm:px-8 min-[400px]:w-auto" />
                    <Button Text="Schedule for Later" Icon="Icon.IconStyle.Clock" Style="Button.ButtonStyle.Secondary" IsDisabled="isSending" OnClick="ShowScheduler" CssClass="w-full whitespace-nowrap min-[400px]:w-auto" />
                </div>
            }
        </div>
    </div>
}

<SelectContactsModal @ref="contactsModal" OnSelected="SetSelectedRecipients" />
<SelectBulkFilesModal @ref="filesModal" OnSelected="SetSelectedFiles" />

@code {
    private readonly List<SenderIdResponse> senderIds = [];
    private readonly List<SelectedFileRecipient> selectedFiles = [];
    private readonly List<SelectedContactRecipient> selectedContacts = [];
    private readonly List<SelectedGroupRecipient> selectedGroups = [];
    private SelectContactsModal contactsModal = new();
    private SelectBulkFilesModal filesModal = new();
    private bool isLoading = true;
    private bool isSending;
    private bool showManual = true;
    private bool showScheduler;
    private string senderId = "";
    private string manualNumbers = "";
    private string message = "";
    private DateTime? deliveryTime;

    private int manualRecipientCount => ParseNumbers(manualNumbers).Count;
    private int selectedGroupRecipientCount => selectedGroups.Sum(x => x.Count);
    private int selectedFileRecipientCount => selectedFiles.Sum(x => x.Count);
    private int totalRecipients => manualRecipientCount + selectedContacts.Count + selectedGroupRecipientCount + selectedFileRecipientCount;
    private int messageParts => string.IsNullOrEmpty(message) ? 0 : message.Length <= 160 ? 1 : (int)Math.Ceiling(message.Length / 153d);
    private bool CanSend => !string.IsNullOrWhiteSpace(senderId) && !string.IsNullOrWhiteSpace(message) && totalRecipients > 0;
    private string MinimumDeliveryTime => DateTime.Now.ToString("yyyy-MM-ddTHH:mm");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var senderTask = apiClient.SenderIdListAsync(1, 500, null);
            await senderTask;

            senderIds.AddRange(senderTask.Result.Result.Where(x => string.Equals(x.Status, "Approved", StringComparison.OrdinalIgnoreCase)));
            senderId = senderIds.FirstOrDefault()?.SenderID ?? "";
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Compose Message");
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ToggleManual(MouseEventArgs _) { showManual = !showManual; return Task.CompletedTask; }
    private Task OpenContacts(MouseEventArgs _) => contactsModal.Show(selectedContacts, selectedGroups);
    private Task OpenFiles(MouseEventArgs _) => filesModal.Show(selectedFiles);
    private Task ClearManual() { manualNumbers = ""; showManual = false; return Task.CompletedTask; }
    private Task ClearManualRecipients(MouseEventArgs _) { manualNumbers = ""; return Task.CompletedTask; }
    private Task ClearMessage() { message = ""; return Task.CompletedTask; }
    private Task ShowScheduler(MouseEventArgs _) { showScheduler = true; return Task.CompletedTask; }
    private Task HideScheduler(MouseEventArgs _) { showScheduler = false; deliveryTime = null; return Task.CompletedTask; }
    private Task RemoveContact(string id) { selectedContacts.RemoveAll(x => x.Id == id); return Task.CompletedTask; }
    private Task RemoveGroup(string id) { selectedGroups.RemoveAll(x => x.Id == id); return Task.CompletedTask; }
    private Task RemoveFile(string id) { selectedFiles.RemoveAll(x => x.FileId == id); return Task.CompletedTask; }

    private void SanitizeNumbers()
    {
        manualNumbers = Regex.Replace(manualNumbers, @"[^0-9+,\s]", "");
    }

    private Task SetSelectedRecipients(SelectedRecipientsResult recipients)
    {
        selectedContacts.Clear();
        selectedContacts.AddRange(recipients.Contacts);
        selectedGroups.Clear();
        selectedGroups.AddRange(recipients.Groups);
        return Task.CompletedTask;
    }

    private Task SetSelectedFiles(List<SelectedFileRecipient> files)
    {
        selectedFiles.Clear();
        selectedFiles.AddRange(files);
        return Task.CompletedTask;
    }

    private Task SendMessage(MouseEventArgs _) => SendMessageCore(null);

    private Task SendScheduledMessage(MouseEventArgs _)
    {
        if (!deliveryTime.HasValue)
            return alert.Error("Choose a delivery date and time, or send the message immediately.", "Compose Message");

        return SendMessageCore(new DateTimeOffset(deliveryTime.Value));
    }

    private async Task SendMessageCore(DateTimeOffset? scheduledDeliveryTime)
    {
        var numbers = ParseNumbers(manualNumbers);
        var phoneNumbers = selectedContacts
            .Select(x => x.Phone)
            .Concat(selectedGroups.SelectMany(x => x.MemberPhones))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.Ordinal)
            .ToList();
        var fileIds = selectedFiles.Select(x => x.FileId).ToList();

        if (string.IsNullOrWhiteSpace(senderId) || string.IsNullOrWhiteSpace(message) || (numbers.Count == 0 && phoneNumbers.Count == 0 && fileIds.Count == 0))
        {
            await alert.Error("Choose an approved sender ID, add recipients, and enter a message.", "Compose Message");
            return;
        }

        isSending = true;
        try
        {
            await apiClient.SmsBatchCreateAsync(new SmsBatchRequest
            {
                SenderID = senderId,
                MessageText = message.Trim(),
                RawNumbers = string.Join(',', numbers),
                PhoneNumbers = phoneNumbers,
                BatchFileIDs = fileIds,
                DeliveryTime = scheduledDeliveryTime
            });
            await alert.Success(scheduledDeliveryTime.HasValue ? "Your message has been scheduled." : "Your message is being sent.", "Message Created");
            manualNumbers = "";
            message = "";
            selectedFiles.Clear();
            selectedContacts.Clear();
            selectedGroups.Clear();
            showScheduler = false;
            deliveryTime = null;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Unable to Send Message");
        }
        finally
        {
            isSending = false;
        }
    }

    private static List<string> ParseNumbers(string value) => value.Split([',', ' ', '\r', '\n', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.Ordinal).ToList();
}
