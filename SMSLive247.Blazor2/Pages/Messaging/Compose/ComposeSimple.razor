@using SMSLive247.Blazor2.Pages.Messaging.Compose.Modals
@using SMSLive247.Blazor2.Pages.Messaging.Compose.Common

@if (model is null)
{
    <div class="rounded-xl border border-slate-200 bg-white p-8 text-sm text-slate-500">Loading compose options...</div>
}
else
{
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <!-- Main Column (col-lg-8) -->
        <div class="flex flex-col gap-6 lg:col-span-2">

            <!-- Recipients Card -->
            <Card HeaderText="Select Recipients">
                <HeaderRight>
                    <span class="bg-brand-50 rounded px-2.5 py-1 text-xs text-slate-500">
                        Total Recipients: @model.CountRecipients().ToString("N0")
                    </span>
                </HeaderRight>
                <ChildContent>
                    <RecipientList Caption="Raw Numbers" Recipients="model.Numbers"
                                   OnClick="() => rawNumbersModal.Show(model.Numbers)">
                        <Button Text="Paste..."
                                Icon="Icon.IconStyle.PenSquare"
                                Style="Button.ButtonStyle.Secondary"
                                OnClick="() => rawNumbersModal.Show(model.Numbers)"
                                CssClass="w-[160px]">
                        </Button>
                        <p class="mt-1 text-slate-500">
                            Type or paste your recipients phone numbers.
                        </p>
                    </RecipientList>

                    <RecipientList Caption="From Contacts" Recipients="model.Contacts"
                                   OnClick="() => contactsModal.Show(model.Contacts)">
                        <Button Text="Contacts..."
                                Icon="Icon.IconStyle.Users"
                                Style="Button.ButtonStyle.Secondary"
                                OnClick="() => contactsModal.Show(model.Contacts)"
                                CssClass="w-[160px]">
                        </Button>
                        <p class="mt-1 text-slate-500">
                            Select numbers from your Phonebook.
                        </p>
                    </RecipientList>

                    <RecipientList Caption="From Bulk Files" Recipients="model.BatchFiles"
                                   OnClick="() => bulkfilesModal.Show(model.BatchFiles)">
                        <Button Text="Bulk Files..."
                                Icon="Icon.IconStyle.FileText"
                                Style="Button.ButtonStyle.Secondary"
                                OnClick="() => bulkfilesModal.Show(model.BatchFiles)"
                                CssClass="w-[160px]">
                        </Button>
                        <p class="mt-1 text-slate-500">
                            Include your Batch Files numbers.
                        </p>
                    </RecipientList>

                </ChildContent>
            </Card>

            <!-- Message Card -->
            <Card HeaderText="Type your Message here">
                <HeaderRight>
                    <span class="bg-brand-50 rounded px-2.5 py-1 text-xs text-slate-500">
                        @model.CounterText()
                    </span>
                </HeaderRight>
                <ChildContent>
                    <textarea @bind="model.MessageText" @bind:event="oninput" 
                              placeholder="Type your message here..."
                              maxlength="918" rows="8"
                              class="w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-brand-500 focus:ring-brand-100 focus:ring-2">
                    </textarea>

                    <div class="mt-1 flex items-center justify-between">
                        <span class="text-sm text-slate-500">Messages longer than 160 characters are charged per page.</span>
                        @if (!string.IsNullOrWhiteSpace(model.MessageText))
                        {
                            <button type="button" class="flex items-center gap-1 text-sm font-medium text-red-500 hover:text-red-600" @onclick="() => model.ClearMessage()">
                                <Icon Style="Icon.IconStyle.Close" CssClass="text-xs" /> Clear
                            </button>
                        }
                    </div>
                </ChildContent>
            </Card>
        </div>

        <!-- Side Column (col-lg-4) -->
        <div class="lg:col-span-1">
            <div class="sticky top-6 flex flex-col gap-6">
                <!-- Sender ID Card -->
                <SenderIdCard Model="@model" SenderIDChanged="SenderIdChanged"></SenderIdCard>
                <!-- Schedule Card -->
                <SchedulerCard Model="@model" OnSubmit="SendMessageCore"></SchedulerCard>
            </div>                
        </div>
    </div>
}

<SelectContacts     @ref="contactsModal"    OnSelected="(items) => model?.UpdateContacts(items)" />
<SelectRawNumbers   @ref="rawNumbersModal"  OnSelected="(items) => model?.UpdateNumbers(items)" CountryCode="234" />
<SelectBulkfiles    @ref="bulkfilesModal"   OnSelected="(items) => model?.UpdateBulkfiles(items)" />

@code {
    private SelectContacts contactsModal = new();
    private SelectBulkfiles bulkfilesModal = new();
    private SelectRawNumbers rawNumbersModal = new();
    private ComposeSimpleModel? model;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = apiClient.SenderIdListAsync(1, 500, null);
            var t2 = apiClient.BatchFileListAsync();
            var t3 = apiClient.ContactListAsync();

            await Task.WhenAll(t1, t2, t3);

            model = new(t1.Result.Result, t3.Result.Result, t2.Result.Result);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
    }

    private async Task SenderIdChanged(string senderId)
    {
        StateHasChanged();
    }

    private async Task SendMessageCore(DateTimeOffset? deliveryTime)
    {
        if (model is null)
        {
            await alert.Error("model should not be null");
            return;
        }

        try
        {
            model.IsBusy = true;

            if (string.IsNullOrWhiteSpace(model.SenderID))
                throw new Exception("Choose an approved sender ID.");

            if (string.IsNullOrWhiteSpace(model.MessageText))
                throw new Exception("Enter a message.");

            if (model.CountRecipients() == 0)
                throw new Exception("Add recipients");

            var request = model.CreateRequest();
            var result = await apiClient.SmsBatchCreateAsync(request);

            await alert.Success(deliveryTime.HasValue
                ? "Your message has been scheduled."
                : "Your message is being sent."
                , "Message Created");
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Unable to Send Message");
        }
        finally
        {
            model.IsBusy = false;
        }
    }
}
