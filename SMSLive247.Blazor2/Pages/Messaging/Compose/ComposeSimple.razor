@using SMSLive247.Blazor.Pages.Messaging.Compose.Simple
@using SMSLive247.Blazor.Pages.Messaging.Compose.Common

<Loading NullCheckObject="model" Message="Loading compose options...">
    @{
        ComposeSimpleModel context = model ?? throw new ArgumentNullException(nameof(model));
    }
    
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <!-- Main Column (col-lg-8) -->
        <div class="flex flex-col gap-6 lg:col-span-2">

            <!-- Recipients Card -->
            <Card HeaderText="Select Recipients">
                <HeaderRight>
                    <span class="rounded bg-brand-50 px-2.5 py-1 text-xs text-slate-500">
                        Total Recipients: @context.CountRecipients().ToString("N0")
                    </span>
                </HeaderRight>
                <ChildContent>
                    <RecipientList Caption="Raw Numbers" Recipients="context.Numbers"
                                   OnClick="() => rawNumbersModal.Show(context.Numbers)">
                        <Button Text="Paste..."
                                Icon="Icon.IconStyle.PenSquare"
                                Style="ColorStyle.Secondary"
                                OnClick="() => rawNumbersModal.Show(context.Numbers)"
                                CssClass="w-[160px]">
                        </Button>
                        <p class="mt-1 text-slate-500">
                            Type or paste your recipients phone numbers.
                        </p>
                    </RecipientList>

                    <RecipientList Caption="From Contacts" Recipients="context.Contacts"
                                   OnClick="() => contactsModal.Show(context.Contacts)">
                        <Button Text="Contacts..."
                                Icon="Icon.IconStyle.Users"
                                Style="ColorStyle.Secondary"
                                OnClick="() => contactsModal.Show(context.Contacts)"
                                CssClass="w-[160px]">
                        </Button>
                        <p class="mt-1 text-slate-500">
                            Select numbers from your Phonebook.
                        </p>
                    </RecipientList>

                    <RecipientList Caption="From Bulk Files" Recipients="context.BatchFiles"
                                   OnClick="() => bulkfilesModal.Show(context.BatchFiles)">
                        <Button Text="Bulk Files..."
                                Icon="Icon.IconStyle.FileText"
                                Style="ColorStyle.Secondary"
                                OnClick="() => bulkfilesModal.Show(context.BatchFiles)"
                                CssClass="w-[160px]">
                        </Button>
                        <p class="mt-1 text-slate-500">
                            Include your Batch Files numbers.
                        </p>
                    </RecipientList>

                </ChildContent>
            </Card>

            <!-- Message Card -->
            <Card HeaderText="Type your Message here">
                <HeaderRight>
                    <span class="rounded bg-brand-50 px-2.5 py-1 text-xs text-slate-500">
                        @context.CounterText()
                    </span>
                </HeaderRight>
                <ChildContent>
                    <FormInput Multiline="8"
                               TValue="string"
                               PlaceHolder="Type your message here..."
                               maxlength="918"
                               @bind-Value="context.MessageText" />

                    <div class="mt-1 flex items-center justify-between">
                        <span class="text-sm text-slate-500">Messages longer than 160 characters are charged per page.</span>
                        @if (!string.IsNullOrWhiteSpace(context.MessageText))
                        {
                            <button class="flex items-center gap-1 text-sm font-medium text-red-500 hover:text-red-600"
                                    type="button" @onclick="() => context.ClearMessage()">
                                <Icon Style="Icon.IconStyle.Close" CssClass="text-xs" /> Clear
                            </button>
                        }
                    </div>
                </ChildContent>
            </Card>
        </div>

        <!-- Side Column (col-lg-4) -->
        <div class="lg:col-span-1">
            <div class="sticky top-6 flex flex-col gap-6">
                <SenderIdCard Model="@model" OnChanged="(id) => StateHasChanged()" />
                <SchedulerCard Model="@model" />
                <SubmitCard Model="@model" ApiSubmit="apiClient.SmsBatchCreateAsync" />
            </div>
        </div>
    </div>
</Loading>

<SelectContacts     @ref="contactsModal"    OnSelected="(items) => model?.UpdateContacts(items)" />
<SelectBulkfiles    @ref="bulkfilesModal"   OnSelected="(items) => model?.UpdateBulkfiles(items)" />
<SelectRawNumbers   @ref="rawNumbersModal"  OnSelected="(items) => model?.UpdateNumbers(items)" CountryCode="State.Account.CountryCode" />

@code {
    [CascadingParameter(Name = "MainAccount")] public required AccountState State { get; set; }

    private SelectContacts contactsModal = new();
    private SelectBulkfiles bulkfilesModal = new();
    private SelectRawNumbers rawNumbersModal = new();
    private ComposeSimpleModel? model;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = apiClient.SenderIdListAsync(1, 500);
            var t2 = apiClient.BatchFileListAsync();
            var t3 = apiClient.ContactListAsync();

            await Task.WhenAll(t1, t2, t3);

            model = new(t1.Result.Result, t3.Result.Result, t2.Result.Result);
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"An error occurred while initializing the compose page. {ex.Message}");
        }
    }
}
