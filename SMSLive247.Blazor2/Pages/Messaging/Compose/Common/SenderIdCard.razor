@typeparam TRequest

<Card HeaderText="From">
    <div class="flex rounded-lg border border-slate-300
        bg-white shadow-sm focus-within:border-brand-500 focus-within:ring-4 focus-within:ring-brand-500/30">
        <div class="flex w-10 items-center justify-center rounded-l-lg bg-slate-50 text-slate-400">
            <Icon Style="Icon.IconStyle.User" CssClass="text-lg" />
        </div>
        <div class="w-full rounded-r-lg sm:max-w-xs">
            @{
                var senderIds = Model.SenderIds;
                var approved  = senderIds.Where(x => x.Status == "APPROVED").ToList();
                var others    = senderIds.Where(x => x.Status != "APPROVED").ToList();
            }
            <FormSelect TValue="string" 
                        Required="true" 
                        IsEmbedded="true"
                        class="text-slate-900 dark:text-slate-100"
                        @bind-Value="Model.SenderId" 
                        @bind-Value:after="HandleChange"
                        IconStyle="Icon.IconStyle.ChevronDown" >
                <option value="" class="bg-white text-slate-900 dark:bg-slate-800 dark:text-slate-100">-Select Sender ID-</option>
                @if (approved.Count > 0)
                {
                    <optgroup label="Approved" class="bg-white text-slate-900 dark:bg-slate-800 dark:text-slate-100">
                        @foreach (var item in approved)
                        {
                            <option value="@item.SenderID" class="bg-white text-slate-900 dark:bg-slate-800 dark:text-slate-100">@item.SenderID</option>
                        }
                    </optgroup>
                }
                @if (others.Count > 0)
                {
                    <optgroup label="Pending/Rejected" class="bg-white text-slate-900 dark:bg-slate-800 dark:text-slate-100">
                        @foreach (var item in others)
                        {
                            <option value="@item.SenderID" disabled class="bg-white text-slate-900 dark:bg-slate-800 dark:text-slate-100">@item.SenderID</option>
                        }
                    </optgroup>
                }
            </FormSelect>
        </div>
    </div>
    <div class="mt-2 text-sm">
        <a href="@Const.Routes.Messaging.SenderIds" class="text-brand-500 hover:underline">
            Click here to request for SenderIDs
        </a>
    </div>
</Card>

@code {
    [Parameter, EditorRequired] public required BaseComposeModel<TRequest> Model { get; set; }
    [Parameter, EditorRequired] public required EventCallback<string> OnChanged { get; set; } 

    public async Task HandleChange()
    {
        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync(Model.SenderId);
    }
}
