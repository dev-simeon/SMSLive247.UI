@typeparam TRequest

<Card HeaderText="When to send">
    <div class="flex flex-col gap-3">
        <label class="group flex cursor-pointer items-center gap-3">
            <input type="radio" name="@radioGroup"
                   class="size-4 border-slate-300 text-brand-600 focus:ring-brand-500"
                   checked="@(!Model.DeliveryTime.HasValue)" @onchange="() => Model.DeliveryTime = null" />
            <span class="text-slate-500 group-hover:text-brand-600">
                Send Immediately
            </span>
        </label>
        <label class="group flex cursor-pointer items-center gap-3">
            <input type="radio" name="@radioGroup"
                   class="size-4 border-slate-300 text-brand-600 focus:ring-brand-500"
                   checked="@Model.DeliveryTime.HasValue" @onchange="() => Model.DeliveryTime = DateTime.Now" />
            <span class="text-slate-500 group-hover:text-brand-600">
                Schedule for Later
            </span>
        </label>
    </div>

    @if (Model.DeliveryTime.HasValue)
    {
        <div class="animate-in slide-in-from-top-2 pt-2">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-slate-600">Send Later at</span>
                @* <button type="button" @onclick="() => nav.NavigateTo(Const.Routes.Account.Profile)"
                        class="flex items-center gap-1 text-[10px] font-bold text-brand-600 hover:text-brand-700 uppercase">
                    <Icon Style="Icon.IconStyle.User" CssClass="text-xs" /> Change
                </button> *@
            </div>
            <div class="flex items-center">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-l-lg border-y border-l border-slate-200 bg-slate-50 text-slate-400">
                    <Icon Style="Icon.IconStyle.Clock" CssClass="text-base" />
                </div>
                <input type="datetime-local" @bind="Model.DeliveryTime"
                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                       class="w-full rounded-r-lg border border-slate-200 bg-white px-3 py-2 text-slate-900 outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500" />
            </div>
            <div class="mt-2 text-sm text-slate-500">Your time zone is: @timeZoneString </div>
        </div>
    }
</Card>

@code {
    [Parameter, EditorRequired] public required BaseComposeModel<TRequest> Model { get; set; }

    private readonly string radioGroup = $"r-{Guid.NewGuid():N}";
    private readonly string timeZoneString = " West/Central Africa GMT +1";
}
