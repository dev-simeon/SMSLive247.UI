<span class="inline-flex max-w-full shrink-0 items-center gap-1.5 rounded-lg border border-brand-100 bg-brand-50 px-3 py-1.5 text-sm font-medium text-brand-700 shadow-sm">
    @if (LeadingIcon.HasValue)
    {
        <Icon Style="LeadingIcon.Value" CssClass="text-sm leading-none" />
    }
    <span class="max-w-60 truncate">@Label</span>
    <button type="button"
            title="Remove"
            class="rounded p-0.5 text-brand-500 transition-colors hover:bg-brand-100 hover:text-brand-700"
            @onclick="OnRemove">
        <Icon Style="Icon.IconStyle.Close" CssClass="text-sm leading-none" />
    </button>
</span>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public Icon.IconStyle? LeadingIcon { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnRemove { get; set; }
}
