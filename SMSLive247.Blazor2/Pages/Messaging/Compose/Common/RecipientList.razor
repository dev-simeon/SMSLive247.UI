@if (Selected.Any())
{
    @* <div class="mb-0 flex gap-4">
        <div class="mt-3 flex cursor-grab flex-wrap items-center gap-2 rounded-lg border border-slate-100 bg-slate-50 p-3">
            @foreach (var item in Selected)
            {
                <RecipientChip Label="@item.Name" LeadingIcon="Icon.IconStyle.Users" OnRemove="() => RemoveItem(item.Key)" />
            }
        </div>
    </div> *@


    <div class="mb-3 rounded-lg border bg-sky-100 shadow-sm">
        <div class="cursor-pointer p-4" @onclick="OnClick">
            <div class="flex items-center justify-between">
                <div>
                    <h6 class="mb-2 text-base font-medium">
                        @Caption [@Selected.Sum(x => x.Count) /
                        @Recipients.Sum(x => x.Count)]
                    </h6>
                </div>
                <div>
                    <Icon Style="Icon.IconStyle.Trash" title="Delete All" CssStyle="font-weight: 300;" />
                    <Icon Style="@ButtonIcon" title="Edit Selection" CssStyle="font-weight: 300;" />
                </div>
            </div>
            @foreach (var item in Selected)
            {
                <span class="mr-1 inline-block rounded-md bg-sky-700 px-2 py-0.5 text-xs font-medium text-white">
                    @item.Name
                </span>
            }
        </div>
    </div>
}
else
{
    <div class="mb-2 flex gap-4">
        <Button Text="@ButtonText"
                Icon="@ButtonIcon"
                Style="@ButtonStyle"
                OnClick="@OnClick"
                CssClass="w-[160px]" />
        <p class="mt-1 text-slate-500">@Description</p>
    </div>
}

@code {
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter, EditorRequired] public string? Caption { get; set; }
    [Parameter, EditorRequired] public string? ButtonText { get; set; }
    [Parameter, EditorRequired] public string? Description { get; set; }
    [Parameter, EditorRequired] public Icon.IconStyle ButtonIcon { get; set; }
    [Parameter, EditorRequired] public Button.ButtonStyle ButtonStyle { get; set; } = Button.ButtonStyle.Secondary;
    [Parameter, EditorRequired] public List<ContactModel> Recipients { get; set; } = [];

    public List<ContactModel> Selected => Recipients.Where(x => x.Selected).ToList();

    public void RemoveItem(string key)
    {
        var item = Recipients.FirstOrDefault(x => x.Key == key);
        if (item != null)
        {
            item.Selected = false;
            StateHasChanged();
        }
    }
}
