@if (Selected.Any())
{
    @* <div class="mb-0 flex gap-4">
        <div class="mt-3 flex cursor-grab flex-wrap items-center gap-2 rounded-lg border border-slate-100 bg-slate-50 p-3">
            @foreach (var item in Selected)
            {
                <RecipientChip Label="@item.Name" LeadingIcon="Icon.IconStyle.Users" OnRemove="() => RemoveItem(item.Key)" />
            }
        </div>
    </div> *@
    <div class="mb-3 rounded-lg border border-slate-200 bg-slate-100 shadow-md">
        <div class="cursor-pointer p-4" @onclick="OnClick">
            <div class="flex items-center justify-between">
                <div>
                    <h6 class="mb-2 text-base font-medium">
                        @Caption [@Selected.Sum(x => x.Count) /
                        @Recipients.Sum(x => x.Count)]
                    </h6>
                </div>
                <div>
                    <Icon Style="Icon.IconStyle.Trash" CssStyle="font-weight: 300;" title="Delete All" />
                    <Icon Style="Icon.IconStyle.PenSquare" CssStyle="font-weight: 300;" title="Edit Selection" />
                </div>
            </div>
            @foreach (var item in Selected)
            {
                <span class="mr-1 inline-block rounded-md bg-green-700 px-2 py-0.5 text-xs font-medium text-white">
                    @item.Name @* <i class="h-full w-9 bg-red-500">x</i> *@
                </span>
            }
        </div>
    </div>
}
else
{
    <div class="mb-2 flex gap-4">
        @ChildContent
    </div>
}

@code {
    [Parameter] public string? Caption { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public List<ContactModel> Recipients { get; set; } = [];
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    public List<ContactModel> Selected => Recipients.Where(x => x.Selected).ToList();

    public void RemoveItem(string key)
    {
        var item = Recipients.FirstOrDefault(x => x.Key == key);
        if (item != null)
        {
            item.Selected = false;
            StateHasChanged();
        }
    }
}
