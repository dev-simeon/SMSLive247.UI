@page "/messaging/compose/customized"
@using System.Text
@using System.Text.RegularExpressions
@using SMSLive247.Blazor2.Pages.Messaging.Compose.Modals
@using SMSLive247.Blazor2.Pages.Messaging.Compose.Common
@using SMSLive247.Blazor2.Pages.ViewModels

@if (isLoading)
{
    <div class="rounded-xl border border-slate-200 bg-white p-8 text-sm text-slate-500">Loading compose options...</div>
}
else
{
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <!-- Main Column (col-lg-8) -->
        <div class="flex flex-col gap-6 lg:col-span-2">
            
            <!-- STEP 1 OF 3: CHOOSE SHEET -->
            @if (currentStep == 1)
            {
                <Card HeaderText="Step 1 of 3: Choose Sheet">
                    <ChildContent>
                        <div class="space-y-6">
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Which sheet are we working with?</h3>
                                <p class="mt-1 text-sm text-slate-500">Pick a sheet you've used before, or upload a new one to get started.</p>
                            </div>

                            <!-- File Selection Control (70% max-width, compact padding, clicking inside or button opens modal) -->
                            <div class="w-full space-y-2 lg:max-w-[70%]">
                                <label class="block text-sm font-medium text-slate-700">Data Sheet</label>
                                <div class="flex items-center rounded-xl border border-slate-200 bg-white p-1.5 shadow-sm transition-all focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20 hover:border-brand-300">
                                    <div class="flex min-w-0 flex-1 cursor-pointer items-center px-3 py-1" @onclick="OpenTemplateFiles">
                                        <div class="min-w-0 flex-1">
                                            @if (hasDataSource)
                                            {
                                                <p class="truncate text-sm font-semibold text-slate-900">@CurrentFileName</p>
                                                <p class="font-mono text-[11px] text-slate-500">
                                                    @CurrentFileRowCount.ToString("N0") records &bull; @headers.Count columns loaded
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="text-sm text-slate-400">No sheet selected yet</p>
                                                <p class="text-xs text-slate-400">Click Browse on the right to select or upload a CSV / Excel file</p>
                                            }
                                        </div>
                                    </div>
                                    <button type="button" 
                                            @onclick="OpenTemplateFiles" 
                                            class="flex shrink-0 items-center gap-1.5 rounded-lg bg-brand-500 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-brand-600">
                                        <Icon Style="Icon.IconStyle.PlusCircle" CssClass="text-sm" />
                                        <span>Browse Sheets...</span>
                                    </button>
                                </div>
                                <p class="px-1 text-xs text-slate-400">
                                    Supported formats: .CSV, .XLS, .XLSX, .XLX (Max 20 MB).
                                </p>
                            </div>

                            <!-- Footer prompt to advance to Step 2 -->
                            <div class="mt-8 flex flex-col items-center justify-between gap-4 rounded-xl border border-slate-200/80 bg-slate-50 p-4 sm:flex-row">
                                <div class="flex items-center gap-2.5 text-sm text-slate-600">
                                    <Icon Style="@(hasDataSource ? Icon.IconStyle.CheckCircle : Icon.IconStyle.Info)" 
                                          CssClass="@(hasDataSource ? "text-emerald-500 text-lg shrink-0" : "text-slate-400 text-lg shrink-0")" />
                                    <span>@(hasDataSource ? "Sheet selected! Proceed to choose the phone number column." : "Please select or upload a sheet to proceed.")</span>
                                </div>
                                <Button Text="Continue to Phone Column" 
                                        Icon="Icon.IconStyle.ChevronRight" 
                                        IsDisabled="@(!hasDataSource)" 
                                        OnClick="() => currentStep = 2" />
                            </div>
                        </div>
                    </ChildContent>
                </Card>
            }

            <!-- STEP 2 OF 3: SELECT PHONE COLUMN -->
            @if (currentStep == 2)
            {
                <Card HeaderText="Step 2 of 3: Select Phone Column">
                    <HeaderRight>
                        <button type="button" @onclick="() => currentStep = 1" class="text-sm font-medium text-slate-500 hover:text-brand-500 hover:underline">
                            &larr; Back to Choose Sheet
                        </button>
                    </HeaderRight>
                    <ChildContent>
                        <div class="space-y-6">
                            <!-- Sheet summary info -->
                            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3.5">
                                <div class="flex min-w-0 items-center gap-3">
                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700">
                                        <Icon Style="Icon.IconStyle.FileSpreadsheet" CssClass="text-lg" />
                                    </div>
                                    <div class="min-w-0">
                                        <p class="truncate text-sm font-bold text-slate-900">@CurrentFileName</p>
                                        <p class="mt-0.5 font-mono text-xs text-slate-500">
                                            @CurrentFileRowCount.ToString("N0") rows &bull; @headers.Count columns &bull; showing first @previewRows.Count
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Phone Column Active Indicator Banner -->
                            <div class="flex flex-col items-start justify-between gap-2 rounded-lg border border-blue-200 bg-blue-50/80 px-4 py-2.5 text-xs text-brand-900 sm:flex-row sm:items-center">
                                <div class="flex items-center gap-2 font-medium">
                                    <Icon Style="Icon.IconStyle.Phone" CssClass="shrink-0 text-sm text-brand-600" />
                                    <span>
                                        Recipient Phone Column: <strong class="font-bold text-slate-900">Column @GetColumnLetter(phoneColumn) &mdash; "@(phoneColumn.HasValue && phoneColumn >= 0 && phoneColumn < headers.Count ? headers[phoneColumn.Value] : "None")"</strong>
                                    </span>
                                </div>
                                <span class="text-[11px] text-brand-700 italic">
                                    Click any column header below to change
                                </span>
                            </div>

                            <!-- Interactive Spreadsheet Preview Table -->
                            @if (previewRows.Count > 0)
                            {
                                <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm">
                                    <table class="w-full border-collapse text-left text-sm text-slate-600">
                                        <thead>
                                            <!-- Letter row: A, B, C... -->
                                            <tr class="border-b border-slate-200 bg-slate-100/80 font-mono text-[11px] text-slate-400">
                                                <th class="w-12 border-r border-slate-200 bg-slate-200/60 px-3 py-1.5 text-center">#</th>
                                                @for (var i = 0; i < headers.Count; i++)
                                                {
                                                    var isSelectedCol = phoneColumn == i;
                                                    <th class="border-r border-slate-200 px-4 py-1.5 text-center font-bold last:border-r-0 @(isSelectedCol ? "bg-brand-100 text-brand-700" : "")">
                                                        @GetColumnLetter(i)
                                                    </th>
                                                }
                                            </tr>
                                            <!-- Column names header row (Clickable) -->
                                            <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-700">
                                                <th class="w-12 border-r border-slate-200 bg-slate-100 px-3 py-2.5 text-center text-slate-400"></th>
                                                @for (var i = 0; i < headers.Count; i++)
                                                {
                                                    var colIndex = i;
                                                    var isSelectedCol = phoneColumn == colIndex;
                                                    <th @onclick="() => SetPhoneColumn(colIndex)"
                                                        title="Click to select '@headers[colIndex]' as the recipient phone number column"
                                                        class="px-4 py-2.5 border-r border-slate-200 last:border-r-0 cursor-pointer select-none transition-colors @(isSelectedCol ? "bg-brand-50 text-brand-700 ring-2 ring-inset ring-brand-500" : "hover:bg-slate-100 text-slate-700")">
                                                        <div class="flex items-center justify-between gap-2">
                                                            <span class="truncate">@headers[colIndex]</span>
                                                            @if (isSelectedCol)
                                                            {
                                                                <span class="flex items-center gap-1 rounded bg-brand-500 px-1.5 py-0.5 font-bold tracking-wider text-[10px] text-white uppercase">
                                                                    <Icon Style="Icon.IconStyle.Phone" CssClass="text-[10px]" /> Recipient
                                                                </span>
                                                            }
                                                        </div>
                                                    </th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 bg-white font-sans">
                                            @for (var r = 0; r < previewRows.Count; r++)
                                            {
                                                var row = previewRows[r];
                                                <tr class="hover:bg-slate-50/70">
                                                    <td class="w-12 border-r border-slate-200 bg-slate-50/80 px-3 py-2 text-center font-mono text-xs text-slate-400">
                                                        @(r + 1)
                                                    </td>
                                                    @for (var i = 0; i < headers.Count; i++)
                                                    {
                                                        var isSelectedCol = phoneColumn == i;
                                                        <td class="max-w-[200px] truncate border-r border-slate-100 px-4 py-2 last:border-r-0 @(isSelectedCol ? "bg-brand-50/30 font-medium text-slate-900" : "")"
                                                            title="@row.GetValueOrDefault(headers[i], "")">
                                                            @row.GetValueOrDefault(headers[i], "")
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <!-- Footer prompt to advance to Step 3 -->
                            <div class="mt-8 flex flex-col items-center justify-between gap-4 rounded-xl border border-slate-200/80 bg-slate-50 p-4 sm:flex-row">
                                <div class="flex items-center gap-2.5 text-sm text-slate-600">
                                    <Icon Style="Icon.IconStyle.CheckCircle" CssClass="shrink-0 text-lg text-emerald-500" />
                                    <span class="font-medium">Phone column confirmed! Ready to compose and personalize your template message.</span>
                                </div>
                                <Button Text="Continue to Compose Message" 
                                        Icon="Icon.IconStyle.ChevronRight" 
                                        IsDisabled="@(!phoneColumn.HasValue)" 
                                        OnClick="() => currentStep = 3" />
                            </div>
                        </div>
                    </ChildContent>
                </Card>
            }

            <!-- STEP 3 OF 3: COMPOSE MESSAGE -->
            @if (currentStep == 3)
            {
                <Card HeaderText="Step 3 of 3: Compose Message">
                    <HeaderRight>
                        <button type="button" @onclick="() => currentStep = 2" class="text-sm font-medium text-slate-500 hover:text-brand-500 hover:underline">
                            &larr; Back to Phone Column
                        </button>
                    </HeaderRight>
                    <ChildContent>
                        <div class="space-y-4">
                            <!-- Available Fields right above the message box -->
                            @if (headers.Any())
                            {
                                <div>
                                    <div class="mb-1.5 flex items-center justify-between">
                                        <span class="text-xs font-bold tracking-wider text-slate-600 uppercase">Available Fields</span>
                                        <span class="text-[11px] text-slate-400">Click a field below to insert it into your message</span>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2.5">
                                        @foreach (var header in headers)
                                        {
                                            <button type="button" 
                                                    @onclick="() => AddPlaceholder(header)" 
                                                    class="inline-flex w-auto items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-mono font-medium text-slate-700 shadow-sm hover:border-brand-400 hover:bg-brand-50 hover:text-brand-700 transition-all">
                                                <span>@Placeholder(header)</span>
                                                <Icon Style="Icon.IconStyle.PlusCircle" CssClass="text-xs text-brand-500" />
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Full-width Message Template Editor -->
                            <div class="w-full">
                                <MessageTemplateEditor @ref="templateEditor"
                                                       @bind-Value="message"
                                                       MaxWidthClass="w-full max-w-full"
                                                       Chars="message.Length"
                                                       Pages="messageParts"
                                                       Max="160"
                                                       Remaining="160 - message.Length" />
                            </div>
                        </div>
                    </ChildContent>
                </Card>

                <!-- Borderless Preview Messages Card -->
                <Card HeaderText="Preview Messages">
                    <ChildContent>
                        @if (!previewRows.Any() || string.IsNullOrWhiteSpace(message))
                        {
                            <p class="py-6 text-center text-sm text-slate-400">Compose a message above to preview personalized messages with data from your sheet.</p>
                        }
                        else
                        {
                            <div class="overflow-x-auto">
                                <table class="w-full border-collapse text-left text-sm text-slate-600">
                                    <thead>
                                        <tr class="border-b border-slate-100 font-bold tracking-wider text-[11px] text-slate-400 uppercase">
                                            <th class="w-12 px-3 py-2.5 text-center">#</th>
                                            <th class="w-48 px-3 py-2.5">Phone Number</th>
                                            <th class="px-3 py-2.5">Message</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y-0 font-sans">
                                        @foreach (var row in previewRows.Take(3).Select((value, index) => new { value, index }))
                                        {
                                            <tr class="transition-colors hover:bg-slate-50/70">
                                                <td class="px-3 py-2.5 text-center text-xs font-semibold text-slate-400">@(row.index + 1)</td>
                                                <td class="px-3 py-2.5 font-mono text-xs font-medium text-brand-600">@PhoneFor(row.value)</td>
                                                <td class="px-3 py-2.5 text-xs break-words whitespace-pre-wrap text-slate-700">@ResolvePlaceholders(message, row.value)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </ChildContent>
                </Card>
            }
        </div>

        <!-- Side Column (col-lg-4) -->
        <div class="lg:col-span-1">
            <div class="sticky top-6 flex flex-col gap-6">
                <!-- Sender ID Card -->
                <SenderIdCard Model="@model" @ref="senderIdCard"></SenderIdCard>
                
                <!-- Schedule Card -->
                <SchedulerCard Model="@model" IsSending="isSending" OnSubmit="SendMessageCore"></SchedulerCard>
            </div>                
        </div>
    </div>
}

<SelectTemplateFileModal @ref="templateFilesModal" 
                        Files="model?.BatchCsvFiles" 
                        OnSelected="SelectHistoryFile"
                        OnFilesUpdated="OnFilesListUpdated" />

@code {
    private const long MaxFileBytes = 10 * 1024 * 1024;
    private readonly List<string> headers = [];
    private readonly List<Dictionary<string, string>> previewRows = [];
    private bool isLoading = true;
    private bool isSending;
    private int currentStep = 1;
    
    private ComposeTemplateModel? model;
    
    private string message = "";
    private int? phoneColumn;
    private BatchFileResponse? selectedExistingFile;
    private SelectTemplateFileModal templateFilesModal = new();
    private MessageTemplateEditor templateEditor;
    private SenderIdCard? senderIdCard;

    private bool hasDataSource => selectedExistingFile is not null;
    private int messageParts => string.IsNullOrEmpty(message) ? 0 : message.Length <= 160 ? 1 : (int)Math.Ceiling(message.Length / 153d);

    private string CurrentFileName => selectedExistingFile?.Description ?? "Selected Sheet";
    private long CurrentFileRowCount => selectedExistingFile?.TotalNumbers ?? (long)previewRows.Count;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var senderTask = apiClient.SenderIdListAsync(1, 500);
            var batchTask = apiClient.BatchFileListAsync();
            await Task.WhenAll(senderTask, batchTask);
            
            var senders = senderTask.Result.Result.Where(x => string.Equals(x.Status, "Approved", StringComparison.OrdinalIgnoreCase)).ToList();
            model = new ComposeTemplateModel(senders, batchTask.Result.Result);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Compose Message");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectHistoryFile(BatchFileResponse file)
    {
        try
        {
            var download = await apiClient.BatchFileDownloadAsync(file.BatchFileID);
            selectedExistingFile = file;
            await LoadCsvPreview(download.Stream, file.Description);
        }
        catch (Exception ex)
        {
            await alert.Error("The content for this file could not be loaded from storage: " + ex.Message, "File Unavailable");
        }
    }

    private void OnFilesListUpdated(List<BatchFileResponse> updatedFiles)
    {
        if (model != null)
        {
            model.UpdateBatchFiles(updatedFiles);
        }
    }

    private void OpenTemplateFiles() => templateFilesModal.Show(selectedExistingFile?.BatchFileID, model?.BatchCsvFiles);

    private void ClearSelection()
    {
        selectedExistingFile = null;
        headers.Clear();
        previewRows.Clear();
        phoneColumn = null;
    }

    private void SetPhoneColumn(int colIndex)
    {
        phoneColumn = colIndex;
    }

    private static string GetColumnLetter(int? index)
    {
        if (!index.HasValue || index.Value < 0) return "-";
        int i = index.Value;
        string columnLetter = "";
        while (i >= 0)
        {
            columnLetter = (char)('A' + (i % 26)) + columnLetter;
            i = (i / 26) - 1;
        }
        return columnLetter;
    }

    private async Task LoadCsvPreview(Stream stream, string fileName)
    {
        headers.Clear();
        previewRows.Clear();
        phoneColumn = null;

        if (string.IsNullOrWhiteSpace(fileName))
            return;

        using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true, leaveOpen: true);
        var firstLine = await reader.ReadLineAsync();
        if (string.IsNullOrWhiteSpace(firstLine)) return;

        headers.AddRange(ReadCsvLine(firstLine));
        string? line;
        while (previewRows.Count < 10 && (line = await reader.ReadLineAsync()) is not null)
        {
            var values = ReadCsvLine(line);
            if (values.Count == 0) continue;
            var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            for (var index = 0; index < headers.Count; index++) row[headers[index]] = index < values.Count ? values[index] : "";
            previewRows.Add(row);
        }
        phoneColumn = headers.FindIndex(x => x.Contains("phone", StringComparison.OrdinalIgnoreCase) || x.Contains("mobile", StringComparison.OrdinalIgnoreCase) || x.Contains("number", StringComparison.OrdinalIgnoreCase) || x.Contains("tel", StringComparison.OrdinalIgnoreCase));
        if (phoneColumn < 0 && headers.Count > 0) phoneColumn = 0;
    }

    private async Task AddPlaceholder(string header) 
    { 
        if (templateEditor != null)
        {
            await templateEditor.InsertPlaceholderAsync(header.Replace(" ", ""));
        }
    }
    
    private string Placeholder(string header) => $"{{{Regex.Replace(header, @"\s+", "")}}}";
    
    private string PhoneFor(Dictionary<string, string> row) => phoneColumn is int index && index >= 0 && index < headers.Count && row.TryGetValue(headers[index], out var number) ? number : "No phone number";

    private string ResolvePlaceholders(string value, Dictionary<string, string> row)
    {
        foreach (var header in headers)
            value = Regex.Replace(value, $@"\{{\s*{Regex.Escape(header.Replace(" ", ""))}\s*\}}", row.GetValueOrDefault(header, ""), RegexOptions.IgnoreCase);
        return value;
    }

    private async Task SendMessageCore(DateTimeOffset? scheduledDeliveryTime)
    {
        var senderId = model?.SenderID;
        if (string.IsNullOrWhiteSpace(senderId) || string.IsNullOrWhiteSpace(message) || !hasDataSource || !phoneColumn.HasValue)
        {
            await alert.Error("Choose an approved sender ID, a data source, recipient phone column, and message.", "Compose Message");
            return;
        }

        isSending = true;
        try
        {
            var fileId = selectedExistingFile?.BatchFileID;
            if (string.IsNullOrWhiteSpace(fileId)) throw new InvalidOperationException("The selected file could not be prepared.");

            await apiClient.SmsBatchCsvCreateAsync(new SmsBatchCsvRequest
            {
                SenderID = senderId,
                MessageText = message.Trim(),
                BatchFileID = fileId,
                PhoneNumberColumn = phoneColumn.Value,
                DeliveryTime = scheduledDeliveryTime
            });
            await alert.Success(scheduledDeliveryTime.HasValue ? "Your personalized messages have been scheduled." : "Your personalized messages are being processed.", "Message Created");
            
            // Reset
            message = "";
            selectedExistingFile = null;
            headers.Clear();
            previewRows.Clear();
            phoneColumn = null;
            currentStep = 1;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Unable to Send Message");
        }
        finally
        {
            isSending = false;
        }
    }

    private static List<string> ReadCsvLine(string line)
    {
        var fields = new List<string>();
        var builder = new StringBuilder();
        var inQuotes = false;
        for (var index = 0; index < line.Length; index++)
        {
            var character = line[index];
            if (character == '"')
            {
                if (inQuotes && index + 1 < line.Length && line[index + 1] == '"') { builder.Append(character); index++; }
                else inQuotes = !inQuotes;
            }
            else if (character == ',' && !inQuotes) { fields.Add(builder.ToString().Trim()); builder.Clear(); }
            else builder.Append(character);
        }
        fields.Add(builder.ToString().Trim());
        return fields;
    }
}