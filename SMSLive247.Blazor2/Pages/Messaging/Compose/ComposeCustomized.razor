@page "/messaging/compose/customized"
@using System.Text
@using System.Text.RegularExpressions
@using SMSLive247.Blazor2.Pages.Messaging.Compose.Modals
@using SMSLive247.Blazor2.Pages.Messaging.Contacts.Modals
@using SMSLive247.Blazor2.Pages.Messaging.Compose.Common
@using SMSLive247.Blazor2.Pages.ViewModels

@if (isLoading)
{
    <div class="rounded-xl border border-slate-200 bg-white p-8 text-sm text-slate-500">Loading compose options...</div>
}
else
{
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <!-- Main Column (col-lg-8) -->
        <div class="flex flex-col gap-6 lg:col-span-2">
            
            @if (currentStep == 1)
            {
                <Card HeaderText="Step 1: Choose Sheet">
                    <ChildContent>
                        <div class="space-y-6">
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Which sheet are we working with?</h3>
                                <p class="mt-1 text-sm text-slate-500">Pick a sheet you've used before, or upload a new one. We'll show you a preview so you can confirm it's the right data before moving on.</p>
                            </div>

                            @if (!hasDataSource)
                            {
                                <!-- Upload / Select Options -->
                                <div class="space-y-4">
                                    <div class="flex flex-col sm:flex-row items-center gap-3">
                                        <button type="button" @onclick="OpenTemplateFiles" class="flex flex-1 items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-4 text-sm font-semibold text-slate-700 shadow-sm hover:border-brand-500 hover:text-brand-600 hover:bg-slate-50 transition-all w-full">
                                            <Icon Style="Icon.IconStyle.PlusCircle" CssClass="text-xl text-brand-500" />
                                            <span>Select or Upload Sheet...</span>
                                        </button>
                                        <label class="flex items-center justify-center gap-2 cursor-pointer rounded-xl bg-brand-500 px-5 py-4 text-sm font-semibold text-white shadow-sm hover:bg-brand-600 transition-colors shrink-0 w-full sm:w-auto">
                                            <Icon Style="Icon.IconStyle.Download" CssClass="text-lg" />
                                            <span>Upload Directly</span>
                                            <InputFile class="hidden" accept=".csv,.xls,.xlsx,.xlx" OnChange="SelectUpload" />
                                        </label>
                                    </div>

                                    @if (recentFiles.Any())
                                    {
                                        <div class="pt-2">
                                            <h4 class="mb-3 text-xs font-bold tracking-wider text-slate-400 uppercase">Recently Used</h4>
                                            <div class="space-y-2">
                                                @foreach (var f in recentFiles)
                                                {
                                                    <div @onclick="() => SelectHistoryFile(f)" class="group flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50/70 p-3.5 cursor-pointer hover:border-brand-300 hover:bg-white transition-all shadow-sm">
                                                        <div class="flex items-center gap-3 min-w-0">
                                                            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 group-hover:bg-emerald-100 transition-colors">
                                                                <Icon Style="Icon.IconStyle.FileSpreadsheet" CssClass="text-lg" />
                                                            </div>
                                                            <div class="min-w-0">
                                                                <p class="truncate text-sm font-semibold text-slate-900 group-hover:text-brand-600">@f.Description</p>
                                                                <p class="text-xs text-slate-400 mt-0.5">
                                                                    <FormatDate DateTime="@f.DateCreated" /> &bull; @f.TotalNumbers.ToString("N0") rows
                                                                </p>
                                                            </div>
                                                        </div>
                                                        <div class="shrink-0 flex items-center gap-1 text-xs font-medium text-slate-400 group-hover:text-brand-600">
                                                            <span>Use sheet</span>
                                                            <Icon Style="Icon.IconStyle.ChevronRight" CssClass="text-sm" />
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Selected File Preview Section -->
                                <div class="space-y-4">
                                    <!-- Sheet summary header -->
                                    <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-4">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700">
                                                <Icon Style="Icon.IconStyle.FileSpreadsheet" CssClass="text-xl" />
                                            </div>
                                            <div class="min-w-0">
                                                <p class="truncate text-sm font-bold text-slate-900">@CurrentFileName</p>
                                                <p class="text-xs text-slate-500 font-mono mt-0.5">
                                                    @CurrentFileRowCount.ToString("N0") rows &bull; @headers.Count columns &bull; showing first @previewRows.Count
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <button type="button" @onclick="OpenTemplateFiles" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 shadow-sm hover:bg-slate-50">
                                                Change Sheet
                                            </button>
                                            <button type="button" @onclick="ClearSelection" class="p-1.5 text-slate-400 hover:text-red-500 transition-colors" title="Remove sheet">
                                                <Icon Style="Icon.IconStyle.Trash" CssClass="text-base" />
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Recipient Phone Column Banner -->
                                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 rounded-lg border border-blue-200 bg-blue-50/80 px-4 py-2.5 text-xs text-brand-900">
                                        <div class="flex items-center gap-2 font-medium">
                                            <Icon Style="Icon.IconStyle.Phone" CssClass="text-brand-600 text-sm shrink-0" />
                                            <span>
                                                Recipient Phone Column: <strong class="font-bold text-slate-900">Column @GetColumnLetter(phoneColumn) &mdash; "@(phoneColumn.HasValue && phoneColumn >= 0 && phoneColumn < headers.Count ? headers[phoneColumn.Value] : "None")"</strong>
                                            </span>
                                        </div>
                                        <span class="text-[11px] text-brand-700 italic">
                                            Click any column header below to change
                                        </span>
                                    </div>

                                    <!-- Spreadsheet Table Preview -->
                                    @if (previewRows.Count > 0)
                                    {
                                        <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm">
                                            <table class="w-full text-left text-sm text-slate-600 border-collapse">
                                                <thead>
                                                    <!-- Letter row: A, B, C... -->
                                                    <tr class="bg-slate-100/80 text-[11px] font-mono text-slate-400 border-b border-slate-200">
                                                        <th class="w-12 px-3 py-1.5 text-center bg-slate-200/60 border-r border-slate-200">#</th>
                                                        @for (var i = 0; i < headers.Count; i++)
                                                        {
                                                            var isSelectedCol = phoneColumn == i;
                                                            <th class="px-4 py-1.5 text-center font-bold border-r border-slate-200 last:border-r-0 @(isSelectedCol ? "bg-brand-100 text-brand-700" : "")">
                                                                @GetColumnLetter(i)
                                                            </th>
                                                        }
                                                    </tr>
                                                    <!-- Column names header row -->
                                                    <tr class="bg-slate-50 text-xs font-semibold text-slate-700 border-b border-slate-200">
                                                        <th class="w-12 px-3 py-2.5 text-center bg-slate-100 border-r border-slate-200 text-slate-400"></th>
                                                        @for (var i = 0; i < headers.Count; i++)
                                                        {
                                                            var colIndex = i;
                                                            var isSelectedCol = phoneColumn == colIndex;
                                                            <th @onclick="() => SetPhoneColumn(colIndex)"
                                                                title="Click to set '@headers[colIndex]' as recipient phone number column"
                                                                class="px-4 py-2.5 border-r border-slate-200 last:border-r-0 cursor-pointer select-none transition-colors @(isSelectedCol ? "bg-brand-50 text-brand-700 ring-2 ring-inset ring-brand-500" : "hover:bg-slate-100 text-slate-700")">
                                                                <div class="flex items-center justify-between gap-2">
                                                                    <span class="truncate">@headers[colIndex]</span>
                                                                    @if (isSelectedCol)
                                                                    {
                                                                        <span class="flex items-center gap-1 rounded bg-brand-500 px-1.5 py-0.5 text-[10px] font-bold text-white uppercase tracking-wider">
                                                                            <Icon Style="Icon.IconStyle.Phone" CssClass="text-[10px]" /> Recipient
                                                                        </span>
                                                                    }
                                                                </div>
                                                            </th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-100 bg-white font-sans">
                                                    @for (var r = 0; r < previewRows.Count; r++)
                                                    {
                                                        var row = previewRows[r];
                                                        <tr class="hover:bg-slate-50/70">
                                                            <td class="w-12 px-3 py-2 text-center text-xs font-mono text-slate-400 bg-slate-50/80 border-r border-slate-200">
                                                                @(r + 1)
                                                            </td>
                                                            @for (var i = 0; i < headers.Count; i++)
                                                            {
                                                                var isSelectedCol = phoneColumn == i;
                                                                <td class="px-4 py-2 truncate max-w-[200px] border-r border-slate-100 last:border-r-0 @(isSelectedCol ? "bg-brand-50/30 font-medium text-slate-900" : "")"
                                                                    title="@row.GetValueOrDefault(headers[i], "")">
                                                                    @row.GetValueOrDefault(headers[i], "")
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <p class="text-xs text-slate-400">Only a preview &mdash; the full sheet is used when you continue.</p>

                                    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 rounded-xl border border-slate-200/80 bg-slate-50 p-4">
                                        <div class="flex items-center gap-2.5 text-sm text-slate-600">
                                            <Icon Style="Icon.IconStyle.CheckCircle" CssClass="text-emerald-500 text-lg shrink-0" />
                                            <span class="font-medium">Looks right? Continue to compose and personalize your message.</span>
                                        </div>
                                        <Button Text="Continue to Compose" 
                                                Icon="Icon.IconStyle.ChevronRight" 
                                                Style="Button.ButtonStyle.Primary" 
                                                IsDisabled="@(!hasDataSource || phoneColumn == null)" 
                                                OnClick="() => currentStep = 2" />
                                    </div>
                                </div>
                            }
                        </div>
                    </ChildContent>
                </Card>
            }

            @if (currentStep == 2)
            {
                <Card HeaderText="Step 2: Compose Message">
                    <HeaderRight>
                        <button type="button" @onclick="() => currentStep = 1" class="text-sm font-medium text-slate-500 hover:text-brand-500 hover:underline">
                            &larr; Back to Data Source
                        </button>
                    </HeaderRight>
                    <ChildContent>
                        <div class="flex flex-col gap-6 xl:flex-row">
                            <div class="flex-1 min-w-0">
                                <MessageTemplateEditor @ref="templateEditor"
                                                       @bind-Value="message"
                                                       Chars="message.Length"
                                                       Pages="messageParts"
                                                       Max="160"
                                                       Remaining="160 - message.Length" />
                            </div>
                            <aside class="w-full shrink-0 overflow-hidden rounded-xl border border-slate-200 bg-white xl:w-72">
                                <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
                                    <span class="text-xs font-bold tracking-wider text-slate-600 uppercase">Available Fields</span>
                                    <p class="mt-1 text-[11px] text-slate-400">Click a field to add it to the message.</p>
                                </div>
                                <div class="max-h-64 space-y-2 overflow-y-auto p-3">
                                    @if (!headers.Any())
                                    {
                                        <p class="py-8 text-center text-xs text-slate-400">Choose a CSV file to see columns.</p>
                                    }
                                    @foreach (var header in headers)
                                    {
                                        <button type="button" @onclick="() => AddPlaceholder(header)" class="flex w-full items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-left text-sm font-mono text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                                            @Placeholder(header)
                                            <Icon Style="Icon.IconStyle.PlusCircle" CssClass="text-brand-500 text-base" />
                                        </button>
                                    }
                                </div>
                            </aside>
                        </div>
                    </ChildContent>
                </Card>

                <Card HeaderText="Preview Messages">
                    <ChildContent>
                        @if (!previewRows.Any() || string.IsNullOrWhiteSpace(message))
                        {
                            <p class="py-10 text-center text-sm text-slate-500">Choose a CSV file and compose a message to preview your personalized messages.</p>
                        }
                        else
                        {
                            <div class="overflow-x-auto rounded-xl border border-slate-200">
                                <table class="w-full text-left text-sm text-slate-500">
                                    <thead class="bg-slate-50 text-xs font-bold tracking-wider text-slate-600 uppercase">
                                        <tr>
                                            <th class="px-4 py-3 w-16">#</th>
                                            <th class="px-4 py-3 w-48">Phone Number</th>
                                            <th class="px-4 py-3">Message</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-200 bg-white">
                                        @foreach (var row in previewRows.Take(3).Select((value, index) => new { value, index }))
                                        {
                                            <tr>
                                                <td class="px-4 py-3 font-semibold text-slate-400">@(row.index + 1)</td>
                                                <td class="px-4 py-3 font-medium text-brand-600">@PhoneFor(row.value)</td>
                                                <td class="px-4 py-3 font-mono text-xs whitespace-pre-wrap text-slate-700 break-words">@ResolvePlaceholders(message, row.value)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </ChildContent>
                </Card>
            }
        </div>

        <!-- Side Column (col-lg-4) -->
        <div class="lg:col-span-1">
            <div class="sticky top-6 flex flex-col gap-6">
                <!-- Sender ID Card -->
                <SenderIdCard Model="@model" @ref="senderIdCard"></SenderIdCard>
                
                <!-- Schedule Card -->
                <SchedulerCard Model="@model" IsSending="isSending" OnSubmit="SendMessageCore"></SchedulerCard>
            </div>                
        </div>
    </div>
}

<SelectTemplateFileModal @ref="templateFilesModal" 
                        Files="model?.BatchCsvFiles" 
                        OnSelected="SelectHistoryFile"
                        OnUploadRequested="() => csvUploadModal.Show()" />

<BulkFileModal @ref="csvUploadModal" ForCSV="true" OnFileUploaded="OnCsvUploadedWithResult" OnCompleted="OnCsvUploadedRefresh" />

@code {
    private const long MaxFileBytes = 10 * 1024 * 1024;
    private readonly List<string> headers = [];
    private readonly List<Dictionary<string, string>> previewRows = [];
    private bool isLoading = true;
    private bool isSending;
    private int currentStep = 1;
    
    private ComposeTemplateModel? model;
    
    private string message = "";
    private int? phoneColumn;
    private IBrowserFile? selectedUpload;
    private BatchFileResponse? selectedExistingFile;
    private SelectTemplateFileModal templateFilesModal = new();
    private BulkFileModal csvUploadModal = new();
    private MessageTemplateEditor templateEditor;
    private SenderIdCard? senderIdCard;
    private byte[]? uploadedFileBytes;

    private bool hasDataSource => selectedUpload is not null || selectedExistingFile is not null;
    private int messageParts => string.IsNullOrEmpty(message) ? 0 : message.Length <= 160 ? 1 : (int)Math.Ceiling(message.Length / 153d);

    private List<BatchFileResponse> recentFiles => model?.BatchCsvFiles?.Take(3).ToList() ?? new();
    private string CurrentFileName => selectedUpload?.Name ?? selectedExistingFile?.Description ?? "Selected Sheet";
    private long CurrentFileRowCount => selectedExistingFile?.TotalNumbers ?? (long)previewRows.Count;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var senderTask = apiClient.SenderIdListAsync(1, 500, null);
            var batchTask = apiClient.BatchFileListAsync();
            await Task.WhenAll(senderTask, batchTask);
            
            var senders = senderTask.Result.Result.Where(x => string.Equals(x.Status, "Approved", StringComparison.OrdinalIgnoreCase)).ToList();
            model = new ComposeTemplateModel(senders, batchTask.Result.Result);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Compose Message");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectUpload(InputFileChangeEventArgs args)
    {
        selectedUpload = args.File;
        selectedExistingFile = null;

        await using var stream = selectedUpload.OpenReadStream(MaxFileBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        uploadedFileBytes = ms.ToArray();

        using var previewStream = new MemoryStream(uploadedFileBytes);
        await LoadCsvPreview(previewStream, selectedUpload.Name);
    }

    private async Task SelectHistoryFile(BatchFileResponse file)
    {
        try
        {
            var download = await apiClient.BatchFileDownloadAsync(file.BatchFileID);
            selectedExistingFile = file;
            selectedUpload = null;
            uploadedFileBytes = null;
            await LoadCsvPreview(download.Stream, file.Description);
        }
        catch (Exception ex)
        {
            await alert.Error("The content for this file could not be loaded from storage: " + ex.Message, "File Unavailable");
        }
    }

    private async Task OnCsvUploadedWithResult(BatchFileResponse newFile)
    {
        await RefreshFilesList();
        await SelectHistoryFile(newFile);
    }

    private async Task OnCsvUploadedRefresh()
    {
        await RefreshFilesList();
        var newest = model?.BatchCsvFiles?.FirstOrDefault();
        if (newest != null)
        {
            await SelectHistoryFile(newest);
        }
    }

    private async Task RefreshFilesList()
    {
        try
        {
            var batchTask = await apiClient.BatchFileListAsync();
            var allFiles = batchTask.Result?.ToList() ?? new();
            if (model != null)
            {
                model.UpdateBatchFiles(allFiles);
            }
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error Refreshing Sheets");
        }
    }

    private void OpenTemplateFiles() => templateFilesModal.Show(selectedExistingFile?.BatchFileID, model?.BatchCsvFiles);

    private void ClearSelection()
    {
        selectedUpload = null;
        selectedExistingFile = null;
        uploadedFileBytes = null;
        headers.Clear();
        previewRows.Clear();
        phoneColumn = null;
    }

    private void SetPhoneColumn(int colIndex)
    {
        phoneColumn = colIndex;
    }

    private static string GetColumnLetter(int? index)
    {
        if (!index.HasValue || index.Value < 0) return "-";
        int i = index.Value;
        string columnLetter = "";
        while (i >= 0)
        {
            columnLetter = (char)('A' + (i % 26)) + columnLetter;
            i = (i / 26) - 1;
        }
        return columnLetter;
    }

    private async Task LoadCsvPreview(Stream stream, string fileName)
    {
        headers.Clear();
        previewRows.Clear();
        phoneColumn = null;

        if (string.IsNullOrWhiteSpace(fileName))
            return;

        using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true, leaveOpen: true);
        var firstLine = await reader.ReadLineAsync();
        if (string.IsNullOrWhiteSpace(firstLine)) return;

        headers.AddRange(ReadCsvLine(firstLine));
        string? line;
        while (previewRows.Count < 10 && (line = await reader.ReadLineAsync()) is not null)
        {
            var values = ReadCsvLine(line);
            if (values.Count == 0) continue;
            var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            for (var index = 0; index < headers.Count; index++) row[headers[index]] = index < values.Count ? values[index] : "";
            previewRows.Add(row);
        }
        phoneColumn = headers.FindIndex(x => x.Contains("phone", StringComparison.OrdinalIgnoreCase) || x.Contains("mobile", StringComparison.OrdinalIgnoreCase) || x.Contains("number", StringComparison.OrdinalIgnoreCase) || x.Contains("tel", StringComparison.OrdinalIgnoreCase));
        if (phoneColumn < 0 && headers.Count > 0) phoneColumn = 0;
    }

    private async Task AddPlaceholder(string header) 
    { 
        if (templateEditor != null)
        {
            await templateEditor.InsertPlaceholderAsync(header.Replace(" ", ""));
        }
    }
    
    private string Placeholder(string header) => $"{{{Regex.Replace(header, @"\s+", "")}}}";
    
    private string PhoneFor(Dictionary<string, string> row) => phoneColumn is int index && index >= 0 && index < headers.Count && row.TryGetValue(headers[index], out var number) ? number : "No phone number";

    private string ResolvePlaceholders(string value, Dictionary<string, string> row)
    {
        foreach (var header in headers)
            value = Regex.Replace(value, $@"\{{\s*{Regex.Escape(header.Replace(" ", ""))}\s*\}}", row.GetValueOrDefault(header, ""), RegexOptions.IgnoreCase);
        return value;
    }

    private async Task SendMessageCore(DateTimeOffset? scheduledDeliveryTime)
    {
        var senderId = model?.SenderID;
        if (string.IsNullOrWhiteSpace(senderId) || string.IsNullOrWhiteSpace(message) || !hasDataSource || !phoneColumn.HasValue)
        {
            await alert.Error("Choose an approved sender ID, a data source, recipient phone column, and message.", "Compose Message");
            return;
        }

        isSending = true;
        try
        {
            var fileId = selectedExistingFile?.BatchFileID;
            if (selectedUpload is not null && uploadedFileBytes is not null)
            {
                using var stream = new MemoryStream(uploadedFileBytes);
                var response = await apiClient.BatchFileCreateAsync(234, new FileParameter(stream, selectedUpload.Name, selectedUpload.ContentType));
                fileId = response.Result.BatchFileID;
            }
            if (string.IsNullOrWhiteSpace(fileId)) throw new InvalidOperationException("The selected file could not be prepared.");

            await apiClient.SmsBatchCsvCreateAsync(new SmsBatchCsvRequest
            {
                SenderID = senderId,
                MessageText = message.Trim(),
                BatchFileID = fileId,
                PhoneNumberColumn = phoneColumn.Value,
                DeliveryTime = scheduledDeliveryTime
            });
            await alert.Success(scheduledDeliveryTime.HasValue ? "Your personalized messages have been scheduled." : "Your personalized messages are being processed.", "Message Created");
            
            // Reset
            message = "";
            selectedUpload = null;
            uploadedFileBytes = null;
            selectedExistingFile = null;
            headers.Clear();
            previewRows.Clear();
            phoneColumn = null;
            currentStep = 1;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Unable to Send Message");
        }
        finally
        {
            isSending = false;
        }
    }

    private static List<string> ReadCsvLine(string line)
    {
        var fields = new List<string>();
        var builder = new StringBuilder();
        var inQuotes = false;
        for (var index = 0; index < line.Length; index++)
        {
            var character = line[index];
            if (character == '"')
            {
                if (inQuotes && index + 1 < line.Length && line[index + 1] == '"') { builder.Append(character); index++; }
                else inQuotes = !inQuotes;
            }
            else if (character == ',' && !inQuotes) { fields.Add(builder.ToString().Trim()); builder.Clear(); }
            else builder.Append(character);
        }
        fields.Add(builder.ToString().Trim());
        return fields;
    }
}