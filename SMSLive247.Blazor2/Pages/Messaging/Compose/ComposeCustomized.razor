@using SMSLive247.Blazor.Pages.ViewModels
@using SMSLive247.Blazor.Pages.Messaging.Compose.Custom
@using SMSLive247.Blazor.Pages.Messaging.Compose.Common

<Loading NullCheckObject="model" Message="Loading compose options...">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <!-- Main Column (col-lg-8) -->
        <div class="flex flex-col gap-6 lg:col-span-2">
            <Step1 @bind-CurrentStep="currentStep" Model="@model" OnModelChanged="() => { }" /> <!-- STEP 1 OF 3: CHOOSE SHEET -->
            <Step2 @bind-CurrentStep="currentStep" Model="@model" OnModelChanged="() => { }" /> <!-- STEP 2 OF 3: SELECT PHONE COLUMN -->
            <Step3 @bind-CurrentStep="currentStep" Model="@model" OnModelChanged="() => { }" /> <!-- STEP 3 OF 3: COMPOSE MESSAGE -->
            <Step4 @bind-CurrentStep="currentStep" Model="@model" /> <!-- Borderless Preview Messages Card -->
        </div>

        <!-- Side Column (col-lg-4) -->
        <div class="lg:col-span-1">
            <div class="sticky top-6 flex flex-col gap-6">
                <SenderIdCard Model="@model" OnChanged="(id) => StateHasChanged()" />                
                <SchedulerCard Model="@model" />          
                <SubmitCard Model="@model" ApiSubmit="apiClient.SmsBatchCsvCreateAsync" />
            </div>
        </div>
    </div>
</Loading>

@code {
    private int currentStep = 1;
    private ComposeTemplateModel? model;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = apiClient.SenderIdListAsync(1, 500);
            var t2 = apiClient.BatchFileListAsync();

            await Task.WhenAll(t1, t2);

            model = new ComposeTemplateModel(t1.Result.Result, t2.Result.Result);
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"An error occurred while initializing the compose page. {ex.Message}");
        }
    }

}
