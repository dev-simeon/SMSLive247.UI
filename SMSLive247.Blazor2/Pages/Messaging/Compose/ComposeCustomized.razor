@page "/messaging/compose/customized"
@using System.Text
@using System.Text.RegularExpressions
@using SMSLive247.Blazor2.Pages.Messaging.Compose.Modals
@using SMSLive247.Blazor2.Pages.Messaging.Compose.Common
@using SMSLive247.Blazor2.Pages.ViewModels

@if (isLoading)
{
    <div class="rounded-xl border border-slate-200 bg-white p-8 text-sm text-slate-500">Loading compose options...</div>
}
else
{
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <!-- Main Column (col-lg-8) -->
        <div class="flex flex-col gap-6 lg:col-span-2">
            
            @if (currentStep == 1)
            {
                <Card HeaderText="Step 1: Data Source">
                    <HeaderRight>
                        <a href="data:text/csv;charset=utf-8,Phone%2CName%0A2348012345678%2CAda" download="template-sample.csv" class="flex items-center gap-1 text-sm font-medium text-slate-400 hover:text-slate-600">
                            <Icon Style="Icon.IconStyle.Download" CssClass="text-base" />Sample CSV
                        </a>
                    </HeaderRight>
                    <ChildContent>
                        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                            <label class="group flex min-h-60 cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed @(hasDataSource ? "border-emerald-400 bg-emerald-50" : "border-slate-300 bg-white hover:border-brand-400 hover:bg-slate-50") p-6 text-center md:col-span-2">
                                <InputFile class="hidden" accept=".csv" OnChange="SelectUpload" />
                                <div class="mb-3 rounded-full @(hasDataSource ? "bg-emerald-100 text-emerald-600" : "bg-blue-50 text-brand-500") p-3"><Icon Style="Icon.IconStyle.FileSpreadsheet" CssClass="text-3xl" /></div>
                                @if (selectedUpload is not null)
                                {
                                    <p class="max-w-full truncate text-sm font-semibold text-emerald-700">@selectedUpload.Name</p>
                                    <p class="mt-1 text-xs text-emerald-600">@FormatFileSize(selectedUpload.Size) - ready to upload</p>
                                }
                                else if (selectedExistingFile is not null)
                                {
                                    <p class="max-w-full truncate text-sm font-semibold text-emerald-700">@selectedExistingFile.Description</p>
                                    <p class="mt-1 text-xs text-emerald-600">@selectedExistingFile.TotalNumbers.ToString("N0") records from file history</p>
                                }
                                else
                                {
                                    <p class="text-sm font-medium text-slate-900">Drop CSV here or <span class="text-brand-500">browse files</span></p>
                                    <p class="mt-1 text-xs text-slate-500">Maximum file size: 10 MB</p>
                                }
                                <button type="button" @onclick:stopPropagation="true" @onclick="OpenTemplateFiles" class="mt-4 flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 shadow-sm hover:border-brand-300 hover:bg-slate-50"><Icon Style="Icon.IconStyle.PlusCircle" CssClass="text-brand-500 text-base" />Select from History</button>
                            </label>

                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
                                <h4 class="mb-4 text-xs font-bold tracking-wider text-slate-500 uppercase">Configuration</h4>
                                <FormSelect TValue="int?" Label="Recipient Phone Column" @bind-Value="phoneColumn" Required="true" disabled="@(!headers.Any())">
                                    @if (!headers.Any())
                                    {
                                        <option value="">Waiting for a CSV file...</option>
                                    }
                                    @for (var index = 0; index < headers.Count; index++)
                                    {
                                        <option value="@index">@headers[index]</option>
                                    }
                                </FormSelect>
                                @if (previewRows.Count > 0)
                                {
                                    <p class="mt-2 flex items-center gap-1 text-xs text-slate-500"><Icon Style="Icon.IconStyle.Info" CssClass="text-sm" />First @previewRows.Count rows previewed below</p>
                                }
                            </div>
                        </div>

                        @if (previewRows.Count > 0)
                        {
                            <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200">
                                <table class="w-full text-left text-sm text-slate-500">
                                    <thead class="bg-slate-50 text-xs font-bold tracking-wider text-slate-600 uppercase">
                                        <tr>
                                            @foreach (var header in headers)
                                            {
                                                <th class="px-4 py-3">@header</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-200 bg-white">
                                        @foreach (var row in previewRows)
                                        {
                                            <tr>
                                                @foreach (var header in headers)
                                                {
                                                    <td class="px-4 py-2 truncate max-w-[200px]" title="@row.GetValueOrDefault(header, "")">@row.GetValueOrDefault(header, "")</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="mt-6 flex justify-end border-t border-slate-100 pt-4">
                            <Button Text="Next Step" Style="Button.ButtonStyle.Primary" IsDisabled="@(!hasDataSource || phoneColumn == null)" OnClick="() => currentStep = 2" />
                        </div>
                    </ChildContent>
                </Card>
            }

            @if (currentStep == 2)
            {
                <Card HeaderText="Step 2: Compose Message">
                    <HeaderRight>
                        <button type="button" @onclick="() => currentStep = 1" class="text-sm font-medium text-slate-500 hover:text-brand-500 hover:underline">
                            &larr; Back to Data Source
                        </button>
                    </HeaderRight>
                    <ChildContent>
                        <div class="flex flex-col gap-6 xl:flex-row">
                            <div class="flex-1 min-w-0">
                                <MessageTemplateEditor @ref="templateEditor"
                                                       @bind-Value="message"
                                                       Chars="message.Length"
                                                       Pages="messageParts"
                                                       Max="160"
                                                       Remaining="160 - message.Length" />
                            </div>
                            <aside class="w-full shrink-0 overflow-hidden rounded-xl border border-slate-200 bg-white xl:w-72">
                                <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
                                    <span class="text-xs font-bold tracking-wider text-slate-600 uppercase">Available Fields</span>
                                    <p class="mt-1 text-[11px] text-slate-400">Click a field to add it to the message.</p>
                                </div>
                                <div class="max-h-64 space-y-2 overflow-y-auto p-3">
                                    @if (!headers.Any())
                                    {
                                        <p class="py-8 text-center text-xs text-slate-400">Choose a CSV file to see columns.</p>
                                    }
                                    @foreach (var header in headers)
                                    {
                                        <button type="button" @onclick="() => AddPlaceholder(header)" class="flex w-full items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-left text-sm font-mono text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                                            @Placeholder(header)
                                            <Icon Style="Icon.IconStyle.PlusCircle" CssClass="text-brand-500 text-base" />
                                        </button>
                                    }
                                </div>
                            </aside>
                        </div>
                    </ChildContent>
                </Card>

                <Card HeaderText="Preview Messages">
                    <ChildContent>
                        @if (!previewRows.Any() || string.IsNullOrWhiteSpace(message))
                        {
                            <p class="py-10 text-center text-sm text-slate-500">Choose a CSV file and compose a message to preview your personalized messages.</p>
                        }
                        else
                        {
                            <div class="overflow-x-auto rounded-xl border border-slate-200">
                                <table class="w-full text-left text-sm text-slate-500">
                                    <thead class="bg-slate-50 text-xs font-bold tracking-wider text-slate-600 uppercase">
                                        <tr>
                                            <th class="px-4 py-3 w-16">#</th>
                                            <th class="px-4 py-3 w-48">Phone Number</th>
                                            <th class="px-4 py-3">Message</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-200 bg-white">
                                        @foreach (var row in previewRows.Take(3).Select((value, index) => new { value, index }))
                                        {
                                            <tr>
                                                <td class="px-4 py-3 font-semibold text-slate-400">@(row.index + 1)</td>
                                                <td class="px-4 py-3 font-medium text-brand-600">@PhoneFor(row.value)</td>
                                                <td class="px-4 py-3 font-mono text-xs whitespace-pre-wrap text-slate-700 break-words">@ResolvePlaceholders(message, row.value)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </ChildContent>
                </Card>
            }
        </div>

        <!-- Side Column (col-lg-4) -->
        <div class="lg:col-span-1">
            <div class="sticky top-6 flex flex-col gap-6">
                <!-- Sender ID Card -->
                <SenderIdCard @ref="senderIdCard" SenderIDs="@model?.SenderIds"></SenderIdCard>
                
                <!-- Schedule Card -->
                <SchedulerCard Model="@model" IsSending="isSending" OnSubmit="SendMessageCore"></SchedulerCard>
            </div>                
        </div>
    </div>
}

<SelectTemplateFileModal @ref="templateFilesModal" Files="model?.BatchCsvFiles" OnSelected="SelectHistoryFile" />

@code {
    private const long MaxFileBytes = 10 * 1024 * 1024;
    private readonly List<string> headers = [];
    private readonly List<Dictionary<string, string>> previewRows = [];
    private bool isLoading = true;
    private bool isSending;
    private int currentStep = 1;
    
    private ComposeTemplateModel? model;
    
    private string message = "";
    private int? phoneColumn;
    private IBrowserFile? selectedUpload;
    private BatchFileResponse? selectedExistingFile;
    private SelectTemplateFileModal templateFilesModal = new();
    private MessageTemplateEditor templateEditor;
    private SenderIdCard? senderIdCard;
    private byte[]? uploadedFileBytes;

    private bool hasDataSource => selectedUpload is not null || selectedExistingFile is not null;
    private int messageParts => string.IsNullOrEmpty(message) ? 0 : message.Length <= 160 ? 1 : (int)Math.Ceiling(message.Length / 153d);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var senderTask = apiClient.SenderIdListAsync(1, 500, null);
            var batchTask = apiClient.BatchFileListAsync();
            await Task.WhenAll(senderTask, batchTask);
            
            var senders = senderTask.Result.Result.Where(x => string.Equals(x.Status, "Approved", StringComparison.OrdinalIgnoreCase)).ToList();
            model = new ComposeTemplateModel(senders, batchTask.Result.Result);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Compose Message");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectUpload(InputFileChangeEventArgs args)
    {
        selectedUpload = args.File;
        selectedExistingFile = null;

        await using var stream = selectedUpload.OpenReadStream(MaxFileBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        uploadedFileBytes = ms.ToArray();

        if (model != null)
        {
            using var countStream = new MemoryStream(uploadedFileBytes);
            model.TotalRecipients = await CountLinesAsync(countStream);
        }

        using var previewStream = new MemoryStream(uploadedFileBytes);
        await LoadCsvPreview(previewStream, selectedUpload.Name);
    }

    private async Task SelectHistoryFile(BatchFileResponse file)
    {
        selectedExistingFile = file;
        selectedUpload = null;
        if (model != null)
        {
            model.TotalRecipients = file.TotalNumbers;
        }
        try
        {
            var download = await apiClient.BatchFileDownloadAsync(file.BatchFileID);
            await LoadCsvPreview(download.Stream, file.Description);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Unable to Read File");
        }
    }

    private void OpenTemplateFiles(MouseEventArgs _) => templateFilesModal.Show(selectedExistingFile?.BatchFileID);

    private async Task LoadCsvPreview(IBrowserFile file)
    {
        if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            headers.Clear();
            previewRows.Clear();
            phoneColumn = null;
            return;
        }

        if (uploadedFileBytes != null)
        {
            using var stream = new MemoryStream(uploadedFileBytes);
            await LoadCsvPreview(stream, file.Name);
        }
    }

    private async Task LoadCsvPreview(Stream stream, string fileName)
    {
        headers.Clear();
        previewRows.Clear();
        phoneColumn = null;

        if (!fileName.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            return;

        using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true, leaveOpen: true);
        var firstLine = await reader.ReadLineAsync();
        if (string.IsNullOrWhiteSpace(firstLine)) return;

        headers.AddRange(ReadCsvLine(firstLine));
        string? line;
        while (previewRows.Count < 10 && (line = await reader.ReadLineAsync()) is not null)
        {
            var values = ReadCsvLine(line);
            if (values.Count == 0) continue;
            var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            for (var index = 0; index < headers.Count; index++) row[headers[index]] = index < values.Count ? values[index] : "";
            previewRows.Add(row);
        }
        phoneColumn = headers.FindIndex(x => x.Contains("phone", StringComparison.OrdinalIgnoreCase) || x.Contains("mobile", StringComparison.OrdinalIgnoreCase));
        if (phoneColumn < 0 && headers.Count > 0) phoneColumn = 0;
    }

    private async Task AddPlaceholder(string header) 
    { 
        if (templateEditor != null)
        {
            await templateEditor.InsertPlaceholderAsync(header.Replace(" ", ""));
        }
    }
    
    private string Placeholder(string header) => $"{{{Regex.Replace(header, @"\s+", "")}}}";
    
    private string PhoneFor(Dictionary<string, string> row) => phoneColumn is int index && index >= 0 && index < headers.Count && row.TryGetValue(headers[index], out var number) ? number : "No phone number";

    private string ResolvePlaceholders(string value, Dictionary<string, string> row)
    {
        foreach (var header in headers)
            value = Regex.Replace(value, $@"\{{\s*{Regex.Escape(header.Replace(" ", ""))}\s*\}}", row.GetValueOrDefault(header, ""), RegexOptions.IgnoreCase);
        return value;
    }

    private async Task SendMessageCore(DateTimeOffset? scheduledDeliveryTime)
    {
        var senderId = senderIdCard?.SenderId;
        if (string.IsNullOrWhiteSpace(senderId) || string.IsNullOrWhiteSpace(message) || !hasDataSource || !phoneColumn.HasValue)
        {
            await alert.Error("Choose an approved sender ID, a data source, recipient phone column, and message.", "Compose Message");
            return;
        }

        isSending = true;
        try
        {
            var fileId = selectedExistingFile?.BatchFileID;
            if (selectedUpload is not null && uploadedFileBytes is not null)
            {
                using var stream = new MemoryStream(uploadedFileBytes);
                var response = await apiClient.BatchFileCreateAsync(null, new FileParameter(stream, selectedUpload.Name, selectedUpload.ContentType));
                fileId = response.Result.BatchFileID;
            }
            if (string.IsNullOrWhiteSpace(fileId)) throw new InvalidOperationException("The selected file could not be prepared.");

            await apiClient.SmsBatchCsvCreateAsync(new SmsBatchCsvRequest
            {
                SenderID = senderId,
                MessageText = message.Trim(),
                BatchFileID = fileId,
                PhoneNumberColumn = phoneColumn.Value,
                DeliveryTime = scheduledDeliveryTime
            });
            await alert.Success(scheduledDeliveryTime.HasValue ? "Your personalized messages have been scheduled." : "Your personalized messages are being processed.", "Message Created");
            
            // Reset
            message = "";
            selectedUpload = null;
            uploadedFileBytes = null;
            selectedExistingFile = null;
            headers.Clear();
            previewRows.Clear();
            phoneColumn = null;
            currentStep = 1;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Unable to Send Message");
        }
        finally
        {
            isSending = false;
        }
    }

    private static List<string> ReadCsvLine(string line)
    {
        var fields = new List<string>();
        var builder = new StringBuilder();
        var inQuotes = false;
        for (var index = 0; index < line.Length; index++)
        {
            var character = line[index];
            if (character == '"')
            {
                if (inQuotes && index + 1 < line.Length && line[index + 1] == '"') { builder.Append(character); index++; }
                else inQuotes = !inQuotes;
            }
            else if (character == ',' && !inQuotes) { fields.Add(builder.ToString().Trim()); builder.Clear(); }
            else builder.Append(character);
        }
        fields.Add(builder.ToString().Trim());
        return fields;
    }

    private async Task<long> CountLinesAsync(Stream stream)
    {
        try
        {
            using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true, leaveOpen: true);
            long count = 0;
            while (await reader.ReadLineAsync() != null) count++;
            return count > 0 ? count - 1 : 0; // subtract header
        }
        catch { return 1; }
    }

    private static string FormatFileSize(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024d:0.0} KB" : $"{bytes / 1024d / 1024d:0.0} MB";
}