@attribute [Route(Const.Routes.Messaging.SenderIds)]
@layout MainLayout

<PageTitle>Sender IDs</PageTitle>

<PageHeader Title="Sender IDs"
            SubTitle="Manage promotional and transactional sender ID requests.">
</PageHeader>

<Tabs>
    <TabPage Title="Promotional" Icon="Icon.IconStyle.Campaign">
        <Promotional Items="promotional" OnRefresh="FetchData" />
    </TabPage>
    <TabPage Title="Transactional" Icon="Icon.IconStyle.Verified">
        <Transactional Items="transactional" OnRefresh="FetchData" />
    </TabPage>
</Tabs>

@code {
    private List<SenderIdResponse> promotional = [];
    private List<SenderIdResponse> transactional = [];

    protected override async Task OnInitializedAsync() => await FetchData();

    private async Task FetchData()
    {
        try
        {
            var response = await apiClient.SenderIdListAsync(1, 500);
            var items = response.Result?.ToList() ?? [];

            transactional = items.Where(x => IsTransactional(x)).ToList();
            promotional = items.Where(x => !IsTransactional(x)).ToList();


        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"An error occurred while fetching sender IDs. {ex.Message}");
        }
    }

    private static bool IsTransactional(SenderIdResponse item) =>
       string.Equals(item.RouteType, "CORPORATE", StringComparison.OrdinalIgnoreCase) ||
       string.Equals(item.Purpose, "Transactional", StringComparison.OrdinalIgnoreCase);
}
