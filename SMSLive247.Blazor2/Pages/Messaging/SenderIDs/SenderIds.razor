@attribute [Route(Const.Routes.Messaging.SenderIds)]
@layout MainLayout

<PageTitle>Sender IDs</PageTitle>

<PageHeader 
    Title="Sender IDs" 
    SubTitle="Manage your sender IDs for messaging campaigns.">
</PageHeader>

<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchQuery" OnSearch="OnSearch">
            <FormSelect @bind-Value="searchStatus" IsEmbedded="true">
                <option value="">All Statuses</option>
                <option value="Approved">Approved</option>
                <option value="Pending">Pending</option>
                <option value="Rejected">Rejected</option>
            </FormSelect>
        </SearchBox>
    </HeaderLeft>
    <HeaderRight>
        <Button Icon="Icon.IconStyle.PlusCircle" Text="Request Sender ID" />
    </HeaderRight>
    <ChildContent>
        <Table Items="filteredItems">
            <Columns>
                <Column Header="Sender ID">
                    <span class="font-medium text-slate-900">@(string.IsNullOrEmpty(context.SenderID) ? "—" : context.SenderID)</span>
                </Column>
                <Column Header="Purpose / Sample Message" Width="40%">
                    <div class="flex flex-col">
                        <div class="text-sm font-medium text-slate-900 mb-0.5">@(string.IsNullOrEmpty(context.Purpose) ? "—" : context.Purpose)</div>
                        <div class="text-xs text-slate-500 truncate max-w-md">@(string.IsNullOrEmpty(context.SampleText) ? "—" : context.SampleText)</div>
                    </div>
                </Column>
                <Column Header="Date Requested">
                    <FormatDate DateTime="@context.DateRequested"></FormatDate>
                </Column>
                <Column Header="Date Approved">
                    @if (context.DateDecided.HasValue)
                    {
                        <FormatDate DateTime="context.DateDecided.Value.DateTime"></FormatDate>
                    }
                    else
                    {
                        <span class="text-slate-400">Pending Approval</span>
                    }
                </Column>
                <Column Header="Status">
                    <Badge Variant="Badge.StatusVariant.SenderIdRequest" Value="@(context.Status ?? "rejected")" />
                 </Column>
                <Column>
                    <Actions OnDelete="() => HandleDelete(context)">
                    </Actions>
                </Column>
            </Columns>
        </Table>
    </ChildContent>
    <FooterLeft>
          <Paging PageNumber="1" PageSize="25"
                TotalRecords="filteredItems?.Count"
                OnPageSizeChange="FetchData">
        </Paging>
    </FooterLeft>
</PageBody>

@code {
    private string? searchStatus;
    private string? searchQuery;
    private List<SenderIdResponse>? items;
    private List<SenderIdResponse>? filteredItems;

    protected override async Task OnInitializedAsync()
    {
        await FetchData();
    }

    private void HandleDelete(SenderIdResponse item)
    {
        // TODO: Implement delete logic
    }

    private async Task FetchData()
    {
        var response = await apiClient.SenderIdListAsync(1, 500, null);

        if (response.StatusCode == 200)
        {
            items = response.Result.ToList();
            filteredItems = items;
        }
    }

    private void OnSearch()
    {
        filteredItems = items;

        if (!string.IsNullOrWhiteSpace(searchStatus))
        {
            filteredItems = filteredItems?.Where(x => x.Status == searchStatus).ToList();
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredItems = filteredItems?.Where(x => x.SenderID.Contains(
                searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }
}
