@using SMSLive247.Blazor.Pages.Messaging.SenderIDs.Modals
@attribute [Route(Const.Routes.Messaging.SenderIds)]
@layout MainLayout

<PageTitle>Sender IDs</PageTitle>

<PageHeader 
    Title="Sender IDs" 
    SubTitle="Manage your sender IDs for messaging campaigns.">
</PageHeader>

<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchQuery" OnSearch="OnSearch" InstantSearch="true">
            <FormSelect ValueChanged="(e) => OnSearch(e)" 
                        ValueExpression="@(() => searchStatus)"
                        TValue="string" IsEmbedded="true">
                <option value="">All Statuses</option>
                <option value="APPROVED">Approved</option>
                <option value="PENDING">Pending</option>
                <option value="REJECTED">Rejected</option>
            </FormSelect>
        </SearchBox>
    </HeaderLeft>
    <HeaderRight>
        <Button Icon="Icon.IconStyle.PlusCircle" Text="Request Sender ID" OnClick="() => requestModal.Show()" />
    </HeaderRight>
    <ChildContent>
        <Table Items="filteredItems" EmptyMessage="No Sender IDs Found">
            <Columns>
                <Column Header="Sender ID">
                    @context.SenderID
                </Column>
                <Column Header="Purpose / Sample Message" Width="40%">
                    <div class="flex flex-col">
                        <div class="mb-0.5 text-sm font-medium text-slate-900">@context.Purpose</div>
                        <div class="max-w-md truncate text-xs text-slate-500">@context.SampleText</div>
                        @if (IsRejected(context) && !string.IsNullOrWhiteSpace(context.Remarks))
                        {
                            <div class="leading-relaxed text-red-700" title="@context.Remarks">
                                @GetSenderIdRejectionReason(context.Remarks)
                            </div>
                        }
                    </div>
                </Column>
                <Column Header="Date Requested">
                    <FormatDate DateTime="@context.DateRequested"></FormatDate>
                </Column>
                <Column Header="Date Approved">
                    @if (context.DateDecided.HasValue)
                    {
                        <FormatDate DateTime="context.DateDecided.Value.DateTime"></FormatDate>
                    }
                    else
                    {
                        <span class="text-slate-400">Pending Approval</span>
                    }
                </Column>
                <Column Header="Status">
                    <Badge Variant="Badge.StatusVariant.SenderIdRequest" Value="@(context.Status ?? "rejected")" />
                 </Column>
                <Column>
                    <Actions OnDelete="() => HandleDelete(context)">
                    </Actions>
                </Column>
            </Columns>
        </Table>
    </ChildContent>
    <FooterLeft>
    </FooterLeft>
</PageBody>

<RequestModal @ref="requestModal" OnCompleted="FetchData" />

@code {
    private string? searchStatus;
    private string? searchQuery;
    private List<SenderIdResponse>? items;
    private List<SenderIdResponse>? filteredItems;
    private RequestModal requestModal = new();

    protected override async Task OnInitializedAsync()
    {
        await FetchData();
    }

    private async Task FetchData()
    {
        try
        {
            var response = await apiClient.SenderIdListAsync(1, 500);
            items = response.Result.ToList();
            filteredItems = items;
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            items = [];
            filteredItems = [];
            await alert.Error($"An error occurred while fetching sender IDs. {ex.Message}");
        }
    }

    private void OnSearch(string status)
    {
        searchStatus = status;
        OnSearch();
    }

    private void OnSearch()
    {
        var noCase = StringComparison.OrdinalIgnoreCase;
        filteredItems = items ?? [];

        if (!string.IsNullOrWhiteSpace(searchStatus))
        {
            filteredItems = filteredItems.Where(x => string.Equals(x.Status, searchStatus, noCase)).ToList();
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredItems = filteredItems.Where(x =>
                (x.SenderID?.Contains(searchQuery, noCase) ?? false) ||
                (x.Purpose?.Contains(searchQuery, noCase) ?? false) ||
                (x.SampleText?.Contains(searchQuery, noCase) ?? false) ||
                (x.Remarks?.Contains(searchQuery, noCase) ?? false)).ToList();
        }
    }

    private static bool IsRejected(SenderIdResponse item) =>
        string.Equals(item.Status, "REJECTED", StringComparison.OrdinalIgnoreCase);


    public static string GetSenderIdRejectionReason(string value)
    {
        return value switch
        {
            "SAMPLE_TOO_BRIEF" =>
                "The sender ID was rejected because the submitted sample message is too brief to adequately verify the sender ID.",

            "GENERIC_SENDERID" =>
                "The sender ID was rejected because it is too generic and does not clearly identify the business, organization, or service using it.",

            "OTP_NOT_ALLOWED" =>
                "The sender ID was rejected because OTP messages are not allowed for promotional sender IDs.",

            "WELL_KNOWN_BRAND" =>
                "The sender ID was rejected because it appears to represent a well-known brand. Additional verification or authorization may be required.",

            "GOVERNMENT_AGENCY" =>
                "The sender ID was rejected because it appears to represent a government agency. Appropriate authorization or verification may be required.",

            "TRANSACTIONAL" =>
                "The sender ID was rejected because it is intended for transactional messages, which are not allowed under the current sender ID requirements.",

            _ =>
                "The sender ID was rejected because it does not meet the sender ID requirements."
        };
    }

    private async Task HandleDelete(SenderIdResponse item)
    {
        if (await alert.Confirm($"Are you sure you want to delete [{item.SenderID}]?", "Delete Sender ID"))
        {
            try
            {
                await apiClient.SenderIdDeleteAsync(item.SenderID);
                await alert.Success("Sender ID deleted successfully.", "Deleted");
                await FetchData();
            }
            catch (ApiException ex)
            {
                await alert.Error(ex.FriendlyErrorMessage);
            }
            catch (Exception ex)
            {
                await alert.Error($"An error occurred while deleting the sender ID. {ex.Message}");
            }
        }
    }
}
