@namespace SMSLive247.Blazor2.Pages.Messaging.SenderIDs.Modals

<Modal Title="Request New Sender ID" @bind-IsVisible="isVisible">
    <Body>
        <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 flex gap-3 mb-4">
            <Icon Style="Icon.IconStyle.Info" CssClass="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
            <p class="text-xs text-blue-700 leading-relaxed font-medium">
                Sender IDs must be relevant to your organization. Generic names (e.g., "Alert", "Info") may be rejected by network operators.
            </p>
        </div>

        <EditForm id="SenderIdRequestForm" Model="@request" OnValidSubmit="HandleSubmit" class="space-y-4">
            <FormInput Label="Sender ID"
                       PlaceHolder="Max 11 characters, no spaces"
                       @bind-Value="request.SenderID"
                       Required="true" />
            @if (!string.IsNullOrWhiteSpace(senderIdError))
            {
                <p class="text-xs text-red-500 font-semibold -mt-2">
                    @senderIdError
                </p>
            }

            <FormInput Label="Purpose"
                       PlaceHolder="Briefly explain what this Sender ID will be used for..."
                       @bind-Value="request.Purpose"
                       Required="true" />

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">
                    Sample Message <span class="text-red-500">*</span>
                </label>
                <textarea rows="3"
                          class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-brand-500 transition-all resize-none"
                          placeholder="Provide a sample of the content you intend to send..."
                          @bind="request.SampleText"
                          required></textarea>
            </div>
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true"
                Text="Submit Request"
                form="SenderIdRequestForm"
                Icon="Icon.IconStyle.PlusCircle"
                IsBusy="@isSubmitting" />
        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="() => isVisible = false" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible = false;
    private bool isSubmitting = false;
    private SenderIdRequest request = new();
    private string? senderIdError;

    public void Show()
    {
        request = new SenderIdRequest();
        senderIdError = null;
        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            senderIdError = null;

            if (string.IsNullOrWhiteSpace(request.SenderID))
            {
                senderIdError = "Sender ID is required.";
                return;
            }

            if (request.SenderID.Length > 11)
            {
                senderIdError = "Sender ID cannot exceed 11 characters.";
                return;
            }

            isSubmitting = true;

            await apiClient.SenderIdCreateAsync(request);

            await alert.Success("Sender ID requested successfully.", "Success");
            await OnCompleted.InvokeAsync();
            isVisible = false;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
