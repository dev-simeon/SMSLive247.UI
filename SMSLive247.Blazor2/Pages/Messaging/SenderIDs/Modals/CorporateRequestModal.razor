@namespace SMSLive247.Blazor.Pages.Messaging.SenderIDs.Modals

<SenderIdWizardModal Title="Request Sender ID"
                     FixedHeight="true"
                     Description="@(currentStep == 1 ? "This is the name your recipients will see · 3–11 characters." : string.Empty)"
                     Steps="wizardSteps"
                     CurrentStep="currentStep"
                     IsVisible="isVisible"
                     IsVisibleChanged="OnVisibilityChanged"
                     IsBusy="isSubmitting"
                     IsPrimaryDisabled="@(!CanContinue)"
                     PrimaryText="@(currentStep == 3 ? "Submit request" : "Continue")"
                     PrimaryIcon="@(currentStep == 3 ? Icon.IconStyle.CheckCircle : Icon.IconStyle.ChevronRight)"
                     OnCancel="Close"
                     OnBack="PreviousStep"
                     OnPrimary="Continue">
    @if (currentStep == 1)
    {
        <section class="mt-6 space-y-4" aria-labelledby="transaction-sender-id-title">
            <div>
                <h3 id="transaction-sender-id-title" class="text-lg font-semibold text-slate-900 dark:text-slate-100">Choose your sender ID</h3>
            </div>

            <div>
                <label for="transactional-sender-id" class="mb-1 flex flex-wrap items-baseline gap-x-1 text-sm font-medium text-slate-700 dark:text-slate-200">
                    <span>Sender ID</span><span class="text-red-500">*</span>
                    @if (showValidation && !SenderIdIsValid)
                    {
                        <span id="transactional-sender-id-error" class="ml-1 text-xs font-normal text-red-500" role="alert">@SenderIdError</span>
                    }
                </label>
                <input id="transactional-sender-id"
                       type="text"
                       maxlength="11"
                       autocomplete="off"
                       placeholder="e.g. AcmeMFB"
                       @bind="senderId"
                       @bind:event="oninput"
                       @onblur="ValidateSenderId"
                       aria-invalid="@(showValidation && !SenderIdIsValid)"
                       aria-describedby="transactional-sender-id-help transactional-sender-id-rules @(showValidation && !SenderIdIsValid ? "transactional-sender-id-error" : null)"
                       class="block w-full appearance-none rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition-all focus:border-brand-500 focus:outline-none focus:ring-4 focus:ring-brand-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder-slate-400 @(showValidation && !SenderIdIsValid ? "border-red-500 bg-red-50 focus:border-red-500 focus:ring-red-500/20 dark:border-red-500 dark:bg-red-950/20" : string.Empty)" />
                <p id="transactional-sender-id-help" class="mt-1 text-xs text-slate-500 dark:text-slate-400">Enter a sender ID that identifies your organization or service.</p>
                <ul id="transactional-sender-id-rules" class="mt-3 space-y-1 text-sm font-normal leading-5 text-slate-600 dark:text-slate-400">
                    <li class="flex gap-2"><span aria-hidden="true" class="shrink-0">•</span><span>Between 3 and 11 characters</span></li>
                    <li class="flex gap-2"><span aria-hidden="true" class="shrink-0">•</span><span>Must contain at least one letter</span></li>
                    <li class="flex gap-2"><span aria-hidden="true" class="shrink-0">•</span><span>Letters, numbers and spaces allowed</span></li>
                    <li class="flex gap-2"><span aria-hidden="true" class="shrink-0">•</span><span>Must not start with a digit</span></li>
                </ul>
            </div>
        </section>
    }
    else if (currentStep == 2)
    {
        <section class="mt-4" aria-label="Upload authorization letters">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Upload completed authorization letters <span class="text-red-500">*</span></h3>
            <InputFile id="loa-files" accept=".pdf,application/pdf" multiple aria-label="Upload four authorization letter PDFs" OnChange="SelectLoaFiles" class="peer sr-only" />
            <label for="loa-files" class="mt-3 flex min-h-12 w-full cursor-pointer items-center justify-between gap-3 rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-700 transition hover:border-brand-500 hover:bg-blue-50 peer-focus-visible:outline-none peer-focus-visible:ring-2 peer-focus-visible:ring-brand-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-900">
                <span class="min-w-0 truncate font-medium">@(authorizationFiles.Count == RequiredLetterCount ? "Four authorization letters selected" : "Choose four PDF files")</span>
                <span class="shrink-0 rounded-md bg-blue-50 px-3 py-1.5 font-semibold text-brand-700 dark:bg-slate-800 dark:text-blue-300">Browse</span>
            </label>
            @if (authorizationFiles.Count > 0)
            {
                <ul class="mt-2 grid gap-x-5 gap-y-1 text-xs text-slate-500 sm:grid-cols-2 dark:text-slate-400">
                    @foreach (var file in authorizationFiles)
                    {
                        <li class="truncate" title="@file.Name">@file.Name</li>
                    }
                </ul>
            }
        </section>
    }
    else
    {
        <section class="mt-4" aria-labelledby="transaction-review-title">
            <Notice Variant="Notice.NoticeVariant.Success" Title="Ready to submit" CssClass="mb-4">
                Review your sender ID and uploaded documents below. Network operators make the final approval decision, and processing times may vary.
            </Notice>
            <div class="space-y-5">
                <section aria-label="Request details">
                    <h4 class="mb-2 text-base font-semibold text-slate-700 dark:text-slate-200">Request details</h4>
                    <dl class="space-y-2 text-base">
                        <div class="min-w-0">
                            <dt class="font-medium text-slate-500 dark:text-slate-400">Sender ID</dt>
                            <dd class="mt-1 break-words text-slate-900 dark:text-slate-100" title="@senderId.Trim()">@senderId.Trim()</dd>
                        </div>
                        <div class="min-w-0">
                            <dt class="font-medium text-slate-500 dark:text-slate-400">Certificate of Incorporation</dt>
                            <dd class="mt-1 break-all text-slate-800 dark:text-slate-200" title="@(HasApprovedTransactionalId ? "Existing approved document" : CacFile!.Name)">@(HasApprovedTransactionalId ? "Existing approved document" : CacFile!.Name)</dd>
                        </div>
                        @if (RequiresLicense)
                        {
                            <div class="min-w-0">
                                <dt class="font-medium text-slate-500 dark:text-slate-400">Operating licence</dt>
                                <dd class="mt-1 break-all text-slate-800 dark:text-slate-200" title="@(HasApprovedTransactionalId ? "Existing approved document" : LicenseFile!.Name)">@(HasApprovedTransactionalId ? "Existing approved document" : LicenseFile!.Name)</dd>
                            </div>
                        }
                    </dl>
                </section>
                <section aria-label="Authorization letters">
                    <h4 class="mb-2 text-base font-semibold text-slate-700 dark:text-slate-200">Authorization letters <span class="font-normal text-slate-500 dark:text-slate-400">(4 files)</span></h4>
                    <ul class="space-y-2 text-base text-slate-800 dark:text-slate-200">
                        @foreach (var file in authorizationFiles)
                        {
                            <li class="flex min-w-0 items-start gap-2" title="@file.Name">
                                <Icon Style="Icon.IconStyle.FileText" CssClass="shrink-0 text-slate-400 dark:text-slate-500" />
                                <span class="min-w-0 break-all">@file.Name</span>
                            </li>
                        }
                    </ul>
                </section>
            </div>
        </section>
    }
</SenderIdWizardModal>

@code {
    private const long MaxFileBytes = 15 * 1024 * 1024;
    private const int RequiredLetterCount = 4;
    private readonly string[] wizardSteps = ["Sender ID", "Documents", "Review"];
    private readonly List<IBrowserFile> authorizationFiles = [];
    private bool isVisible;
    private bool isSubmitting;
    private bool showValidation;
    private int currentStep = 1;
    private string senderId = string.Empty;

    [Parameter] public IBrowserFile? CacFile { get; set; }
    [Parameter] public IBrowserFile? LicenseFile { get; set; }
    [Parameter] public bool RequiresLicense { get; set; }
    [Parameter] public bool HasApprovedTransactionalId { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool SenderIdIsValid
    {
        get
        {
            var value = senderId.Trim();
            return value.Length is >= 3 and <= 11
                && char.IsLetter(value[0])
                && value.Any(char.IsLetter)
                && value.All(c => char.IsLetterOrDigit(c) || c == ' ');
        }
    }

    private string SenderIdError
    {
        get
        {
            var value = senderId.Trim();
            if (value.Length == 0) return "Enter a sender ID.";
            if (value.Length < 3 || value.Length > 11) return "Sender ID must be between 3 and 11 characters.";
            if (!char.IsLetter(value[0])) return "Sender ID must start with a letter.";
            return "Use letters, numbers and spaces only.";
        }
    }

    private bool DocumentsValid => authorizationFiles.Count == RequiredLetterCount
        && (HasApprovedTransactionalId || (CacFile is not null && (!RequiresLicense || LicenseFile is not null)));

    private bool CanContinue => currentStep switch
    {
        1 => SenderIdIsValid,
        2 => DocumentsValid,
        _ => !isSubmitting
    };

    public void Show()
    {
        Reset();
        isVisible = true;
        StateHasChanged();
    }

    private void Reset()
    {
        currentStep = 1;
        senderId = string.Empty;
        showValidation = false;
        authorizationFiles.Clear();
        isSubmitting = false;
    }

    private void ValidateSenderId(FocusEventArgs _) => showValidation = true;

    private async Task SelectLoaFiles(InputFileChangeEventArgs args)
    {
        authorizationFiles.Clear();
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = args.GetMultipleFiles(RequiredLetterCount);
        }
        catch (InvalidOperationException)
        {
            await alert.Error("Select exactly four authorization-letter PDF files.", "Four PDF files required");
            return;
        }

        if (files.Count != RequiredLetterCount || files.Any(file => !IsPdf(file) || file.Size > MaxFileBytes))
        {
            await alert.Error("Select exactly four authorization-letter PDFs. Each file must be 15 MB or smaller.", "Four valid PDF files required");
            return;
        }

        authorizationFiles.AddRange(files);
    }

    private static bool IsPdf(IBrowserFile file) => Path.GetExtension(file.Name).Equals(".pdf", StringComparison.OrdinalIgnoreCase);

    private async Task Continue(MouseEventArgs _)
    {
        if (currentStep == 1 && !SenderIdIsValid)
        {
            showValidation = true;
            return;
        }
        if (currentStep == 2 && !DocumentsValid)
        {
            await alert.Error("Upload the required business documents and all four authorization letters before continuing.", "Documents required");
            return;
        }
        if (currentStep < 3)
        {
            currentStep++;
            return;
        }
        await Submit();
    }

    private void PreviousStep(MouseEventArgs _) => currentStep = Math.Max(1, currentStep - 1);

    private Task OnVisibilityChanged(bool visible)
    {
        isVisible = visible;
        return Task.CompletedTask;
    }

    private async Task Submit()
    {
        var streams = new List<MemoryStream>();
        try
        {
            isSubmitting = true;
            if (!HasApprovedTransactionalId && CacFile is null)
                throw new InvalidOperationException("Upload your CAC document before requesting a sender ID.");
            if (!HasApprovedTransactionalId && RequiresLicense && LicenseFile is null)
                throw new InvalidOperationException("Upload your operating licence or clear the licence requirement checkbox.");

            var files = new List<FileParameter>();
            if (!HasApprovedTransactionalId)
            {
                streams.Add(await ToMemoryStream(CacFile!));
                files.Add(new FileParameter(streams[^1], $"CAC_{Path.GetFileName(CacFile!.Name)}", "application/pdf"));

                if (RequiresLicense)
                {
                    streams.Add(await ToMemoryStream(LicenseFile!));
                    files.Add(new FileParameter(streams[^1], $"Operating_License_{Path.GetFileName(LicenseFile!.Name)}", "application/pdf"));
                }
            }
            foreach (var file in authorizationFiles)
            {
                streams.Add(await ToMemoryStream(file));
                files.Add(new FileParameter(streams[^1], $"Authorization_Letter_{Path.GetFileName(file.Name)}", "application/pdf"));
            }
            await apiClient.SenderIdCreate2Async("CORPORATE", senderId.Trim(), "Transactional", "Transactional service notification", files);
            await alert.Success("Your sender ID request has been submitted.", "Request submitted");
            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage, "Unable to submit request");
        }
        catch (Exception ex)
        {
            await alert.Error($"The sender ID request could not be submitted. {ex.Message}", "Unable to submit request");
        }
        finally
        {
            foreach (var stream in streams)
                await stream.DisposeAsync();
            isSubmitting = false;
        }
    }

    private static async Task<MemoryStream> ToMemoryStream(IBrowserFile file)
    {
        var stream = new MemoryStream();
        await using var source = file.OpenReadStream(MaxFileBytes);
        await source.CopyToAsync(stream);
        stream.Position = 0;
        return stream;
    }

    private void Close(MouseEventArgs _) 
    {
        if (!isSubmitting)
            isVisible = false;
    }
}
