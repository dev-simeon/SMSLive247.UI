<Modal Title="@modalTitle" @bind-IsVisible="isVisible">
    <Body>
        <div class="space-y-5">
            @{
                string demo = "";
            }
            <FormInput Label="Select File"
                       Type="file" @bind-Value="demo"
                       accept="@acceptedFileTypes" 
                       HelpText="@supportedFormatsText"
                       OnFileChange="FileSelected" />

            @if (ForCSV)
            {
                <FormInput Label="File Name"
                           PlaceHolder="e.g. July Campaign"
                           @bind-Value="newFileName" />
            }
            else  
            {
                <div>
                    <span class="uppercase text-sm font-medium text-brand-400">Organize File</span>
                    <div class="flex gap-6">
                        <label class="flex cursor-pointer items-center gap-2 text-slate-700">
                            <input type="radio" class="accent-brand-500"
                                   name="organise_123"
                                   checked="@(!isMergeMode)"
                                   @onchange="e => isMergeMode = false" />
                            Save as new file
                        </label>
                        <label class="flex cursor-pointer items-center gap-2 text-slate-700">
                            <input type="radio" class="accent-brand-500"
                                   name="organise_123"
                                   checked="@(isMergeMode)"
                                   @onchange="e => isMergeMode = true" />
                            Merge into existing file
                        </label>
                    </div>
                </div>

                @if (isMergeMode == false)
                {
                    <FormInput Label="New File Name"
                               PlaceHolder="e.g New Customers"
                               @bind-Value="newFileName" 
                               Required="true" />
                }
                else 
                {
                    <FormSelect Label="Select Existing File" 
                                @bind-Value="mergeFileId" 
                                Required="true">
                        <option value="">— Choose a file to merge into —</option>
                        @foreach (var f in ExistingFiles)
                        {
                            <option value="@f.BatchFileID">@f.Description (@f.TotalNumbers.ToString("N0") records)</option>
                        }
                    </FormSelect>
                }

             @*    <FormSelect Label="Country Code"
                            Variant="FormSelect<int?>.SelectType.Country"
                            @bind-Value="countryCode" /> *@
            }

            <p class="flex items-center gap-1.5 text-sm text-slate-400">
                @* <Icon Style="Icon.IconStyle.Info" CssClass="h-3.5 w-3.5 shrink-0" /> *@
                Note: Duplicate numbers will be removed.
            </p>
        </div>
    </Body>

    <Footer>
        <Button Text="Upload & Process"
                Icon="Icon.IconStyle.Download"
                IsBusy="@isSubmitting"
                IsDisabled="@(selectedFile == null)"
                OnClick="HandleUpload" />

        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    private const long maxFileBytes = 20 * 1024 * 1024;

    [Parameter] public bool ForCSV { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public List<BatchFileResponse> ExistingFiles { get; set; } = [];

    private bool isVisible;
    private bool isMergeMode; //true: merge, false: newFile
    private bool isSubmitting;
    private int countryCode = 234;
    private string newFileName = string.Empty;
    private string mergeFileId = string.Empty;
    private IBrowserFile? selectedFile;

    private string modalTitle => ForCSV ? "Upload CSV / Excel File" : "Upload Bulk File";
    private string acceptedFileTypes => ForCSV ? ".csv,.xls,.xlsx,.xlx" : ".txt,.text";
    private string supportedFormatsText => "Supported formats: " + acceptedFileTypes.Replace(".", "").Replace(",", ", ").ToUpperInvariant();

    public void Show(int cCode = 234)
    {
        isMergeMode = false;
        countryCode = cCode;
        selectedFile = null;
        newFileName = string.Empty;
        mergeFileId = string.Empty;
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        StateHasChanged();
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null) return;

        isSubmitting = true;
        try
        {
            await using var stream = selectedFile.OpenReadStream(maxFileBytes);
            var file = new FileParameter(stream, selectedFile.Name, selectedFile.ContentType);

            if (!ForCSV && isMergeMode == true)
            {
                if (string.IsNullOrWhiteSpace(mergeFileId))
                    throw new Exception("Please select a file to merge into.");

                await apiClient.BatchFileUpdateAsync(mergeFileId, countryCode, file);
                await alert.Success("File merged successfully.");
            }
            else
            {
                if (string.IsNullOrWhiteSpace(newFileName))
                    throw new Exception("Please enter a name for the new file.");

                await apiClient.BatchFileCreateAsync(countryCode, file);
                await alert.Success("File uploaded successfully.");
            }

            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Upload Failed");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void FileSelected(InputFileChangeEventArgs e) => selectedFile = e.File;
}
