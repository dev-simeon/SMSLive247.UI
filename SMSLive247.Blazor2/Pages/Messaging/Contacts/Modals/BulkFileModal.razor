<Modal Title="@modalTitle" @bind-IsVisible="isVisible">
    <Body>
        <div class="space-y-5">
            <FormInput Type="file"
                       Label="Select File"
                       HelpText="@supportedFormatsText"
                       OnFileChange="FileSelected"
                       accept="@acceptedFileTypes"
                       @bind-Value="selectedFile" />

            @if (ForCSV)
            {
                <FormInput Label="File Name"
                           PlaceHolder="e.g. July Campaign"
                           @bind-Value="newFileName" />
            }
            else  
            {
                <div>
                    <span class="mb-2 block text-sm font-medium text-slate-700">Organize File</span>
                    <div class="flex gap-6">
                        <label class="flex cursor-pointer items-center gap-2 text-slate-700">
                            <input type="radio" class="accent-brand-500"
                                   name="organise_123"
                                   checked="@(!isMergeMode)"
                                   @onchange="e => isMergeMode = false" />
                            Save as new file
                        </label>
                        <label class="flex cursor-pointer items-center gap-2 text-slate-700">
                            <input type="radio" class="accent-brand-500"
                                   name="organise_123"
                                   checked="@(isMergeMode)"
                                   @onchange="e => isMergeMode = true" />
                            Merge into existing file
                        </label>
                    </div>
                </div>

                @if (!isMergeMode)
                {
                    <FormInput Label="New File Name"
                               PlaceHolder="e.g New Customers"
                               @bind-Value="newFileName" />
                }
                else 
                {
                    <FormSelect 
                        Label="Select Existing File"
                        @bind-Value="mergeFileId">
                            <option value="">— Choose a file to merge into —</option>
                            @foreach (var f in ExistingFiles)
                            {
                                <option value="@f.BatchFileID">@f.Description (@f.TotalNumbers.ToString("N0") records)</option>
                            }
                    </FormSelect>
                }
            }

            <p class="flex items-center gap-1.5 text-xs text-slate-500">
                <Icon Style="Icon.IconStyle.Info" CssClass="mt-px size-3.5 shrink-0" />
                Note: Duplicate numbers will be removed.
            </p>
        </div>
    </Body>

    <Footer>
        <Button Text="Upload & Process"
                Icon="Icon.IconStyle.Download"
                IsBusy="@isSubmitting"
                IsDisabled="@(selectedFile == null)"
                OnClick="HandleUpload" />

        <Button Text="Cancel"
                Style="ColorStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    private const long maxFileBytes = 20 * 1024 * 1024;
    [CascadingParameter(Name = "MainAccount")] public required AccountState State { get; set; }

    [Parameter, EditorRequired] public bool ForCSV { get; set; }
    [Parameter, EditorRequired] public EventCallback OnCompleted { get; set; }
    [Parameter, EditorRequired] public List<BatchFileResponse> ExistingFiles { get; set; } = [];

    private bool isVisible;
    private bool isMergeMode;
    private bool isSubmitting;
    private string newFileName = string.Empty;
    private string mergeFileId = string.Empty;
    private IBrowserFile? selectedFile;

    private string modalTitle           => ForCSV ? "Upload CSV / Excel File" : "Upload Bulk File";
    private string acceptedFileTypes    => ForCSV ? ".csv,.xls,.xlsx,.xlx" : ".txt,.text";
    private string supportedFormatsText => "Supported formats: " + acceptedFileTypes.Replace(".", "").Replace(",", ", ").ToUpperInvariant();

    public void Show()
    {
        isMergeMode = false;
        selectedFile = null;
        newFileName = string.Empty;
        mergeFileId = string.Empty;
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        StateHasChanged();
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null)
            throw new SystemException("Please select a file first.");

        try
        {
            isSubmitting = true;
            StateHasChanged();

            var countryCode = State.Account.CountryCode;
            var file = new FileParameter(selectedFile, newFileName);

            if (!ForCSV && isMergeMode)
            {
                if (string.IsNullOrWhiteSpace(mergeFileId))
                    throw new SystemException("Please select an existing file to merge into.");

                var response = await apiClient.BatchFileUpdateAsync(mergeFileId, countryCode, file);
                await alert.Success("File merged successfully.");
                await OnCompleted.InvokeAsync();
                isVisible = false;
            }
            else
            {
                var response = await apiClient.BatchFileCreateAsync(countryCode, file);
                await alert.Success("File uploaded successfully.");
                await OnCompleted.InvokeAsync();
                isVisible = false;
            }
        }
        catch (SystemException ex)
        {
            await alert.Error(ex.Message, "Validation Error");
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Upload Failed");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void FileSelected(InputFileChangeEventArgs e)
    {
        if (e.File != null && string.IsNullOrWhiteSpace(newFileName))
            newFileName = Path.GetFileNameWithoutExtension(e.File.Name);

        selectedFile = e.File;
        StateHasChanged();
    }
}
