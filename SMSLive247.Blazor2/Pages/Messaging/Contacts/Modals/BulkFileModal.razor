<Modal Title="@ModalTitle" @bind-IsVisible="isVisible">
    <Body>
        <div class="space-y-6">
            @if (!ForCSV)
            {
                <FormSelect Label="Country Code"
                            Type="FormSelect.SelectType.Country"
                            @bind-Value="CountryCodeString" />
            }

            <div class="space-y-4">
                <label class="block text-sm font-medium text-slate-700">
                    Upload File
                </label>

                @if (selectedFile == null)
                {
                    <label class="relative group cursor-pointer flex flex-col items-center justify-center w-full h-48 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 hover:bg-slate-100 hover:border-brand-500 transition-all duration-200">
                        <div class="flex flex-col items-center justify-center pt-5 pb-6">
                            <div class="p-3 mb-3 rounded-full bg-blue-50 text-brand-600 group-hover:bg-white group-hover:shadow-md transition-all duration-200">
                                <Icon Style="Icon.IconStyle.Download" CssClass="w-8 h-8" />
                            </div>
                            <p class="mb-2 text-sm text-slate-700 font-medium">
                                <span class="text-brand-600 hover:underline">Click to upload</span>
                                or drag and drop
                            </p>
                            <p class="text-xs text-slate-500 uppercase">
                                @SupportedFormatsText
                            </p>
                        </div>
                        <InputFile class="hidden" OnChange="FileSelected" accept="@AcceptedFileTypes" />
                    </label>
                }
                else
                {
                    <div class="bg-slate-50 rounded-lg border border-slate-200 p-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0">
                                    <Icon Style="@(ForCSV ? Icon.IconStyle.FileSpreadsheet : Icon.IconStyle.FileText)" CssClass="w-6 h-6" />
                                </div>
                                <div class="flex flex-col min-w-0">
                                    <span class="text-sm font-semibold text-slate-900 truncate">
                                        @selectedFile.Name
                                    </span>
                                    <span class="text-xs text-slate-500">
                                        @FormatFileSize(selectedFile.Size) - Ready
                                    </span>
                                </div>
                            </div>
                            <button type="button"
                                    @onclick="ClearFile"
                                    class="text-slate-400 hover:text-red-500 transition-colors p-1"
                                    title="Remove file">
                                <Icon Style="Icon.IconStyle.Trash" CssClass="w-5 h-5" />
                            </button>
                        </div>
                        <div class="w-full bg-slate-200 rounded-full h-1.5 mt-2 overflow-hidden">
                            <div class="bg-emerald-500 h-1.5 rounded-full w-full"></div>
                        </div>
                    </div>
                }

                <p class="text-xs text-slate-400 px-1">
                    Supported formats: @SupportedFormatsText
                </p>
            </div>

            <p class="text-xs text-slate-500 flex items-center gap-1.5">
                <Icon Style="Icon.IconStyle.Info" CssClass="w-3.5 h-3.5 shrink-0" />
                Duplicate numbers will be automatically removed during processing.
            </p>
        </div>
    </Body>
    <Footer>
        <Button Text="Upload & Process"
                Icon="Icon.IconStyle.Download"
                IsBusy="@isSubmitting"
                IsDisabled="@(selectedFile == null)"
                OnClick="HandleUpload" />
        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    private const long MaxFileBytes = 20 * 1024 * 1024;

    [Parameter] public bool ForCSV { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible;
    private bool isSubmitting;
    private IBrowserFile? selectedFile;
    private string? CountryCodeString { get; set; }

    private string ModalTitle => ForCSV ? "Upload CSV / Excel File" : "Upload Bulk File";
    private string AcceptedFileTypes => ForCSV ? ".csv,.xls,.xlsx,.xlx" : ".txt,.text";
    private string SupportedFormatsText => AcceptedFileTypes.Replace(".", "").Replace(",", ", ");

    public void Show()
    {
        selectedFile = null;
        CountryCodeString = null;
        isVisible = true;
        StateHasChanged();
    }

    private void FileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private void ClearFile()
    {
        selectedFile = null;
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null)
            return;

        if (!ForCSV && !int.TryParse(CountryCodeString, out _))
        {
            await alert.Error("Please select a country code.", "Validation Error");
            return;
        }

        isSubmitting = true;
        try
        {
            int? countryCode = null;
            if (int.TryParse(CountryCodeString, out var parsedCountryCode))
                countryCode = parsedCountryCode;

            await using var stream = selectedFile.OpenReadStream(MaxFileBytes);
            var file = new FileParameter(stream, selectedFile.Name, selectedFile.ContentType);
            await apiClient.BatchFileCreateAsync(countryCode, file);

            await alert.Success("File uploaded successfully.", "Success");
            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Upload Failed");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private Task Close()
    {
        isVisible = false;
        return Task.CompletedTask;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0)
            return "0 Bytes";

        string[] sizes = ["Bytes", "KB", "MB", "GB"];
        var order = Math.Min(sizes.Length - 1, (int)Math.Floor(Math.Log(bytes, 1024)));
        var size = bytes / Math.Pow(1024, order);
        return $"{size:0.##} {sizes[order]}";
    }
}
