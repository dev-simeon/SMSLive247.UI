<Modal Title="@modalTitle" @bind-IsVisible="isVisible">
    <Body>
        <div class="space-y-5">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Select File</label>
                <InputFile class="block w-full text-sm text-slate-700
                                  file:mr-4 file:py-2 file:px-4
                                  file:rounded-lg file:border-0
                                  file:text-sm file:font-semibold
                                  file:bg-brand-50 file:text-brand-700
                                  hover:file:bg-brand-100 file:cursor-pointer
                                  border border-slate-200 rounded-lg bg-white py-1.5 px-2 cursor-pointer focus:outline-none"
                           accept="@acceptedFileTypes" 
                           OnChange="FileSelected" />
                <p class="mt-1 text-xs text-slate-400">@supportedFormatsText</p>
            </div>

            @if (ForCSV)
            {
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">File Name</label>
                    <input type="text"
                           class="block w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none"
                           placeholder="e.g. July Campaign"
                           @bind="newFileName" @bind:event="oninput" />
                </div>
            }
            else  
            {
                <div>
                    <span class="block text-sm font-medium text-slate-700 mb-2">Organize File</span>
                    <div class="flex gap-6">
                        <label class="flex cursor-pointer items-center gap-2 text-slate-700">
                            <input type="radio" class="accent-brand-500"
                                   name="organise_123"
                                   checked="@(!isMergeMode)"
                                   @onchange="e => isMergeMode = false" />
                            Save as new file
                        </label>
                        <label class="flex cursor-pointer items-center gap-2 text-slate-700">
                            <input type="radio" class="accent-brand-500"
                                   name="organise_123"
                                   checked="@(isMergeMode)"
                                   @onchange="e => isMergeMode = true" />
                            Merge into existing file
                        </label>
                    </div>
                </div>

                @if (!isMergeMode)
                {
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">New File Name</label>
                        <input type="text"
                               class="block w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none"
                               placeholder="e.g New Customers"
                               @bind="newFileName" @bind:event="oninput" />
                    </div>
                }
                else 
                {
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Select Existing File</label>
                        <select class="block w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none"
                                @bind="mergeFileId">
                            <option value="">— Choose a file to merge into —</option>
                            @foreach (var f in ExistingFiles)
                            {
                                <option value="@f.BatchFileID">@f.Description (@f.TotalNumbers.ToString("N0") records)</option>
                            }
                        </select>
                    </div>
                }
            }

            <p class="flex items-center gap-1.5 text-xs text-slate-500">
                <Icon Style="Icon.IconStyle.Info" CssClass="h-3.5 w-3.5 shrink-0 mt-px" />
                Note: Duplicate numbers will be removed.
            </p>
        </div>
    </Body>

    <Footer>
        <Button Text="Upload & Process"
                Icon="Icon.IconStyle.Download"
                IsBusy="@isSubmitting"
                IsDisabled="@(selectedFile == null)"
                OnClick="HandleUpload" />

        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    private const long maxFileBytes = 20 * 1024 * 1024;

    [Parameter] public bool ForCSV { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public EventCallback<BatchFileResponse> OnFileUploaded { get; set; }
    [Parameter] public List<BatchFileResponse> ExistingFiles { get; set; } = [];

    private bool isVisible;
    private bool isMergeMode;
    private bool isSubmitting;
    private int countryCode = 234;
    private string newFileName = string.Empty;
    private string mergeFileId = string.Empty;
    private IBrowserFile? selectedFile;

    private string modalTitle => ForCSV ? "Upload CSV / Excel File" : "Upload Bulk File";
    private string acceptedFileTypes => ForCSV ? ".csv,.xls,.xlsx,.xlx" : ".txt,.text";
    private string supportedFormatsText => "Supported formats: " + acceptedFileTypes.Replace(".", "").Replace(",", ", ").ToUpperInvariant();

    public void Show(int cCode = 234)
    {
        isMergeMode = false;
        countryCode = cCode;
        selectedFile = null;
        newFileName = string.Empty;
        mergeFileId = string.Empty;
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        StateHasChanged();
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null)
        {
            await alert.Error("Please select a file first.", "Validation Error");
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            await using var stream = selectedFile.OpenReadStream(maxFileBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var ext = Path.GetExtension(selectedFile.Name);
            var fileNameToSend = string.IsNullOrWhiteSpace(newFileName) 
                ? selectedFile.Name 
                : (newFileName.EndsWith(ext, StringComparison.OrdinalIgnoreCase) ? newFileName : $"{newFileName}{ext}");

            var file = new FileParameter(ms, fileNameToSend, selectedFile.ContentType);

            if (!ForCSV && isMergeMode)
            {
                if (string.IsNullOrWhiteSpace(mergeFileId))
                {
                    await alert.Error("Please select an existing file to merge into.", "Validation Error");
                    return;
                }

                await apiClient.BatchFileUpdateAsync(mergeFileId, countryCode, file);
                await alert.Success("File merged successfully.");
                isVisible = false;
                await OnCompleted.InvokeAsync();
            }
            else
            {
                var response = await apiClient.BatchFileCreateAsync(countryCode, file);
                await alert.Success("File uploaded successfully.");
                isVisible = false;
                if (OnFileUploaded.HasDelegate && response?.Result != null)
                {
                    await OnFileUploaded.InvokeAsync(response.Result);
                }
                else
                {
                    await OnCompleted.InvokeAsync();
                }
            }
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Upload Failed");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void FileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        if (selectedFile != null && string.IsNullOrWhiteSpace(newFileName))
        {
            newFileName = Path.GetFileNameWithoutExtension(selectedFile.Name);
        }
        StateHasChanged();
    }
}
