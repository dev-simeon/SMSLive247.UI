<Modal Title="@ModalTitle" @bind-IsVisible="isVisible">
    <Body>
        <div class="space-y-5">

            @* ── File picker ── *@
            <div class="space-y-1">
                <label class="block text-sm font-medium text-slate-700">Select File</label>
                <InputFile class="block w-full text-sm text-slate-700
                                  file:mr-4 file:py-2 file:px-4
                                  file:rounded-lg file:border-0
                                  file:text-sm file:font-semibold
                                  file:bg-brand-50 file:text-brand-700
                                  hover:file:bg-brand-100 file:cursor-pointer
                                  border border-slate-200 rounded-lg bg-white py-1.5 px-2 cursor-pointer"
                           accept="@AcceptedFileTypes"
                           OnChange="FileSelected" />
                <p class="text-xs text-slate-400">
                    Supported formats: @SupportedFormatsText
                </p>
            </div>

            @* ── For CSV: File Name field ── *@
            @if (ForCSV)
            {
                <FormInput Label="File Name"
                           PlaceHolder="Enter a name for this file e.g. Campaign July"
                           @bind-Value="fileName" />
            }

            @* ── For Bulk: Organise (new vs merge) ── *@
            @if (!ForCSV)
            {
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">Organize File</label>
                    <div class="flex gap-6">
                        <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
                            <input type="radio" class="accent-brand-500"
                                   name="organise_@_uid"
                                   checked="@(groupMode == "NEW")"
                                   @onchange='_ => groupMode = "NEW"' />
                            Save as new file
                        </label>
                        <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
                            <input type="radio" class="accent-brand-500"
                                   name="organise_@_uid"
                                   checked="@(groupMode == "MERGE")"
                                   @onchange='_ => groupMode = "MERGE"' />
                            Merge into existing file
                        </label>
                    </div>
                </div>

                @if (groupMode == "NEW")
                {
                    <FormInput Label="File Name"
                               PlaceHolder="Enter a name for this file"
                               @bind-Value="fileName" />
                }
                else if (groupMode == "MERGE")
                {
                    <FormSelect TValue="string" Label="Select Existing File" @bind-Value="mergeFileId" Required="true">
                        <option value="">— Choose a file to merge into —</option>
                        @foreach (var f in existingBulkFiles)
                        {
                            <option value="@f.BatchFileID">@f.Description (@f.TotalNumbers.ToString("N0") records)</option>
                        }
                    </FormSelect>
                }

                <FormSelect Label="Country Code"
                            Variant="FormSelect<int?>.SelectType.Country"
                            @bind-Value="countryCode" />
            }

            <p class="flex items-center gap-1.5 text-xs text-slate-500 leading-none">
                <Icon Style="Icon.IconStyle.Info" CssClass="h-3.5 w-3.5 shrink-0 leading-none" />
                <span class="leading-none">Note: Duplicate numbers will be removed.</span>
            </p>
        </div>
    </Body>

    <Footer>
        <Button Text="@SubmitLabel"
                Icon="Icon.IconStyle.Download"
                IsBusy="@isSubmitting"
                IsDisabled="@IsSubmitDisabled"
                OnClick="HandleUpload" />
        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    private const long MaxFileBytes = 20 * 1024 * 1024;

    [Parameter] public bool ForCSV { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public List<BatchFileResponse> ExistingFiles { get; set; } = [];

    private bool isVisible;
    private bool isSubmitting;
    private IBrowserFile? selectedFile;
    private int? countryCode;
    private string groupMode = "NEW";
    private string fileName = string.Empty;
    private string mergeFileId = string.Empty;
    private readonly string _uid = Guid.NewGuid().ToString("N")[..6];

    private List<BatchFileResponse> existingBulkFiles =>
        ExistingFiles.Where(f => string.Equals(f.FileType, "txt", StringComparison.OrdinalIgnoreCase)).ToList();

    private string ModalTitle => ForCSV ? "Upload CSV / Excel File" : "Upload Bulk File";
    private string SubmitLabel => groupMode == "MERGE" ? "Merge & Process" : "Upload & Process";
    private string AcceptedFileTypes => ForCSV ? ".csv,.xls,.xlsx,.xlx" : ".txt,.text";
    private string SupportedFormatsText => AcceptedFileTypes.Replace(".", "").Replace(",", ", ").ToUpperInvariant();

    private bool IsSubmitDisabled
    {
        get
        {
            if (selectedFile == null) return true;
            if (!ForCSV && groupMode == "MERGE" && string.IsNullOrWhiteSpace(mergeFileId)) return true;
            return false;
        }
    }

    public void Show(List<BatchFileResponse>? allFiles = null)
    {
        selectedFile = null;
        countryCode = null;
        groupMode = "NEW";
        fileName = string.Empty;
        mergeFileId = string.Empty;
        if (allFiles != null)
            ExistingFiles = allFiles;
        isVisible = true;
        StateHasChanged();
    }

    private void FileSelected(InputFileChangeEventArgs e) => selectedFile = e.File;

    private async Task HandleUpload()
    {
        if (selectedFile == null) return;

        if (!ForCSV && !countryCode.HasValue)
        {
            await alert.Error("Please select a country code.", "Validation Error");
            return;
        }

        isSubmitting = true;
        try
        {
            await using var stream = selectedFile.OpenReadStream(MaxFileBytes);
            var file = new FileParameter(stream, selectedFile.Name, selectedFile.ContentType);

            if (!ForCSV && groupMode == "MERGE" && !string.IsNullOrWhiteSpace(mergeFileId))
            {
                await apiClient.BatchFileUpdateAsync(mergeFileId, countryCode, file);
                await alert.Success("File merged successfully.");
            }
            else
            {
                await apiClient.BatchFileCreateAsync(countryCode, file);
                await alert.Success("File uploaded successfully.");
            }

            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Upload Failed");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private Task Close()
    {
        isVisible = false;
        return Task.CompletedTask;
    }
}
