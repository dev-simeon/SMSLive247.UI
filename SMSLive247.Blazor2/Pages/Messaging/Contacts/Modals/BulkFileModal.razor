<Modal Title="@ModalTitle" @bind-IsVisible="isVisible">
    <Body>
        <div class="space-y-6">
            @if (!ForCSV)
            {
                <FormSelect Label="Country Code"
                            Variant="FormSelect<int?>.SelectType.Country"
                            @bind-Value="countryCode" />
            }

            <div class="space-y-4">
                <label class="block text-sm font-medium text-slate-700">
                    Upload File
                </label>

                @if (selectedFile == null)
                {
                    <label class="group relative flex h-48 w-full cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 transition-all duration-200 hover:border-brand-500 hover:bg-slate-100">
                        <div class="flex flex-col items-center justify-center pt-5 pb-6">
                            <div class="text-brand-600 mb-3 rounded-full bg-blue-50 p-3 transition-all duration-200 group-hover:bg-white group-hover:shadow-md">
                                <Icon Style="Icon.IconStyle.Download" CssClass="h-8 w-8" />
                            </div>
                            <p class="mb-2 text-sm font-medium text-slate-700">
                                <span class="text-brand-600 hover:underline">Click to upload</span>
                                or drag and drop
                            </p>
                            <p class="text-xs text-slate-500 uppercase">
                                @SupportedFormatsText
                            </p>
                        </div>
                        <InputFile class="hidden" OnChange="FileSelected" accept="@AcceptedFileTypes" />
                    </label>
                }
                else
                {
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                        <div class="mb-2 flex items-center justify-between">
                            <div class="flex min-w-0 items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                                    <Icon Style="@(ForCSV ? Icon.IconStyle.FileSpreadsheet : Icon.IconStyle.FileText)" CssClass="h-6 w-6" />
                                </div>
                                <div class="flex min-w-0 flex-col">
                                    <span class="truncate text-sm font-semibold text-slate-900">
                                        @selectedFile.Name
                                    </span>
                                    <span class="text-xs text-slate-500">
                                        @FormatFileSize(selectedFile.Size) - Ready
                                    </span>
                                </div>
                            </div>
                            <button type="button"
                                    @onclick="ClearFile"
                                    class="p-1 text-slate-400 transition-colors hover:text-red-500"
                                    title="Remove file">
                                <Icon Style="Icon.IconStyle.Trash" CssClass="h-5 w-5" />
                            </button>
                        </div>
                        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
                            <div class="h-1.5 w-full rounded-full bg-emerald-500"></div>
                        </div>
                    </div>
                }

                <p class="px-1 text-xs text-slate-400">
                    Supported formats: @SupportedFormatsText
                </p>
            </div>

            <p class="flex items-center gap-1.5 text-xs text-slate-500">
                <Icon Style="Icon.IconStyle.Info" CssClass="h-3.5 w-3.5 shrink-0" />
                Duplicate numbers will be automatically removed during processing.
            </p>
        </div>
    </Body>
    <Footer>
        <Button Text="Upload & Process"
                Icon="Icon.IconStyle.Download"
                IsBusy="@isSubmitting"
                IsDisabled="@(selectedFile == null)"
                OnClick="HandleUpload" />
        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    private const long MaxFileBytes = 20 * 1024 * 1024;

    [Parameter] public bool ForCSV { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible;
    private bool isSubmitting;
    private IBrowserFile? selectedFile;
    private int? countryCode;

    private string ModalTitle => ForCSV ? "Upload CSV / Excel File" : "Upload Bulk File";
    private string AcceptedFileTypes => ForCSV ? ".csv,.xls,.xlsx,.xlx" : ".txt,.text";
    private string SupportedFormatsText => AcceptedFileTypes.Replace(".", "").Replace(",", ", ");

    public void Show()
    {
        selectedFile = null;
        countryCode = null;
        isVisible = true;
        StateHasChanged();
    }

    private void FileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private void ClearFile()
    {
        selectedFile = null;
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null)
            return;

        if (!ForCSV && !countryCode.HasValue)
        {
            await alert.Error("Please select a country code.", "Validation Error");
            return;
        }

        isSubmitting = true;
        try
        {
            await using var stream = selectedFile.OpenReadStream(MaxFileBytes);
            var file = new FileParameter(stream, selectedFile.Name, selectedFile.ContentType);
            await apiClient.BatchFileCreateAsync(countryCode, file);

            await alert.Success("File uploaded successfully.");
            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Upload Failed");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private Task Close()
    {
        isVisible = false;
        return Task.CompletedTask;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0)
            return "0 Bytes";

        string[] sizes = ["Bytes", "KB", "MB", "GB"];
        var order = Math.Min(sizes.Length - 1, (int)Math.Floor(Math.Log(bytes, 1024)));
        var size = bytes / Math.Pow(1024, order);
        return $"{size:0.##} {sizes[order]}";
    }
}
