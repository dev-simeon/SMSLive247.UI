<Modal Title="@modalTitle" Size="Modal.ModalSize.Large" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="GroupForm" Model="@model" OnValidSubmit="HandleSubmit" class="space-y-6">
            <FormInput Label="Group Name"
                       PlaceHolder="e.g. Summer VIP List"
                       @bind-Value="model.GroupName"
                       disabled="@isEditMode"
                       Required="true" />

            <SearchBox InstantSearch="true" Placeholder="Find a contact..." @bind-SearchTerm="pickerSearch"></SearchBox>

            <div class="overflow-x-hidden overflow-y-auto h-64 border border-slate-200 rounded-lg p-3 bg-slate-50 shadow-inner">
                @{
                    var filteredContacts = AllContacts.Where(x => x.Visible);
                }

                @if (!filteredContacts.Any())
                {
                    <p class="text-sm text-slate-500 italic">No contacts found</p>
                }
                else
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        @foreach (var contact in filteredContacts)
                        {
                            <div class="flex items-center gap-2">
                                <input type="checkbox"
                                       value="@contact.Key" checked="@contact.Selected"
                                       id="gc-@contact.Key" @onchange="e => OnContactSelect(e, contact)"
                                       class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                                <label class="text-sm text-slate-700 cursor-pointer select-none truncate" 
                                       for="gc-@contact.Key" title="@contact.Name (@contact.Key)">
                                    @contact.Name
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>

            <label class="text-slate-400">
                @AllContacts.Where(x => x.Selected).Count() Members Selected
            </label>

        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true"
                Text="@(isEditMode ? "Update Group" : "Create Group")"
                Icon="Icon.IconStyle.Save"
                IsBusy="@isSubmitting"
                form="GroupForm" />

        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public List<ContactModel> AllContacts { get; set; } = [];

    private bool isVisible;
    private bool isEditMode;
    private bool isSubmitting;
    private string pickerSearch = string.Empty;
    private GroupResponse model = new();

    private string modalTitle => isEditMode ? "Edit Group Members" : "Create New Group";

    public void Show(GroupResponse? group = null)
    {
        AllContacts.ForEach(x => x.Selected = false);
        isEditMode = group != null;
        model = group ?? new();

        if (group != null)
        {
            var selected = group.Members.Select(x => x.PhoneNumber).ToList();
            AllContacts.Where(x => selected.Contains(x.Key))
                .ToList().ForEach(x => x.Selected = true);
        }
        isVisible = true;
        StateHasChanged();
    }

    private void OnContactSelect(ChangeEventArgs e, ContactModel contact)
    {
        contact.Selected = (bool?)e.Value ?? false;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(model.GroupName))
        {
            await alert.Error("Please enter a group name.", "Validation Error");
            return;
        }

        isSubmitting = true;
        var selectedMembers = AllContacts.Where(x => x.Selected).Select(x => x.Key).ToList();

        try
        {
            if (isEditMode)
            {
                await apiClient.GroupUpdateAsync(model.GroupName, selectedMembers);
                await alert.Success("Group updated successfully.");
            }
            else
            {
                await apiClient.GroupCreateAsync(model.GroupName.Trim(), selectedMembers);
                await alert.Success("Group created successfully.");
            }

            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void Close()
    {
        isVisible = false;
    }
}
