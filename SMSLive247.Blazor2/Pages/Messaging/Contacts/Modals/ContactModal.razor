<Modal Title="@ModalTitle" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="ContactForm" Model="@model" OnValidSubmit="HandleSubmit" class="space-y-6">
            <FormInput Label="Full Name"
                       PlaceHolder="e.g. Sarah Smith"
                       IconStyle="Icon.IconStyle.User"
                       @bind-Value="model.ContactName"
                       Required="true" />

            <div class="space-y-1">
                <FormInput Label="Phone Number"
                           PlaceHolder="+234 800 000 0000"
                           Type="tel"
                           @bind-Value="model.PhoneNumber"
                           disabled="@isEditMode"
                           Required="true" />
                <p class="flex items-center gap-1 text-xs text-slate-500">
                    <Icon Style="Icon.IconStyle.Info" CssClass="h-3.5 w-3.5" />
                    Please include country code.
                </p>
            </div>

                <div class="space-y-2">
                    <div class="flex justify-between">
                        <label class="block text-sm font-medium text-slate-700">
                            Assign to Groups
                        </label>
                        <span class="text-xs text-slate-500 italic">Optional</span>
                    </div>

                    <div class="max-h-48 overflow-y-auto rounded-lg border border-slate-200 bg-slate-50 p-3">
                        @if (isLoadingGroups)
                        {
                            <div class="flex items-center justify-center py-4">
                                <div class="border-brand-500 h-5 w-5 animate-spin rounded-full border-2 border-t-transparent"></div>
                            </div>
                        }
                        else if (groups.Count > 0)
                        {
                            <div class="grid grid-cols-1 gap-2">
                                @foreach (var group in groups)
                                {
                                    <button type="button"
                                            @onclick="() => ToggleGroup(group.GroupName)"
                                            class="@GetGroupButtonClass(group.GroupName)">
                                        <span>@group.GroupName</span>
                                        @if (IsSelected(group.GroupName))
                                        {
                                            <Icon Style="Icon.IconStyle.CheckCircle" CssClass="h-4 w-4" />
                                        }
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="py-4 text-center text-xs text-slate-400">
                                No groups found. Create a group first to assign contacts.
                            </p>
                        }
                    </div>
                </div>
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true"
                Text="@(isEditMode ? "Update Contact" : "Save Contact")"
                Icon="Icon.IconStyle.Save"
                IsBusy="@isSubmitting"
                form="ContactForm" />
        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSubmitting;
    private bool isLoadingGroups;
    private string? originalPhoneNumber;
    private ContactUpdateRequest model = new();
    private List<GroupResponse> groups = [];
    private HashSet<string> selectedGroups = [];

    private string ModalTitle => isEditMode ? "Edit Contact" : "Add New Contact";

    public void Show(ContactResponse? contact = null)
    {
        isEditMode = contact != null;
        originalPhoneNumber = contact?.PhoneNumber;
        model = new ContactUpdateRequest
        {
            ContactName = contact?.ContactName ?? string.Empty,
            PhoneNumber = contact?.PhoneNumber ?? string.Empty,
            Groups = contact?.Groups?.ToList() ?? []
        };
        selectedGroups = model.Groups?.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
        isVisible = true;
        _ = LoadGroups();
        StateHasChanged();
    }

    private async Task LoadGroups()
    {
        isLoadingGroups = true;
        try
        {
            var response = await apiClient.GroupListAsync();
            groups = response.Result?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Groups");
        }
        finally
        {
            isLoadingGroups = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleGroup(string? groupName)
    {
        if (string.IsNullOrWhiteSpace(groupName))
            return;

        if (!selectedGroups.Add(groupName))
            selectedGroups.Remove(groupName);
    }

    private bool IsSelected(string? groupName) =>
        !string.IsNullOrWhiteSpace(groupName) && selectedGroups.Contains(groupName);

    private string GetGroupButtonClass(string? groupName)
    {
        var selected = IsSelected(groupName);
        return selected
            ? "flex items-center justify-between px-3 py-2 rounded-md text-sm transition-all bg-brand-50 text-brand-700 border border-brand-200 shadow-sm"
            : "flex items-center justify-between px-3 py-2 rounded-md text-sm transition-all bg-white text-slate-600 border border-slate-200 hover:border-brand-300";
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(model.ContactName) || string.IsNullOrWhiteSpace(model.PhoneNumber))
        {
            await alert.Error("Please enter both contact name and phone number.", "Validation Error");
            return;
        }

        isSubmitting = true;
        model.Groups = selectedGroups.ToList();

        try
        {
            if (isEditMode)
            {
                await apiClient.ContactUpdateAsync(originalPhoneNumber ?? model.PhoneNumber, model);
                await alert.Success("Contact updated successfully.");
            }
            else
            {
                var request = new ContactCreateRequest
                {
                    ContactName = model.ContactName,
                    PhoneNumber = model.PhoneNumber,
                    Groups = model.Groups
                };
                await apiClient.ContactCreateAsync(request);
                await alert.Success("Contact created successfully.");
            }

            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private Task Close()
    {
        isVisible = false;
        return Task.CompletedTask;
    }
}
