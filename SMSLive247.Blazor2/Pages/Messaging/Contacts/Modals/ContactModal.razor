<Modal Title="@modalTitle" Size="Modal.ModalSize.Medium" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="ContactForm" Model="@editModel" OnValidSubmit="HandleSubmit" class="space-y-4">
            @if (!isEditMode)
            {
                <div class="space-y-1">
                    @for (int i = 0; i < contactFields.Count; i++)
                    {
                        var index = i;
                        <div class="flex gap-2">
                            <div class="flex-1">
                                <FormInput PlaceHolder="@($"Contact Name {@index + 1}")"
                                           @bind-Value="contactFields[index].ContactName" />
                            </div>
                            <div class="flex-1">
                                <FormInput PlaceHolder="@($"Phone Number {@index + 1}")" Type="tel"
                                           @bind-Value="contactFields[index].PhoneNumber" />
                            </div>
                        </div>
                    }
                </div>

                <div class="">
                    <button type="button" class="text-brand-600 hover:text-brand-700" 
                            @onclick="AddField">
                        <span>Add More Contact</span>
                    </button>
                </div>
            }
            else
            {
                <div class="flex gap-2">
                    <FormInput Label="Contact Name" class="flex-1"
                               PlaceHolder="e.g. Sarah Smith"
                               @bind-Value="editModel.ContactName"
                               Required="true" />

                    <FormInput Label="Phone Number" class="flex-1"
                               PlaceHolder="+2348000000000"
                               Type="tel" disabled="true"
                               @bind-Value="editModel.PhoneNumber"
                               Required="true" />
                </div>
            }

            <div class="pt-1">
                @if (AllGroups.Count > 0)
                {
                    <label class="font-medium text-slate-700 mb-2">
                        Assign to Groups <span class="font-xs text-slate-400 italic">(Optional)</span>
                    </label>

                    <div class="flex gap-3">
                        @foreach (var group in AllGroups)
                        {
                            <div class="flex items-center gap-1">
                                <input type="checkbox"
                                       value="@group.Key" checked="@group.Selected"
                                       id="cg-@group.Key" @onchange="e => OnGroupSelect(e, group)" class="accent-brand-500 h-4 w-4 rounded border-slate-300" />
                                <label class="text-sm text-slate-700 cursor-pointer select-none truncate" for="cg-@group.Key" title="@group.Key">
                                    @group.Key
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true"
                Text="@(isEditMode ? "Update Contact" : "Save Contacts")"
                Icon="Icon.IconStyle.Save"
                IsBusy="@isSubmitting"
                form="ContactForm" />

        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    [Parameter] public List<GroupModel> AllGroups { get; set; } = [];
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSubmitting;

    private ContactUpdateRequest editModel = new();
    private List<ContactResponse> contactFields = [];

    private string modalTitle => isEditMode ? "Edit Contact" : "Add New Contacts";

    public void Show(ContactResponse? contact = null)
    {
        isEditMode = contact != null;
        AllGroups.ForEach(x => x.Selected = false);

        if (contact != null)
        {
            editModel = new ContactUpdateRequest
            {
                ContactName = contact.ContactName,
                PhoneNumber = contact.PhoneNumber,
                Groups = contact.Groups
            };

            if (contact.Groups != null)
                AllGroups.Where(x => contact.Groups.Contains(x.Key))
                    .ToList().ForEach(x => x.Selected = true);
        }
        else
        {
            contactFields = [new(), new(), new(), new(), new()];
        }

        isVisible = true;
        StateHasChanged();
    }

    private void AddField()
    {
        contactFields.Add(new());
    }
    
    private void OnGroupSelect(ChangeEventArgs e, GroupModel group)
    {
        group.Selected = (bool?)e.Value ?? false;
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            var selectedGroups = AllGroups.Where(x => x.Selected).Select(x => x.Key).ToList();

            if (isEditMode)
            {
                if (string.IsNullOrWhiteSpace(editModel.ContactName) || string.IsNullOrWhiteSpace(editModel.PhoneNumber))
                {
                    await alert.Error("Please enter both contact name and phone number.", "Validation Error");
                    return;
                }

                editModel.Groups = selectedGroups;
                await apiClient.ContactUpdateAsync(editModel.PhoneNumber, editModel);
                await alert.Success("Contact updated successfully.");
            }
            else
            {
                var validContacts = contactFields.Where(x => !string.IsNullOrWhiteSpace(x.PhoneNumber)).ToList();
                if (validContacts.Count == 0)
                {
                    await alert.Error("Please enter at least one phone number.", "Validation Error");
                    return;
                }

                var tasks = validContacts.Select(contact =>
                {
                    var request = new ContactCreateRequest
                    {
                        ContactName = contact.ContactName,
                        PhoneNumber = contact.PhoneNumber,
                        Groups = selectedGroups
                    };
                    return apiClient.ContactCreateAsync(request);
                });

                await Task.WhenAll(tasks);
                await alert.Success($"{validContacts.Count} contact(s) created successfully.");
            }

            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void Close()
    {
        isVisible = false;
    }
}
