

@using SMSLive247.Blazor.Pages.Messaging.Contacts.Modals

<PageBody>
    <HeaderLeft>
        <SearchBox Placeholder="Search files..." @bind-SearchTerm="searchQuery" />
    </HeaderLeft>
    <HeaderRight>
        <Button Text="Upload Text File" Icon="Icon.IconStyle.Download" @onclick="HandleUpload" />
    </HeaderRight>

    <ChildContent>
        <Table Items="paginatedFiles" EmptyMessage="No files uploaded yet.">
            <Columns>
                <Column Header="File / Description">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                            <Icon Style="Icon.IconStyle.FileText" CssClass="h-5 w-5" />
                        </div>
                        <div>
                            <p class="text-sm font-medium text-slate-900">@(string.IsNullOrEmpty(context.Description) ? "—" : context.Description)</p>
                            <p class="font-mono text-xs text-slate-400 uppercase">@context.FileType</p>
                        </div>
                    </div>
                </Column>
                <Column Header="Records">
                    <span class="text-sm font-semibold text-slate-900">@context.TotalNumbers.ToString("#,##0")</span>
                </Column>
                <Column Header="Date Uploaded">
                    <FormatDate DateTime="@context.DateCreated" />
                </Column>
                <Column>
                    <Actions OnDownload="() => HandleDownload(context)"
                             OnDelete="() => HandleDelete(context)">
                    </Actions>
                </Column>
            </Columns>
        </Table>
    </ChildContent>

    <FooterLeft>
        <Paging @bind-PageNumber="pageNumber"
                @bind-PageSize="pageSize"
                TotalRecords="filteredFiles?.Count">
        </Paging>
    </FooterLeft>
</PageBody>

<BulkFileModal @ref="uploadModal" OnCompleted="FetchFiles" ExistingFiles="files" />

@code {
    private string? searchQuery;
    private int pageNumber = 1;
    private int pageSize = 25;

    private bool isLoading = false;
    private BulkFileModal uploadModal = new();
    private List<BatchFileResponse>? files;

    protected override async Task OnInitializedAsync()
    {
        await FetchFiles();
    }

    private async Task FetchFiles()
    {
        try
        {
            isLoading = true;
            var res = await apiClient.BatchFileListAsync();
            files = res.Result.Where(f => string.Equals(f.FileType, "txt", StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (Exception)
        {
            files = [];
            await alert.Error("Failed to load bulk text files.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<BatchFileResponse>? filteredFiles
    {
        get
        {
            if (files is null)
                return null;

            if (string.IsNullOrWhiteSpace(searchQuery))
                return files;

            var q = searchQuery.Trim().ToLowerInvariant();
            return files.Where(f => f.Description != null && f.Description.ToLowerInvariant().Contains(q)).ToList();
        }
    }

    private List<BatchFileResponse>? paginatedFiles
    {
        get
        {
            return filteredFiles?
                .Skip((pageNumber - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
    }

    private void HandleUpload()
    {
        uploadModal.Show();
    }

    private async Task HandleDownload(BatchFileResponse file)
    {
        try
        {
            await js.DownloadFromStream(file, apiClient);
        }
        catch (Exception)
        {
            await alert.Error("Failed to download file.");
        }
    }

    private async Task HandleDelete(BatchFileResponse file)
    {
        var desc = string.IsNullOrEmpty(file.Description) ? file.BatchFileID : file.Description;

        if (await alert.Confirm($"Are you sure you want to delete file '{desc}'?", "Confirm Delete"))
        {
            try
            {
                await apiClient.BatchFileDeleteAsync(file.BatchFileID);
                await alert.Success("File deleted successfully.");
                await FetchFiles();
            }
            catch (Exception)
            {
                await alert.Error("Failed to delete file.");
            }
        }
    }
}
