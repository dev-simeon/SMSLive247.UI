<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchQuery" OnSearch="ReloadData">
            <DateRange DateRangeChanged="OnDateRangeChanged" />
        </SearchBox>
    </HeaderLeft>
    <HeaderRight>
        <Button Text="Export Messages" Icon="Icon.IconStyle.Download" OnClick="HandleExport" />
    </HeaderRight>

    <ChildContent>
        <Table DataSource="ds">
            <Columns>
                <Column Header="Date / Time" Width="180px">
                    <FormatDate DateTime="@context.DateSubmitted"></FormatDate>
                </Column>
                <Column Header="Status">
                    <Badge Variant="Badge.StatusVariant.BatchMessage" Value="@context.Status" />
                </Column>
                <Column Header="Sender" Width="100px">
                    <strong>@context.SenderID</strong>
                </Column>
                <Column Header="Message">
                    <p class="max-w-md wrap-break-word">@context.MessageText</p>
                </Column>
                <Column Header="Delivery">
                    <a href="@Const.Routes.Messaging.MessageDetailsUrl(context.BatchID)" target="_blank" class="block transition-opacity hover:opacity-75">
                        <div class="text-end font-mono text-xs text-nowrap text-emerald-600 uppercase" title="Total Processed">
                            @context.TotalProcessed.ToString("#,##0") PASS
                        </div>
                        <div class="text-end font-mono text-xs text-nowrap text-rose-600 uppercase" title="Total Failed">
                            @context.TotalFailed.ToString("#,##0") FAIL
                        </div>
                    </a>
                </Column>
                <Column Header="Credits" Width="100px" Align="right">
                    <FormatCredit Credits="@context.CreditsCharged" Title="Credits Charged" />
                </Column>
                <Column>
                    <Actions ViewLink="@Const.Routes.Messaging.MessageDetailsUrl(context.BatchID)"
                             OnDelete="e => HandleDelete(context)">
                    </Actions>
                </Column>
                </Columns>
            </Table>
    </ChildContent>
    <FooterLeft>
        <Paging PageNumber="ds.PageState.PageNumber"
                PageSize="ds.PageState.PageSize"
                TotalRecords="ds.PageState.TotalCount"
                PageNumberChanged="OnPageChange"
                PageSizeChanged="OnPageSizeChange">
        </Paging>
    </FooterLeft>
</PageBody>


@code {
    private string? searchQuery;
    private DateTime? filterFrom;
    private DateTime? filterTo;
    private ApiDataSource<SmsBatchResponse> ds = new();

    protected override async Task OnInitializedAsync()
    {
        ds.Callback = new((PageState p, FilterState? f) =>
        {
            return apiClient.SmsBatchListAsync(p.PageNumber, p.PageSize, filterFrom, filterTo, searchQuery);
        });

        ds.SetPage(new PageState(100, 1));
        await ds.LoadData(alert);
    }

    private async Task ReloadData()
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, 1));
        await ds.LoadData(alert);
    }

    private async Task HandleExport()
    {
        try
        {
            var response = await apiClient.SmsBatchDownloadAsync(filterFrom, filterTo, searchQuery);
            var fileName = $"sent-sms-{filterFrom:dd-MMM-yyyy}-to-{filterTo:dd-MMM-yyyy}.csv";

            await js.DownloadFromStream(fileName, response.Stream);
        }
        catch (Exception)
        {
            await alert.Error("Failed to download file.");
        }
    }


    private async Task HandleDelete(SmsBatchResponse batch)
    {       
        if (await alert.Confirm("Are you sure you want to delete this batch?", "Confirm Delete"))
        {
            await apiClient.SmsBatchDeleteAsync(batch.BatchID);
            await alert.Success("Batch deleted successfully.");
            await ReloadData();
        }
    }

    private void OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        filterFrom = range.From;
        filterTo = range.To;
    }

    private async Task OnPageChange(int page)
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, page));
        await ds.LoadData(alert);
    }

    private async Task OnPageSizeChange(int size)
    {
        ds.SetPage(new PageState(size, ds.PageState.PageNumber));
        await ds.LoadData(alert);
    }
}
