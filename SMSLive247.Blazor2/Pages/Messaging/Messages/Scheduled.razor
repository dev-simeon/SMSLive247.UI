<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchQuery" OnSearch="ReloadData" />
    </HeaderLeft>
    <ChildContent>
        <Table DataSource="ds">
            <Columns>
                <Column Header="Scheduled Time" Width="180px">
                    <FormatDate DateTime="@context.DateSubmitted"></FormatDate>
                </Column>
                <Column Header="Status">
                    <Badge Variant="Badge.StatusVariant.BatchMessage" Value="@context.Status" />
                </Column>
                <Column Header="Sender" Width="100px">
                    <span class="font-medium text-slate-900 text-sm">@context.SenderID?.ToUpper()</span>
                </Column>
                <Column Header="Message">
                    <p class="text-sm text-slate-600 truncate max-w-md" title="@context.MessageText">@context.MessageText</p>
                </Column>
                <Column>
                    <Actions>
                        <button class="flex items-center gap-3 px-4 py-2 text-sm text-brand-700 hover:bg-brand-50 w-full text-left transition-colors"
                                @onclick="e => ResumeBatch(context.BatchID)"
                                @onclick:stopPropagation="true" title="Resume Batch">
                            <Icon Style="Icon.IconStyle.CheckCircle" CssClass="text-brand-500 w-4 h-4 text-center" />
                            Send Immediately
                        </button>
                        <button class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 w-full text-left transition-colors"
                                @onclick="e => AbortBatch(context.BatchID)"
                                @onclick:stopPropagation="true" title="Abort Batch">
                            <Icon Style="Icon.IconStyle.Close" CssClass="text-red-500 w-4 h-4 text-center" />
                            Abort
                        </button>
                    </Actions>
                </Column>
            </Columns>
        </Table>
    </ChildContent>
    <FooterLeft>
        <Paging PageNumber="ds.PageState.PageNumber"
                PageSize="ds.PageState.PageSize"
                TotalRecords="ds.PageState.TotalCount"
                PageNumberChanged="OnPageChange"
                PageSizeChanged="OnPageSizeChange">
        </Paging>
    </FooterLeft>
</PageBody>

@code {

    private string? searchQuery;
    private ApiDataSource<SmsBatchResponse> ds = new();

    protected override async Task OnInitializedAsync()
    {
        ds.Callback = new((PageState p, FilterState? f) =>
        {
            return apiClient.SmsBatchPendingListAsync();
        });

        ds.SetPage(new PageState(100, 1));
        await ds.LoadData(alert);
    }
    
    private async Task AbortBatch(long batchId)
    {
        bool confirmed = await alert.Confirm("Are you sure you want to cancel this batch?");
        if (confirmed)
        {
            await apiClient.SmsBatchPendingAbortAsync(batchId);
            await ReloadData();
        }
    }

    private async Task ResumeBatch(long batchId)
    {
        bool confirmed = await alert.Confirm("Are you sure you want to resume this batch now?");
        if (confirmed)
        {
            await apiClient.SmsBatchPendingResumeAsync(batchId);
            await ReloadData();
        }
    }

    private async Task ReloadData()
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, 1));
        await ds.LoadData(alert);
    }

    private async Task OnPageChange(int page)
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, page));
        await ds.LoadData(alert);
    }

    private async Task OnPageSizeChange(int size)
    {
        ds.SetPage(new PageState(size, ds.PageState.PageNumber));
        await ds.LoadData(alert);
    }
}