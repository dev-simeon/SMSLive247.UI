@attribute [Route(Const.Routes.Support.ContactUs)]
@layout MainLayout

<PageTitle>SMSLive247 - Contact Us</PageTitle>

<PageHeader Title="Contact Us"
            SubTitle="Have a question or need help? Reach out and our support team will get back to you." />

<PageBody>
    <ChildContent>
        <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-6">

            @* Contact Form *@
            <div class="space-y-4">
                <h3 class="text-sm font-semibold text-slate-700">Send Us a Message</h3>

                <div class="space-y-1">
                    <label class="text-xs font-medium text-slate-600">Subject</label>
                    <FormInput @bind-Value="subject" Placeholder="e.g. Issue with sender ID approval" />
                </div>
                <div class="space-y-1">
                    <label class="text-xs font-medium text-slate-600">Priority</label>
                    <FormSelect @bind-Value="priority">
                        <option value="low">Low</option>
                        <option value="medium" selected>Medium</option>
                        <option value="high">High</option>
                        <option value="critical">Critical</option>
                    </FormSelect>
                </div>
                <div class="space-y-1">
                    <label class="text-xs font-medium text-slate-600">Message</label>
                    <textarea class="w-full border border-slate-200 rounded-lg px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-300 focus:border-brand-400 min-h-32 resize-none"
                              placeholder="Describe your issue in detail..."
                              @bind="message" />
                </div>
                <Button Icon="Icon.IconStyle.Mail" Text="Submit Ticket" @onclick="SubmitTicket" />
            </div>

            @* Contact Info *@
            <div class="space-y-4">
                <h3 class="text-sm font-semibold text-slate-700">Other Ways to Reach Us</h3>
                <div class="space-y-3">
                    <div class="flex items-start gap-3 p-4 border border-slate-200 rounded-xl bg-white">
                        <Icon Style="Icon.IconStyle.Mail" CssClass="w-5 h-5 text-brand-500 shrink-0 mt-0.5" />
                        <div>
                            <p class="text-sm font-semibold text-slate-800">Email Support</p>
                            <p class="text-sm text-slate-500">support@smslive247.com</p>
                            <p class="text-xs text-slate-400 mt-0.5">Response within 24 hours</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-4 border border-slate-200 rounded-xl bg-white">
                        <Icon Style="Icon.IconStyle.Globe" CssClass="w-5 h-5 text-brand-500 shrink-0 mt-0.5" />
                        <div>
                            <p class="text-sm font-semibold text-slate-800">Live Chat</p>
                            <p class="text-sm text-slate-500">Available Mon–Fri, 9 AM–6 PM WAT</p>
                            <p class="text-xs text-slate-400 mt-0.5">Fastest support channel</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-4 border border-slate-200 rounded-xl bg-white">
                        <Icon Style="Icon.IconStyle.HelpCircle" CssClass="w-5 h-5 text-brand-500 shrink-0 mt-0.5" />
                        <div>
                            <p class="text-sm font-semibold text-slate-800">Help Center</p>
                            <p class="text-sm text-slate-500">Browse our knowledge base for common answers</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </ChildContent>
    <FooterLeft>
        <p class="text-xs text-slate-400">Our support team operates Monday to Friday, 9 AM – 6 PM WAT.</p>
    </FooterLeft>
</PageBody>

@code {
    private string? subject;
    private string? priority = "medium";
    private string? message;

    private async Task SubmitTicket()
    {
        if (string.IsNullOrWhiteSpace(subject) || string.IsNullOrWhiteSpace(message))
        {
            await alert.Error("Please fill in all required fields.", "Validation Error");
            return;
        }
        // TODO: Call API to submit ticket
        await alert.Success("Your ticket has been submitted. We'll get back to you shortly.", "Ticket Submitted");
        subject = null;
        message = null;
    }
}
