@attribute [Route(Const.Routes.Support.ContactUs)]
@layout MainLayout
@inject IJSRuntime JSRuntime

<PageTitle>SMSLive247 - Contact Us</PageTitle>

<PageHeader Title="Contact Support"
            SubTitle="Reach out to our team directly via our official channels below. For technical issues that require tracking, please use the ticket system." />

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-6">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden h-full">
            <div class="p-6 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                    <Icon Style="Icon.IconStyle.CheckCircle" CssClass="text-brand-500 w-5 h-5" />
                    Official Communication Channels
                </h3>
            </div>
            <div class="divide-y divide-slate-100">
                <a href="mailto:info@smslive247.com"
                   class="p-6 flex items-start gap-4 hover:bg-slate-50 transition-colors group cursor-pointer w-full text-left">
                    <div class="bg-slate-100 p-3 rounded-xl text-slate-500 group-hover:text-brand-600 group-hover:bg-brand-50 transition-colors shrink-0">
                        <Icon Style="Icon.IconStyle.Mail" CssClass="w-6 h-6" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">
                            Email Support
                        </p>
                        <span class="text-base font-medium text-brand-600 group-hover:underline truncate block">
                            info@smslive247.com
                        </span>
                        <p class="text-sm text-slate-500 mt-1">
                            For general inquiries and partnership proposals.
                        </p>
                    </div>
                </a>

                <a href="tel:+2348099999247"
                   class="p-6 flex items-start gap-4 hover:bg-slate-50 transition-colors group cursor-pointer w-full text-left">
                    <div class="bg-slate-100 p-3 rounded-xl text-slate-500 group-hover:text-brand-600 group-hover:bg-brand-50 transition-colors shrink-0">
                        <Icon Style="Icon.IconStyle.Phone" CssClass="w-6 h-6" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">
                            Call Center
                        </p>
                        <div class="space-y-1">
                            <span class="text-base font-medium text-slate-900 group-hover:text-brand-600 transition-colors block">
                                +234-809-9999-247
                            </span>
                            <span class="text-base font-medium text-slate-900 group-hover:text-brand-600 transition-colors block">
                                +234-704-7332-240
                            </span>
                        </div>
                        <p class="text-sm text-slate-500 mt-1">
                            Mondays - Fridays : 8AM - 5PM
                        </p>
                    </div>
                </a>

                <button type="button"
                        @onclick="OpenChat"
                        class="p-6 flex items-start gap-4 hover:bg-slate-50 transition-colors group cursor-pointer w-full text-left">
                    <div class="bg-slate-100 p-3 rounded-xl text-slate-500 group-hover:text-brand-600 group-hover:bg-brand-50 transition-colors shrink-0">
                        <Icon Style="Icon.IconStyle.HelpCircle" CssClass="w-6 h-6" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">
                            Live Chat
                        </p>
                        <span class="text-base font-medium text-slate-900 group-hover:text-brand-600 transition-colors block">
                            Start a conversation
                        </span>
                        <p class="text-sm text-slate-500 mt-1">
                            Available 24/7 for quick questions.
                        </p>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <div class="space-y-6">
        <div class="bg-blue-50 rounded-xl border border-blue-100 p-6 flex items-start gap-4">
            <div class="bg-blue-100 p-2.5 rounded-lg shrink-0 text-brand-600">
                <Icon Style="Icon.IconStyle.Clock" CssClass="w-5 h-5" />
            </div>
            <div>
                <h3 class="text-base font-semibold text-slate-900">
                    Estimated Response Time
                </h3>
                <p class="text-sm text-slate-600 mt-1">
                    We typically respond to inquiries within
                    <span class="font-bold text-brand-600">2 hours</span> during business days.
                </p>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
            <div class="flex items-start gap-4">
                <div class="bg-slate-100 p-3 rounded-xl text-slate-500">
                    <Icon Style="Icon.IconStyle.Globe" CssClass="w-6 h-6" />
                </div>
                <div class="flex-1">
                    <h3 class="text-lg font-bold text-slate-900 mb-2">
                        Visit Our Office
                    </h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        6 Oremeta Street, Oregun,<br />
                        Ikeja, Lagos State,<br />
                        Nigeria.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="h-12"></div>

@code {
    private async Task OpenChat()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("smsliveOpenTawkChat");
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Live Chat");
        }
    }
}
