@attribute [Route(Const.Routes.Support.Coverage)]
@layout MainLayout

<PageTitle>SMSLive247 - Coverage</PageTitle>

<PageHeader Title="Global Network Coverage Lookup"
            SubTitle="Search and view comprehensive network coverage and termination rates for supported countries." />

<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchText" OnSearch="ApplySearch" />
    </HeaderLeft>
    <HeaderRight>
        <Button Text="Export CSV" Icon="Icon.IconStyle.Download" Style="ColorStyle.Secondary" />
    </HeaderRight>

    <ChildContent>
        <Table Items="filteredItems" AllowSelect="false">
            <Columns>
                <Column Header="Country">
                    <span class="text-sm font-medium text-slate-900">@context.CountryName</span>
                </Column>
                <Column Header="Network Operator">
                    <span class="text-sm font-medium text-slate-600">@context.NetworkName</span>
                </Column>
            </Columns>
        </Table>
    </ChildContent>

    <FooterLeft>
    </FooterLeft>
</PageBody>

@code {
    private string searchText = "";
    private List<CoverageResponse> items = [];
    private List<CoverageResponse> filteredItems = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await apiClient.CoverageListAsync();

            if (response.StatusCode == 200)
            {
                items = response.Result.ToList();
                filteredItems = items;
            }
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredItems = items;
        }
        else
        {
            filteredItems = items.Where(x =>
                   (x.CountryName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                || (x.NetworkName.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }
}
