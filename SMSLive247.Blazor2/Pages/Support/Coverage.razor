@attribute [Route(Const.Routes.Support.Coverage)]
@attribute [Route(Const.Routes.Wallet.Pricing)]

@layout MainLayout

<PageTitle>SMSLive247 - Coverage</PageTitle>

<PageHeader Title="Network Coverage and Pricing"
            SubTitle="Search and view network coverage and termination prices for supported countries." />


<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchText" OnSearch="ApplySearch" />
    </HeaderLeft>
    <HeaderRight>
        <Button Text="Export CSV" Icon="Icon.IconStyle.Download" Style="ColorStyle.Secondary" />
    </HeaderRight>

    <ChildContent>
        @if (filteredItems is { Count: > 0 })
        {
            <Table Items="filteredItems" AllowSelect="false">
                <Columns>
                    <Column Header="Route ID">
                        @context.RouteID
                    </Column>
                    <Column Header="Country">
                        @context.Network.CountryName
                    </Column>
                    <Column Header="Network">
                        @context.Network.NetworkName
                    </Column>
                    <Column Header="Traffic Type">
                        @context.RouteTypeID
                    </Column>

                    @if(MainAccount != null && MainAccount.Account.Wallet == "SMS")
                    {
                        <Column Header="SMS Charge">
                            @* <FormatBalance Wallet="SMS" Balance="@context.SmsCharge" Title="" /> *@
                            <b>@context.SmsCharge</b> Units per SMS message (160 chars)
                        </Column>
                    }
                    else
                    {
                        <Column Header="Cash Charge">
                            <b>@context.CashCharge</b> Naira per SMS message (160 chars)
                            @* <FormatBalance Wallet="CASH" Balance="@context.CashCharge" Title="" /> *@
                        </Column>
                    }
                </Columns>
            </Table>
        }
        else
        {
            <div class="flex min-h-48 items-center justify-center px-4 text-center">
                <p class="text-sm text-slate-500 dark:text-slate-400">No coverage results found. Try another country or network.</p>
            </div>
        }
    </ChildContent>

    <FooterLeft>
    </FooterLeft>
</PageBody>

@code {
    [CascadingParameter(Name = "MainAccount")] private AccountState? MainAccount { get; set; }

    private string searchText = "Nigeria";
    private List<RouteResponse>? items;
    private List<RouteResponse>? filteredItems;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await apiClient.RouteListAsync();
            items = response.Result?.ToList() ?? [];
            items = items.Where(x => x.RouteTypeID == "PROMOTIONAL").ToList();
            ApplySearch();
        }
        catch (ApiException ex)
        {
            items = [];
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            items = [];
            await alert.Error($"An error occurred while fetching coverage information. {ex.Message}");
        }
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredItems = items;
        }
        else
        {

            filteredItems = (items ?? []).Where(x =>
                   (x.RouteName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.ProviderID?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }
}