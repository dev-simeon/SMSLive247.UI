@attribute [Route(Const.Routes.Developer.ApiKeys)]
@layout MainLayout

<PageTitle>SMSLive247 - API Keys</PageTitle>

<PageHeader 
    Title="API Keys" 
    SubTitle="Manage your API keys for programmatic access to the platform.">
</PageHeader>

<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchQuery" OnSearch="ReloadData" />
    </HeaderLeft>

    <ChildContent>
        <Table Items="accounts">
            <Columns>
                <Column Header="Account" Width="38%">
                    <div>
                        <span class="font-medium text-slate-900">@context.AccountName</span>
                        <div class="mt-0.5 font-mono text-xs text-slate-400">@context.AccountID</div>
                    </div>
                </Column>
                <Column Header="Type">
                    <Badge Style="@(context.Phone == "main" ? Badge.BadgeStyle.Success : Badge.BadgeStyle.Neutral)" 
                           Value="@(context.Phone == "main" ? "MAIN ACCOUNT" : "SUB ACCOUNT")" />
                </Column>
                <Column Header="API Key">
                    <div class="flex items-center gap-3">
                        <span class="font-mono text-xs text-slate-700">
                            @(IsKeyVisible(context) ? GetKeyString(context.Key) : "••••••••••••••••••••••••••••••••")
                        </span>
                        <button @onclick="() => ToggleKeyVisibility(context)" class="text-slate-400 hover:text-slate-600 transition-colors" title="Toggle visibility">
                            <Icon Style="@(IsKeyVisible(context) ? Icon.IconStyle.EyeOff : Icon.IconStyle.Eye)" CssClass="h-4 w-4" />
                        </button>
                    </div>
                </Column>
                <Column Header="" Width="56px">
                    @if (IsKeyVisible(context))
                    {
                        <button @onclick="() => ResetApiKey(context)"
                                class="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-brand-50 rounded-md transition-all"
                                title="Reset API Key">
                            <Icon Style="Icon.IconStyle.Refresh" CssClass="h-4 w-4" />
                        </button>
                    }
                </Column>
                <Column Header="Date Created" Width="160px">
                    <FormatDate DateTime="@context.DateCreated" />
                </Column>
            </Columns>
        </Table>
    </ChildContent>

    <FooterLeft>
    </FooterLeft>
</PageBody>

@code {
    private string? searchQuery;
    private List<AccountResponse> accounts =[];
    private HashSet<string> visibleKeys = new();

    private void ToggleKeyVisibility(AccountResponse account)
    {
        if (visibleKeys.Contains(account.AccountID))
            visibleKeys.Remove(account.AccountID);
        else
            visibleKeys.Add(account.AccountID);
    }

    private bool IsKeyVisible(AccountResponse account) => visibleKeys.Contains(account.AccountID);

    protected override async Task OnInitializedAsync()
    {
        await ReloadData();
    }

    private async Task ReloadData()
    {
        var t1 = apiClient.AccountGetAsync("self");
        var t2 = apiClient.AccountsListAsync(1, 200, null, null);

        await Task.WhenAll(t1, t2);

        var mainAccount = t1.Result.Result;
        accounts = t2.Result.Result.ToList();

        mainAccount.Phone = "main"; // hack to identify main acct

        accounts.Insert(0, mainAccount);
    }

    private static string GetKeyString(byte[]? key)
    {
        if (key == null || key.Length == 0) return "—";
        try { return new Guid(key).ToString().ToUpperInvariant(); }
        catch { return "—"; }
    }

    private async Task ResetApiKey(AccountResponse account)
    {
        try
        {
            bool confirmed = await alert.Confirm(
                $"This will immediately invalidate the current API key for [{account.AccountName}]. " +
                $"Any applications using it will stop authenticating. Continue?",
                "Reset API Key");

            if (!confirmed) return;

            // var response = await apiClient.AccountUpdateProviderKeyAsync(
            //     account.AccountID, new AccountProviderKeyRequest());

            await alert.Success("API key reset successfully. Please update your integrations.", "Key Regenerated");
            await ReloadData();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
    }
}

