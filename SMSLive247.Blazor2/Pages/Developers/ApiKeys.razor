@attribute [Route(Const.Routes.Developer.ApiKeys)]
@layout MainLayout

<PageTitle>SMSLive247 - API Keys</PageTitle>

<PageHeader 
    Title="API Keys" 
    SubTitle="Manage your API keys for programmatic access to the platform.">
</PageHeader>

<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchQuery" OnSearch="ReloadData" />
    </HeaderLeft>

    <ChildContent>
        <Table Items="accounts">
            <Columns>
                <Column Header="Account" Width="25%">
                    <span class="font-medium text-slate-900">@context.AccountName</span>
                </Column>
                <Column Header="Type">
                    @if (context.Phone == "main")
                    {
                        <Badge Style="ColorStyle.Danger" Value="MAIN ACCOUNT" />
                    }
                    else
                    {
                        <Badge Style="ColorStyle.Info" Value="SUB ACCOUNT" />
                    }
                </Column>
                <Column Header="API Key">
                    <ApiKeyDisplay Account="@context" OnReset="ReloadData" />
                </Column>
                <Column Header="Date Created" Width="160px">
                    <FormatDate DateTime="@context.DateCreated" />
                </Column>
            </Columns>
        </Table>
    </ChildContent>

    <FooterLeft>
    </FooterLeft>
</PageBody>

@code {
    private string? searchQuery;
    private List<AccountResponse>? accounts;

    protected override async Task OnInitializedAsync()
    {
        await ReloadData();
    }

    private async Task ReloadData()
    {
        try
        {
            var t1 = apiClient.AccountGetAsync("self");
            var t2 = apiClient.AccountsListAsync(1, 200, null);

            await Task.WhenAll(t1, t2);

            var mainAccount = t1.Result.Result;
            accounts = t2.Result.Result.ToList();

            mainAccount.Phone = "main"; // hack to identify main acct

            accounts.Insert(0, mainAccount);
        }
        catch (ApiException ex)
        {
            accounts = [];
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            accounts = [];
            await alert.Error($"An error occurred while fetching API keys. {ex.Message}");
        }
    }
}
