<Modal Title="Update Profile" @bind-IsVisible="isVisible">

    <Body>
        <EditForm FormName="BasicInfo" Model="@accountUpdateRequest" OnValidSubmit="HandleValidSubmit" class="space-y-4">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <FormInput Label="First Name" @bind-Value="accountUpdateRequest.FirstName" required="true" />
            <FormInput Label="Last Name" @bind-Value="accountUpdateRequest.LastName" required="true" />
            <FormInput Label="Email Address" @bind-Value="accountUpdateRequest.Email" disabled="true" />
            <FormInput Label="Phone Number" @bind-Value="accountUpdateRequest.Phone" disabled="true" />

            <FormSelect Label="Country" Type="FormSelect.SelectType.Country" @bind-Value="CountryCodeString"
                        IsEmbedded="false" />
            <FormSelect Label="Time Zone" Type="FormSelect.SelectType.TimeZone" @bind-Value="TimeZoneString"
                        IsEmbedded="false" />
        </EditForm>
    </Body>

    <Footer>
        <Button IsSubmit="true" Text="Save Changes" />
    </Footer>
</Modal>

@code {
    [Parameter] public AccountResponse account { get; set; } = new();
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible = false;
    private AccountUpdateRequest accountUpdateRequest = new();
    private string? CountryCodeString { get; set; }
    private string? TimeZoneString { get; set; }

    // ✅ Country list with code & label
    private List<(string Name, string Code)> CountryList = new()
{
("Nigeria", "+234"),
("Ghana", "+233"),
("Kenya", "+254"),
("South Africa", "+27"),
("United Kingdom", "+44"),
("United States", "+1")
};

    // ✅ Time zones cleanly represented
    private List<(string Label, int Value)> TimeZones = Enumerable.Range(-12, 25)
    .Select(i => ($"GMT {(i >= 0 ? "+" + i : i.ToString())}", i))
    .ToList();

    protected override void OnParametersSet()
    {
        accountUpdateRequest.FirstName = account.FirstName;
        accountUpdateRequest.LastName = account.LastName;
        accountUpdateRequest.Email = account.AccountName;
        accountUpdateRequest.Phone = account.Phone;
        accountUpdateRequest.TimeZone = account.TimeZone;
        accountUpdateRequest.CountryCode = account.CountryCode;

        var country = CountryList.FirstOrDefault(c => c.Code.TrimStart('+') == account.CountryCode.ToString());
        if (country.Code != null)
        {
            CountryCodeString = account.CountryCode.ToString();
        }

        TimeZoneString = account.TimeZone.ToString();
    }

    public void show()
    {
        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (!string.IsNullOrEmpty(CountryCodeString))
            {
                accountUpdateRequest.CountryCode = int.Parse(CountryCodeString.TrimStart('+'));
            }

            if (!string.IsNullOrEmpty(TimeZoneString) && int.TryParse(TimeZoneString, out int tz))
            {
                accountUpdateRequest.TimeZone = tz;
            }

            var response = await apiClient.AccountUpdateAsync(account.AccountID, accountUpdateRequest);

            if (response.StatusCode == 200)
            {
                await alert.Success("Profile updated successfully.", "Success");
                await OnCompleted.InvokeAsync();
            }
            else
            {
                await alert.Error("Failed to update profile.", "Error");
            }
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error");
        }
        finally
        {
            isVisible = false;
            StateHasChanged();
        }
    }
}