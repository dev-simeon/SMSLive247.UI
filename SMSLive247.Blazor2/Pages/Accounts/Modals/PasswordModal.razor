<Modal Title="Change Password" @bind-IsVisible="isVisible">

    <Body>
        <EditForm id="f1" FormName="f1" Model="@model" OnValidSubmit="HandleSubmit" class="space-y-4">
            <FormInput Label="Old Password" 
                       Type="password" 
                       @bind-Value="model.OldPassword" 
                       PlaceHolder="Enter current password"
                       Required="true" />
            <FormInput Label="New Password" 
                       Type="password" 
                       @bind-Value="model.NewPassword" 
                       PlaceHolder="Enter new password"
                       Required="true" />
            <FormInput Label="Confirm Password" 
                       Type="password" 
                       @bind-Value="confirmNewPassword" 
                       PlaceHolder="Confirm new password"
                       Required="true" />
        </EditForm>
    </Body>
    <Footer>
        <Button form="f1" IsSubmit="true" Text="Change Password" IsBusy="@isSubmitting" />
    </Footer>
</Modal>

@code {
    [Parameter] public AccountResponse Account { get; set; } = new();

    private AccountPasswordRequest model = new();
    private string confirmNewPassword = string.Empty;
    private bool isSubmitting = false;
    private bool isVisible = false;

    public void Show()
    {
        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;

            if (model.NewPassword != confirmNewPassword)
                throw new Exception("Passwords do not match.");

            var response = await apiClient.AccountChangePasswordAsync(Account.AccountID, model);
            await alert.Success("Password changed successfully.");
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isSubmitting = false;
            isVisible = false;
            StateHasChanged();
        }
    }
}
