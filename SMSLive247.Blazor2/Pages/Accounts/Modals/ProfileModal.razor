<Modal Title="Update Profile" @bind-IsVisible="isVisible">

    <Body>
        <EditForm FormName="f1" Model="@model" OnValidSubmit="HandleSubmit" class="space-y-4">
            <FormInput @bind-Value="model.FirstName" Label="First Name" Required="true" />   
            <FormInput @bind-Value="model.LastName" Label="Last Name" Required="true" />
            <FormInput @bind-Value="model.Email" Label="Email Address" Disabled="true" />
            <FormInput @bind-Value="model.Phone" Label="Phone Number" Disabled="true" />
            <FormSelect @bind-Value="model.CountryCode" Label="Country" Variant="FormSelect<int?>.SelectType.Country" />
            <FormSelect @bind-Value="model.TimeZone" Label="Time Zone" Variant="FormSelect<int?>.SelectType.TimeZone" />
        </EditForm>
    </Body>

    <Footer>
        <Button form="f1" IsSubmit="true" Text="Save Changes" IsBusy="@isSubmitting" />
    </Footer>
</Modal>

@code {
    [Parameter] public AccountResponse Account { get; set; } = new();
    [Parameter] public EventCallback OnCompleted { get; set; }

    private AccountUpdateRequest model = new();
    private bool isSubmitting = false;
    private bool isVisible = false;

    protected override void OnParametersSet()
    {
        model.FirstName = Account.FirstName;
        model.LastName = Account.LastName;
        model.Email = Account.AccountName;
        model.Phone = Account.Phone;
        model.TimeZone = Account.TimeZone;
        model.CountryCode = Account.CountryCode;
    }

    public void Show()
    {
        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;
            var response = await apiClient.AccountUpdateAsync(Account.AccountID, model);

            await alert.Success("Profile updated successfully.");
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isSubmitting = false;
            isVisible = false;
            StateHasChanged();
        }
    }
}
