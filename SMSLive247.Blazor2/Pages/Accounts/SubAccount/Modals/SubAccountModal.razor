@namespace SMSLive247.Blazor2.Pages.Accounts.SubAccount.Modals

<Modal Title="@modalTitle" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="SubAccountForm" Model="@formModel" OnValidSubmit="HandleSubmit" class="space-y-6">
            @if (isEditMode)
            {
                <div>
                    <label class="block text-sm font-medium text-slate-700">Account Name</label>
                    <div class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700">
                        @account.AccountName
                    </div>
                </div>

                <FormRow Cols="2">
                    <FormInput Label="First Name"
                               PlaceHolder="First Name"
                               @bind-Value="updateModel.FirstName"
                               Required="true" />
                    <FormInput Label="Last Name"
                               PlaceHolder="Last Name"
                               @bind-Value="updateModel.LastName"
                               Required="true" />
                </FormRow>

                <FormRow Cols="2">
                    <FormInput Label="Email Address"
                               Type="email"
                               PlaceHolder="email@example.com"
                               @bind-Value="updateModel.Email"
                               Required="true" />
                    <FormInput Label="Phone Number"
                               Type="tel"
                               PlaceHolder="e.g. 08030000000"
                               @bind-Value="updateModel.Phone"
                               Required="true" />
                </FormRow>

                <FormRow Cols="2">
                    <FormSelect Label="Country Code"
                                Variant="FormSelect<int?>.SelectType.Country"
                                @bind-Value="updateModel.CountryCode" />
                    <FormSelect Label="Time Zone (GMT Offset)"
                                Variant="FormSelect<int?>.SelectType.TimeZone"
                                @bind-Value="updateModel.TimeZone"  />
                </FormRow>
            }
            else
            {
                <FormInput Label="Account Name"
                           PlaceHolder="e.g. Marketing Dept"
                           @bind-Value="createModel.AccountName"
                           Required="true" />

                <FormRow Cols="2">
                    <FormInput Label="First Name"
                               PlaceHolder="First Name"
                               @bind-Value="createModel.FirstName"
                               Required="true" />
                    <FormInput Label="Last Name"
                               PlaceHolder="Last Name"
                               @bind-Value="createModel.LastName"
                               Required="true" />
                </FormRow>

                <FormRow Cols="2">
                    <FormInput Label="Email Address"
                               Type="email"
                               PlaceHolder="email@example.com"
                               @bind-Value="createModel.Email"
                               Required="true" />
                    <FormInput Label="Phone Number"
                               Type="tel"
                               PlaceHolder="e.g. 08030000000"
                               @bind-Value="createModel.Phone"
                               Required="true" />
                </FormRow>

                <FormRow Cols="2">
                    <FormSelect Label="Country Code"
                                Variant="FormSelect<int>.SelectType.Country"
                                @bind-Value="createModel.CountryCode" />
                    <FormSelect Label="Time Zone (GMT Offset)"
                                Variant="FormSelect<int>.SelectType.TimeZone"
                                @bind-Value="createModel.TimeZone" />
                </FormRow>

                <FormInput Label="Password"
                           Type="password"
                           PlaceHolder="••••••••"
                           @bind-Value="createModel.Password"
                           Required="true"
                           HelpText="Must be at least 8 characters with numbers and symbols."
                           />
            }
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true"
                Text="@(isEditMode ? "Update Sub-Account" : "Create Sub-Account")"
                form="SubAccountForm"
                Icon="@(isEditMode ? Icon.IconStyle.Save : Icon.IconStyle.PlusCircle)"
                IsBusy="@isSubmitting" />
        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="() => isVisible = false" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible = false;
    private bool isSubmitting = false;
    private bool isEditMode = false;
    private string modalTitle = "Add Sub-Account";

    private AccountCreateRequest createModel = new();
    private AccountUpdateRequest updateModel = new();
    private AccountResponse account = new();

    private object formModel => isEditMode ? (object)updateModel : createModel;

    public void Show()
    {
        isEditMode = false;
        modalTitle = "Add Sub-Account";
        createModel = new();
        isVisible = true;
        StateHasChanged();
    }

    // Open for Edit
    public void Show(AccountResponse account)
    {
        isEditMode = true;
        modalTitle = "Edit Sub-Account";
        this.account = account;

        updateModel = new AccountUpdateRequest
        {
            FirstName = account.FirstName,
            LastName = account.LastName,
            Email = account.Email,
            Phone = account.Phone,
            CountryCode = account.CountryCode,
            TimeZone = account.TimeZone
        };

        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;

            if (isEditMode)
            {
                await apiClient.AccountUpdateAsync(account.AccountID, updateModel);
                await alert.Success("Sub-account updated successfully.", "Success");
            }
            else
            {
                await apiClient.AccountCreateAsync(createModel);
                await alert.Success("Sub-account created successfully.", "Success");
            }

            await OnCompleted.InvokeAsync();
            isVisible = false;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
