@namespace SMSLive247.Blazor.Pages.Accounts.SubAccount.Modals

@if (accountId != null)
{
    <Modal Title="Edit Sub-Account" @bind-IsVisible="isVisible">
        <Body>
            <EditForm id="updateForm" Model="@updateModel" OnValidSubmit="HandleSubmit" class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Account Name</label>
                        <div class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700">
                            @accountName
                        </div>
                    </div>

                    <FormRow Cols="2">
                        <FormInput Label="First Name"
                                   PlaceHolder="First Name"
                                   @bind-Value="updateModel.FirstName"
                                   Required="true" />

                        <FormInput Label="Last Name"
                                   PlaceHolder="Last Name"
                                   @bind-Value="updateModel.LastName"
                                   Required="true" />
                    </FormRow>

                    <FormRow Cols="2">
                        <FormInput Label="Email Address"
                                   Type="email"
                                   PlaceHolder="email@example.com"
                                   @bind-Value="updateModel.Email"
                                   Required="true" />

                        <FormInput Label="Phone Number"
                                   Type="tel"
                                   PlaceHolder="e.g. 08030000000"
                                   @bind-Value="updateModel.Phone"
                                   Required="true" />
                    </FormRow>

                    <FormRow Cols="2">
                        <FormSelect Label="Country Code"
                                    Variant="FormSelect<int?>.SelectVariant.Country"
                                    @bind-Value="updateModel.CountryCode" />

                        <FormSelect Label="Time Zone (GMT Offset)"
                                    Variant="FormSelect<int?>.SelectVariant.TimeZone"
                                    @bind-Value="updateModel.TimeZone" />
                    </FormRow>

                    <!-- Status Toggle (Last item in form) -->
                    <div class="rounded-lg border border-slate-200 bg-slate-50/60 p-3.5 flex items-center justify-between">
                        <div>
                            <div class="text-sm font-medium text-slate-800 flex items-center" style="gap: 0.5rem;">
                                <span>Account Status:</span>
                                <span class="inline-flex items-center text-xs font-semibold @(updateModel.Active == true ? "text-emerald-700" : "text-slate-500")">
                                    <span style="display: inline-block; width: 0.45rem; height: 0.45rem; border-radius: 9999px; margin-right: 0.3rem; background-color: @(updateModel.Active == true ? "#10b981" : "#94a3b8");"></span>
                                    @(updateModel.Active == true ? "Active" : "Inactive")
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mt-0.5">
                                @(updateModel.Active == true ? "This sub-account is enabled and can send messages." : "This sub-account is disabled and cannot perform operations.")
                            </p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer select-none ml-4" title="Toggle status">
                            <input type="checkbox"
                                   class="sr-only"
                                   checked="@(updateModel.Active == true)"
                                   @onchange="(ChangeEventArgs e) => updateModel.Active = e.Value is bool b ? b : false" />
                            <div class="relative flex items-center transition-colors duration-200"
                                 style="width: 2.5rem; height: 1.35rem; border-radius: 9999px; padding: 2px; background-color: @(updateModel.Active == true ? "#0066f5" : "#cbd5e1");">
                                <div class="bg-white rounded-full shadow-sm transition-transform duration-200"
                                     style="width: 1.1rem; height: 1.1rem; border-radius: 9999px; background-color: #ffffff; box-shadow: 0 1px 2px rgba(0,0,0,0.25); transform: translateX(@(updateModel.Active == true ? "1.15rem" : "0.05rem"));">
                                </div>
                            </div>
                        </label>
                    </div>
            </EditForm>
        </Body>
        <Footer>
            <Button IsSubmit="true" form="updateForm"
                    Text="Update Sub-Account"
                    Icon="@Icon.IconStyle.Save"
                    IsBusy="@isSubmitting" />

            <Button Text="Cancel"
                    Style="ColorStyle.Secondary"
                    IsDisabled="@isSubmitting"
                    OnClick="() => isVisible = false" />
        </Footer>
    </Modal>
}
else
{
    <Modal Title="Add Sub-Account" @bind-IsVisible="isVisible">
        <Body>
            <EditForm id="createForm" Model="@createModel" OnValidSubmit="HandleSubmit" class="space-y-6">
                    <FormInput Label="Account Name"
                               PlaceHolder="e.g. Marketing Dept"
                               @bind-Value="createModel.AccountName"
                               Required="true" />

                    <FormRow Cols="2">
                        <FormInput Label="First Name"
                                   PlaceHolder="First Name"
                                   @bind-Value="createModel.FirstName"
                                   Required="true" />
                        <FormInput Label="Last Name"
                                   PlaceHolder="Last Name"
                                   @bind-Value="createModel.LastName"
                                   Required="true" />
                    </FormRow>

                    <FormRow Cols="2">
                        <FormInput Label="Email Address"
                                   Type="email"
                                   PlaceHolder="email@example.com"
                                   @bind-Value="createModel.Email"
                                   Required="true" />
                        <FormInput Label="Phone Number"
                                   Type="tel"
                                   PlaceHolder="e.g. 08030000000"
                                   @bind-Value="createModel.Phone"
                                   Required="true" />
                    </FormRow>

                    <FormRow Cols="2">
                        <FormSelect Label="Country Code"
                                    Variant="FormSelect<int>.SelectVariant.Country"
                                    @bind-Value="createModel.CountryCode" />
                        <FormSelect Label="Time Zone (GMT Offset)"
                                    Variant="FormSelect<int>.SelectVariant.TimeZone"
                                    @bind-Value="createModel.TimeZone" />
                    </FormRow>

                    <FormInput Label="Password"
                               Type="password"
                               PlaceHolder="••••••••"
                               @bind-Value="createModel.Password"
                               Required="true"
                               HelpText="Must be at least 8 characters with numbers and symbols." />
            </EditForm>
        </Body>
        <Footer>
            <Button IsSubmit="true" form="createForm"
                    Text="Create Sub-Account"
                    Icon="@Icon.IconStyle.PlusCircle"
                    IsBusy="@isSubmitting" />

            <Button Text="Cancel"
                    Style="ColorStyle.Secondary"
                    IsDisabled="@isSubmitting"
                    OnClick="() => isVisible = false" />
        </Footer>
    </Modal>
}


@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible = false;
    private bool isSubmitting = false;

    private AccountCreateRequest createModel = new();
    private AccountUpdateRequest updateModel = new();

    private string? accountId;
    private string? accountName;

    public void Show()
    {
        accountId = null;
        createModel = new();
        isVisible = true;
        StateHasChanged();
    }

    // Open for Edit
    public void Show(AccountResponse account)
    {
        accountId = account.AccountID;
        accountName = account.AccountName;

        updateModel = new AccountUpdateRequest
        {
            Active = account.Active,
            FirstName = account.FirstName,
            LastName = account.LastName,
            Email = account.Email,
            Phone = account.Phone,
            CountryCode = account.CountryCode,
            TimeZone = account.TimeZone, 
        };

        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;

            if (accountId != null)
            {
                await apiClient.AccountUpdateAsync(accountId, updateModel);
                await alert.Success("Sub-account updated successfully.");
            }
            else
            {
                await apiClient.AccountCreateAsync(createModel);
                await alert.Success("Sub-account created successfully.");
            }

            await OnCompleted.InvokeAsync();
            isVisible = false;
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"An error occurred while {(accountId != null ? "updating" : "creating")} the sub-account. {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
