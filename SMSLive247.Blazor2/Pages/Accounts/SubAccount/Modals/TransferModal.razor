<Modal Title="Transfer SMS Credits" @bind-IsVisible="isVisible">

    <Body>
        <EditForm id="Transfer" Model="request" OnValidSubmit="BeginTransfer" class="space-y-6">
            <div>
                <label class="mb-2 block text-sm font-medium text-slate-700">Transfer Direction</label>
                <InputRadioGroup @bind-Value="parentToChild" class="flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                        <InputRadio id="toChild" Value="@true" />
                        <label for="toChild" class="text-sm text-slate-700">
                            @ParentAccount?.AccountName → @subAccount.AccountName
                        </label>
                    </div>
                    <div class="flex items-center gap-2">
                        <InputRadio id="toParent" Value="@false" />
                        <label for="toParent" class="text-sm text-slate-700">
                            @subAccount.AccountName → @ParentAccount?.AccountName
                        </label>
                    </div>
                </InputRadioGroup>
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Credits</label>
                <InputNumber
                class="block w-full appearance-none rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 focus:ring-brand-500 focus:ring-1 focus:outline-none"
                @bind-Value="request.Credits" 
                min="50"
                @oninput="OnCreditChanged" 
                required 
                placeholder="Enter amount to transfer" />
            </div>

            <FormRow Cols="2">
                <div>
                    <label class="block text-sm font-medium text-slate-700">Sender Current Balance</label>
                    <div class="mt-1 block w-full appearance-none rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700">
                        @senderOldBalance.ToString("#,##0.##")
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">Sender New Balance</label>
                    <div class="mt-1 block w-full appearance-none rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm @(senderNewBalance < 0 ? "text-red-600" : "text-slate-700")">
                        @senderNewBalance.ToString("#,##0.##")
                    </div>
                </div>
            </FormRow>
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true" Text="Transfer Credits" form="Transfer" />
    </Footer>
</Modal>

@code {
    [CascadingParameter] public AccountResponse? ParentAccount { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible = false;
    private AccountResponse subAccount = new();
    private TransferRequest request = new();

    private bool parentToChild = true;
    private double senderOldBalance => parentToChild ? ParentAccount?.Credits ?? 0 : subAccount.Credits;
    private double senderNewBalance => senderOldBalance - request.Credits;

    public void Show(AccountResponse child)
    {
        subAccount = child;
        request = new TransferRequest();

        isVisible = true;
        StateHasChanged();
    }

    private async Task BeginTransfer()
    {
        try
        {
            if (request.Credits < 50)
                throw new Exception("Minimum SMS credit quantity to transfer is 50.");

            if (request.Credits > senderOldBalance)
                throw new Exception("Insufficient balance for this transfer.");

            if (!parentToChild)
                request.Credits = -request.Credits;

            await apiClient.TransferCreditAsync(request);
            await alert.Success("Credits transferred successfully.");
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isVisible = false;
            StateHasChanged();
        }
    }

    private void OnCreditChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int credits))
        {
            request.Credits = credits;
        }
    }
}
