<Modal Title="Transfer Balance" @bind-IsVisible="isVisible">

    <Body>
        <EditForm id="Transfer" Model="model" OnValidSubmit="BeginTransfer" class="space-y-6">
            <div>
                <label class="mb-2 block text-sm font-medium text-slate-700">Transfer Direction</label>
                <InputRadioGroup @bind-Value="parentToChild" class="flex flex-col gap-2">
                    <div class="flex items-center gap-2">
                        <InputRadio id="toChild" Value="@true" />
                        <label for="toChild" class="text-sm text-slate-700">
                            @parentAccount?.AccountName → @childAccount?.AccountName
                        </label>
                    </div>
                    <div class="flex items-center gap-2">
                        <InputRadio id="toParent" Value="@false" />
                        <label for="toParent" class="text-sm text-slate-700">
                            @childAccount?.AccountName → @parentAccount?.AccountName
                        </label>
                    </div>
                </InputRadioGroup>
            </div>

            <FormInput Type="number"
                       Label="Value"
                       PlaceHolder="Enter amount to transfer"
                       Required="true"
                       min="50"
                       @bind-Value="model.Value"
                       @oninput="OnCreditChanged" />

            
            <BalanceDisplay OldBalance="@senderOldBalance" NewBalance="@senderNewBalance" />
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true" Text="Transfer" form="Transfer" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible = false;
    private AccountResponse? parentAccount;
    private AccountResponse? childAccount;
    private TransferRequest model = new() { Value = 50 };

    private bool parentToChild = true;
    private double senderOldBalance => parentToChild ? parentAccount?.WalletBalance ?? 0 : childAccount?.WalletBalance ?? 0;
    private double senderNewBalance => senderOldBalance - model.Value;


    public void Show(AccountResponse parent, AccountResponse child)
    {
        parentAccount = parent;
        childAccount = child;
        model.Value = 50;
        model.Recipient = childAccount.AccountID;
        model.Remarks = $"Transfer from {parentAccount.AccountName} to {childAccount.AccountName}";

        isVisible = true;
        StateHasChanged();
    }

    private void See(string? para)
    {
        
    }

    private async Task BeginTransfer()
    {
        try
        {
            if (model.Value < 50)
                throw new Exception("Minimum SMS credit quantity to transfer is 50.");

            if (model.Value > senderOldBalance)
                throw new Exception("Insufficient balance for this transfer.");

            if (!parentToChild)
                model.Value = -model.Value;

            await apiClient.TransferCreditAsync(model);
            await alert.Success("Credits transferred successfully.");
            await OnCompleted.InvokeAsync();
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"An error occurred while transferring credits. {ex.Message}");
        }
        finally
        {
            isVisible = false;
            StateHasChanged();
        }
    }

    private void OnCreditChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int credits))
        {
            model.Value = credits;
        }
    }
}
