<Modal Title="Add Sub-Account" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="CreateSubAccountForm" FormName="CreateSubAccount" Model="@request" OnValidSubmit="HandleSubmit" class="edit-form">
            <FormInput Label="Account Name"
                       PlaceHolder="Marketing Dept"
                       @bind-Value="request.AccountName"
                       Required="true" />

            <FormRow Cols="2">
                <FormInput Label="First Name"
                           PlaceHolder="John"
                           @bind-Value="request.FirstName"
                           Required="true" />
                <FormInput Label="Last Name"
                           PlaceHolder="Doe"
                           @bind-Value="request.LastName"
                           Required="true" />
            </FormRow>

            <FormRow Cols="2">
                <FormInput Label="Email Address" Type="email"
                           PlaceHolder="email@example.com"
                           @bind-Value="request.Email"
                           Required="true" />
                <FormInput Label="Phone Number" Type="tel"
                           PlaceHolder="08030000000"
                           @bind-Value="request.Phone"
                           Required="true" />
            </FormRow>

            <FormRow Cols="2">
                <FormSelect Label="Country Code"
                            Variant="FormSelect<int>.SelectVariant.Country"
                            @bind-Value="request.CountryCode"
                            IsEmbedded="false" />
                <FormSelect Label="Time Zone (GMT Offset)"
                            Variant="FormSelect<int>.SelectVariant.TimeZone"
                            @bind-Value="request.TimeZone"
                            IsEmbedded="false" />
            </FormRow>

            <FormInput Label="Password"
                       Type="password"
                       PlaceHolder="••••••••"
                       @bind-Value="password"
                       Required="true"
                       HelpText="Must be at least 8 characters with numbers and symbols."
                       />
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true" Text="Create Sub-Account" form="CreateSubAccountForm" Icon="Icon.IconStyle.PlusCircle" IsBusy="@isSubmitting" />
        <Button Text="Cancel" Style="ColorStyle.Secondary" IsDisabled="@isSubmitting" OnClick="() => isVisible = false" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible = false;
    private bool isSubmitting = false;
    private AccountCreateRequest request = new() { CountryCode = 234, TimeZone = 1};
    private string password = string.Empty;
    // private string? countryCodeString { get; set; } = "234";
    // private string? timeZoneString { get; set; } = "1";

    public void Show()
    {
        request = new() { CountryCode = 234, TimeZone = 1 };
        password = string.Empty;
        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;
            request.Password = password;

            await apiClient.AccountCreateAsync(request);

            await alert.Success("Sub-account created successfully.", "Success");
            await OnCompleted.InvokeAsync();
            isVisible = false;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
