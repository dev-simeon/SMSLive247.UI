<Modal Title="Add Sub-Account" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="CreateSubAccountForm" FormName="CreateSubAccount" Model="@request" OnValidSubmit="HandleSubmit" class="edit-form">
            @* Account Name — full width *@
            <FormInput Label="Account Name"
                       PlaceHolder="e.g. Marketing Dept"
                       @bind-Value="request.AccountName"
                       required="true"
                       ErrorMessage="" />

            @* First Name & Last Name — 2 columns *@
            <FormRow Cols="2">
                <FormInput Label="First Name"
                           PlaceHolder="First Name"
                           @bind-Value="request.FirstName"
                           ErrorMessage="" />
                <FormInput Label="Last Name"
                           PlaceHolder="Last Name"
                           @bind-Value="request.LastName"
                           ErrorMessage="" />
            </FormRow>

            @* Email Address & Phone Number — 2 columns *@
            <FormRow Cols="2">
                <FormInput Label="Email Address"
                           Type="email"
                           PlaceHolder="email@example.com"
                           @bind-Value="request.Email"
                           ErrorMessage="" />
                <FormInput Label="Phone Number"
                           Type="tel"
                           PlaceHolder="e.g. 08030000000"
                           @bind-Value="request.Phone"
                           ErrorMessage="" />
            </FormRow>

            @* Country Code & Time Zone — 2 columns *@
            <FormRow Cols="2">
                <FormSelect Label="Country Code"
                            Type="FormSelect.SelectType.Country"
                            @bind-Value="CountryCodeString"
                            IsEmbedded="false" />
                <FormSelect Label="Time Zone (GMT Offset)"
                            Type="FormSelect.SelectType.TimeZone"
                            @bind-Value="TimeZoneString"
                            IsEmbedded="false" />
            </FormRow>

            @* Password — full width *@
            <FormInput Label="Password"
                       Type="password"
                       PlaceHolder="••••••••"
                       @bind-Value="password"
                       required="true"
                       HelpText="Must be at least 8 characters with numbers and symbols."
                       ErrorMessage="" />
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true" Text="Create Sub-Account" form="CreateSubAccountForm" Icon="Icon.IconStyle.PlusCircle" IsBusy="@isSubmitting" />
        <Button Text="Cancel" Style="Button.ButtonStyle.Secondary" IsDisabled="@isSubmitting" OnClick="() => isVisible = false" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible = false;
    private bool isSubmitting = false;
    private AccountCreateRequest request = new();
    private string password = string.Empty;
    private string? CountryCodeString { get; set; } = "234";
    private string? TimeZoneString { get; set; } = "0";

    public void Show()
    {
        request = new();
        password = string.Empty;
        CountryCodeString = "234";
        TimeZoneString = "0";
        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;

            if (!string.IsNullOrEmpty(CountryCodeString)
                && int.TryParse(CountryCodeString.TrimStart('+'), out int countryCode))
            {
                request.CountryCode = countryCode;
            }

            if (!string.IsNullOrEmpty(TimeZoneString)
                && int.TryParse(TimeZoneString, out int tz))
            {
                request.TimeZone = tz;
            }

            request.Password = password;

            await apiClient.AccountCreateAsync(request);

            await alert.Success("Sub-account created successfully.", "Success");
            await OnCompleted.InvokeAsync();
            isVisible = false;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
