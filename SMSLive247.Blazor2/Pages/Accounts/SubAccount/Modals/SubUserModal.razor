<Modal Title="@modalTitle" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="f3" Model="@subUser" OnValidSubmit="HandleSubmit" class="space-y-6">
            @if (editMode == EditModeEnum.CREATE)
            {
                <FormInput Label="UserName" @bind-Value="subUser.AccountName" Required="true" />
                <FormInput Label="First Name" @bind-Value="subUser.FirstName" Required="true" />
                <FormInput Label="Last Name" @bind-Value="subUser.LastName" Required="true" />
                <FormInput Label="Phone Number" @bind-Value="subUser.Phone" Required="true" />
                <FormInput Label="Delivery Email" Type="email" @bind-Value="subUser.Email" Required="true" />
            }
            else if (editMode == EditModeEnum.EDIT)
            {
                <FormInput Label="UserName" @bind-Value="subUser.AccountName" ReadOnly="true" />
                <FormInput Label="First Name" @bind-Value="subUser.FirstName" Required="true" />
                <FormInput Label="Last Name" @bind-Value="subUser.LastName" Required="true" />
                <FormInput Label="Phone Number" @bind-Value="subUser.Phone" ReadOnly="true" />
                <FormInput Label="Delivery Email" Type="email" @bind-Value="subUser.Email" ReadOnly="true" />

                <div>
                    <label class="block text-sm font-medium text-slate-700">API Key</label>
                    <div class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700">
                        @(subAccount?.Key != null ? BitConverter.ToString(subAccount.Key) : "N/A")
                    </div>
                </div>
            }
            else if (editMode == EditModeEnum.VIEW)
            {
                <FormInput Label="First Name" @bind-Value="subUser.FirstName" ReadOnly="true" />
                <FormInput Label="Last Name" @bind-Value="subUser.LastName" ReadOnly="true" />
                <FormInput Label="Phone Number" @bind-Value="subUser.Phone" ReadOnly="true" />
                <FormInput Label="Delivery Email" Type="email" @bind-Value="subUser.Email" ReadOnly="true" />
            }
        </EditForm>
    </Body>
    <Footer>
        @if (editMode == EditModeEnum.CREATE)
        {
            <Button IsSubmit="true" Text="Create Sub User" form="f3" Icon="Icon.IconStyle.PlusCircle" />
        }
        else if (editMode == EditModeEnum.EDIT)
        {
            <Button IsSubmit="true" Text="Update Sub User" form="f3" Icon="Icon.IconStyle.Save" />
        }
        else
        {
            <Button Text="Close" OnClick="() => isVisible = false" Style="Button.ButtonStyle.Secondary" />
        }
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private enum EditModeEnum { CREATE, EDIT, VIEW }

    private bool isVisible = false;
    private string modalTitle = "Sub User";
    private AccountResponse subUser = new();
    private AccountResponse? subAccount;
    private EditModeEnum editMode = EditModeEnum.CREATE;

    public void Show(AccountResponse parent, AccountResponse? child, bool readOnly = false)
    {
        subAccount = parent;
        if (child == null)
        {
            editMode = EditModeEnum.CREATE;
            modalTitle = "Add Sub User";
            subUser = new();
        }
        else
        {
            editMode = EditModeEnum.EDIT;
            modalTitle = "Edit Sub User";
            subUser = child;

            if (readOnly)
                editMode = EditModeEnum.VIEW;
        }
        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (editMode == EditModeEnum.CREATE)
            {
                var request = new AccountCreateRequest
                {
                    FirstName = subUser.FirstName,
                    LastName = subUser.LastName,
                    Phone = subUser.Phone,
                    Email = subUser.Email,
                    AccountName = subUser.AccountName,
                    Password = GeneratePassword(12)
                };

                await subClient.Impersonate(subAccount).AccountCreateAsync(request);
                await alert.Success("Sub User created.");
            }
            else if (editMode == EditModeEnum.EDIT)
            {
                var updateRequest = new AccountUpdateRequest
                {
                    FirstName = subUser.FirstName,
                    LastName = subUser.LastName,
                    Phone = subUser.Phone,
                    Email = subUser.Email,
                };

                await subClient.Impersonate(subAccount).AccountUpdateAsync(subUser.AccountID, updateRequest);
                await alert.Success("Sub User updated.");
            }

            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
    }

    public static string GeneratePassword(int length)
    {
        const string validChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890";
        char[] passwordChars = new char[length];
        var random = new Random();

        for (int i = 0; i < length; i++)
            passwordChars[i] = validChars[random.Next(validChars.Length)];

        return new string(passwordChars);
    }
}
