<Modal Title="@modalTitle" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="f3" Model="@model" OnValidSubmit="HandleSubmit" class="space-y-6">
            @if (editMode == EditModeEnum.CREATE)
            {
                <FormInput Label="UserName" @bind-Value="model.AccountName" Required="true" />
                <FormInput Label="First Name" @bind-Value="model.FirstName" Required="true" />
                <FormInput Label="Last Name" @bind-Value="model.LastName" Required="true" />
                <FormInput Label="Phone Number" @bind-Value="model.Phone" Required="true" />
                <FormInput Label="Delivery Email" Type="email" @bind-Value="model.Email" Required="true" />
            }
            else if (editMode == EditModeEnum.EDIT)
            {
                <FormInput Label="UserName" @bind-Value="model.AccountName" ReadOnly="true" />
                <FormInput Label="First Name" @bind-Value="model.FirstName" Required="true" />
                <FormInput Label="Last Name" @bind-Value="model.LastName" Required="true" />
                <FormInput Label="Phone Number" @bind-Value="model.Phone" ReadOnly="true" />
                <FormInput Label="Delivery Email" Type="email" @bind-Value="model.Email" ReadOnly="true" />

                <div>
                    <label class="block text-sm font-medium text-slate-700">API Key</label>
                    <div class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700">
                        @(Account?.Key != null ? BitConverter.ToString(Account.Key) : "N/A")
                    </div>
                </div>
            }
            else if (editMode == EditModeEnum.VIEW)
            {
                <FormInput Label="First Name" @bind-Value="model.FirstName" ReadOnly="true" />
                <FormInput Label="Last Name" @bind-Value="model.LastName" ReadOnly="true" />
                <FormInput Label="Phone Number" @bind-Value="model.Phone" ReadOnly="true" />
                <FormInput Label="Delivery Email" Type="email" @bind-Value="model.Email" ReadOnly="true" />
            }
        </EditForm>
    </Body>
    <Footer>
        @if (editMode == EditModeEnum.CREATE)
        {
            <Button IsSubmit="true" Text="Create Sub User" form="f3" Icon="Icon.IconStyle.PlusCircle" />
        }
        else if (editMode == EditModeEnum.EDIT)
        {
            <Button IsSubmit="true" Text="Update Sub User" form="f3" Icon="Icon.IconStyle.Save" />
        }
        else
        {
            <Button Text="Close" OnClick="() => isVisible = false" Style="Button.ButtonStyle.Secondary" />
        }
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }
    [CascadingParameter] public AccountResponse? Account { get; set; }

    private enum EditModeEnum { CREATE, EDIT, VIEW }

    private bool isVisible = false;
    private string modalTitle = "Sub User";
    private AccountResponse model = new();
    private EditModeEnum editMode = EditModeEnum.CREATE;

    public void Show(AccountResponse? subUser, bool readOnly = false)
    {
        if (subUser == null)
        {
            editMode = EditModeEnum.CREATE;
            modalTitle = "Add Sub User";
            model = new();
        }
        else
        {
            editMode = EditModeEnum.EDIT;
            modalTitle = "Edit Sub User";
            model = subUser;

            if (readOnly)
                editMode = EditModeEnum.VIEW;
        }
        isVisible = true;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (editMode == EditModeEnum.CREATE)
            {
                var request = new AccountCreateRequest
                {
                    FirstName = model.FirstName,
                    LastName = model.LastName,
                    Phone = model.Phone,
                    Email = model.Email,
                    AccountName = model.AccountName,
                    Password = GeneratePassword(12)
                };

                await subClient.Impersonate(Account).AccountCreateAsync(request);
                await alert.Success("Sub User created.");
            }
            else if (editMode == EditModeEnum.EDIT)
            {
                var updateRequest = new AccountUpdateRequest
                {
                    FirstName = model.FirstName,
                    LastName = model.LastName,
                    Phone = model.Phone,
                    Email = model.Email,
                };

                await subClient.Impersonate(Account).AccountUpdateAsync(model.AccountID, updateRequest);
                await alert.Success("Sub User updated.");
            }

            isVisible = false;
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
    }

    public static string GeneratePassword(int length)
    {
        const string validChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890";
        char[] passwordChars = new char[length];
        var random = new Random();

        for (int i = 0; i < length; i++)
            passwordChars[i] = validChars[random.Next(validChars.Length)];

        return new string(passwordChars);
    }
}
