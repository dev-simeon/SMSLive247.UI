@using SMSLive247.Blazor2.Pages.Accounts.SubAccount.Modals

<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchQuery" OnSearch="ReloadData">
        </SearchBox>
    </HeaderLeft>
    <HeaderRight>
        <Button Text="Add Sub User" Icon="Icon.IconStyle.PlusCircle" OnClick="() => subUserModal.Show(null)" />
    </HeaderRight>

    <ChildContent>
        <Table DataSource="ds">
            <Columns>
                <Column Header="Date Created" Width="180px">
                    <FormatDate DateTime="@context.DateCreated"></FormatDate>
                </Column>
                <Column Header="Username">
                    <span class="font-medium text-slate-900">@context.AccountName</span>
                </Column>
                <Column Header="First Name">
                    @context.FirstName
                </Column>
                <Column Header="Last Name">
                    @context.LastName
                </Column>
                <Column Header="Balance">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-slate-900">
                            <FormatNumber Number="@context.Credits"></FormatNumber>
                        </span>
                        <Button Type="Button.Style.SECONDARY" OnClick="() => transferModal.Show(context)" CssClass="text-xs px-2 py-1">
                            Add/Remove Credit
                        </Button>
                    </div>
                </Column>
                <Column Header="Status">
                    @if (context.Active)
                    {
                        <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800">
                            ACTIVE
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800">
                            INACTIVE
                        </span>
                    }
                </Column>
                <Column>
                    <Actions OnEdit="() => subUserModal.Show(context)"
                             OnDelete="() => DeleteSubUser(context)">
                    </Actions>
                </Column>
            </Columns>
        </Table>
    </ChildContent>
    <FooterLeft>
        <Paging PageNumber="ds.PageState.PageNumber"
                PageSize="ds.PageState.PageSize"
                TotalRecords="ds.PageState.TotalCount"
                PageNumberChanged="OnPageChange"
                PageSizeChanged="OnPageSizeChange">
        </Paging>
    </FooterLeft>
</PageBody>

<SubUserModal @ref="subUserModal" OnCompleted="ReloadData"></SubUserModal>
<TransferModal @ref="transferModal" OnCompleted="ReloadData"></TransferModal>

@code {
    [CascadingParameter] public AccountResponse? Account { get; set; }

    private string? searchQuery;
    private SubUserModal subUserModal = new();
    private TransferModal transferModal = new();
    private ApiDataSource<AccountResponse> ds = new();

    protected override async Task OnInitializedAsync()
    {
        ds.Callback = new(async (PageState p, FilterState? f) =>
        {
            if (Account != null)
            {
                return await subClient.Impersonate(Account).AccountsListAsync(
                    p.PageNumber, p.PageSize, null, searchQuery);
            }
            return ds.EmptyResponse;
        });
        
        ds.SetPage(new PageState(10, 1));
        await ds.LoadData(alert);
    }
    
    private async Task ReloadData()
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, 1));
        await ds.LoadData(alert);
    }

    private async Task OnPageChange(int page)
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, page));
        await ds.LoadData(alert);
    }

    private async Task OnPageSizeChange(int size)
    {
        ds.SetPage(new PageState(size, ds.PageState.PageNumber));
        await ds.LoadData(alert);
    }
    
    private async Task DeleteSubUser(AccountResponse account)
    {
        var question = $"Are you sure you want to delete the sub user '{account.AccountName}'?";
        bool confirmed = await alert.Confirm(question, "Confirm Deletion");

        if (confirmed && Account != null)
        {
            try
            {
                await subClient.Impersonate(Account).AccountDeleteAsync(account.AccountID);
                await alert.Success("Sub User deleted.");
                await ReloadData();
            }
            catch (Exception ex)
            {
                await alert.Error(ex.Message);
            }
        }
    }
}
