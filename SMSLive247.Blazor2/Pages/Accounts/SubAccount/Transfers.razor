@using SMSLive247.Blazor2.Pages.Accounts.SubAccount.Modals

<div class="bg-white shadow rounded-lg border border-slate-200">
    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50 rounded-t-lg">
        <SearchBox Placeholder="Search transfers..." @bind-SearchTerm="searchQuery" OnSearch="ReloadData">
        </SearchBox>
        <Button Text="Add/Remove Credit" Type="Button.Style.SECONDARY" OnClick="() => transferModal.Show(subAccount)" />
    </div>

    <Table DataSource="ds">
        <Columns>
            <Column Header="Request Date" Width="180px">
                <FormatDate DateTime="@context.DateCreated"></FormatDate>
            </Column>
            <Column Header="Sender">
                <span class="font-medium text-slate-900">@context.SenderName</span>
            </Column>
            <Column Header="Recipient">
                <span class="font-medium text-slate-900">@context.RecipientName</span>
            </Column>
            <Column Header="Credits">
                <span class="font-medium">
                    <FormatNumber Number="@context.Credits"></FormatNumber>
                </span>
            </Column>
            <Column Header="Status">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
                    TRANSFERRED
                </span>
            </Column>
        </Columns>
    </Table>
    <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 rounded-b-lg">
        <Paging PageNumber="ds.PageState.PageNumber"
                PageSize="ds.PageState.PageSize"
                TotalRecords="ds.PageState.TotalCount"
                PageNumberChanged="OnPageChange"
                PageSizeChanged="OnPageSizeChange">
        </Paging>
    </div>
</div>

<TransferModal @ref="transferModal" ParentId="self"></TransferModal>

@code {
    [Parameter] public string SubAccountId { get; set; } = string.Empty;
    
    private string? searchQuery;
    private TransferModal transferModal = new();
    private AccountResponse? subAccount;

    private ApiDataSource<TransferResponse> ds = new();

    protected override async Task OnInitializedAsync()
    {
        subAccount = await GetSubAccount(SubAccountId);

        ds.Callback = new(async (PageState p, FilterState? f) =>
        {
            if (subAccount != null)
            {
                return await subClient.Impersonate(subAccount).TransferListAsync(
                    p.PageNumber, p.PageSize, null, searchQuery);
            }
            return ds.EmptyResponse;
        });
        
        ds.SetPage(new PageState(10, 1));
        await ds.LoadData(alert);
    }

    private async Task<AccountResponse?> GetSubAccount(string subAccountId)
    {
        try
        {
            var response = await apiClient.AccountGetAsync(subAccountId);

            if (response.StatusCode == 200)
                return response.Result;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error");
        }
        return null;
    }
    
    private async Task ReloadData()
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, 1));
        await ds.LoadData(alert);
    }

    private async Task OnPageChange(int page)
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, page));
        await ds.LoadData(alert);
    }

    private async Task OnPageSizeChange(int size)
    {
        ds.SetPage(new PageState(size, ds.PageState.PageNumber));
        await ds.LoadData(alert);
    }
}
