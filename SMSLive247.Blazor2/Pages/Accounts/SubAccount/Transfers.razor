@using SMSLive247.Blazor2.Pages.Accounts.SubAccount.Modals

<PageBody>
    <HeaderLeft>
        <SearchBox @bind-SearchTerm="searchQuery" OnSearch="ReloadData">
        </SearchBox>
    </HeaderLeft>
    <HeaderRight>
        @if (Sub.Account != null)
        {
            <Button Text="Add/Remove Credit" OnClick="() => transferModal.Show(Main.Account, Sub.Account)" />
        }
    </HeaderRight>

    <ChildContent>
        <Table DataSource="ds">
            <Columns>
                <Column Header="Request Date" Width="180px">
                    <FormatDate DateTime="@context.DateCreated"></FormatDate>
                </Column>
                <Column Header="Sender">
                    <span class="font-medium text-slate-900">@context.SenderName</span>
                </Column>
                <Column Header="Recipient">
                    <span class="font-medium text-slate-900">@context.RecipientName</span>
                </Column>
                <Column Header="Credits">
                    <FormatNumber Number="@context.Credits"></FormatNumber>
                </Column>
                <Column Header="Status">
                    <Badge Style="Badge.BadgeStyle.Success" Value="TRANSFERRED" />
                </Column>
            </Columns>
        </Table>
    </ChildContent>
    <FooterLeft>
        <Paging PageNumber="ds.PageState.PageNumber"
                PageSize="ds.PageState.PageSize"
                TotalRecords="ds.PageState.TotalCount"
                PageNumberChanged="OnPageChange"
                PageSizeChanged="OnPageSizeChange">
        </Paging>
    </FooterLeft>
</PageBody>

<TransferModal @ref="transferModal" OnCompleted="ReloadData"></TransferModal>

@code {
    [CascadingParameter(Name = "SubAccount")] public required AccountState Sub { get; set; }
    [CascadingParameter(Name = "MainAccount")] public required AccountState Main { get; set; }

    private string? searchQuery;
    private TransferModal transferModal = new();
    private ApiDataSource<TransferResponse> ds = new();

    protected override async Task OnInitializedAsync()
    {
        ds.Callback = new(async (PageState p, FilterState? f) =>
        {
            if (Sub.Account != null)
            {
                return await subClient.Impersonate(Sub.Account).TransferListAsync(
                    p.PageNumber, p.PageSize, null, searchQuery);
            }
            return ds.EmptyResponse;
        });
        
        ds.SetPage(new PageState(10, 1));
        await ds.LoadData(alert);
    }
    
    private async Task ReloadData()
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, 1));
        await ds.LoadData(alert);
    }

    private async Task OnPageChange(int page)
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, page));
        await ds.LoadData(alert);
    }

    private async Task OnPageSizeChange(int size)
    {
        ds.SetPage(new PageState(size, ds.PageState.PageNumber));
        await ds.LoadData(alert);
    }
}
