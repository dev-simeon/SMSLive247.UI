@using SMSLive247.Blazor2.Pages.Accounts.SubAccount.Modals;
@inject IJSRuntime js

@if (Sub?.Account != null)
{
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <!-- ── Top Row: Title + Balance Widget, Edit Profile far right ── -->
        <div class="flex flex-wrap items-center justify-between" style="column-gap: 1rem; row-gap: 0.75rem;">
            <!-- Left: Account Name + Balance/Transfer consolidated widget -->
            <div class="flex flex-wrap items-center" style="column-gap: 0.85rem; row-gap: 0.5rem;">
                <h1 class="text-xl font-bold tracking-tight text-slate-900">
                    @Sub.Account.AccountName
                </h1>

                <!-- Balance & Transfer Button (consolidated, left side, exact same height as button) -->
                <div class="inline-flex items-center rounded-lg border border-brand-500 bg-white shadow-sm overflow-hidden" style="height: 38px;">
                    <div class="bg-brand-50/80 px-3 flex items-center h-full border-r border-brand-200 text-xs font-bold text-brand-700 select-all" title="Current Credit Balance">
                        <span class="text-slate-500 font-normal mr-1 text-[11px]">Balance:</span>
                        <span>₦ @Sub.Account.Credits.ToString("#,##0.00")</span>
                    </div>
                    <button type="button"
                            @onclick="() => transferModal.Show(Main.Account, Sub.Account)"
                            class="inline-flex items-center h-full px-3 text-xs font-semibold text-brand-600 hover:bg-brand-50 hover:text-brand-700 transition-colors cursor-pointer"
                            style="gap: 0.35rem;"
                            title="Add or Remove Credit">
                        <Icon Style="Icon.IconStyle.ArrowRightLeft" CssClass="text-xs" />
                        <span>Add/Remove</span>
                    </button>
                </div>
            </div>

            <!-- Far Right: Edit Profile only -->
            <div class="flex items-center ml-auto" style="margin-left: auto;">
                <Button Style="ColorStyle.Primary"
                        Text="Edit Profile"
                        Icon="Icon.IconStyle.PenSquare"
                        CssClass="text-xs px-3.5 h-[38px]"
                        OnClick="() => editModal.Show(Sub.Account)" />
            </div>
        </div>

        <!-- ── Bottom Row: Minimalist Inline Metadata Bar with Responsive Flow ── -->
        <div class="mt-3.5 pt-3 border-t border-slate-100 flex flex-wrap items-center text-xs text-slate-500" style="column-gap: 1.5rem; row-gap: 0.5rem;">

            <!-- Active status badge (read-only, edit via Edit Profile) -->
            <div class="inline-flex items-center">
                <span class="text-slate-400" style="margin-right: 0.4rem;">Status:</span>
                <span class="inline-flex items-center text-xs font-semibold @(Sub.Account.Active ? "text-emerald-700" : "text-slate-500")">
                    <span style="display: inline-block; width: 0.45rem; height: 0.45rem; border-radius: 9999px; margin-right: 0.3rem; background-color: @(Sub.Account.Active ? "#10b981" : "#94a3b8");"></span>
                    @(Sub.Account.Active ? "Active" : "Inactive")
                </span>
            </div>

            <div class="inline-flex items-center">
                <span class="text-slate-400" style="margin-right: 0.4rem;">Phone:</span>
                <span class="font-medium text-slate-700">@(string.IsNullOrWhiteSpace(Sub.Account.Phone) ? "—" : Sub.Account.Phone)</span>
            </div>

            <div class="inline-flex items-center">
                <span class="text-slate-400" style="margin-right: 0.4rem;">Country:</span>
                <span class="font-medium text-slate-700">+@Sub.Account.CountryCode</span>
            </div>

            <div class="inline-flex items-center">
                <span class="text-slate-400" style="margin-right: 0.4rem;">Time Zone:</span>
                <span class="font-medium text-slate-700">GMT @(Sub.Account.TimeZone >= 0 ? "+" : "")@Sub.Account.TimeZone</span>
            </div>

            <div class="inline-flex items-center">
                <span class="text-slate-400" style="margin-right: 0.4rem;">Traffic:</span>
                <span class="font-medium text-slate-700">@(string.IsNullOrWhiteSpace(Sub.Account.Traffic) ? "—" : Sub.Account.Traffic)</span>
            </div>

            <div class="inline-flex items-center">
                <span class="text-slate-400" style="margin-right: 0.4rem;">Created:</span>
                <span class="font-medium text-slate-700">@Sub.Account.DateCreated.ToString("MMM dd, yyyy")</span>
            </div>

            <!-- API Key: Aligns right on wide screens (xl:ml-auto); flows naturally on smaller screens -->
            <div class="inline-flex items-center xl:ml-auto">
                <span class="text-slate-400" style="margin-right: 0.4rem;">API Key:</span>
                <ApiKeyDisplay Account="@Sub.Account" OnReset="HandleModalCompleted" />
            </div>
        </div>
    </div>
}
else
{
    <div class="flex justify-center p-6">
        <div class="h-6 w-6 animate-spin rounded-full border-2 border-brand-500 border-t-transparent"></div>
    </div>
}

<TransferModal @ref="transferModal" OnCompleted="HandleModalCompleted"></TransferModal>
<EditModal @ref="editModal" OnCompleted="HandleModalCompleted"></EditModal>

@code {
    [CascadingParameter(Name = "SubAccount")] public required AccountState Sub { get; set; }
    [CascadingParameter(Name = "MainAccount")] public required AccountState Main { get; set; }
    [Parameter] public EventCallback OnUpdated { get; set; }

    private TransferModal transferModal = new();
    private EditModal editModal = new();

    private async Task HandleModalCompleted()
    {
        Sub.Reload();
        Main.Reload();
        if (OnUpdated.HasDelegate)
        {
            await OnUpdated.InvokeAsync();
        }
    }

    private async Task CopyToClipboard(string text, string label)
    {
        try
        {
            await js.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await alert.Success($"{label} copied to clipboard.", "Copied");
        }
        catch { }
    }
}
