@using SMSLive247.Blazor2.Pages.Accounts.SubAccount.Modals;
@inject IJSRuntime js

@if (Sub?.Account != null)
{
    <div class="flex flex-col gap-4 rounded-xl bg-white p-5 shadow-sm">
        <!-- ── Top Row: Title + Balance Widget, Edit Profile far right ── -->
        <div class="flex flex-wrap items-center justify-between">
            <!-- Left: Account Name + Balance/Transfer consolidated widget -->
            <div class="flex flex-wrap items-center gap-4">
                <h1 class="text-xl font-bold tracking-tight text-slate-900">
                    @Sub.Account.AccountName
                </h1>
                <Badge Variant="Badge.StatusVariant.ActiveInactive"
                       Value="@(Sub.Account.Active ? "ACTIVE" : "INACTIVE")" />
            </div>

            <!-- Far Right: Edit Profile only -->
            <div class="ml-auto flex items-center gap-4">
                <FormatCredit Credits="@Sub.Account.Credits" Title="Current Credit Balance" />

                <Button Style="ColorStyle.Info"
                        Text="Add Credits..."
                        Icon="Icon.IconStyle.ArrowRightLeft"
                        OnClick="() => transferModal.Show(Main.Account, Sub.Account)" />

                <Button Style="ColorStyle.Warning"
                        Text="Edit Profile..."
                        Icon="Icon.IconStyle.PenSquare"
                        OnClick="() => editModal.Show(Sub.Account)" />
            </div>
        </div>

        <!-- ── Bottom Row: Minimalist Inline Metadata Bar with Responsive Flow ── -->
        <div class="flex flex-wrap items-center gap-4 text-slate-500">
            @foreach (var item in items)
            {
                <div class="inline-flex items-center gap-1 rounded bg-brand-50 px-2">
                    <span class="mr-3 text-slate-400">@item.Key:</span>
                    <span class="font-medium text-slate-700">@item.Value</span>
                </div>
            }
            <div class="inline-flex items-center gap-1 rounded bg-brand-50 px-2">
                <span class="mr-3 text-slate-400">API Key:</span>
                <ApiKeyDisplay Account="@Sub.Account" OnReset="HandleModalCompleted" />
            </div>
        </div>
    </div>
}
else
{
    <div class="flex justify-center p-6">
        <div class="h-6 w-6 animate-spin rounded-full border-2 border-brand-500 border-t-transparent"></div>
    </div>
}

<TransferModal  @ref="transferModal"    OnCompleted="HandleModalCompleted"></TransferModal>
<EditModal      @ref="editModal"        OnCompleted="HandleModalCompleted"></EditModal>

@code {
    [CascadingParameter(Name =  "SubAccount")] public required AccountState Sub  { get; set; }
    [CascadingParameter(Name = "MainAccount")] public required AccountState Main { get; set; }
    [Parameter] public EventCallback OnUpdated { get; set; }

    private Dictionary<string,string> items = [];
    private TransferModal transferModal = new();
    private EditModal editModal = new();

    protected override void OnParametersSet()
    {
        items.Clear();
        items.Add("Created", Sub.Account.DateCreated.ToString("MMM dd, yyyy"));
        items.Add("Traffic", Sub.Account.Traffic ?? "-");
        items.Add("Country", $"+{Sub.Account.CountryCode}");
        items.Add("Time Zone", $"GMT {Sub.Account.TimeZone:+#;-#;0}");
        items.Add("Email", Sub.Account.Email);
        //items.Add("Phone", Sub.Account.Phone);
    }
    private async Task HandleModalCompleted()
    {
        Sub.Reload();
        Main.Reload();
        if (OnUpdated.HasDelegate)
        {
            await OnUpdated.InvokeAsync();
        }
    }

    private async Task CopyToClipboard(string text, string label)
    {
        try
        {
            await js.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await alert.Success($"{label} copied to clipboard.", "Copied");
        }
        catch { }
    }
}
