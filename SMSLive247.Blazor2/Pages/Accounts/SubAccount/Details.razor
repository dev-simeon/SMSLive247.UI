@using SMSLive247.Blazor2.Pages.Accounts.SubAccount.Modals;

@if (Sub.Account != null)
{
    <div class="max-w-4xl rounded-lg border border-slate-200 bg-white shadow">
        <div class="flex items-center justify-between rounded-t-lg border-b border-slate-200 bg-slate-50 px-6 py-5">
            <div>
                <h2 class="m-0 text-xl font-bold text-slate-900">@Sub.Account.AccountName</h2>
                <p class="mt-1 text-sm text-slate-500">ID: <span class="font-mono text-slate-700">@Sub.Account.AccountID</span></p>
            </div>
            <div class="flex items-center gap-2">
                <Button Style="Button.ButtonStyle.Secondary" OnClick="() => editModal.Show(Sub.Account)">
                    Edit Profile
                </Button>
                <Button Style="Button.ButtonStyle.Secondary" OnClick="() => transferModal.Show(Main.Account, Sub.Account)">
                    Add/Remove Credit
                </Button>
            </div>
        </div>
       
        <div class="p-6">
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div class="flex flex-col">
                    <label class="mb-1 text-sm font-semibold tracking-wider text-slate-500 uppercase">Status</label>
                    @if (Sub.Account.Active)
                    {
                        <div>
                            <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800">
                                ACTIVE
                            </span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800">
                                INACTIVE
                            </span>
                        </div>
                    }
                </div>
                <div class="flex flex-col">
                    <label class="mb-1 text-sm font-semibold tracking-wider text-slate-500 uppercase">Phone</label>
                    <span class="text-slate-900">@Sub.Account.Phone</span>
                </div>
                <div class="flex flex-col">
                    <label class="mb-1 text-sm font-semibold tracking-wider text-slate-500 uppercase">Credit Balance</label>
                    <span class="font-medium text-slate-900">₦ @Sub.Account.Credits.ToString("##0.00")</span>
                </div>
                <div class="flex flex-col">
                    <label class="mb-1 text-sm font-semibold tracking-wider text-slate-500 uppercase">Date Created</label>
                    <span class="text-slate-900">@Sub.Account.DateCreated.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="flex flex-col">
                    <label class="mb-1 text-sm font-semibold tracking-wider text-slate-500 uppercase">Time Zone</label>
                    @{
                        string sign = Sub.Account.TimeZone > 0 ? "+" : "-";
                    }
                    <span class="text-slate-900">GMT @sign@Sub.Account.TimeZone</span>
                </div>
                <div class="flex flex-col">
                    <label class="mb-1 text-sm font-semibold tracking-wider text-slate-500 uppercase">Country Code</label>
                    <span class="text-slate-900">@Sub.Account.CountryCode</span>
                </div>
                <div class="flex flex-col">
                    <label class="mb-1 text-sm font-semibold tracking-wider text-slate-500 uppercase">Traffic</label>
                    <span class="text-slate-900">@Sub.Account.Traffic</span>
                </div>
                <div class="flex flex-col">
                    <label class="mb-1 text-sm font-semibold tracking-wider text-slate-500 uppercase">API Key</label>
                    <span class="font-mono text-sm text-slate-900">@(Sub.Account.Key != null ? BitConverter.ToString(Sub.Account.Key) : "N/A")</span>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="flex justify-center p-8">
        <div class="border-brand-600 h-8 w-8 animate-spin rounded-full border-b-2"></div>
    </div>
}

<TransferModal @ref="transferModal" OnCompleted="ReloadData"></TransferModal>
<EditModal @ref="editModal" OnCompleted="ReloadData"></EditModal>

@code {
    [CascadingParameter(Name = "SubAccount")] public required AccountState Sub { get; set; }
    [CascadingParameter(Name = "MainAccount")] public required AccountState Main { get; set; }

    private TransferModal transferModal = new();
    private EditModal editModal = new();

    private async Task ReloadData()
    {
        Sub.Reload();
        Main.Reload();
        // try
        // {
        //     var response = await apiClient.AccountGetAsync(Sub?.Account?.AccountID);
        //     //SubAccount = response.Result;
        // }
        // catch (Exception ex)
        // {
        //     await alert.Error(ex.Message);
        // }
    }
}
