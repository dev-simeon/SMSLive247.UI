@attribute [Route(Const.Routes.Account.SubAccountDetails)]
@layout MainLayout

@inject NavigationManager nav

<PageTitle>Sub-Account Details</PageTitle>

@if (subAccount is not null && state is not null)
{
    <BackLink Location="@Const.Routes.Account.SubAccounts"
              Title="Back to Sub-Accounts">
    </BackLink>

    <CascadingValue Name="SubAccount" Value="@state">
        <Details OnUpdated="ReloadData" />

        <Tabs>
            <TabPage Title="Sent Messages" Icon="Icon.IconStyle.Mail">
                <Messages></Messages>
            </TabPage>
            <TabPage Title="Transfers" Icon="Icon.IconStyle.ArrowRightLeft">
                <Transfers></Transfers>
            </TabPage>
            <TabPage Title="Sub-Users" Icon="Icon.IconStyle.Users">
                <SubUsers></SubUsers>
            </TabPage>
        </Tabs>
    </CascadingValue>
}
else if (errorMessage is null)
{
    <PageHeader Title="Sub-Account Details"
                SubTitle="Wait while the account details are fetched...">
    </PageHeader>

    <div class="flex items-center gap-3 py-12 text-slate-500">
        <div class="h-6 w-6 animate-spin rounded-full border-2 border-brand-500 border-t-transparent"></div>
        <span>Loading account details...</span>
    </div>
}
else
{
    <PageHeader Title="Sub-Account Details"
                SubTitle="The requested account was not found">
    </PageHeader>

    <p class="text-red-500">@errorMessage</p>
    <br />
    <a href="@Const.Routes.Account.SubAccounts" class="text-brand-600 hover:underline"> &lt; Go back</a>
}

@code {
    [Parameter] public string? id { get; set; }

    private AccountState? state;
    private string? errorMessage;
    private AccountResponse? subAccount => state?.Account;

    protected override async Task OnInitializedAsync()
    {
        await ReloadData();
    }

    private async Task ReloadData()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(id))
            {
                nav.NavigateTo(Const.Routes.Account.SubAccounts);
                return;
            }

            var response = await apiClient.AccountGetAsync(id);
            state = new(response.Result);
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        StateHasChanged();
    }
}
