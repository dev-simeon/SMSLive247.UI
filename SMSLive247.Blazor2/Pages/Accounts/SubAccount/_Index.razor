@attribute [Route(Const.Routes.Account.SubAccountDetails)]
@layout MainLayout

@inject NavigationManager nav

<PageTitle>Sub-Account Details</PageTitle>

@if (subAccount is not null)
{
    <PageHeader Title="@subAccount.AccountName">
        <div class="mt-1 text-sm text-slate-500">
            <strong>Sub-Account Details </strong>
            <small>@subAccount.AccountID</small>
            <Badge Variant="@Badge.StatusVariant.ActiveInactive" 
                Value="@(subAccount.Active ? "ACTIVE" : "DISABLED")" />
        </div>
    </PageHeader>

    <CascadingValue Name="SubAccount" Value="@state">
        <Tabs>
            <TabPage Title="Details" Icon="Icon.IconStyle.Info">
                <Details></Details>
            </TabPage>
            <TabPage Title="Sent Messages" Icon="Icon.IconStyle.Mail">
                <Messages></Messages>
            </TabPage>
            <TabPage Title="Sub-Users" Icon="Icon.IconStyle.Users">
                <SubUsers></SubUsers>
            </TabPage>
            <TabPage Title="Transfers" Icon="Icon.IconStyle.ArrowRightLeft">
                <Transfers></Transfers>
            </TabPage>
        </Tabs>
    </CascadingValue>
}
else if (errorMessage is null)
{
    <PageHeader Title="Sub-Account Details"
                SubTitle="Wait while the account details is fetched...">
    </PageHeader>

    <p>Loading...</p>
}
else
{

    <PageHeader Title="Sub-Account Details"
                SubTitle="The requested account was not found">
    </PageHeader>

    <p class="text-red-500">@errorMessage</p>
    <br />
    <a href="@Const.Routes.Account.SubAccounts"> &lt; Go back</a>
}

@code {
    [Parameter] public string? id { get; set; }

    private AccountState? state;
    private string? errorMessage;
    private AccountResponse? subAccount => state?.Account;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(id))
            {
                nav.NavigateTo(Const.Routes.Account.SubAccounts);
                return;
            }

            var response = await apiClient.AccountGetAsync(id);
            state = new(response.Result);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
