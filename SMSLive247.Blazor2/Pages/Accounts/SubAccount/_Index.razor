@attribute [Route(Const.Routes.Account.SubAccountDetails)]
@layout MainLayout

<PageTitle>Sub-Account Details</PageTitle>

<PageBody>
    <HeaderLeft>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Sub-Account Details</h1>
    </HeaderLeft>
    <HeaderRight>
        <Button Text="Back" Icon="Icon.IconStyle.ChevronRight" OnClick='() => nav.NavigateTo(Const.Routes.Account.SubAccounts)' />
    </HeaderRight>
    
    <ChildContent>
        <Tabs>
            <TabPage Title="Details" Icon="Icon.IconStyle.Info">
                <Details SubAccountId="@subAccountId"></Details>
            </TabPage>
            <TabPage Title="Sent Messages" Icon="Icon.IconStyle.Mail">
                <Messages SubAccountId="@subAccountId"></Messages>
            </TabPage>
            <TabPage Title="Sub-Users" Icon="Icon.IconStyle.Users">
                <SubUsers SubAccountId="@subAccountId"></SubUsers>
            </TabPage>
            <TabPage Title="Transfers" Icon="Icon.IconStyle.ArrowRightLeft">
                <Transfers SubAccountId="@subAccountId"></Transfers>
            </TabPage>
        </Tabs>
    </ChildContent>
</PageBody>

@code {
    [Parameter] public string? id { get; set; }

    private string subAccountId => id ?? string.Empty;
    
    [Inject] private NavigationManager nav { get; set; } = default!;
}
