<div class="bg-white shadow rounded-lg border border-slate-200">
    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50 rounded-t-lg">
        <SearchBox Placeholder="Search messages..." @bind-SearchTerm="searchQuery" OnSearch="ReloadData">
            <DateRangePicker DateRangeChanged="OnDateRangeChanged" />
        </SearchBox>
        <Button Text="Export CSV" Icon="Icon.IconStyle.Download" />
    </div>

    <Table DataSource="ds">
        <Columns>
            <Column Header="Date / Time" Width="180px">
                <FormatDate DateTime="@context.DateSubmitted"></FormatDate>
            </Column>
            <Column Header="Status">
                <Badge Variant="Badge.StatusVariant.BatchMessage" Value="@context.Status" />
            </Column>
            <Column Header="Sender" Width="100px">
                <span class="">@context.SenderID?.ToUpper()</span>
            </Column>
            <Column Header="Message">
                <p class="truncate max-w-md" title="@context.MessageText">@context.MessageText</p>
            </Column>
            <Column Header="Delivery">
                <div class="flex flex-col gap-0.5 text-sm">
                    <div class="">
                        @context.TotalProcessed / @(context.TotalProcessed + context.TotalFailed)
                    </div>
                    <div class="flex items-center gap-1.5 text-xs text-slate-500 mt-1" title="Credits Charged">
                        <Icon Style="Icon.IconStyle.Coins" CssClass="w-3.5 h-3.5 text-blue-500" />
                        <span>@context.CreditsCharged.ToString("#,##0.00")</span>
                    </div>
                </div>
            </Column>
            <Column>
                <Actions ViewLink="@($"/messaging/{context.BatchID}")"
                         OnDelete="e => DeleteBatch(context.BatchID)">
                </Actions>
            </Column>
        </Columns>
    </Table>
    <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 rounded-b-lg">
        <Paging PageNumber="ds.PageState.PageNumber"
                PageSize="ds.PageState.PageSize"
                TotalRecords="ds.PageState.TotalCount"
                PageNumberChanged="OnPageChange"
                PageSizeChanged="OnPageSizeChange">
        </Paging>
    </div>
</div>

@code {
    [Parameter] public string SubAccountId { get; set; } = string.Empty;

    private string? searchQuery;
    private DateTime? filterFrom;
    private DateTime? filterTo;

    private void OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        filterFrom = range.From;
        filterTo = range.To;
    }

    private ApiDataSource<SmsBatchResponse> ds = new();

    protected override async Task OnInitializedAsync()
    {
        var account = await GetSubAccount(SubAccountId);

        ds.Callback = new(async (PageState p, FilterState? f) =>
        {
            if (account != null && account.AccountID != null)
            {
                return await subClient.Impersonate(account).SmsBatchListAsync(
                    p.PageNumber, p.PageSize, null, filterFrom, filterTo, searchQuery);
            }
            return ds.EmptyResponse;
        });
        ds.SetPage(new PageState(100, 1));
        await ds.LoadData(alert);
    }

    private async Task<AccountResponse?> GetSubAccount(string subAccountId)
    {
        try
        {
            var response = await apiClient.AccountGetAsync(subAccountId);

            if (response.StatusCode == 200)
                return response.Result;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error");
        }
        return null;
    }

    private async Task ReloadData()
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, 1));
        await ds.LoadData(alert);
    }

    private async Task OnPageChange(int page)
    {
        ds.SetPage(new PageState(ds.PageState.PageSize, page));
        await ds.LoadData(alert);
    }

    private async Task OnPageSizeChange(int size)
    {
        ds.SetPage(new PageState(size, ds.PageState.PageNumber));
        await ds.LoadData(alert);
    }

    private async Task DeleteBatch(long? batchId)
    {
        if (batchId == null) return;
        
        bool confirmed = await alert.Confirm("Are you sure you want to delete this batch?", "Confirm");
        if (confirmed)
        {
            // Implementation for impersonated delete would go here if available
            await ReloadData();
        }
    }
}
