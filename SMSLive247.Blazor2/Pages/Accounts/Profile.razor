@layout MainLayout
@attribute [Route(Const.Routes.Account.Profile)]
@using SMSLive247.Blazor.Pages.Accounts.Modals

<PageTitle>SMSLive247 - Profile</PageTitle>

<PageHeader Title="My Profile"
            SubTitle="Manage your personal information and account security.">
</PageHeader>

<Loading NullCheckObject="account" Message="Loading profile...">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
    <!-- ── Left: Personal Information ──────────────────────────────────── -->
    <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-black">
        <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50/50 p-6 dark:border-slate-700 dark:bg-gray-900">
            <h3 class="flex items-center gap-2 text-lg font-bold text-slate-800 dark:text-slate-200">
                    <Icon Style="Icon.IconStyle.User" CssClass="size-5 text-slate-400" />
                Personal Information
            </h3>
            <button @onclick="() => profileModal.Show()"
                    class="text-sm font-medium text-brand-600 hover:text-brand-700 transition-colors">
                Edit
            </button>
        </div>

        <div class="flex-1 space-y-8 p-6">
            <!-- Avatar -->
            <div class="flex flex-col items-center gap-6 sm:flex-row">
                <div class="relative">
                    <div class="flex size-24 items-center justify-center rounded-full border-4 border-white bg-brand-100 text-3xl font-bold text-brand-600 shadow-sm">
                        @account?.Initials
                    </div>
                    @* <button class="absolute right-0 bottom-0 rounded-full border border-slate-200 bg-white p-1.5 text-slate-500 shadow-sm transition-colors hover:text-brand-600">
                            <Icon Style="Icon.IconStyle.Camera" CssClass="size-4" />
                        </button> *@
                </div>
                <div class="text-center sm:text-left">
                    <h2 class="text-base font-bold text-slate-900 dark:text-slate-200">
                        @account?.FullName
                    </h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        @(account?.Active == true ? "Active Account" : "Inactive Account")
                    </p>
                    <div class="mt-3 flex justify-center gap-2 sm:justify-start">
                        <span class="inline-flex items-center rounded-full border border-blue-100 bg-blue-50 px-2.5 py-0.5 font-mono text-xs font-medium text-blue-700 italic">
                            ID: @account?.AccountID
                        </span>
                    </div>
                </div>
            </div>

            <!-- Info rows -->
            <div class="space-y-3">
                <div>
                    <label class="mb-1.5 block text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">Email Address</label>
                    <div class="flex items-center rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-gray-900">
                        <span class="mr-3 text-slate-400"><Icon Style="Icon.IconStyle.Mail" CssClass="size-5" /></span>
                        <span class="font-medium text-slate-700 dark:text-slate-200">@(account?.AccountName ?? "—")</span>
                        <span class="ml-auto rounded-full border border-emerald-100 bg-emerald-50 px-2 py-0.5 font-bold text-emerald-700 text-[10px]">ACTIVE</span>
                    </div>
                </div>
                <div>
                    <label class="mb-1.5 block text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">Phone Number</label>
                    <div class="flex items-center rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-gray-900">
                        <span class="mr-3 text-slate-400"><Icon Style="Icon.IconStyle.Phone" CssClass="size-5" /></span>
                        <span class="font-medium text-slate-700 dark:text-slate-200">@(account?.Phone ?? "—")</span>
                    </div>
                </div>
                <div>
                    <label class="mb-1.5 block text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">Country Code</label>
                    <div class="flex items-center rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-gray-900">
                        <span class="mr-3 text-slate-400"><Icon Style="Icon.IconStyle.Globe" CssClass="size-5" /></span>
                        <span class="font-medium text-slate-700 dark:text-slate-200">+@account?.CountryCode</span>
                    </div>
                </div>
                <div>
                    <label class="mb-1.5 block text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">Time Zone</label>
                    <div class="flex items-center rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-gray-900">
                        <span class="mr-3 text-slate-400"><Icon Style="Icon.IconStyle.Clock" CssClass="size-5" /></span>
                        <span class="font-medium text-slate-700 dark:text-slate-200">GMT @((account?.TimeZone >= 0 ? "+" : "") + account?.TimeZone)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Right: Security ───────────────────────────────────────── -->
    <div class="space-y-8">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-black">
            <div class="border-b border-slate-200 bg-slate-50/50 p-6 dark:border-slate-700 dark:bg-gray-900">
                <h3 class="flex items-center gap-2 text-lg font-bold text-slate-800 dark:text-slate-200">
                        <Icon Style="Icon.IconStyle.Shield" CssClass="size-5 text-slate-400" />
                    Security Settings
                </h3>
            </div>
            <div class="space-y-6 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h4 class="font-semibold text-slate-800 dark:text-slate-200">Password</h4>
                        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                            Manage your account password here.
                        </p>
                    </div>
                    <button @onclick="() => passwordModal.Show()"
                            class="px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors shadow-sm dark:border-slate-700 dark:bg-gray-900 dark:text-slate-200 dark:hover:bg-slate-800">
                        Change Password
                    </button>
                </div>

                <hr class="border-slate-100 dark:border-slate-700" />

                <div class="flex cursor-not-allowed items-start justify-between opacity-50">
                    <div class="pr-8">
                        <h4 class="flex items-center gap-2 font-semibold text-slate-800 dark:text-slate-200">
                            Two-Factor Authentication
                            <span class="rounded border border-slate-200 bg-slate-100 px-2 py-0.5 font-bold text-[10px] text-slate-500 uppercase">
                                Coming Soon
                            </span>
                        </h4>
                        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                            Secure your account with 2FA using SMS or an authenticator
                            app.
                        </p>
                    </div>
                    <label class="pointer-events-none relative inline-flex items-center">
                        <input type="checkbox"
                               disabled checked
                               class="peer sr-only" />
                            <div class="h-6 w-11 rounded-full bg-slate-200 after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:border after:border-gray-300 after:bg-white after:transition-all after:content-['']"></div>
                    </label>
                </div>
            </div>
        </div>

        <!-- KYC Verification -->
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-black">
            <div class="border-b border-slate-200 bg-slate-50/50 p-6 dark:border-slate-700 dark:bg-gray-900">
                <h3 class="flex items-center gap-2 text-lg font-bold text-slate-800 dark:text-slate-200">
                        <Icon Style="Icon.IconStyle.CheckCircle" CssClass="size-5 text-slate-400" />
                    KYC Verification
                </h3>
            </div>
            <div class="p-6">
                <div class="flex items-center gap-4">
                        <div class="flex size-12 shrink-0 items-center justify-center rounded-full border border-amber-100 bg-amber-50 text-amber-600">
                            <Icon Style="Icon.IconStyle.AlertCircle" CssClass="size-6" />
                    </div>
                    <div>
                        <h4 class="text-lg font-bold text-slate-900 dark:text-slate-200">
                            Not Verified
                        </h4>
                        <p class="text-sm text-slate-500 dark:text-slate-400">
                            Your account identity has not been verified yet.
                        </p>
                    </div>
                </div>
                <button disabled
                        class="mt-6 w-full rounded-lg bg-slate-200 px-4 py-2 text-sm font-semibold text-white shadow-md transition-colors">
                    Start Verification
                </button>
            </div>
        </div>
    </div>
    </div>
</Loading>

@if (account != null)
{
    <ProfileModal @ref="profileModal" Account="account" OnCompleted="ReloadProfile"></ProfileModal>
    <PasswordModal @ref="passwordModal" Account="account"></PasswordModal>    
}

@code {
    [CascadingParameter(Name = "MainAccount")] public required AccountState State { get; set; }

    private ProfileModal profileModal = new();
    private PasswordModal passwordModal = new();
    private AccountResponse account => State.Account;

    private async Task ReloadProfile()
    {
        try
        {
            var response = await apiClient.AccountGetAsync("self");
            State.UpdateAccount(response.Result);
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"An error occurred while fetching account data. {ex.Message}");
        }
    }
}
