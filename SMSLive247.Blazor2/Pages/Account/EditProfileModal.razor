<Modal Title="Edit Profile" IsVisible="isVisible" Size="Modal.ModalSize.Medium">
    <Body>
        <span>just a content</span>
    </Body>

    <Footer>
        <button class="btn btn-primary" @onclick="Hide">Close</button>
    </Footer>
</Modal>

@code {
    private bool isVisible = false;

    public void Show()
    {
        isVisible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        isVisible = false;
        StateHasChanged();
    }
}
