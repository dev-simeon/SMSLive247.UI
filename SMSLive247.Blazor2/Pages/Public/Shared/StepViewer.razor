<BackLink Location="@Const.Routes.Login"
          Title="Back to Sign In">
</BackLink>

<div class="mb-8 flex items-center gap-4" @onclick="() => Step += 1">
    @for (int i = 1; i <= StepNames.Length; i++)
    {
        <div class="flex items-center gap-2">
            @if (i > Step)
            {
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-400 transition-all">@i</div>
                <span class="text-sm font-medium text-slate-400 transition-colors sm:inline">@StepNames[i - 1]</span>
            }
            else if (i < Step)
            {
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-200 text-xs font-bold text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" 
                    stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                </div>
                <span class="text-sm font-medium text-slate-400 transition-colors sm:inline">@StepNames[i - 1]</span>
            }
            else
            {
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-500 text-xs font-bold text-white ring-4 ring-brand-500/20 transition-all">@i</div>
                <span class="text-sm font-medium text-slate-900 transition-colors sm:inline">@StepNames[i - 1]</span>
            }
        </div>

        if (i < StepNames.Length)
        {
            <div class="h-px flex-1 @(i == Step ? "bg-brand-100" : "bg-slate-200")"></div>
        }
    }
</div>


