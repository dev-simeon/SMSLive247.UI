@attribute [Route(Const.Routes.Logoff)]
@attribute [AllowAnonymous]

@inject NavigationManager nav
@inject AuthenticationStateProvider auth;

@code {
    protected override async Task OnInitializedAsync()
    {
        await ((Authentication.SmsAuthProvider)auth).ClearAuthenticationState();
        var shouldForceReload = !nav.Uri.EndsWith(Const.Routes.Login, StringComparison.OrdinalIgnoreCase);
        nav.NavigateTo(Const.Routes.Login, shouldForceReload);
    }
}
