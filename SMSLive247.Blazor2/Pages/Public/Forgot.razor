@using SMSLive247.Blazor2.Pages.Public.Shared
@attribute [Route(Const.Routes.ForgotPassword)]

<SectionContent SectionName="page-branding">
    <div class="relative z-10 max-w-lg">
        <h1 class="mb-6 text-4xl leading-tight font-bold">
            Security is our Priority.
        </h1>
        <p class="text-lg leading-relaxed text-blue-100">
            Follow our secure process to recover your account and get back to managing your communications.
        </p>
    </div>
</SectionContent>

<div>

    <div class="mb-6 flex items-center justify-center lg:hidden">
        <img src="smslive-logo-2.png"
             alt="SMSLive247"
             class="h-10 w-auto rounded-lg" />
    </div>

    @if (step < 3)
    {
        <StepViewer Step="@step" StepNames="@(new[] { "Verify Email", "Reset Password" })" />
    }

    @if (step == 1)
    {
        <div class="animate-in fade-in space-y-6 duration-300">
            <div class="text-center lg:text-left">
                <h2 class="text-3xl font-bold text-slate-900 transition-colors">
                    Forgot Password?
                </h2>
                <p class="mt-2 text-slate-500">
                    Enter your account email address and we'll send you a reset code.
                </p>
            </div>

            <EditForm Model="@requestModel" OnValidSubmit="RequestResetAsync" FormName="fRequest" class="space-y-6">
                <FormRow>
                    <FormInput @bind-Value="requestModel.Username"
                               Type="email"
                               Label="Email Address"
                               Required="true"
                               IconStyle="Icon.IconStyle.Mail"
                               PlaceHolder="name@company.com"
                               RequiredMessage="Please enter your email address." />
                </FormRow>

                <div>
                    <Button IsSubmit="true"
                            CssClass="w-full py-3 text-base"
                            IsBusy="@isBusy"
                            Text="Send Reset Code">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" 
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-chevron-right" aria-hidden="true"><path d="m9 18 6-6-6-6"></path>
                        </svg>
                    </Button>
                </div>
            </EditForm>

            <p class="text-center text-sm text-slate-500">
                Wait, I remember my password!
                <a href="@Const.Routes.Login"
                   class="font-semibold text-brand-500 underline decoration-brand-500/30 transition-all hover:text-brand-600 hover:decoration-brand-500">
                    Sign In
                </a>
            </p>
        </div>
    }
    else if (step == 2)
    {
        <div class="animate-in fade-in space-y-6 duration-300">
            <div class="text-center lg:text-left">
                <h2 class="text-3xl font-bold text-slate-900 transition-colors">
                    Set New Password
                </h2>
                <p class="mt-2 text-slate-500">
                    Enter the reset code sent to your account and choose a new password.
                </p>
            </div>


            <div class="flex items-start gap-3 rounded-xl border border-brand-100 bg-brand-50 p-4 text-sm text-brand-700">
                <Icon Style="Icon.IconStyle.Key" CssClass="mt-0.5 shrink-0 text-lg" />
                <span>
                    A reset code has been dispatched. Check your registered email or SMS and enter it below.
                </span>
            </div>

            <EditForm Model="@confirmModel" OnValidSubmit="ConfirmResetAsync" FormName="fConfirm" class="space-y-6">
                <FormRow>
                    <FormInput @bind-Value="confirmModel.ResetCode"
                               Label="Reset Code"
                               Required="true"
                               IconStyle="Icon.IconStyle.Key"
                               PlaceHolder="Enter the code you received"
                               RequiredMessage="Reset code is required." />
                </FormRow>

                <FormRow>
                    <FormInput @bind-Value="confirmModel.NewPassword"
                               Type="password"
                               Label="New Password"
                               Required="true"
                               PlaceHolder="At least 6 characters"
                               RequiredMessage="New password is required." />
                </FormRow>

                <FormRow>
                    <FormInput @bind-Value="confirmPassword"
                               Type="password"
                               Label="Confirm New Password"
                               Required="true"
                               PlaceHolder="Re-enter your new password"
                               RequiredMessage="Please confirm your new password." />
                </FormRow>

                @if (!string.IsNullOrEmpty(confirmPassword) && confirmModel.NewPassword != confirmPassword)
                {
                    <p class="text-xs font-medium text-red-500">Passwords do not match.</p>
                }

                <div>
                    <Button IsSubmit="true"
                            CssClass="w-full py-3 text-base"
                            IsBusy="@isBusy"
                            Text="Reset My Password" />
                </div>
            </EditForm>

            <p class="text-center text-sm text-slate-500">
                Didn't receive a code?
                <button type="button"
                        @onclick="BackToStep1"
                        class="font-semibold text-brand-500 underline decoration-brand-500/30 transition-all hover:text-brand-600 hover:decoration-brand-500">
                    Go back &amp; resend
                </button>
            </p>
        </div>
    }
    else if (step == 3)
    {
        <div class="animate-in fade-in space-y-6 py-4 text-center duration-500">
            <div class="mb-2 inline-flex h-20 w-20 items-center justify-center rounded-full border border-emerald-100 bg-emerald-50 text-emerald-500 shadow-sm">
                <Icon Style="Icon.IconStyle.CheckCircle" CssClass="text-4xl text-emerald-500" />
            </div>
            <div class="space-y-2">
                <h2 class="text-3xl font-bold text-slate-900">
                    Password Reset!
                </h2>
                <p class="mx-auto max-w-sm text-sm text-slate-500">
                    Your password has been changed successfully. You can now sign in with your new credentials.
                </p>
            </div>
            <div>
                <Button Text="Go to Sign In"
                        CssClass="w-full py-3 text-base"
                        OnClick="() => nav.NavigateTo(Const.Routes.Login)" />
            </div>
        </div>
    }
</div>

@code {
    private int step = 1;
    private bool isBusy = false;
    private string confirmPassword = "";

    private PasswordResetRequest requestModel = new();
    private PasswordResetConfirm confirmModel = new();

    private async Task RequestResetAsync()
    {
        try
        {
            isBusy = true;
            requestModel.ParentID = settings.ParentID;
            var response = await apiClient.PasswordResetRequestAsync(requestModel);

            confirmModel.Username = requestModel.Username;
            await alert.Info("Reset code sent! Please check your email.", "Reset Code Sent");
            step = 2;
        }
        catch (SMSLive247.OpenApi.ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ConfirmResetAsync()
    {
        try
        {
            isBusy = true;

            if (confirmModel.NewPassword != confirmPassword)
                throw new Exception("Passwords do not match");

            confirmModel.Username = requestModel.Username;
            confirmModel.ParentID = settings.ParentID;

            var response = await apiClient.PasswordResetConfirmAsync(confirmModel);
            step = 3;
        }
        catch (SMSLive247.OpenApi.ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void BackToStep1()
    {
        confirmModel.ResetCode = "";
        confirmModel.NewPassword = "";
        confirmPassword = "";
        step = 1;
    }
}
