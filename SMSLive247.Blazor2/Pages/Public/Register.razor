@attribute [Route(Const.Routes.Register)]
@attribute [AllowAnonymous]
@layout PublicLayout

@inject Settings settings;
@inject AlertService alert
@inject ApiClient apiClient
@inject NavigationManager nav

<SectionContent SectionName="page-branding">
    <div class="relative z-10 max-w-lg">
        <h1 class="mb-6 text-4xl leading-tight font-bold">Everything you need to reach your customers.</h1>
        <p class="mb-8 text-lg leading-relaxed text-slate-100">
            Join thousands of businesses sending millions of messages daily with
            the most reliable bulk SMS platform in Nigeria.
        </p>
        <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3 rounded-xl border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big shrink-0 text-white" aria-hidden="true">
                    <path d="M21.801 10A10 10 0 1 1 17 3.335"></path>
                    <path d="m9 11 3 3L22 4"></path>
                </svg>
                <div>
                    <p class="font-semibold">Robust API Integration</p>
                    <p class="mt-0.5 text-xs text-slate-100">Connect your enterprise workflows in minutes.</p>
                </div>
            </div>
            <div class="flex items-center gap-3 rounded-xl border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield shrink-0 text-white" aria-hidden="true">
                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                </svg>
                <div>
                    <p class="font-semibold">Scalable Infrastructure</p>
                    <p class="mt-0.5 text-xs text-slate-100">High throughput for time-critical notifications.</p>
                </div>
            </div>
        </div>
    </div>
</SectionContent>

<div class="text-center lg:text-left">
    <div class="mb-8 flex items-center justify-center lg:hidden">
        <img src="smslive-logo-2.png" alt="SMSLive247" class="h-10 w-auto rounded-lg" />
    </div>
    <h2 class="text-3xl font-bold text-slate-900">Create Account</h2>
    <p class="mt-2 text-slate-500">Join the SMSLive247 enterprise platform today.</p>
</div>

<EditForm Model="@model" OnValidSubmit="RegisterAsync" FormName="R1" class="space-y-5">
    <FormRow Cols="2">
        <FormInput 
            @bind-Value="model.FirstName" 
            Label="First Name" 
            PlaceHolder="John"
            IconStyle="Icon.IconStyle.User"
            Required="true"/>
        <FormInput 
            @bind-Value="model.LastName" 
            Label="Last Name" 
            PlaceHolder="Doe" 
            IconStyle="Icon.IconStyle.User" 
            Required="true"/>
    </FormRow>

    <FormRow Cols="1">
        <FormInput 
            @bind-Value="model.Email" 
            Type="email" 
            Label="Email" 
            PlaceHolder="john@company.com" 
            IconStyle="Icon.IconStyle.Mail"
            Required="true"/>
    </FormRow>

    <FormRow Cols="2">
        <FormInput 
            @bind-Value="model.Phone" 
            Type="tel" 
            Label="Phone Number" 
            PlaceHolder="+234 800 000 0000" 
            IconStyle="Icon.IconStyle.Phone" 
            Required="true"/>
        <FormSelect 
            @bind-Value="model.CountryCode"  
            Label="Country" 
            Variant="FormSelect<int>.SelectType.Country" 
            IconStyle="Icon.IconStyle.Phone"
            Required="true" />
    </FormRow>

    <FormRow Cols="1" Visible="true">
        <FormSelect 
            @bind-Value="model.TimeZone" 
            Label="Time Zone" 
            Variant="FormSelect<int>.SelectType.TimeZone"
            IconStyle="Icon.IconStyle.Phone"
            Required="true" />
    </FormRow>

    <FormRow Cols="2">
        <FormInput @bind-Value="model.Password" Type="password" Label="Password" Required="true" />
        <FormInput @bind-Value="confirmPassword" Type="password" Label="Confirm Password" Required="true" />
    </FormRow>

    @if (model.Password != confirmPassword && !string.IsNullOrEmpty(confirmPassword))
    {
        <p class="mt-1 text-red-500">Passwords do not match.</p>
    }

    <div class="flex items-center">
        <InputCheckbox @bind-Value="termsAccepted" id="terms" style="accent-color: lime"
                       class="bg-brand-500 h-4 w-4 rounded-lg border-slate-200 focus:ring-brand-500/30 focus:border-brand-500 focus:ring-4 focus:outline-none" />
        
                       <label class="ml-2 block text-sm text-slate-600" for="terms">
            I have read and accepted the
            <a href="@Const.Routes.Legal.Terms" target="_blank"
               class="text-brand-500 hover:text-brand-600">Agreement</a> and
            <a href="@Const.Routes.Legal.Privacy" target="_blank"
               class="text-brand-500 hover:text-brand-600">Privacy Policy</a>
        </label>
    </div>

    <Button IsSubmit="true"
            IsBusy="@isBusy"
            IsDisabled="@(!termsAccepted)"
            CssClass="w-full py-3"
            Text="Create Account" />
</EditForm>

<p class="text-center text-sm text-slate-500">
    Already have an account?
    <a href="@Const.Routes.Login" class="text-brand-500 font-semibold hover:text-brand-600">
        Sign In
    </a>
</p>

@code {
    private bool isBusy = false;
    private bool termsAccepted = false;
    private string confirmPassword = "";

    private AccountCreateRequest model = new() { TimeZone = 99, CountryCode = 0 };

    private async Task RegisterAsync()
    {
        isBusy = true;
        try
        {
            if (!termsAccepted)
                throw new Exception("You must accept the agreement and privacy policy to register");

            if (model.Password != confirmPassword)
                throw new Exception("Passwords do not match");

            model.AccountName = $"{model.FirstName} {model.LastName}";
            var response = await apiClient.RegisterAsync(settings.ParentID, model);

            if (response.StatusCode == 200)
            {
                await alert.Success("Account created successfully!");
                nav.NavigateTo($"{Const.Routes.Login}?email=" + model.Email);
            }
            else
            {
                throw new Exception("Registration failed. Please try again.");
            }
        }
        catch (SMSLive247.OpenApi.ApiException ex)
        {
            await alert.Error(ex.Message);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}