@using SMSLive247.Blazor.Pages.Public.Shared
@attribute [Route(Const.Routes.Register)]

<SectionContent SectionName="page-branding">
    <div class="relative z-10 max-w-lg">
        <h1 class="mb-6 text-4xl leading-tight font-bold">Everything you need to reach your customers.</h1>
        <p class="mb-8 text-lg leading-relaxed text-slate-100">
            Join thousands of businesses sending millions of messages daily with
            the most reliable bulk SMS platform in Nigeria.
        </p>
        <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3 rounded-xl border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
                <Icon Style="Icon.IconStyle.CheckCircle" CssClass="shrink-0 text-xl text-white" />
                <div>
                    <p class="font-semibold">Robust API Integration</p>
                    <p class="mt-0.5 text-xs text-slate-100">Connect your enterprise workflows in minutes.</p>
                </div>
            </div>
            <div class="flex items-center gap-3 rounded-xl border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
                <Icon Style="Icon.IconStyle.Shield" CssClass="shrink-0 text-xl text-white" />
                <div>
                    <p class="font-semibold">Scalable Infrastructure</p>
                    <p class="mt-0.5 text-xs text-slate-100">High throughput for time-critical notifications.</p>
                </div>
            </div>
        </div>
    </div>
</SectionContent>

<div>

    <div class="mb-6 flex items-center justify-center lg:hidden">
        <img src="smslive-logo-2.png" alt="SMSLive247" class="h-10 w-auto rounded-lg" />
    </div>

    @if (step < 3)
    {
        <StepViewer Step="@step" StepNames="@(new[] { "Verify Email", "Create Account" })" />
    }

    @if (step == 1)
    {
        <div class="animate-in fade-in space-y-6 duration-300">
            <div class="text-center lg:text-left">
                <h2 class="text-3xl font-bold text-slate-900">Create Account</h2>
                <p class="mt-2 text-slate-500">Enter your email and mobile phone to receive a verification code.</p>
            </div>

            <EditForm Model="@requestModel" OnValidSubmit="RequestOtpAsync" FormName="regRequest" class="space-y-5">
                <FormRow Cols="1">
                    <FormInput @bind-Value="requestModel.Email"
                               Label="Email Address" Type="email"
                               PlaceHolder="name@company.com"
                               IconStyle="Icon.IconStyle.Mail"
                               Required="true" />
                </FormRow>

                <FormRow Cols="1">
                    <FormInput @bind-Value="requestModel.Phone"
                               Label="Mobile Phone Number" Type="tel"
                               PlaceHolder="+234 800 000 0000"
                               IconStyle="Icon.IconStyle.Phone"
                               Required="true" />
                </FormRow>

                <div>
                    <Button IsSubmit="true"
                            IsBusy="@isBusy"
                            CssClass="w-full py-3 text-base"
                            Text="Send Verification Code">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="lucide lucide-chevron-right" aria-hidden="true">
                            <path d="m9 18 6-6-6-6"></path>
                        </svg>
                    </Button>
                </div>
            </EditForm>

            <p class="text-center text-sm text-slate-500">
                Already have an account?
                <a href="@Const.Routes.Login" class="font-semibold text-brand-500 hover:text-brand-600">
                    Sign In
                </a>
            </p>
        </div>
    }
    else if (step == 2)
    {
        <div class="animate-in fade-in space-y-6 duration-300">
            <div class="text-center lg:text-left">
                <h2 class="text-3xl font-bold text-slate-900">Verify &amp; Complete Profile</h2>
                <p class="mt-2 text-slate-500">Enter the verification code sent to your email and finish setting up your account.</p>
            </div>


            <div class="flex items-start gap-3 rounded-xl border border-brand-100 bg-brand-50 p-4 text-sm text-brand-700">
                <Icon Style="Icon.IconStyle.Key" CssClass="mt-0.5 shrink-0 text-lg" />
                <span>
                    A verification code was sent to <strong>@requestModel.Email</strong>. Enter it below to complete your registration.
                </span>
            </div>

            <EditForm Model="@confirmModel" OnValidSubmit="ConfirmRegisterAsync" FormName="regConfirm" class="space-y-5">
                <FormRow Cols="1">
                    <FormInput @bind-Value="confirmModel.VerifyCode"
                               Label="Verification Code (OTP)"
                               PlaceHolder="Enter the code sent to your email"
                               IconStyle="Icon.IconStyle.Key"
                               Required="true" />
                </FormRow>
                <FormRow Cols="2">
                    <FormInput @bind-Value="confirmModel.FirstName"
                               Label="First Name"
                               PlaceHolder="John"
                               IconStyle="Icon.IconStyle.User"
                               Required="true" />
                    <FormInput @bind-Value="confirmModel.LastName"
                               Label="Last Name"
                               PlaceHolder="Doe"
                               IconStyle="Icon.IconStyle.User"
                               Required="true" />
                </FormRow>
                <FormRow Cols="2">
                    <FormSelect @bind-Value="confirmModel.CountryCode"
                                Label="Country"
                                Variant="FormSelect<int>.SelectVariant.Country"
                                IconStyle="Icon.IconStyle.Phone"
                                Required="true" />
                    <FormSelect @bind-Value="confirmModel.TimeZone"
                                Label="Time Zone"
                                Variant="FormSelect<int>.SelectVariant.TimeZone"
                                IconStyle="Icon.IconStyle.Clock"
                                Required="true" />
                </FormRow>
                <FormRow Cols="2">
                    <FormInput @bind-Value="confirmModel.Password"
                               Type="password"
                               Label="Password"
                               Required="true"
                               PlaceHolder="At least 6 characters" />
                    <FormInput @bind-Value="confirmPassword"
                               Type="password"
                               Label="Confirm Password"
                               Required="true"
                               PlaceHolder="Re-enter your password" />
                </FormRow>
                @if (confirmModel.Password != confirmPassword && !string.IsNullOrEmpty(confirmPassword))
                {
                    <p class="text-xs font-medium text-red-500">Passwords do not match.</p>
                }
                <div class="flex items-center">
                    <InputCheckbox @bind-Value="termsAccepted" id="terms"
                                   class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                    <label class="ml-2 block text-sm text-slate-700" for="terms">
                        I have read and accepted the
                        <a href="@Const.Routes.Legal.Terms" target="_blank"
                           class="font-medium text-brand-600 underline hover:text-brand-700">Agreement</a> and
                        <a href="@Const.Routes.Legal.Privacy" target="_blank"
                           class="font-medium text-brand-600 underline hover:text-brand-700">Privacy Policy</a>
                    </label>
                </div>
                <div>
                    <Button IsSubmit="true"
                            IsBusy="@isBusy"
                            IsDisabled="@(!termsAccepted)"
                            CssClass="w-full py-3 text-base"
                            Text="Complete Registration" />
                </div>
            </EditForm>

            <p class="text-center text-sm text-slate-500">
                Didn't receive a verification code?
                <button type="button"
                        @onclick="BackToStep1"
                        class="font-semibold text-brand-500 underline decoration-brand-500/30 transition-all hover:text-brand-600 hover:decoration-brand-500">
                    Go back &amp; resend
                </button>
            </p>
        </div>
    }
    else if (step == 3)
    {
        <div class="animate-in fade-in space-y-6 py-4 text-center duration-500">
            <div class="mb-2 inline-flex h-20 w-20 items-center justify-center rounded-full border border-emerald-100 bg-emerald-50 text-emerald-500 shadow-sm">
                <Icon Style="Icon.IconStyle.CheckCircle" CssClass="text-4xl text-emerald-500" />
            </div>
            <div class="space-y-2">
                <h2 class="text-3xl font-bold text-slate-900">
                    Account Created!
                </h2>
                <p class="mx-auto max-w-sm text-sm text-slate-500">
                    Your SMSLive247 account has been created successfully. You can now sign in with your credentials.
                </p>
            </div>
            <div>
                <Button Text="Go to Sign In"
                        CssClass="w-full py-3 text-base"
                        OnClick="() => nav.NavigateTo(Const.Routes.Login)" />
            </div>
        </div>
    }
</div>

@code {
    private int step = 1;
    private bool isBusy = false;
    private bool termsAccepted = false;
    private string confirmPassword = "";

    private RegisterRequest requestModel = new();
    private RegisterConfirm confirmModel = new() { TimeZone = 99, CountryCode = 0 };

    private async Task RequestOtpAsync()
    {
        try
        {
            isBusy = true;
            requestModel.ParentID = settings.ParentID;

            var response = await apiClient.RegisterRequestAsync(requestModel);

            // confirmModel.Email = requestModel.Email;
            // confirmModel.Phone = requestModel.Phone;
            await alert.Info("Verification code sent to your email!", "Verification Code");
            step = 2;
        }
        catch (SMSLive247.OpenApi.ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"An error occurred while requesting the verification code. {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ConfirmRegisterAsync()
    {
        try
        {
            isBusy = true;

            if (!termsAccepted)
                throw new Exception("You must accept the agreement and privacy policy to register");

            if (confirmModel.Password != confirmPassword)
                throw new Exception("Passwords do not match");

            confirmModel.Email = requestModel.Email;
            confirmModel.Phone = requestModel.Phone;
            confirmModel.ParentID = settings.ParentID;
            confirmModel.AccountName = $"{confirmModel.FirstName} {confirmModel.LastName}";

            var response = await apiClient.RegisterConfirmAsync(confirmModel);
            await alert.Success("Account created successfully!", "Account Created");
            step = 3;
        }
        catch (SMSLive247.OpenApi.ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error($"An error occurred while confirming the registration. {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void BackToStep1()
    {
        confirmModel.VerifyCode = "";
        step = 1;
    }
}