@attribute [Route(Const.Routes.Login)]

<SectionContent SectionName="page-branding">
    <div class="relative z-10 max-w-lg">
        <h1 class="mb-6 text-4xl leading-tight font-bold">
            Reliable Bulk SMS for Every Business.
        </h1>
        <p class="mb-8 text-lg leading-relaxed text-slate-100">
            Scale your communication with high-volume workflows, sub-account
            management, and real-time delivery analytics tailored for large
            organizations.
        </p>
        <div class="flex gap-4">
            <div class="flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-4 py-2 backdrop-blur-sm">
                <Icon Style="Icon.IconStyle.CheckCircle" />
                <span class="text-sm font-medium">99.9% Uptime</span>
            </div>
            <div class="flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-4 py-2 backdrop-blur-sm">
                <Icon Style="Icon.IconStyle.Shield" />
                <span class="text-sm font-medium">Bank-grade Security</span>
            </div>
        </div>
    </div>
</SectionContent>

<div class="text-center lg:text-left">
    <logo class="mb-8 flex items-center justify-center lg:hidden">
        <img src="smslive-logo-2.png"
             alt="SMSLive247"
             class="h-10 w-auto rounded-lg" />
    </logo>
    <h2 class="text-3xl font-bold text-slate-900 transition-colors">
        Welcome Back
    </h2>
    <p class="mt-2 text-slate-500">
        Please enter your details to access your dashboard.
    </p>
</div>

<EditForm Model="@model" OnValidSubmit="LoginAsync" FormName="f1" class="space-y-6">
    <FormRow>
        <FormInput @bind-Value="model.Username"
                   Type="email" Label="Email"
                   IconStyle="Icon.IconStyle.Mail"
                   Required="true"
                   PlaceHolder="name@company.com" />
    </FormRow>

    <FormRow>
        <FormInput @bind-Value="model.Password" 
                   Type="password" Label="Password"
                   Required="true"
                   PlaceHolder="••••••••" />
    </FormRow>
 
    <div class="flex items-center justify-between">
        <div class="flex items-center">
            <input id="remember-me"
                   name="remember-me"
                   type="checkbox"
                   class="h-4 w-4 rounded border-slate-200 text-brand-500 focus:ring-brand-500" />
            <label class="ml-2 block text-slate-600"
                   for="remember-me">
                Remember me for 30 days
            </label>
        </div>
        <div class="">
            <a href="@Const.Routes.ForgotPassword" class="font-medium text-brand-500 hover:text-brand-600">
                Forgot password?
            </a>
        </div>
    </div>

    <div>
        <Button IsSubmit="true"
                CssClass="w-full py-3 text-base"
                IsBusy="@isBusy"
                Text="Sign in to Dashboard" />
    </div>
</EditForm>

<div class="relative">
    <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-slate-200"></div>
    </div>
    <div class="relative flex justify-center text-sm">
        <span class="bg-white px-2 text-slate-500 transition-colors">
            Or continue with
        </span>
    </div>
</div>

<div>
    <GoogleAuth @bind-IsBusy="isBusy"></GoogleAuth>
</div>

<p class="mt-8 text-center text-sm text-slate-500">
    Don't have an account?
    <a href="@Const.Routes.Register"
           class="font-semibold text-brand-500 hover:text-brand-600">
        Sign up now
    </a>
</p>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool isBusy = false;
    private LoginRequest model = new();

    protected override async Task OnParametersSetAsync()
    {
        var authState = await ((Authentication.SmsAuthProvider)auth).GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var destination = !string.IsNullOrWhiteSpace(ReturnUrl)
                ? ReturnUrl : Const.Routes.Dashboard;

            nav.NavigateTo(destination);
        }
    }
    // protected override async Task OnInitializedAsync()
    // {
    //     var authState = await ((Authentication.SmsAuthProvider)auth).GetAuthenticationStateAsync();
    //     if (authState.User.Identity?.IsAuthenticated == true)
    //     {
    //         var destination = !string.IsNullOrWhiteSpace(ReturnUrl)
    //             ? ReturnUrl : Const.Routes.Dashboard;

    //         nav.NavigateTo(destination);
    //     }
    // }

    private async Task LoginAsync()
    {
        try
        {
            isBusy = true;
            model.ParentID = settings.ParentID;
            var response = await apiClient.LoginAsync(model);

            await ((Authentication.SmsAuthProvider)auth)
                .SaveAuthenticationState(apiKey: response.Result.AccessToken);

            var destination = !string.IsNullOrWhiteSpace(ReturnUrl)
                ? ReturnUrl : Const.Routes.Dashboard;

            nav.NavigateTo(destination);
        }
        catch (ApiException ex)
        {
            await alert.Error(ex.FriendlyErrorMessage);
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
