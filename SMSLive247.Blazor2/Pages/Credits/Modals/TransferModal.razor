<Modal Title="Transfer Credit" @bind-IsVisible="isVisible">
    <Body>
        <EditForm id="wf3" Model="@model" OnValidSubmit="HandleSubmit" class="space-y-6">

            <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 flex gap-3">
                <Icon Style="Icon.IconStyle.AlertCircle" CssClass="w-5 h-5 text-amber-600 shrink-0" />
                <p class="text-xs text-amber-800 leading-relaxed font-medium">
                    Minimum SMS credit quantity to transfer is 50 sms credit.
                </p>
            </div>

            <div class="space-y-4">
                <FormInput Label="Recipient Email"
                            PlaceHolder="user@example.com"
                            Type="email"
                            IconStyle="Icon.IconStyle.Mail"
                            @bind-Value="model.Recipient" />

                <div class="space-y-1.5">
                    <label class="block text-sm font-medium text-slate-700">
                        Credits
                    </label>
                    <InputNumber class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all shadow-sm sm:text-sm"
                                    min="50"
                                    @bind-Value="model.Credits" />
                    @if (model.Credits > 0 && model.Credits < 50)
                    {
                        <p class="text-xs text-red-500 font-semibold mt-1">
                            Amount must be at least 50 credits.
                        </p>
                    }
                    @if (model.Credits > currentBalance)
                    {
                        <p class="text-xs text-red-500 font-semibold mt-1">
                            Insufficient balance to transfer this amount.
                        </p>
                    }
                </div>

                <div class="space-y-1.5">
                    <label class="block text-sm font-medium text-slate-700">
                        Remarks
                    </label>
                    <textarea rows="3"
                                @bind="model.Remarks"
                                class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all shadow-sm sm:text-sm resize-none"
                                placeholder="Optional note..."></textarea>
                </div>
            </div>

            <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 grid grid-cols-2 gap-4">
                <div>
                    <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wide">
                        Old Balance
                    </span>
                    <span class="block text-lg font-mono font-bold text-slate-700 mt-1">
                        @currentBalance.ToString("#,##0.##")
                    </span>
                </div>
                <div class="text-right">
                    <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wide">
                        New Balance
                    </span>
                    <span class="block text-lg font-mono font-bold mt-1 @(newBalance < 0 ? "text-red-600" : "text-brand-600")">
                        @newBalance.ToString("#,##0.##")
                    </span>
                </div>
            </div>
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true"
                Text="Transfer Credits"
                Icon="Icon.IconStyle.ChevronRight"
                IsBusy="@isSubmitting"
                IsDisabled="@(!canSubmit)" />
        <Button Text="Cancel"
                Style="Button.ButtonStyle.Secondary"
                IsDisabled="@isSubmitting"
                OnClick="Close" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible;
    private bool isSubmitting;
    private double currentBalance;
    private TransferRequest model = new();

    private double newBalance => currentBalance - model.Credits;
    private bool canSubmit => !string.IsNullOrWhiteSpace(model.Recipient)
        && model.Credits >= 50 && model.Credits <= currentBalance;

    public async Task Show()
    {
        model = new TransferRequest();
        await FetchData();

        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        StateHasChanged();
    }

    private async Task FetchData()
    {
        try
        {
            var response = await apiClient.AccountGetAsync("self");
            currentBalance = response.Result.Credits;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (!canSubmit)
                throw new Exception("Please enter a valid recipient and credit amount.");

            isSubmitting = true;
            var response = await apiClient.TransferCreditAsync(model);

            await alert.Success($"Your transfer of {model.Credits:#,##0} to {model.Recipient} was successful.");
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message, "Error");
        }
        finally
        {
            isVisible = false;
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
