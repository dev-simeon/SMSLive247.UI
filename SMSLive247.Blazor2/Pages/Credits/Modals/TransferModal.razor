<Modal Title="Transfer Credit" @bind-IsVisible="isVisible">

    <Body>
        <EditForm id="wf3" Model="@model" OnValidSubmit="HandleSubmit" class="space-y-6">

            <div class="flex gap-3 rounded-lg border border-amber-200 bg-amber-50 p-3">
                <Icon Style="Icon.IconStyle.AlertCircle" CssClass="h-5 w-5 shrink-0 text-amber-600" />
                <p class="text-xs leading-relaxed font-medium text-amber-800">
                    Minimum SMS credit quantity to transfer is 50 sms credit.
                </p>
            </div>

            <div class="space-y-4">
                <FormInput Label="Recipient Email" PlaceHolder="user@example.com" Type="email"
                           IconStyle="Icon.IconStyle.Mail" @bind-Value="model.Recipient" Required="true" />

                <div class="space-y-1.5">
                    <label class="block text-sm font-medium text-slate-700">
                        Credits
                    </label>
                    <InputNumber
                    class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 placeholder-slate-400 shadow-sm transition-all focus:ring-brand-500 focus:border-brand-500 focus:ring-2 focus:outline-none sm:text-sm"
                    min="50" @bind-Value="model.Credits" />
                    @if (model.Credits > 0 && model.Credits < 50)
                    {
                        <p class="mt-1 text-xs font-semibold text-red-500">
                            Amount must be at least 50 credits.
                        </p>
                    }
                    @if (model.Credits > currentBalance)
                    {
                        <p class="mt-1 text-xs font-semibold text-red-500">
                            Insufficient balance to transfer this amount.
                        </p>
                    }
                </div>

                <div class="space-y-1.5">
                    <label class="block text-sm font-medium text-slate-700">
                        Remarks
                    </label>
                    <textarea rows="3" @bind="model.Remarks"
                              class="w-full resize-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 placeholder-slate-400 shadow-sm transition-all focus:ring-brand-500 focus:border-brand-500 focus:ring-2 focus:outline-none sm:text-sm"
                              placeholder="Optional note..."></textarea>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
                <div>
                    <span class="block text-xs font-semibold tracking-wide text-slate-500 uppercase">
                        Old Balance
                    </span>
                    <span class="mt-1 block font-mono text-lg font-bold text-slate-700">
                        @currentBalance.ToString("#,##0.##")
                    </span>
                </div>
                <div class="text-right">
                    <span class="block text-xs font-semibold tracking-wide text-slate-500 uppercase">
                        New Balance
                    </span>
                    <span
                        class="mt-1 block font-mono text-lg font-bold @(newBalance < 0 ? "text-red-600" : "text-brand-600")">
                        @newBalance.ToString("#,##0.##")
                    </span>
                </div>
            </div>
        </EditForm>
    </Body>
    <Footer>
        <Button IsSubmit="true" Text="Transfer Credits" Icon="Icon.IconStyle.ChevronRight" IsBusy="@isSubmitting"
                IsDisabled="@(!canSubmit)" form="wf3" />
        <Button Text="Cancel" Style="Button.ButtonStyle.Secondary" IsDisabled="@isSubmitting" OnClick="Close" />
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private bool isVisible;
    private bool isSubmitting;
    private double currentBalance;
    private TransferRequest model = new();

    private double newBalance => currentBalance - model.Credits;
    private bool canSubmit => !string.IsNullOrWhiteSpace(model.Recipient)
        && model.Credits >= 50 && model.Credits <= currentBalance;

    public async Task Show()
    {
        model = new TransferRequest();
        await FetchData();

        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        StateHasChanged();
    }

    private async Task FetchData()
    {
        try
        {
            var response = await apiClient.AccountGetAsync("self");
            currentBalance = response.Result.Credits;
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (!canSubmit)
                throw new Exception("Please enter a valid recipient and credit amount.");

            isSubmitting = true;
            var response = await apiClient.TransferCreditAsync(model);

            await alert.Success($"Your transfer of {model.Credits:#,##0} to {model.Recipient} was successful.");
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            await alert.Error(ex.Message);
        }
        finally
        {
            isVisible = false;
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
