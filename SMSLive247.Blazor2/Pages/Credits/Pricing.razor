@attribute [Route(Const.Routes.Wallet.Pricing)]
@layout MainLayout

<PageTitle>SMSLive247 - Pricing</PageTitle>

<PageHeader Title="Pricing" SubTitle="Calculate your SMS credits instantly. Enter the quantity you need below." />

<div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-12">
    @* Left Column: Calculator *@
    <div class="lg:col-span-4">
        <div class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex-1 space-y-6">
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">
                        Quantity/Credits
                    </label>
                    <div class="relative">
                        <input type="number" @bind="quantity" @bind:event="oninput" min="500"
                               class="block w-full rounded-lg border-0 py-3 pr-16 pl-4 font-mono text-slate-900 ring-1 ring-slate-300 outline-none ring-inset placeholder:text-slate-400 focus:ring-2 focus:ring-brand-500 focus:ring-inset sm:text-sm"
                               placeholder="e.g. 10000" />
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                            <span class="font-bold text-slate-500 text-[10px]">
                                CREDITS
                            </span>
                        </div>
                    </div>
                </div>

                <div class="space-y-4 rounded-xl border border-slate-200 bg-slate-50 p-5">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-slate-500">Credit Price</span>
                        <span class="font-bold text-slate-800">
                            ₦ @(CurrentTier?.Price.ToString("0.00") ?? "0.00")
                        </span>
                    </div>
                    <div class="flex items-center justify-between border-t border-slate-200 pt-4">
                        <span class="font-medium text-slate-500">
                            Total Amount
                        </span>
                        <span class="text-xl font-bold text-brand-600">
                            ₦ @totalCost.ToString("#,##0.00")
                        </span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* Right Column: Pricing Tiers *@
    <div class="lg:col-span-8">
        <div class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 bg-slate-50/50 p-5">
                <h3 class="text-sm font-bold tracking-wider text-slate-900 uppercase">
                    Volume Pricing Guide
                </h3>
            </div>
            <div class="flex-1 overflow-x-auto">
                <table class="w-full border-collapse text-left">
                    <thead>
                        <tr
                            class="border-b border-slate-200 bg-slate-50 font-bold tracking-widest text-slate-500 text-[10px] uppercase">
                            <th class="px-6 py-4">Min Qty</th>
                            <th class="px-6 py-4">Max Qty</th>
                            <th class="px-6 py-4 text-right">Price (₦)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var tier in pricingTiers)
                        {
                            bool isActive = IsTierActive(tier);
                            <tr
                                class="transition-colors @(isActive ? "bg-brand-50 border-l-4 border-l-brand-500" : "hover:bg-slate-50")">
                                <td class="px-6 py-4 text-sm font-medium @(isActive ? "text-brand-700" : "text-slate-600")">
                                    @tier.MinQuantity.ToString("#,##0")
                                </td>
                                <td class="px-6 py-4 text-sm @(isActive ? "text-brand-700" : "text-slate-600")">
                                    @(tier.MaxQuantity == 0 ? "Unlimited" : tier.MaxQuantity.ToString("#,##0"))
                                </td>
                                <td
                                    class="px-6 py-4 text-right text-sm font-bold @(isActive ? "text-brand-700" : "text-slate-900")">
                                    @tier.Price.ToString("0.00")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private long quantity = 10000;
    private List<PriceSlotResponse> pricingTiers = [];
    private PriceSlotResponse? CurrentTier => pricingTiers.FirstOrDefault(t => IsTierActive(t)) ?? pricingTiers.FirstOrDefault();
    private double totalCost => quantity * (CurrentTier?.Price ?? 0);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await apiClient.PriceListAsync();
            if (res.Result != null)
            {
                pricingTiers = res.Result.ToList();
            }
        }
        catch (Exception ex)
        {
            await alert.Error("Failed to load pricing data: " + ex.Message);
        }
    }

    private bool IsTierActive(PriceSlotResponse tier)
    {
        long max = tier.MaxQuantity == 0 ? long.MaxValue : tier.MaxQuantity;
        return quantity >= tier.MinQuantity && quantity <= max;
    }
}
