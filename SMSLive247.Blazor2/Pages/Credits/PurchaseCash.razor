@layout MainLayout
@using SMSLive247.Blazor.Pages.Credits.Modals


<div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-12">
    <div class="lg:col-span-7">
        <div class="flex h-full flex-col rounded-2xl border border-slate-200/90 bg-white p-6 shadow-sm lg:p-7 dark:border-slate-700 dark:bg-black">
            <div class="flex-1 space-y-7">
                    <div class="space-y-2">
                        <div class="flex items-center justify-between gap-3">
                            <label for="custom-funding-amount" class="block text-sm font-medium text-slate-800 dark:text-slate-200">Amount to add</label>
                            <span class="rounded border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium whitespace-nowrap text-slate-400 dark:border-slate-700 dark:bg-gray-900 dark:text-slate-400">Minimum top-up: ₦@minimumFundingAmount.ToString("#,##0")</span>
                        </div>
                        <div class="relative rounded-xl">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-lg font-normal text-slate-400 dark:text-slate-400">₦</span>
                            <input id="custom-funding-amount" type="number" min="@minimumFundingAmount" step="50"
                                   @bind="fundingAmount" @bind:event="oninput" disabled="@isBusy"
                                   class="block w-full rounded-xl border border-slate-300 py-3.5 pr-24 pl-11 font-sans text-xl font-normal tracking-tight text-slate-900 outline-none placeholder:text-slate-400 focus:border-brand-600 focus:ring-4 focus:ring-brand-500/10 disabled:opacity-60 dark:bg-gray-900 dark:text-slate-200 dark:ring-slate-700"
                                   placeholder="0.00" />
                            <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3"><span class="rounded bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-400">NGN</span></span>
                        </div>
                        @if (fundingAmount > 0 && fundingAmount < minimumFundingAmount)
                        {
                            <p class="text-sm text-red-600 dark:text-red-400">Enter at least ₦1,000 to continue.</p>
                        }
                    </div>
                    <div>
                        <p class="mb-2.5 text-xs font-medium tracking-wider text-slate-400 uppercase">Quick amounts</p>
                        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                            @foreach (var amount in fundingPresets)
                            {
                                var selected = fundingAmount == amount;
                                <button type="button" @onclick="() => SetFundingAmount(amount)" aria-pressed="@selected"
                                        disabled="@isBusy"
                                        class="relative flex min-h-[68px] flex-col items-center justify-center rounded-xl border p-3 text-center text-sm font-normal tabular-nums transition-colors disabled:cursor-not-allowed disabled:opacity-60 @(selected ? "border-2 border-brand-600 bg-brand-50/50 text-brand-700 ring-2 ring-brand-500/10 dark:bg-blue-950/40 dark:text-blue-300" : "border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-700 dark:bg-gray-900 dark:text-slate-200 dark:hover:border-slate-500 dark:hover:bg-slate-800")">
                                    <span>₦@amount.ToString("#,##0")</span>
                                    @if (selected)
                                    {
                                        <span class="absolute -top-2 right-2 flex size-4 items-center justify-center rounded-full bg-brand-600 text-[10px] text-white">✓</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                    <button @onclick="ProceedToPayment" disabled="@isBusy"
                            class="flex w-full items-center justify-center gap-2.5 rounded-xl bg-brand-600 px-6 py-4 text-base font-medium text-white shadow-lg shadow-brand-600/30 transition-all hover:bg-brand-700 active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-60">
                        @if (isBusy)
                        {
                            <span class="size-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
                            <span>Calculating...</span>
                        }
                        else
                        {
                            <span>Proceed to Pay ₦@fundingAmount.ToString("#,##0")</span>
                            <Icon Style="Icon.IconStyle.ChevronRight" CssClass="text-base" />
                        }
                    </button>
            </div>
        </div>
    </div>

