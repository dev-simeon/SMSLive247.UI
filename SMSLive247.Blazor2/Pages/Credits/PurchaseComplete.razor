@attribute [Route(Const.Routes.Wallet.PurchaseComplete)]

@layout MainLayout
@inject NavigationManager nav
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>SMSLive247 - Purchase Complete</PageTitle>

@if (status == "loading")
{
    <div class="flex min-h-125 flex-1 items-center justify-center p-8">
        <Loading BoolCheck="false" Message="Verifying payment…" />
    </div>
}
else if (status == "cancelled")
{
    <div class="flex min-h-125 flex-1 items-center justify-center p-6 md:p-8">
        <div class="mx-auto w-full max-w-xl space-y-6 text-center">
            <div
                class="mx-auto flex size-20 items-center justify-center rounded-full bg-amber-50 ring-8 ring-amber-50/50">
                <Icon Style="Icon.IconStyle.AlertCircle" CssClass="size-10 text-amber-400" />
            </div>
            <div>
                <h1 class="mb-2 text-2xl font-bold text-slate-900">Payment Cancelled</h1>
                <p class="text-slate-500">
                    You cancelled the payment or it was not completed. No charge was made to your account.
                </p>
            </div>
            <div class="flex flex-col justify-center gap-3 sm:flex-row">
                <button @onclick='() => nav.NavigateTo(Const.Routes.Wallet.Purchase)'
                        class="flex items-center justify-center gap-2 px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-lg font-medium transition-all">
                    <Icon Style="Icon.IconStyle.CreditCard" CssClass="size-4" /> Try Again
                </button>
            </div>
        </div>
    </div>
}
else if (status == "failed")
{
    <div class="flex min-h-125 flex-1 items-center justify-center p-6 md:p-8">
        <div class="mx-auto w-full max-w-xl space-y-6 text-center">
            <div class="mx-auto flex size-20 items-center justify-center rounded-full bg-red-50 ring-8 ring-red-50/50">
                <Icon Style="Icon.IconStyle.AlertCircle" CssClass="size-10 text-red-400" />
            </div>
            <div>
                <h1 class="mb-2 text-2xl font-bold text-slate-900">Payment Verification Failed</h1>
                <p class="text-slate-500">
                    We could not verify your transaction. If you were charged, please contact support with your payment
                    reference.
                </p>
                @if (transactionId != Guid.Empty)
                {
                    <p class="mt-3 inline-block rounded-lg bg-slate-50 px-3 py-2 font-mono text-xs text-slate-400">
                        Ref: @transactionId
                    </p>
                }
            </div>
            <div class="flex flex-col justify-center gap-3 sm:flex-row">
                <button @onclick='() => nav.NavigateTo(Const.Routes.Wallet.Purchase)'
                        class="flex items-center justify-center gap-2 px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-lg font-medium transition-all">
                    <Icon Style="Icon.IconStyle.CreditCard" CssClass="size-4" /> Try Again
                </button>
            </div>
        </div>
    </div>
}
else if (status == "success" && purchase != null)
{
    <div class="flex min-h-125 flex-1 items-center justify-center p-6 md:p-8">
        <div class="mx-auto w-full max-w-xl space-y-6">
            <div class="relative overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-xl">
                <div class="pointer-events-none absolute inset-0 opacity-[0.07]"
                     style="background-image: radial-gradient(#136dec 1px, transparent 1px), radial-gradient(#10b981 1px, transparent 1px); background-size: 20px 20px; background-position: 0 0, 10px 10px;">
                </div>

                <div class="relative flex flex-col items-center p-8 text-center">
                    <div
                        class="mb-6 flex size-20 items-center justify-center rounded-full bg-emerald-100 ring-8 ring-emerald-50">
                        <Icon Style="Icon.IconStyle.CheckCircle" CssClass="size-11 text-emerald-500" />
                    </div>

                    <h1 class="mb-2 text-2xl font-bold text-slate-900">Payment Successful!</h1>
                    <p class="mb-8 text-slate-500">Your transaction has been completed successfully.</p>

                    <div class="mb-6 w-full rounded-xl border border-slate-100 bg-slate-50 p-5 text-left">
                        <h3 class="mb-4 text-xs font-semibold tracking-wider text-slate-400 uppercase">
                            Transaction Summary
                        </h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-slate-500">Transaction ID</span>
                                <span
                                    class="max-w-[220px] text-right font-mono text-xs font-medium break-all text-slate-900">
                                    @(purchase.Reference ?? transactionId.ToString() ?? "—")
                                </span>
                            </div>

                            @if (purchase.Wallet == "SMS")
                            {
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Credits Purchased</span>
                                    <span class="font-medium text-slate-900">@(purchase.Quantity.ToString("#,##0")) SMS</span>
                                </div>
                            }
                            @if (purchase.Wallet == "CASH")
                            {
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Wallet funded</span>
                                    <span class="font-medium text-slate-900">₦ @purchase.SubTotal.ToString("#,##0.00")</span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">VAT</span>
                                    <span class="font-medium text-slate-900">₦ @purchase.TaxAmount.ToString("#,##0.00")</span>
                                </div>
                            }

                            <div class="flex items-center justify-between text-sm">
                                <span class="text-slate-500">Payment Method</span>
                                <span class="rounded bg-blue-100 px-2 py-0.5 text-xs font-bold tracking-wide text-blue-700">
                                    @(purchase.ProviderID?.ToUpper() ?? "PAYSTACK")
                                </span>
                            </div>

                            <div class="flex items-center justify-between border-t border-slate-200 pt-3">
                                <span class="font-semibold text-slate-700">Amount Paid</span>
                                <span class="text-lg font-bold text-slate-900">
                                    @purchase.TotalAmount.ToString("₦ #,##0.00")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="grid w-full grid-cols-2 gap-4">
                        <button @onclick='() => nav.NavigateTo(Const.Routes.Wallet.Purchase)'
                                class="flex items-center justify-center gap-2 px-4 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg font-medium transition-colors text-sm">
                            <Icon Style="Icon.IconStyle.Menu" CssClass="size-4" /> View History
                        </button>
                        <button @onclick='() => nav.NavigateTo(Const.Routes.Messaging.Compose)'
                                class="flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-lg font-medium shadow-sm shadow-brand-500/30 transition-colors text-sm">
                            <Icon Style="Icon.IconStyle.PenSquare" CssClass="size-4" /> Go to Compose
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string status = "loading";
    private Guid transactionId = Guid.Empty;
    private PurchaseResponse? purchase;

    [CascadingParameter(Name = "MainAccount")] public required AccountState State { get; set; }


    public Guid GetTransactionId(IEnumerable<string> queryParams)
    {
        var uri = nav.ToAbsoluteUri(nav.Uri);
        var parsedQuery = QueryHelpers.ParseQuery(uri.Query);

        foreach (var param in queryParams)
        {
            if (parsedQuery.TryGetValue(param, out var value) &&
                Guid.TryParse(value.ToString(), out var transactionId))
            {
                return transactionId;
            }
        }

        return Guid.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        transactionId = GetTransactionId(["txref", "reference"]);

        if (transactionId == Guid.Empty)
        {
            nav.NavigateTo(Const.Routes.Wallet.Purchase, replace: true);
            return;
        }

        try
        {
            var res = await apiClient.PurchaseCompleteAsync(transactionId);
            var data = res.Result;

            if (data != null && data.Status == "PAID")
            {
                purchase = data;
                status = "success";
                await RefreshWalletBalance();
            }
            else
            {
                // IsPaid false = user cancelled on Paystack
                nav.NavigateTo(Const.Routes.Wallet.Purchase, replace: true);
            }
        }
        catch (Exception)
        {
            // Verification failed
            status = "failed";
        }
    }

    private async Task RefreshWalletBalance()
    {
        try
        {
            var response = await apiClient.AccountGetAsync("self");

            if (response.Result is not null)
                State.UpdateBalance(response.Result.WalletBalance);
        }
        catch (ApiException ex)
        {
            await alert.Error($"Payment was verified, but the displayed balance could not be refreshed. {ex.FriendlyErrorMessage}");
        }
        catch (Exception ex)
        {
            await alert.Error($"Payment was verified, but the displayed balance could not be refreshed. {ex.Message}");
        }
    }
}
